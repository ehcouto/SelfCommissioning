    320          //---------------------------------------------------------------------------------------------------------------------
    321          /**
    322           *
    323           */

   \                                 In section .text, align 2, keep-with-next
    324          void API011AppCtrl__Handler(void)
    325          {
    326              #if (SYSTEM_HMI_HANDLING == ENABLED)
    327          
    328                  if(FALSE == First_Status_Regulations_Requested)
    329                  {
    330                      if((Reveal__GetNodestatus() & (1 << WIN_ACU_ADDRESS) ) != 0)
    331                      {
    332                          /*
    333                             Request status and regulations once ACU is detected alive.
    334                             Reset API011_Comm_Handle timer to avoid multiple, redundant requests at the same time.
    335                             Set API011AppCtrl_Request_Message_Content to API011APPCTRL_MESSAGE_REQUEST_REGULATIONS
    336                             to reinitialize standard request mechanism.
    337                           */
    338                          (void)API011AppCtrl__RequestStatus(WIN_ACU_ADDRESS);
    339                          (void)API011AppCtrl__RequestRegulations(WIN_ACU_ADDRESS);
    340                          First_Status_Regulations_Requested = TRUE;
    341                          Millis__Subtract(&API011_Elapsed_Time, API011APPCTRL_STANDARD_REQUEST_PERIOD);
    342                          API011AppCtrl_Request_Message_Content = API011APPCTRL_MESSAGE_REQUEST_REGULATIONS;
    343                      }
    344                  }
    345          
    346                  if (API011_Poll_Timeout > 0)
    347                  {
    348                      API011_Poll_Timeout--;
    349                  }
    350                  else
    351                  {
    352                      API011_Hmi_Poll_Reg_Status = ON;
    353                  }
    354          
    355                  if ((Mode__GetRemoteMode() == MODE_NORMAL) &&
    356                      (Mode__GetMode() == MODE_NORMAL) &&
    357                      (Mode__GetSubMode() != SUBMODE_NORMAL_EXT_CONTROL_ENGAGED) &&
    358                      API011_Hmi_Poll_Reg_Status == ON)
    359                  {
    360                      if(Millis__ReachedTarget(&API011_Elapsed_Time, API011APPCTRL_STANDARD_REQUEST_PERIOD))
    361                      {
    362                          Millis__Subtract(&API011_Elapsed_Time,API011APPCTRL_STANDARD_REQUEST_PERIOD);
    363                          // Checking the flag to decide if it is time to request Regulations or Status.
    364                          if(API011AppCtrl_Request_Message_Content == API011APPCTRL_MESSAGE_REQUEST_REGULATIONS)
    365                          {
    366                              API011_Num_Of_Consecutive_Regulations_Requests++;   // Increment number of regulations requests.
    367                              API011_Num_Of_Consecutive_Status_Requests = 0;      // Clear counter for status requests.
    368                              API011_Num_Of_Consecutive_Regulations_Sets = 0;     // Clear counter for regulations sets.
    369                              API011AppCtrl__RequestRegulations(WIN_ACU_ADDRESS);
    370                              API011AppCtrl_Request_Message_Content = API011APPCTRL_MESSAGE_REQUEST_STATUS;
    371                          }
    372                          else
    373                          {
    374                              API011_Num_Of_Consecutive_Status_Requests++;        // Increment number of status requests.
    375                              API011_Num_Of_Consecutive_Regulations_Requests = 0; // Clear counter for regulations requests.
    376                              API011AppCtrl__RequestStatus(WIN_ACU_ADDRESS);
    377                              API011AppCtrl_Request_Message_Content = API011APPCTRL_MESSAGE_REQUEST_REGULATIONS;
    378                          }
    379                      }
    380                      else
    381                      {
    382                          /*
    383                           * Verify if any of counters reached the limit. If yes act immediately.
    384                           */
    385                          if((API011_Num_Of_Consecutive_Regulations_Sets >= MAX_NUM_OF_CONSECUTIVE_REQUESTS) ||
    386                             (API011_Num_Of_Consecutive_Status_Requests >= MAX_NUM_OF_CONSECUTIVE_REQUESTS))
    387                          {
    388                              /*
    389                               * To many regulations sets without requesting regulations OR
    390                               * to many status requests without requesting regulations.
    391                               * In both cases Request Regulations packet needs to be sent to ACU.
    392                               */
    393                              #if(API011APPCTRL_LOG_FEATURE == ENABLED)
    394                              if(API011_Num_Of_Consecutive_Regulations_Sets >= MAX_NUM_OF_CONSECUTIVE_REQUESTS)
    395                              {
    396                                  // Reaching this point indicates abnormal behavior. This shall be avoided.
    397                                  LOG_ADD_EXCEPTION(TO_MANY_CONSECUTIVE_REGULATIONS_SETS, 0);
    398                              }
    399                              else
    400                              {
    401                                  // Reaching this point indicates abnormal behavior. This shall be avoided.
    402                                  LOG_ADD_EXCEPTION(TO_MANY_CONSECUTIVE_STATUS_REQUESTS, 0);
    403                              }
    404                              #endif //(API011APPCTRL_LOG_FEATURE == ENABLED)
    405          
    406                              if(TRUE == API011AppCtrl__RequestRegulations(WIN_ACU_ADDRESS))                      // Request regulations.
    407                              {
    408                                  API011_Num_Of_Consecutive_Regulations_Sets = 0;                                 // Clear counter for regulations sets.
    409                                  API011_Num_Of_Consecutive_Status_Requests = 0;                                  // Clear counter for status requests.
    410                                  API011_Num_Of_Consecutive_Regulations_Requests++;                               // Increment number of regulations requests.
    411                                  Millis__Subtract(&API011_Elapsed_Time,API011APPCTRL_TIMEOUT_TO_NEXT_REQUEST);   // Set timer to get status in 100ms.
    412                                  API011AppCtrl_Request_Message_Content = API011APPCTRL_MESSAGE_REQUEST_STATUS;   // Regulations just requested. Change content to status request.
    413                              }
    414                          }
    415                          else if(API011_Num_Of_Consecutive_Regulations_Requests >= MAX_NUM_OF_CONSECUTIVE_REQUESTS)
    416                          {
    417                              /*
    418                               * To many regulation requests without status request.
    419                               * In that case Request Status packet needs to be sent to ACU.
    420                               */
    421                              if(TRUE == API011AppCtrl__RequestStatus(WIN_ACU_ADDRESS))                               // Request status
    422                              {
    423                                  API011_Num_Of_Consecutive_Regulations_Requests = 0;                                 // Clear counter for regulations requests.
    424                                  API011_Num_Of_Consecutive_Status_Requests++;                                        // Increment counter for status requests.
    425                                  Millis__Subtract(&API011_Elapsed_Time,API011APPCTRL_TIMEOUT_TO_NEXT_REQUEST);       // Set timer to get regulations in 100ms.
    426                                  API011AppCtrl_Request_Message_Content = API011APPCTRL_MESSAGE_REQUEST_REGULATIONS;  // Status just requested. Change content to regulations request.
    427                              }
    428                              #if(API011APPCTRL_LOG_FEATURE == ENABLED)
    429                              // Reaching this point indicates abnormal behavior. This shall be avoided.
    430                              LOG_ADD_EXCEPTION(TO_MANY_CONSECUTIVE_REGULATIONS_REQUESTS, 0);
    431                              #endif //(API011APPCTRL_LOG_FEATURE == ENABLED)
    432                          }
    433                      }
    434                  }
    435              #elif (SYSTEM_ACU_HANDLING == ENABLED)
    436                  API011AppCtrlPublishStatus();
    437              #endif
    438          }
