    182          //---------------------------------------------------------------------------------------------------------------------
    183          /**
    184           *    @brief  - Enable or Disable the Flash security by back door key access
    185           *    @details- If this feature is enabled then the micro can be programmed or read the Flash memory only by providing the correct access key
    186           *
    187           *    The Access key is defined in the MICRO_FLASH_CONFIGURATION_BACKDOOR_ACCESS_KEY macro
    188           *
    189           *    By default disabling this feature
    190           */
    191          #ifndef MICRO_FLASH_SECUTIRY_BY_BACK_DOOR_KEY_ACCESS_FEATURE
