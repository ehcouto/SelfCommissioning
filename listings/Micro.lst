   2471          #pragma inline=forced
   2472          static MICRO_LAST_RESET_TYPE MicroReadActualReset(void)
   2473          {
   2474          	MICRO_LAST_RESET_TYPE reset;
   2475          
   2476          	*((uint8 *) (&reset)) = 0;
   2477          
   2478          	//Watchdog reset flag
   2479          	if ((RCM.SRS0 & RCM_SRS0_WDOG_MASK) || (RCM.SSRS0 & RCM_SSRS0_SWDOG_MASK))				//if ((SIM_CLK.SIM_SRSID & SIM_SRSID_WDOGRSTF) != FALSE)
   2480          	{
   2481          		reset.WATCHDOG = TRUE;
   2482          	}
   2483          
   2484          	//Low-power reset flag
   2485          	if (RCM.SRS0 & RCM_SRS0_LVD_MASK)
   2486          	{
   2487          		reset.LVD = TRUE;
   2488          	}
   2489          
   2490          	//Software reset flag or Option byte loader reset flag
   2491          	if (RCM.SRS1 & RCM_SRS1_SW_MASK)
