     48          /**
     49           *    @brief  - Defines the Enabling or disabling of the Safety relevant test features
     50           *    @details-
     51           *
     52           *    Below are the tests to be performed during boot and run-time -
     53           *    CPU Register test,
     54           *    Stack Test
     55           *    RAM Test(at boot time)
     56           *    Flash Test
     57           *    Watchdog Test
     58           *
     59           *    @param  - ENABLED(1)    - Which Enables the ClassB Test. ClassB software shall enable this macro
     60           *              DISABLED(0)   – Which Disables the ClassB Test. ClassA software can disables this macro
     61           *
     62           *    @note -   "#define MICRO_SR_FEATURE_TEST                   ENABLED"
     63           *              "#define MICRO_SR_FEATURE_TEST                   DISABLED"
     64           */
     65          #if (CLASSB_FEATURE == ENABLED)
     66              #ifndef MICRO_SR_FEATURE_TEST
     67                  #define MICRO_SR_FEATURE_TEST                               ENABLED
     68              #endif
     69          #else
     70              #ifndef MICRO_SR_FEATURE_TEST
     71                  #define MICRO_SR_FEATURE_TEST                               DISABLED
     72              #endif
     73          #endif
     74          
     75          #if (MICRO_SR_FEATURE_TEST   == ENABLED)
     76              #include "SRData.h"
     77          #endif
