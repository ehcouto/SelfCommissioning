   2494          	}
   2495          
   2496          	//POR reset flag
   2497          	if (RCM.SRS0 & RCM_SRS0_POR_MASK)
   2498          	{
   2499          		reset.POR = TRUE;		//This POR bits get set all the time for every power up without debugger
   2500          								//Temporary this is commented to resolve this POR bit issue talking with FAE
   2501          	}
   2502          
   2503              // External reset pin which makes external reset flag to set on all other type of resets.
   2504              // IWDG reset, WWDG reset, Power reset, Software reset and Low power management reset asserts 20us of low signal on the
   2505              // External reset pin which makes external reset flag to set on all other type of resets.
   2506              // Actual External reset can only be differentiated only if no other reset occurs other than external reset.
   2507          	if (RCM.SRS0 & RCM_SRS0_PIN_MASK)
   2508          	{
   2509          		reset.EXTERNAL = TRUE;
   2510          	}
   2511          
   2512          	RCM.SSRS0 = 0x7F;						//Clear System Reset Status Register
   2513          	RCM.SSRS1 = 0x3F;
   2514          
   2515              return(reset);
   2516          }
