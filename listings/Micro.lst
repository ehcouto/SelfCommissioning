   1840          /**
   1841           *    @brief    This method performs non-volatile memory (FLASH) test periodically.
   1842           *    @details  This method is responsible for checking the FLASH memory consistency.
   1843           *              Run time Flash Test which calculates CRC couple bytes each time and keeps on continuing until it
   1844           *              reaches the FLASH memory end and compare the calculated CRC against a CRC value stored
   1845           *              in FLASH memory.
   1846           *
   1847           *              INBUILT_FLASH_CRC_CALCULATOR macro defines the CRC calculation engine either Inbuilt or External.
   1848           *
   1849           *              MICRO_NUM_BYTE_FOR_FLASH_CONTINUOUS_TEST configuration macro defined in the SRMicro_prv.h file
   1850           *              Defines how many words will be processed each interaction of the Continuous Flash Test.
   1851           *
   1852           *              The time taken for complete FLASH test is calculated below-
   1853           *              For the inbuilt CRC tool(IELF) -
   1854           *              FULL FLASH TEST (in ms) =
   1855           *                 (((FLASH Size in words)-4)/ MICRO_NUM_BYTE_FOR_FLASH_CONTINUOUS_TEST) * Call rate(of Micro__FlashTest())
   1856           *
   1857           *              If the external CRC tool(IELF) is used-
   1858           *              FULL FLASH TEST (in ms) =
   1859           *                  (((FLASH Size in bytes)-4)/ MICRO_NUM_BYTE_FOR_FLASH_CONTINUOUS_TEST) * Call rate(of Micro__FlashTest())
   1860           *
   1861           *              In the calculation FLASH Size-4 because the last 4- bytes of the flash memory is used to
   1862           *              hold the calculated CRC value on which the Flash test is not performed.
   1863           *
   1864           *
   1865           *              For example
   1866           *              Flash size is 32768 in words,  number of bytes processed in each call are 4 and the call rate is 5ms
   1867           *              then time taken by the inbuilt CRC calculator is-
   1868           *              FULL FLASH TEST (in ms) =  ((32768-4) /4)  * 5 ms
   1869           *                                      = 2047.75ms
   1870           *
   1871           *              Along with this it provides the flow control log and exception control for each tests.
   1872           *              Note- Should be called at every 5ms or 25ms slot.
   1873           */
   1874          #pragma optimize=none

