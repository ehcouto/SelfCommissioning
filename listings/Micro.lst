    193          #endif
    194          
    195          //---------------------------------------------------------------------------------------------------------------------
    196          /**
    197           *    @brief  - Flash Access key to secure the Flash read
    198           *    @details- The key shall be of 8 bytes only
    199           *              The feature is disabled if all the bits of the key are either 0 or 1
    200           *
    201           *              Default value will be as below which disables the feature
    202           *              #define MICRO_FLASH_CONFIGURATION_BACKDOOR_ACCESS_KEY       {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}
    203           *
    204           */
    205          #if (MICRO_FLASH_SECUTIRY_BY_BACK_DOOR_KEY_ACCESS_FEATURE == ENABLED)
