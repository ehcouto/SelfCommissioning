    208              #endif
    209          #endif
    210          
    211          #ifndef MICRO_FLASH_CONFIGURATION_BACKDOOR_ACCESS_KEY
    212              #define MICRO_FLASH_CONFIGURATION_BACKDOOR_ACCESS_KEY       {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}
    213          #endif
