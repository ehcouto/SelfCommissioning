   1071          /**
   1072          *    @brief    This method is used for Core/System clock oscillation frequency errors can be detected.
   1073          *    @details  This ISR function measure the cycle of the frequency-divided LPO clock used for the independent watchdog timer (IWDT)
   1074          *              in the MKV03x. By this function, the main Core/System clock oscillation frequency errors can be detected.
   1075          *              This needs to be configured in the SRInterruptVector_prm.h & SRClockMonitor_prv.h file as below
   1076          *
   1077          *              #define LOW_POWER_TIMER                             Micro__LPTimerInterrupt
   1078          *
   1079          *              It defines the maximum number of TimerInterrupt counts above the expected is acceptable for the external clock source base
   1080          *              #define SRCLOCKMONITOR_CLK_TICKS_ABOVE       5
   1081          *
   1082          *              It defines the minimum number of TimerInterrupt counts below the expected is acceptable for the external clock source base
   1083          *              #define SRCLOCKMONITOR_CLK_TICKS_BELOW       5
   1084          *
   1085          *              example: for by default LPTIMER = 1Khz  & Prescaler is disabled  = 1msec
   1086          *              #define MICRO_LPTIMER_COMPARE_VAL    50 (i.e 50msec )
   1087          *              For every 50 msec LPTimer will generate an interrupt so compare this with SR Clockmonitor
   1088          *              to test Core/System clock by keeping min and max limits
   1089          *
   1090          */

   \                                 In section .text, align 2, keep-with-next
   1091          INTERRUPT_DIRECTIVE void Micro__LPTimerInterrupt(void)
   1092          {
   1093              #if(MICRO_LPTIMER_EXTCLOCKSOURCE == ENABLED)
   1094          
   1095                  /* write 1 to TCF to clear the LPT timer compare flag */
   1096                  LPTMR0.CSR |= LPTMR_CSR_TCF_MASK;
