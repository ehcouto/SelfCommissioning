     98          {
     99              /**
    100               * @brief If the project decided to secure the flash memory access then they shall define the Access Key
    101               */
    102              uint8 BackDoor_Access_Key[8];
    103          
    104              /**
    105               * @brief Define which program flash regions are protected from program and erase operations.
    106               * Protected flash regions cannot have their content changed; that is, these regions cannot be programmed and cannot be erased.
    107               * Unprotected regions can be changed by program and erase operations.
    108               *
    109               * This feature is disabled as we do not have a requirement or use case to protect the selective Flash regions from program and erase operations
    110               */
    111              uint32 Flash_Protection_Regions;
    112          
    113              /**
    114               * @brief - Flash Security
    115               *
    116               * KEYEN - Back door key access is Enabled or Disabled
    117               * Bit 7-6          : 11 Backdoor key access disabled
    118               *                  : 10 Backdoor key access enabled
    119               *
    120               * Mass Erase Enable
    121               * Bit 5-4          : 11 Mass erase is enabled
    122               *
    123               * Factory Security Level Access Code Granted
    124               * Bit 3-2          : 11 Factory access granted
    125               *
    126               * Flash Security
    127               * Bit 1-0          : 10 MCU security status is unsecure
    128               *
    129               */
    130              uint8 Security;
    131          
    132              /**
    133               * @brief Allows the user to customize the operation of the MCU at boot time.
    134               *
    135               * Boot From Flash Memory
    136               * Bit 7 BOOTSRC_SEL    - 0
    137               * Bit 1 BOOTPIN_OPT    - 1
    138               *
    139               *
    140               * Below are reserved and written as 1 by default
    141               * Bit 6 - 4            - 1
    142               *
    143               *
    144               * RESET PIN Configuration - RESET_b pin is dedicated. The port is configured with pullup enabled, open drain, passive filter enabled.
    145               * Bit 3 RESET_PIN_CFG  - 1
    146               *
    147               *
    148               * Disable the NMI interrupts generated by the dedicated pin -
    149               * The associated pin continues to default to NMI_b pin controls with internal pullup enabled. When NMI_b pin function is
    150               * disabled, it cannot be used as a source for low-power mode wake-up.
    151               * If the NMI function is not required, either for an interrupt or wake up source, it is
    152               * recommended that the NMI function be disabled by clearing NMI_DIS.
    153               * Bit 2 NMI_DIS        - 0
    154               *
    155               *
    156               * LPBOOT - Normal boot: Core and system clock divider (DIVCORE) is 0x0 (divide by 1).
    157               * Bit 0                - 1
    158               *
    159               */
    160              uint8 Boot_options;
    161          
    162              /**
    163               * @brief The FEPROT register defines which EEPROM regions of the FlexRAM are protected against program and erase operations.
    164               * Protected EEPROM regions cannot have their content changed by writing to it.
    165               * Unprotected regions can be changed by writing to the FlexRAM.
    166               *
    167               * This feature is disabled as we do not have a requirement or use case to protect the EEPROM regions from program and erase operations
    168               */
    169              uint8 EEPROM_Protection;
    170          
    171              /**
    172               * @brief Defines which data flash regions are protected against program and erase operations.
    173               * Protected Flash regions cannot have their content changed; that is, these regions cannot be programmed and cannot be erased.
    174               * Unprotected regions can be changed by both program and erase operations.
    175               *
    176               * This feature is disabled as we do not have a requirement or use case to protect the Data Flash regions from program and erase operations
    177               */
    178              uint8 DataFlash_Protection;
    179          } MICRO_FLASH_CONFIGURATION_TYPE;
    180          
