    134          //---------------------------------------------------------------------------------------------------------------------
    135          /**
    136           * Restore the Milliseconds value from non-volatile memory.
    137           * On the ACU there are two possibilities after a reset:
    138           *  1. NVData recovered RAM variables
    139           *     In this case, the Milliseconds variable is restored to its value before the reset and
    140           *     it is ready for use. Also, all the non-volatile timers are restored and ready for use.
    141           *  2. NVData was unable to recover RAM variables
    142           *     In this case, the non-volatile timers were not restored either. Therefore, the value of
    143           *     the Milliseconds variable is probably 0 from the initialization firmware; but the value
    144           *     is actually unimportant. Any starting value will work since there are no active timers.
    145           *
    146           * On any non-ACU project type, the method of restoring the Milliseconds value must be managed
    147           * through the Millis_prv.h file using the following macros:
    148           *      RESTORE_HANDLER()
    149           *      INIT_COMPLETE()
    150           *      STORE_HANDLER()
    151           */

   \                                 In section .text, align 2, keep-with-next
    152          void Millis__Initialize(void)
    153          {
    154              #if ((MILLIS_SUPPORT_NV_TIMERS == ENABLED) && (SYSTEM_ACU_HANDLING == DISABLED))
    155                  Init_Complete = FALSE;
    156                  Millis_Store_Timer = Millis__BuildTimer();
    157                  Milliseconds = 0;
    158              #endif
    159          
    160              #if (SYSTEM_TIMERS_FEATURE == ENABLED)
    161                  SystemTimers__Initialize();
