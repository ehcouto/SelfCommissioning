    194          /**
    195           * Takes care of store(requirement specifies when the value has to be stored, i.e. each second or each minute)
    196           * and restore (after a power failure) action of the timer reference
    197           * This function should be called from the lowest priority thread.
    198           */

   \                                 In section .text, align 2, keep-with-next
    199          void Millis__SlowHandler(void)
    200          {
    201              #if ((MILLIS_SUPPORT_NV_TIMERS == ENABLED) && (SYSTEM_ACU_HANDLING == DISABLED))
    202                  if (Init_Complete)
    203                  {
    204                      if (Millis__ReachedTargetSeconds(&Millis_Store_Timer, MILLIS_SAVE_PERIOD_SECONDS))
    205                      {
    206                          Stored_Milliseconds = Milliseconds;
    207                          // Prepare for the next update
    208                          Millis__SubtractSeconds(&Millis_Store_Timer, MILLIS_SAVE_PERIOD_SECONDS);
    209                      }
    210                  }
    211                  else
    212                  {
    213                      if ((Mode__GetMode() == MODE_NORMAL) &&
    214                          (Mode__GetSubMode() == SUBMODE_NORMAL_SUPERVISOR) &&
    215                          (IS_MILLIS_DATA_RESTORED() == TRUE))
    216                      {
    217                          Milliseconds = Stored_Milliseconds;
    218                          Init_Complete = TRUE;
    219                      }
    220                      else
    221                      {
    222                          if (Milliseconds >= MILLIS_START_UP_TIMEOUT)
    223                          {
    224                              Init_Complete = TRUE;
    225                          }
    226                      }
    227          
    228                      if (Init_Complete)
    229                      {
    230                          Millis__Start(&Millis_Store_Timer);
    231                          Stored_Milliseconds = Milliseconds;   // store Milliseconds value in case of power interruption before 60 seconds since Power On
    232                      }
    233                  }
    234              #endif
    235          }
