    583          /**
    584           * Convert HMS clock time to milliseconds.
    585           * @param hms = The HMS clock time to convert
    586           * @return The equivalent time in milliseconds
    587           */
    588          static uint32 ConvertHmsToMilliseconds(MILLIS_HMS_TYPE hms)
    589          {
    590              uint32 value = hms.Hours;
    591              value *= 60;
    592              value += hms.Minutes;
    593              value *= 60;
    594              value += hms.Seconds;
    595              value *= 1000;
    596              value += hms.Milliseconds;
    597              return value;
    598          }
