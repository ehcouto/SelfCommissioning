     67          
     68          //! Structure for periodic analog data publishing.
     69          typedef struct
     70          {
     71              uint8 Publish_Requested;                        //!< Flags if the data is requested to be published
     72              uint16 Time_Threshold;                          //!< Time threshold; multiple of 25 ms. Note: this value shall be adjusted according to the amount of motors
     73              uint16 Time_Counter;                            //!< Instantaneous timer counter.
     74          } API220_PUBLISH_ANALOG_DATA_PERIOD_TYPE;
     75          
     76          
     77          //! Converts a value into TRUE or FALSE; 0 is FALSE, TRUE otherwise.
     78          #ifndef GET_TRUE_FALSE
