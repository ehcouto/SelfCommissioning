    620          //---------------------------------------------------------------------------------------------------------------------
    621          /*
    622           * @brief       Set a new target speed and invoke the Mci run command.
    623           * @param       buffer - a pointer to the received Reveal buffer.
    624           * @return      Returns whether Mci has accepted or not the command; TRUE = accepted; FALSE = denied
    625           */
    626          uint8 Run_Motor(REVEAL_MSG_TYPE *buffer)
    627          {
    628          #ifdef API220_ENABLE_MCI_CALLS
    629          
    630              uint8 ret_val;
    631              MOTOR_ENUM_TYPE motor_index;
    632              sint16 target_speed;
    633              sint16 target_accel;
    634              #ifndef ENABLE_API220_CALLBACKS
    635                  MCI_CMD_RESPONSE_TYPE feedback;
    636                  REVEAL_COMMAND_TYPE *command;
    637              #endif
    638          
    639              ret_val = FALSE;                                // Default answer is FALSE
    640          
    641              if(buffer->sdu_length == 7)                     // This command requests receiving this amount of bytes, include API and Opcode bytes.
    642              {
    643                  // Build up the data from the Reveal buffer
    644                  motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
    645                  target_speed = ((sint16)(buffer->payload[1])<<8) + buffer->payload[2];
    646                  target_accel = ((sint16)(buffer->payload[3])<<8) + buffer->payload[4];
    647          
    648                  #ifdef ENABLE_API220_CALLBACKS
    649          
    650                      // Invoke Mci
    651                      Mci__Run(motor_index, target_speed, target_accel);
    652          
    653                      ret_val = TRUE;
    654          
    655                  #else
    656          
    657                      // Invoke Mci run and read its feedback
    658                      feedback = Mci__Run(motor_index, target_speed, target_accel);
    659          
    660                      command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_RUN, REVEAL_BROADCAST_NODE, 6);
    661                      if(command != NULL)
    662                      {
    663                          // Build and enqueue the Reveal buffer with the required feedback
    664                          Reveal__AddDataU8(command, motor_index);
    665                          Reveal__AddDataU16(command, target_speed);
    666                          Reveal__AddDataU16(command, target_accel);
    667                          Reveal__AddDataU8(command, (uint8)feedback);
    668          
    669                          ret_val = Reveal__QueueCommand(command);
    670                      }
    671          
    672                  #endif
    673          
    674                  // Set the last commands to internal variables.
    675                  Last_Speed_Target[motor_index] = target_speed;
    676                  Last_Ramp_Target[motor_index] = target_accel;
    677              }
    678          
    679              return(ret_val);
    680          
    681          #else
    682          
    683              return(FALSE);
    684          
    685          #endif
    686          }
