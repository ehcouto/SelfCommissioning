   1388          //---------------------------------------------------------------------------------------------------------------------
   1389          /*
   1390           * @brief       Manual control of the inverter output
   1391           * @detail      The output can be manually controlled, this output might be the voltage vector or the current vector.
   1392           * @param       buffer - a pointer to the received Reveal buffer.
   1393           * @return      Returns whether Mci has accepted or not the command; TRUE = accepted; FALSE = denied
   1394           */
   1395          uint8 Manual_Control(REVEAL_MSG_TYPE *buffer)
   1396          {
   1397          #ifdef API220_ENABLE_MCI_CALLS
   1398          
   1399              uint8 ret_val;
   1400              MOTOR_ENUM_TYPE motor_index;
   1401              MCI_INJECTION_TYPE method;
   1402              sint32 level_target;
   1403              sint32 level_rate;
   1404              sint32 parameter;
   1405              sint32 param_rate;
   1406          
   1407              #ifndef ENABLE_API220_CALLBACKS
   1408                  MCI_CMD_RESPONSE_TYPE feedback;
   1409                  REVEAL_COMMAND_TYPE *command;
   1410              #endif
   1411          
   1412              ret_val = FALSE;                                // Default answer is FALSE
   1413          
   1414              if(buffer->sdu_length == 12)                    // This command requests receiving this amount of bytes, include API and Opcode bytes.
   1415              {
   1416                  // Build up the data from the Reveal buffer
   1417                  motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
   1418                  method = (MCI_INJECTION_TYPE)buffer->payload[1];
   1419                  level_target = (((sint16)buffer->payload[2])<<8) + buffer->payload[3];
   1420                  level_rate   = (((sint16)buffer->payload[4])<<8) + buffer->payload[5];
   1421                  parameter    = (((sint16)buffer->payload[6])<<8) + buffer->payload[7];
   1422                  param_rate   = (((sint16)buffer->payload[8])<<8) + buffer->payload[9];
   1423          
   1424                  #ifdef ENABLE_API220_CALLBACKS
   1425          
   1426                      // Invoke Mci
   1427                      Mci__Manual_Injection(motor_index, method, level_target, level_rate, parameter, param_rate);
   1428          
   1429                      ret_val = TRUE;
   1430          
   1431                  #else
   1432          
   1433                      // Invoke Mci manual control and read its feedback
   1434                      feedback = MANUAL_INJECTION_RUN(motor_index, method, level_target, level_rate, parameter, param_rate);
   1435          
   1436                      command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_MANUAL_CONTROL, REVEAL_BROADCAST_NODE, 3);
   1437                      if(command != NULL)
   1438                      {
   1439                          // Build and enqueue the Reveal buffer with the required feedback
   1440                          Reveal__AddDataU8(command, motor_index);
   1441                          Reveal__AddDataU8(command, method);
   1442                          Reveal__AddDataU8(command, (uint8)feedback);
   1443          
   1444                          ret_val = Reveal__QueueCommand(command);
   1445                      }
   1446          
   1447                  #endif
   1448          
   1449                  // Set the last commands to internal variables.
   1450                  Last_Manual_Injection_Method[motor_index] = method;
   1451                  Last_Manual_Injection_Level_Target[motor_index] = level_target;
   1452                  Last_Manual_Injection_Parameter[motor_index] = parameter;
   1453              }
   1454          
   1455              return(ret_val);
   1456          
   1457          #else
   1458          
   1459              return(FALSE);
   1460          
   1461          #endif
   1462          }
