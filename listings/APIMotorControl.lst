   1344          //---------------------------------------------------------------------------------------------------------------------
   1345          /*
   1346           * @brief       Handle the algorithms for periodic analog data publishing.
   1347           */
   1348          void Periodically_Publish_Analog(void)
   1349          {
   1350              static MOTOR_ENUM_TYPE motor_index;
   1351              uint8 analog_data_index;
   1352          
   1353              // Handle the connected motor amount, it shall sweep of number of the connected motors
   1354              motor_index++;
   1355              if(motor_index >= API220_NR_OF_CONNECTED_MOTORS)
   1356              {
   1357                  motor_index = MOTOR0;
   1358              }
   1359          
   1360              // Sweeps all the requested analog data for publishing
   1361              for(analog_data_index = 0; analog_data_index < (1+MCI_AI_NR_OF_AI); analog_data_index++)
   1362              {
   1363                  // Check if the data defined in the PUBLISH_ANALOG_DATA_TYPE is requested for periodic publishing
   1364                  if(Api220_Per_Analog_Data[motor_index][analog_data_index].Publish_Requested == TRUE)
   1365                  {
   1366                      // If the publishing time is not yet over, then
   1367                      if(Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Counter)
   1368                      {
   1369                          // count the time.
   1370                          Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Counter--;
   1371                      }
   1372                      else // otherwise
   1373                      {
   1374                          // attempt to build and stack the command on the wide, if it was stacked,
   1375                          if(Publish_Analog_Input(motor_index, (MCI_AI_TYPE)analog_data_index) == TRUE)
   1376                          {
   1377                              // then reload the time for publishing.
   1378                              Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Counter = Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Threshold;
   1379                          }
   1380                      }
   1381                  }
   1382              }
   1383          }
   1384          
