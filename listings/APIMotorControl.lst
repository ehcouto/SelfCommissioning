    762          /**
    763           * @brief       Get all the digital inputs. It parses the command from Reveal, builds up the
    764           *              buffer and sends it back to the communication buffer.
    765           * @param       buffer a point to the incoming Reveal buffer
    766           * @return      TRUE: The variable was successfully changed.
    767           *              FALSE: The variable could not be changed.
    768           */
    769          uint8 Get_Digital(REVEAL_MSG_TYPE *buffer)
    770          {
    771              uint8 ret_val;
    772              MOTOR_ENUM_TYPE motor_index;
    773          
    774              ret_val = FALSE;                                // By default, the feedback is always false.
    775          
    776              if(buffer->sdu_length == 3)                     // This command requests receiving this amount of bytes, include API and Opcode bytes.
    777              {
    778                  // Recover the data from the Reveal buffer
    779                  motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
    780          
    781                  // Check the sanity of the motor index
    782                  if(motor_index < API220_NR_OF_CONNECTED_MOTORS)
    783                  {
    784                      // Invoke the publishing method with the required feedback
    785                      Publish_Digital_Input(motor_index, Mci_Digital_Inputs[motor_index]);
    786          
    787                      ret_val = TRUE;                         // Command is accepted
    788                  }
    789              }
    790          
    791              return(ret_val);
    792          }
