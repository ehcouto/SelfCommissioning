    828                  	// Clear error holder
    829                  	 Mci__ClearError(motor_index);
    830                      // Update the error
    831                  	 Mci_Digital_Error[motor_index] = Mci__GetErrorList(motor_index);
    832                  	 // Invoke the publishing method with the required feedback
    833                  	 Publish_Error(motor_index, Mci_Digital_Error[motor_index]);
    834                  	 ret_val = TRUE;                         // Command is accepted
    835                  }
    836              }
    837          
    838              return(ret_val);
    839          }
    840          
    841          //---------------------------------------------------------------------------------------------------------------------
    842          /*
    843           * @brief       Periodically update the digital inputs log from Mci. In the case any bit is changed in the log status,
    844           *              then the event needs to be published over the Reveal stack.
    845           */
    846          void Update_Digital_Inputs(void)
    847          {
    848          
    849              uint32 digital_in_temp[API220_NR_OF_CONNECTED_MOTORS];
    850              static MOTOR_ENUM_TYPE motor_index = MOTOR0;
    851          
    852              // Motor index is handled in a such way that no nested for loops are performed,
    853              // as the computational effort is decreased, it saves cpu resources, e.g., cpu usage
    854              // by having only the side effect to take more time to sweep all digital failures
    855              // configured in the Mci look up tables.
    856              motor_index++;
    857              if(motor_index >= API220_NR_OF_CONNECTED_MOTORS)
    858              {
    859                  motor_index = MOTOR0;
    860              }
    861          
    862              digital_in_temp[motor_index] = Mci__GetDigitalList(motor_index);
    863          
    864              // Check for any differences between the previous log status to the actual one...
    865              if(Mci_Digital_Inputs[motor_index] != digital_in_temp[motor_index])
    866              {
    867              	// If any bit is inverted, then check if the command was properly enqueued on the Reveal buffer
    868              	// if the command was not enqueued, then, keep trying until the value is sent.
    869              	if(Publish_Digital_Input(motor_index, digital_in_temp[motor_index]) == TRUE)
    870              	{
    871              		// Publish the digital inputs to the Reveal bus
    872              		Mci_Digital_Inputs[motor_index] = digital_in_temp[motor_index];
    873              	}
    874              }
    875          }
    876          
    877          
    878          
    879          //---------------------------------------------------------------------------------------------------------------------
    880          /*
    881           * @brief       Periodically update the digital inputs log from Mci. In the case any bit is changed in the log status,
    882           *              then the event needs to be published over the Reveal stack.
    883           */
    884          void Update_Error(void)
    885          {
    886          
    887              uint32 error_temp[API220_NR_OF_CONNECTED_MOTORS];
    888              static MOTOR_ENUM_TYPE motor_index = MOTOR0;
    889          
    890              // Motor index is handled in a such way that no nested for loops are performed,
    891              // as the computational effort is decreased, it saves cpu resources, e.g., cpu usage
    892              // by having only the side effect to take more time to sweep all digital failures
    893              // configured in the Mci look up tables.
    894              motor_index++;
    895              if(motor_index >= API220_NR_OF_CONNECTED_MOTORS)
    896              {
    897                  motor_index = MOTOR0;
    898              }
    899          
    900              error_temp[motor_index] = Mci__GetErrorList(motor_index);
    901          
    902              // Check for any differences between the previous log status to the actual one...
    903              if(Mci_Digital_Error[motor_index] != error_temp[motor_index])
    904              {
    905              	// If any bit is inverted, then check if the command was properly enqueued on the Reveal buffer
    906              	// if the command was not enqueued, then, keep trying until the value is sent.
    907              	if(Publish_Error(motor_index, error_temp[motor_index]) == TRUE)
    908              	{
    909              		// Publish the digital inputs to the Reveal bus
    910              		Mci_Digital_Error[motor_index] = error_temp[motor_index];
    911              	}
    912              }
    913          }
    914          
    915          
    916          
    917          
    918          
    919          //---------------------------------------------------------------------------------------------------------------------
    920          /**
    921           * @brief       Publish the digital data with the latest log
    922           * @param       motor_index motor indexer between 0 and user defined
    923           * @param       digital_input the bitwise flags read from the Mci digital data
    924           * @return      TRUE: command was properly enqueued.
    925           *              FALSE: command was not enqueued; feedback from Reveal stack.
    926           */
    927          T_BOOL Publish_Digital_Input(MOTOR_ENUM_TYPE motor_index, uint32 digital_input)
    928          {
    929              T_BOOL ret_val;
    930              REVEAL_COMMAND_TYPE *command;
    931          
    932              ret_val = FALSE;                                // Default answer is false.
    933          
    934              command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_GET_DIGITAL, REVEAL_BROADCAST_NODE, 5);
    935              if(command != NULL)
    936              {
    937                  // Build and enqueue the Reveal buffer with the required feedback
    938                  Reveal__AddDataU8(command, motor_index);
    939                  Reveal__AddDataU32(command, digital_input);
    940          
    941                  ret_val = (T_BOOL)Reveal__QueueCommand(command);
    942              }
    943          
    944              return(ret_val);
    945          }
    946          
    947          
    948          
    949          
    950          //---------------------------------------------------------------------------------------------------------------------
    951          /**
    952           * @brief       Publish the digital data with the latest log
    953           * @param       motor_index motor indexer between 0 and user defined
    954           * @param       digital_input the bitwise flags read from the Mci digital data
    955           * @return      TRUE: command was properly enqueued.
    956           *              FALSE: command was not enqueued; feedback from Reveal stack.
    957           */
    958          T_BOOL Publish_Error(MOTOR_ENUM_TYPE motor_index, uint32 errors)
    959          {
    960              T_BOOL ret_val;
    961              REVEAL_COMMAND_TYPE *command;
    962          
    963              ret_val = FALSE;                                // Default answer is false.
    964          
    965              command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_GET_ERROR, REVEAL_BROADCAST_NODE, 5);
    966              if(command != NULL)
    967              {
    968                  // Build and enqueue the Reveal buffer with the required feedback
    969                  Reveal__AddDataU8(command, motor_index);
    970                  Reveal__AddDataU32(command, errors);
    971          
    972                  ret_val = (T_BOOL)Reveal__QueueCommand(command);
    973              }
    974          
    975              return(ret_val);
    976          }
    977          
    978          
    979          
    980          //---------------------------------------------------------------------------------------------------------------------
    981          /**
    982           * @brief       Set digital data in the Mci. The data comes from Reveal, is parsed within this method. If there is a
    983           *              free spot in the Reveal stack, then the Mci set digital command is performed
    984           * @param       buffer a pointer to the incoming Reveal buffer
    985           * @return      TRUE: The variable was successfully changed.
    986           *              FALSE: The variable could not be changed.
    987           */
    988          uint8 Set_Digital(REVEAL_MSG_TYPE *buffer)
    989          {
    990              uint8 dig_feedback;
    991              uint8 ret_val;
    992              MOTOR_ENUM_TYPE motor_index;
    993              MCI_DO_TYPE dig_index;
    994              uint8 dig_data;
    995              REVEAL_COMMAND_TYPE *command;
    996          
    997              ret_val = FALSE;                                // Default answer is false.
    998          
    999              if(buffer->sdu_length == 5)                     // This command requests receiving this amount of bytes, include API and Opcode bytes.
   1000              {
   1001                  command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_SET_DIGITAL, REVEAL_BROADCAST_NODE, 4);
   1002                  if(command != NULL)
   1003                  {
   1004                      // Recover the data from the serial communication.
   1005                      motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
   1006                      dig_index = (MCI_DO_TYPE)buffer->payload[1];
   1007                      dig_data = (MCI_DO_TYPE)buffer->payload[2];
   1008                      dig_data = GET_TRUE_FALSE(dig_data);
   1009          
   1010          #ifdef API220_ENABLE_MCI_CALLS
   1011                      // Invoke the Mci Command.
   1012                      dig_feedback = Mci__SetDigital(motor_index, dig_index, (T_BOOL)dig_data);
   1013          #else
   1014                      dig_feedback = FALSE;
   1015          #endif
   1016          
   1017                      // Build and enqueue the Reveal buffer with the required feedback
   1018                      Reveal__AddDataU8(command, motor_index);
   1019                      Reveal__AddDataU8(command, dig_index);
   1020                      Reveal__AddDataU8(command, dig_data);
   1021                      Reveal__AddDataU8(command, dig_feedback);
   1022          
   1023                      ret_val = Reveal__QueueCommand(command);
   1024                  }
   1025              }
   1026          
   1027              return(ret_val);
   1028          }
   1029          
   1030          
   1031          
   1032          //---------------------------------------------------------------------------------------------------------------------
   1033          /**
   1034           * @brief       Get analog data from Mci according to the incoming Reveal buffer.
   1035           * @param       buffer a pointer to the incoming Reveal buffer
   1036           * @return      TRUE data is read and has properly fedback the Reveal protocol
   1037           *              FALSE data wasn't read nor built in the Reveal stack
   1038           */
   1039          uint8 Get_Analog(REVEAL_MSG_TYPE *buffer)
   1040          {
   1041              uint8 ret_val;
   1042              MOTOR_ENUM_TYPE motor_index;
   1043              MCI_AI_TYPE analog_data_index;
   1044          
   1045              ret_val = FALSE;                                // Default answer is false.
   1046          
   1047              if(buffer->sdu_length == 4)                     // This command requests receiving this amount of bytes, include API and Opcode bytes.
   1048              {
   1049                  motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
   1050                  analog_data_index = (MCI_AI_TYPE)buffer->payload[1];
   1051          
   1052                  ret_val = Publish_Analog_Input(motor_index, analog_data_index);
   1053              }
   1054          
   1055              return(ret_val);
   1056          }
   1057          
   1058          
   1059          
   1060          
   1061          //---------------------------------------------------------------------------------------------------------------------
   1062          /**
   1063           * @brief       Publish on the Reveal bus the requested analog data.
   1064           * @param       motor_index is the requested motor index connected to the Mci API implementation.
   1065           * @param       analog_data_index indexes the requested analog data from the Mci API implementation
   1066           * @return      TRUE data was properly read and set in the Reveal buffer
   1067           *              FALSE data wasn't able to be read nor be built on the on the Reveal buffer
   1068           */
   1069          uint8 Publish_Analog_Input(MOTOR_ENUM_TYPE motor_index, MCI_AI_TYPE analog_data_index)
   1070          {
   1071              uint16 temp_u16;
   1072              uint8 ret_val;
   1073              sint32 analog_data;
   1074              REVEAL_COMMAND_TYPE *command;
   1075          
   1076              ret_val = FALSE;                            // By default, the feedback is FALSE.
   1077          
   1078              // Check and, if available, enqueue a new Reveal feedback.
   1079              command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_GET_ANALOG, REVEAL_BROADCAST_NODE, 6);
   1080              if(command != NULL)
   1081              {
   1082                  if(analog_data_index < MCI_AI_NR_OF_AI)
   1083                  {
   1084                   	// Invoke Mci with required analog data to be read
   1085                  	analog_data = (sint32)Mci__GetAnalog(motor_index, analog_data_index);
   1086          
   1087                  	// Build and enqueue the Reveal buffer with the required feedback
   1088                  	Reveal__AddDataU8(command, motor_index);
   1089                  	Reveal__AddDataU8(command, analog_data_index);
   1090                  	Reveal__AddDataU32(command, (uint32)analog_data);        
   1091                  }
   1092                  else
   1093                  {
   1094                      // Build and enqueue the Reveal buffer with the required feedback
   1095                      Reveal__AddDataU8(command, motor_index);
   1096                      Reveal__AddDataU8(command, analog_data_index);
   1097          
   1098                      temp_u16 = (uint16)(Mci__GetAnalog(MOTOR0, MCI_AI_SPEED_REFERENCE_RPM_S16)>>16);
   1099                      Reveal__AddDataU16(command, temp_u16);
   1100          
   1101                      temp_u16 = (uint16)(Mci__GetAnalog(MOTOR0, MCI_AI_ACTUAL_SPEED_S16)>>16);
   1102                      Reveal__AddDataU16(command, temp_u16);
   1103          
   1104                      temp_u16 = (uint16)Mci__GetAnalog(MOTOR0, MCI_AI_INTERNAL_MCI_STATE);
   1105                      Reveal__AddDataU8(command, (uint8)temp_u16);
   1106          
   1107                      temp_u16 = (uint16)(Mci__GetAnalog(MOTOR0, MCI_AI_BUS_VOLTAGE_S16)>>16);
   1108                      Reveal__AddDataU16(command, temp_u16);
   1109                  }
   1110          
   1111                  ret_val = Reveal__QueueCommand(command);
   1112              }
   1113          
   1114              return(ret_val);
   1115          }
   1116          
   1117          
   1118          
   1119          
   1120          //---------------------------------------------------------------------------------------------------------------------
   1121          /*
   1122           * @brief       Set analog data in the Mci.
   1123           * @param       buffer a pointer to the incoming Reveal buffer
   1124           * @return      TRUE: The variable was successfully changed.
   1125           *              FALSE: The variable could not be changed.
   1126           */
   1127          uint8 Set_Analog(REVEAL_MSG_TYPE *buffer)
   1128          {
   1129              uint8 ret_val;
   1130              uint8 feedback;
   1131              MOTOR_ENUM_TYPE motor_index;
   1132              MCI_AO_TYPE analog_data_index;
   1133              uint32 analog_data;
   1134              REVEAL_COMMAND_TYPE *command;
   1135          
   1136              ret_val = FALSE;                                // Default answer is FALSE
   1137          
   1138              if(buffer->sdu_length == 8)                     // This command requests receiving this amount of bytes, include API and Opcode bytes.
   1139              {
   1140                  // Check and, if available, enqueue a new Reveal feedback.
   1141                  command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_SET_ANALOG, REVEAL_BROADCAST_NODE, 7);
   1142                  if(command != NULL)
   1143                  {
   1144                      motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
   1145                      analog_data_index = (MCI_AO_TYPE)buffer->payload[1];
   1146                      analog_data =   (((uint32)buffer->payload[2])<<24) +
   1147                                      (((uint32)buffer->payload[3])<<16) +
   1148                                      (((uint32)buffer->payload[4])<<8)  +
   1149                                      (((uint32)buffer->payload[5]));
   1150          
   1151          #ifdef API220_ENABLE_MCI_CALLS
   1152                      // Invoke Mci to write the analog data
   1153                      feedback = Mci__SetAnalog(motor_index, analog_data_index, analog_data);
   1154          #else
   1155                      feedback = FALSE;
   1156          #endif
   1157          
   1158                      // Update last user analog write request
   1159                      Last_Analog_Output[motor_index][analog_data_index] = analog_data;
   1160          
   1161                      // Build and enqueue the Reveal buffer with the required feedback
   1162                      Reveal__AddDataU8(command, motor_index);
   1163                      Reveal__AddDataU8(command, analog_data_index);
   1164                      Reveal__AddDataU32(command, analog_data);
   1165                      Reveal__AddDataU8(command, feedback);
   1166          
   1167                      ret_val = Reveal__QueueCommand(command);
   1168                  }
   1169              }
   1170          
   1171              return(ret_val);
   1172          }
   1173          
   1174          
   1175          
   1176          
   1177          //---------------------------------------------------------------------------------------------------------------------
   1178          /*
   1179           * @brief       Parse the buffer that sets the parameters to periodically publish the analog data.
   1180           * @param       buffer a Reveal buffer to be parsed
   1181           * @return      TRUE the command accepted with all parameters correct. FALSE something was wrong in the requested data
   1182           */
   1183          uint8 Set_Data_Periodically_Publish(REVEAL_MSG_TYPE *buffer)
   1184          {
   1185              MOTOR_ENUM_TYPE motor_index;
   1186              MCI_AI_TYPE analog_data_index;
   1187              uint8 publish_rate;
   1188              uint8 ret_val;
   1189          
   1190              ret_val = FALSE;                                // Default answer is FALSE
   1191          
   1192              if(buffer->sdu_length == 5)                     // This command requests receiving this amount of bytes, include API and Opcode bytes.
   1193              {
   1194                  // Build the data from the buffer
   1195                  motor_index = (MOTOR_ENUM_TYPE)buffer->payload[0];
   1196                  analog_data_index = (MCI_AI_TYPE)buffer->payload[1];
   1197                  publish_rate = buffer->payload[2];
   1198          
   1199                  // Sanity check on the given parameters
   1200                  if( (motor_index < API220_NR_OF_CONNECTED_MOTORS) &&
   1201                      (analog_data_index < MCI_AI_NR_OF_AI)   )
   1202                  {
   1203                      // If the rate is different than zero, it means that something has to be published periodically
   1204                      if(publish_rate)
   1205                      {
   1206                          // Enable the periodic publishing according to the received bytes.
   1207                          Api220_Per_Analog_Data[motor_index][analog_data_index].Publish_Requested = TRUE;
   1208                          Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Threshold = (publish_rate * 40)/API220_NR_OF_CONNECTED_MOTORS;
   1209                          Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Counter = 0;
   1210                      }
   1211                      else // otherwise, it is requested to stop publishing
   1212                      {
   1213                          // Disable the periodic publishing.
   1214                          Api220_Per_Analog_Data[motor_index][analog_data_index].Publish_Requested = FALSE;
   1215                          Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Threshold = 0;
   1216                          Api220_Per_Analog_Data[motor_index][analog_data_index].Time_Counter = 0;
   1217                      }
   1218          
   1219                      ret_val = TRUE;                         // command accepted.
   1220                  }
   1221          
   1222              }
   1223          
   1224              return(ret_val);
   1225          }
   1226          
   1227          
   1228          
   1229          
   1230          //---------------------------------------------------------------------------------------------------------------------
   1231          /*
   1232           * @brief       Parse commands required by FVT mode.
   1233           * @details     Parse and communicates to FVT tests, start, stop, request and publish results.
   1234           * @param       buffer a Reveal buffer to be parsed
   1235           * @return      TRUE the command accepted with all parameters correct. FALSE something was wrong in the requested data
   1236           */
   1237          
   1238          #if (MCI_FVT_TESTS == ENABLED)
   1239          
   1240          static uint8 Api220_Fvt_Mode(REVEAL_MSG_TYPE *buffer)
   1241          {
   1242              API220_FVT_COMMANDS_TYPE fvt_command;
   1243              uint8 feedback;
   1244              MOTOR_ENUM_TYPE motor_index;
   1245              REVEAL_COMMAND_TYPE *command;
   1246              uint8 ret_val;
   1247          
   1248              ret_val = FALSE;                                // Default answer is FALSE
   1249          
   1250              // parse incoming package
   1251              fvt_command = (API220_FVT_COMMANDS_TYPE)buffer->payload[0];
   1252              motor_index = (MOTOR_ENUM_TYPE)buffer->payload[1];
   1253          
   1254              switch(fvt_command)
   1255              {
   1256                  case API220_FVT_START:
   1257                      // Check and, if available, enqueue a new Reveal feedback.
   1258                      command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_FVT, REVEAL_BROADCAST_NODE, 6);
   1259                      if(command != NULL)
   1260                      {
   1261                          feedback = FVT_START(motor_index);
   1262          
   1263                          Api220_Fvt_Result_Published = FALSE;
   1264          
   1265                          Reveal__AddDataU8(command, fvt_command);
   1266                          Reveal__AddDataU8(command, motor_index);
   1267                          Reveal__AddDataU8(command, feedback);
   1268          
   1269                          ret_val = Reveal__QueueCommand(command);
   1270                      }
   1271                      break;
   1272          
   1273                  case API220_FVT_STOP:
   1274                      // Check and, if available, enqueue a new Reveal feedback.
   1275                      command = Reveal__NewFeedback(API220_MOTOR_CONTROL_NUM, API220_OPCODE_MOTOR_CONTROL_FVT, REVEAL_BROADCAST_NODE, 6);
   1276                      if(command != NULL)
   1277                      {
   1278                          feedback = FVT_STOP(motor_index);
   1279          
   1280                          Reveal__AddDataU8(command, fvt_command);
   1281                          Reveal__AddDataU8(command, motor_index);
   1282                          Reveal__AddDataU8(command, feedback);
   1283          
   1284                          ret_val = Reveal__QueueCommand(command);
   1285                      }
   1286                      break;
   1287          
   1288                  case API220_FVT_REQUEST_RESULT:
   1289                      ret_val = Publish_Fvt_Result();
   1290                      break;
   1291          
   1292                  default:
   1293                      // Left blank intentionally
   1294                      break;
   1295              }
   1296          
   1297          
   1298          
   1299              return(ret_val);
   1300          }
