    670              {
    671                  // phase U
    672                  FTM0.CONTROLS[SR_PWM_U_HIGH].CnV    = (sint16)SR_Pwm_A_1;
    673                  FTM0.CONTROLS[SR_PWM_U_LOW].CnV     = -(sint16)SR_Pwm_A_1;
    674          
    675                  // phase V
    676                  FTM0.CONTROLS[SR_PWM_V_HIGH].CnV    = (sint16)SR_Pwm_B_1;
    677                  FTM0.CONTROLS[SR_PWM_V_LOW].CnV     = -(sint16)SR_Pwm_B_1;
    678          
