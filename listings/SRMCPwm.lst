     84          //-------------------------------------- Definitions ------------------------------------------------
     85          
     86          #define PWM_OUTPUT_OFF()			{FTM0.OUTMASK |= (FTM_OUTMASK_CH5OM_MASK | FTM_OUTMASK_CH4OM_MASK |FTM_OUTMASK_CH3OM_MASK | FTM_OUTMASK_CH2OM_MASK |FTM_OUTMASK_CH1OM_MASK | FTM_OUTMASK_CH0OM_MASK);}	// all outputs disabled (at inactive level)
     87          #define PWM_OUTPUT_ON()				{FTM0.OUTMASK &= ~(FTM_OUTMASK_CH5OM_MASK | FTM_OUTMASK_CH4OM_MASK |FTM_OUTMASK_CH3OM_MASK | FTM_OUTMASK_CH2OM_MASK |FTM_OUTMASK_CH1OM_MASK | FTM_OUTMASK_CH0OM_MASK);}	// all outputs enable (at active level)
     88          #define PWM_TIMER_START()			{FTM0.MODE |= FTM_MODE_WPDIS_MASK; FTM0.SC |= FTM_SC_CLKS(1);FTM0.FMS |= FTM_FMS_WPEN_MASK;} //Not functional
     89          #define PWM_TIMER_STOP()			{FTM0.MODE |= FTM_MODE_WPDIS_MASK; FTM0.SC |= FTM_SC_CLKS(0);FTM0.FMS |= FTM_FMS_WPEN_MASK;} //Not functional
