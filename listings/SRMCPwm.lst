    176          /*
    177           * @brief       Initialize the inverter outputs before booting the class B - enable all lowers switches
    178           * @details     According to the memory size, the microcontroller may take long time to power up, in the case of
    179           *              a reset and according to the physics of the motor, some side effects shall happen to the
    180           *              system. E.g., very high DC bus voltage and breaks the electronic. Therefore, it requires
    181           *              to disconnect motor from the dc bus capacitors by enabled lowers switches.
    182           */

   \                                 In section .text, align 2, keep-with-next
    183          void SRMCPwm__Initialize_Before_Boot(void)
    184          {
    185              SIM.SCGC5 |= (SIM_SCGC5_PORTA_MASK |            // Connect the GPIOA device to the Core bus
    186                           SIM_SCGC5_PORTB_MASK  |            // Connect the GPIOB device to the Core bus
    187                           SIM_SCGC5_PORTC_MASK  |            // Connect the GPIOC device to the Core bus
    188                           SIM_SCGC5_PORTD_MASK  |            // Connect the GPIOD device to the Core bus
    189                           SIM_SCGC5_PORTE_MASK);             // Connect the GPIOE device to the Core bus
   \                     SRMCPwm__Initialize_Before_Boot: (+1)
   \   00000000   0x.... 0x....      LDR.W    R0,??DataTable19  ;; 0x40048038
   \   00000004   0x6801             LDR      R1,[R0, #+0]
   \   00000006   0xF441 0x5178      ORR      R1,R1,#0x3E00
   \   0000000A   0x6001             STR      R1,[R0, #+0]
    190          
    191          
    192          
    193          
    194              // Initialize the output state
    195          #if SR_PWM_HIGH_CHANNELS_ACTIVE_LEVEL == 1 // High level activated
    196          
    197              #if (SR_PWM__REMAP == 0)
    198          
    199                  // Zero all upper switches
    200                  GPIOC.PCOR = (1<<0);
    201                  GPIOC.PCOR = (1<<2);
    202                  GPIOC.PCOR = (1<<4);
    203          
    204              #elif(SR_PWM__REMAP == 1)
    205          
    206                  // Zero all upper switches
    207                  GPIOD.PCOR = (1<<0);
   \   0000000C   0x2101             MOVS     R1,#+1
   \   0000000E   0x.... 0x....      LDR.W    R0,??DataTable19_1  ;; 0x400ff0c4
   \   00000012   0x6041             STR      R1,[R0, #+4]
   \   00000014   0xF44F 0x7280      MOV      R2,#+256
    208                  GPIOD.PCOR = (1<<2);
   \   00000018   0x2104             MOVS     R1,#+4
   \   0000001A   0x6041             STR      R1,[R0, #+4]
    209                  GPIOD.PCOR = (1<<4);
   \   0000001C   0x2110             MOVS     R1,#+16
   \   0000001E   0x6041             STR      R1,[R0, #+4]
    210          
    211              #endif
    212          
    213          #elif SR_PWM_HIGH_CHANNELS_ACTIVE_LEVEL == 0 // Low level activated
    214          
    215              #if (SR_PWM__REMAP == 0)
    216          
    217                  // One all upper switches
    218                  GPIOC.PSOR = (1<<0);
    219                  GPIOC.PSOR = (1<<2);
    220                  GPIOC.PSOR = (1<<4);
    221          
    222              #elif(SR_PWM__REMAP == 1)
    223          
    224                  // One all upper switches
    225                  GPIOD.PSOR = (1<<0);
    226                  GPIOD.PSOR = (1<<2);
    227                  GPIOD.PSOR = (1<<4);
    228          
    229              #endif
    230          
    231          #else
    232          
    233              #error High power switch driver polarity not defined
    234          
    235          #endif
    236          
    237          
    238          #if SR_PWM_LOW_CHANNELS_ACTIVE_LEVEL == 1 // High level activated
    239          
