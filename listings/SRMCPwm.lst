    681                  FTM0.CONTROLS[SR_PWM_W_LOW].CnV     = -(sint16)SR_Pwm_C_1;
    682          
    683                  FTM0.PWMLOAD = FTM_PWMLOAD_LDOK_MASK;
    684          
    685          
    686                  FTM0.SC &= ~FTM_SC_TOF_MASK; //Clear the interrupt flag
    687              }
    688          #endif
    689          
    690          }
