    804          /**
    805           * @brief Local method to evaluate a NVTimer
    806           * @param nv_timer
    807           */
    808          static void EvalTimer(SYSTEMTIMER_NV_TIMER_TYPE * nv_timer)
    809          {
    810          	nv_timer->last_handle_counter = Handle_Counter;
    811          	if (nv_timer->state == SYSTEMTIMERS_STATE_RUNNING)
    812          	{
    813          		//  |--reference  --------  compare ---|
    814          		//  |----------------------------------|
    815          
    816          		uint32 current;
    817          		uint32 compare;
    818          
    819          		if (Handle_Counter >= nv_timer->reference)
    820          		{
    821          			current = Handle_Counter - nv_timer->reference;
    822          		}
    823          		else
    824          		{
    825          			current = Handle_Counter +(0xFFFFFFFF - nv_timer->reference);
    826          		}
    827          
    828          		if (nv_timer->compare >= nv_timer->reference)
    829          		{
    830          			compare = nv_timer->compare - nv_timer->reference;
    831          		}
    832          		else
    833          		{
    834          			compare = nv_timer->compare + (0xFFFFFFFF - nv_timer->reference);
    835          		}
    836          
    837          		if (compare <= current)
    838          		{
    839          			nv_timer->state = SYSTEMTIMERS_STATE_DONE;
    840          			nv_timer->n_state = SYSTEMTIMERS_STATE_N_DONE;
    841          		}
    842          
    843          	}
    844          	else if (nv_timer->state > SYSTEMTIMERS_STATE_INVALID)
    845          	{
    846          		nv_timer->state = SYSTEMTIMERS_STATE_INVALID;
    847          		nv_timer->n_state = SYSTEMTIMERS_STATE_N_INVALID;
    848          	}
    849          }
    850          
    851          #endif

