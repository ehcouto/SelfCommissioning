    818          /**
    819           * @brief   Returns the start address of the setting file data based on the position of the section in the setting file.
    820           * @param   sf_position: position of the section in the setting file
    821           */
    822          static uint16 * GetSettingFileStartByPosition(uint8 sf_position)
    823          {
    824              uint16* ptr16 = NULL;
    825          
    826              if (SettingFile__IsValid() == TRUE)
    827              {
    828                  ptr16 = SF_START_ADDRESS;
    829                  for (uint8 position = 0; position < SF_MAX_SECTIONS; position++)
    830                  {
    831                      SF_ID_TYPE section_id = ((SF_SECTION_HEADER_TYPE*)(void*)ptr16)->Section_ID;
    832                      if (section_id == SF_ID_END)
    833                      {
    834                          ptr16 = NULL;                           // Invalidate the pointer if the end of the setting file is reached
    835                          break;                                  // Break out of the for() loop.
    836                      }
    837                      else if (position == sf_position)
    838                      {
    839                          break;                                  // Reached the desired section so break out of the for() loop
    840                      }
    841          
    842                      ptr16++;                                    // Adjust pointer to point to the beginning of the data (excluded section ID and endianness)
    843                      ptr16 = &ptr16[ptr16[SF_PTR_ACU_END_OF_SECTION]];   // Adjust pointer to point to the start of the next section
    844                  }
    845          
    846                  ptr16++;                                        // Adjust pointer to point to the beginning of the data (excluded section ID and endianness)
    847              }
    848          
    849              return(ptr16);
    850          }
