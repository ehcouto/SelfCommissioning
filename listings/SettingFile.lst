    716          //---------------------------------------------------------------------------------------------------------------------
    717          /**
    718           * @brief   Calculates the CRC of a setting file section
    719           * @param   section_start_address: Address of the start of the setting file data (does not include first word that
    720           *          contains the section ID and endianness)
    721           * @return  CRC of the setting file section
    722           */
    723          static uint16 CalculateSectionCRC(uint16 * section_start_address)
    724          {
    725              uint16   crc = 0;   // Initialize value to zero in case the setting file with the requested ID is not found
    726              uint16 * data_crc_address;
    727          
    728              data_crc_address = ExtractAbsPointer(section_start_address, SF_PTR_ACU_CRC);
    729          
    730              if (data_crc_address != NULL)
    731              {
    732                  uint8 * byte_ptr = (void*)(section_start_address - 1);
    733                  uint8 * end_of_data_ptr = (void*)data_crc_address;
    734          
    735                  crc = 0xFFFF;
    736          
    737                  while (byte_ptr < end_of_data_ptr)
    738                  {
    739                      crc = Crc16__ByteProcess(crc,*byte_ptr);
    740                      byte_ptr++;
    741                  }
    742              }
    743          
    744              return (crc);
    745          }
