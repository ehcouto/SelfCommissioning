   2761          #pragma inline = forced
   2762          #endif
   2763          
   2764          
   2765          #ifdef __IAR_SYSTEMS_ICC__
   2766          #pragma inline = forced
   2767          #endif
   2768          void InputCapturePlausibilityHandler(void)
   2769          {
   2770              uint16 temp;
   2771          
   2772              temp = SRMCInputCapture__GetDiagnosticFeedback();
   2773          
   2774              if (temp == SR_IC_MIN_TACH_ERROR)
   2775              {
   2776                  // Set the plausibility fault
   2777                  SetFault(SR_FAULT_INPUTCAPTURE_PLAUSIBILITY_MIN_FAILED);
   2778          
   2779                  SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,TACHO_TIMEOUT); //Load time out
   2780              }
   2781              else if (temp == SR_IC_MAX_SPEED_ERROR)
   2782              {
   2783                  SetFault(SR_FAULT_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED);
   2784          
   2785                  SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,TACHO_TIMEOUT); //Load time out
   2786              }
   2787              else if ((temp == SR_IC_TEST_NOT_INITIALIZED) || (temp == SR_IC_ERROR_PERIPHERAL_NOT_SAFE))
   2788              {
   2789                  // todo: which fault report?
   2790                  // Set the plausibility fault
   2791                  SetFault(SR_FAULT_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED);
   2792          
   2793                  SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,TACHO_TIMEOUT); //Load time out
   2794              }
   2795          }
