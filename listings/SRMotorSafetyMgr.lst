    111          //! Define the states for the state machine handler
    112          typedef enum
    113          {
    114              SAFETY_MNGR_NOT_DEFINED         = 0,                //! Reserved 0 index - shall not be used
    115              SAFETY_MNGR_INITIALIZE          = 1,                //! Initialization for the state machine
    116              SAFETY_MNGR_IDLE                = 2,                //! The state machine is able to accept requests to run the pre run tests
    117              SAFETY_MNGR_PRERUN_TESTS        = 3,                //! All tests before running the motor has to be performed within this state
    118              SAFETY_MNGR_POSTRUN_TESTS       = 4,                //! Performs tests after running and before setting the unlock door speed flag
    119              SAFETY_MNGR_RUNNING             = 5,                //! This state is used when the motor is running
    120              SAFETY_MNGR_ERROR_FOUND         = 6,                //! If an error is found, the state machine shall stay in this ERROR state
    121              SAFETY_MNGR_UNLOCK_DOOR_CHECK   = 7,                //! Perform the plausibility check only once after IDLING for some time
    122          } SAFETY_MNGR_TYPE;
