   2801          /**
   2802           *  @brief      Get the latest captured value of the InputCapture driver.
   2803           *  @param      none
   2804           *  @return     Last value of the InputCapture driver. Zero if the IC driver is disabled
   2805           */
   2806          unsigned int SRMotorSafetyMgr__GetInputCaptureCounterValue(void)
   2807          {
   2808              unsigned int res = 0;
   2809              if (SRMCInputCapture__GetStatus() == INPUTCAPTURE_ENABLED)
   2810              {
   2811                  res = SRMCInputCapture__GetCounterValue();
   2812              }
   2813          
   2814              return res;
   2815          }
