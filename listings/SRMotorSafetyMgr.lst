   2261          
   2262          
   2263          /**
   2264           *  @brief      Performs the diagnostic of motor control peripherals (Atod and Pwm)
   2265           *  @return     none
   2266           *
   2267           */
   2268          #ifdef __IAR_SYSTEMS_ICC__
   2269          #pragma inline = forced
   2270          #endif
   2271          void PeripheralDiagnostic(void)
   2272          {
   2273              uint32 temp;
   2274              uint16 temp_flags;
   2275          
   2276              if(SR_SafetyMngr_State == SAFETY_MNGR_PRERUN_TESTS)
   2277              {
   2278                  // Perform the Shut Down pin plausibility check
   2279                  SRMCPwm__DiagnosticHandler();
   2280          
   2281                  // Perfom the ADCs plausibility check
   2282                  SRMCAtod__DiagnosticHandler();
   2283          
   2284                  // Read flag and fault to temp variables.
   2285                  temp_flags = SR_Motor_Flags;
   2286          
   2287                  // Handle the feedbacks
   2288          
   2289                  // AtoD module
   2290                  temp = SRMCAtod__GetDiagnosticFeedback();
   2291                  if (temp == SR_MCATOD_ERROR_PERIPHERAL_SAFE)
   2292                  {
   2293                      BIT_SET(temp_flags, SR_FLAG_ADC_PLAUSIB_CHECK_OK);
   2294                  }
   2295                  else if(temp == SR_MCATOD_ERROR_PERIPHERAL_NOT_SAFE)
   2296                  {
   2297                      SetFault(SR_FAULT_CURRENT_SENSOR_FAILED);
   2298          
   2299                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,ELECTRONIC_FAIL_TIMEOUT); //Load time out
   2300                  }
   2301          
   2302                  // PWM module
   2303                  temp = SRMCPwm__GetDiagnosticFeedback();
   2304                  if (temp == SR_MCPWM_ERROR_PERIPHERAL_SAFE)
   2305                  {
   2306                      BIT_SET(temp_flags, SR_FLAG_SHUTDOWN_PLAUSIB_CHECK_OK);
   2307                  }
   2308                  else if (temp == SR_MCPWM_ERROR_PERIPHERAL_NOT_SAFE)
   2309                  {
   2310                      SetFault(SR_FAULT_PWM_SHUTDOWN_FAILED);
   2311          
   2312                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,ELECTRONIC_FAIL_TIMEOUT); //Load time out
   2313                  }
   2314          
   2315                  // If there is nothing wrong in the plausibility chech of the sensors...
   2316                  if( (BIT_TEST(temp_flags, SR_FLAG_ADC_PLAUSIB_CHECK_OK) != 0)       &&
   2317                      (BIT_TEST(temp_flags, SR_FLAG_SHUTDOWN_PLAUSIB_CHECK_OK) != 0)  )
   2318                  {
   2319          
   2320                      // Check if the signals from the hardware are within the
   2321                      // acceptable levels.
   2322                      temp = MotorAnalogCircuitCheck();
   2323          
   2324                      if (temp == MOTOR_ANALOG_CHECK_CURR_FAIL)
   2325                      {
   2326                          SetFault(SR_FAULT_CURRENT_SENSOR_FAILED);
   2327          
   2328                          SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,ELECTRONIC_FAIL_TIMEOUT); //Load time out
   2329                      }
   2330                      else if (temp == MOTOR_ANALOG_CHECK_VBUS_FAIL)
   2331                      {
   2332                          SetFault(SR_FAULT_VOLTAGE_SENSOR_FAILED);
   2333          
   2334                          SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,ELECTRONIC_FAIL_TIMEOUT); //Load time out
   2335                      }
   2336                      else // no hardware circuit error was found so far.
   2337                      {
   2338                          BIT_SET(temp_flags, SR_FLAG_PRERUN_TESTS_FINISHED);     // Warn the initial tests were performed
   2339                      }
   2340          
   2341                      // Reset plausibility checks status - RICUPL
   2342                      BIT_CLR(temp_flags, SR_FLAG_ADC_PLAUSIB_CHECK_OK);
   2343                      BIT_CLR(temp_flags, SR_FLAG_SHUTDOWN_PLAUSIB_CHECK_OK);
   2344                  }
   2345          
   2346                  SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags, temp_flags);
   2347              }
   2348              else if (SR_SafetyMngr_State == SAFETY_MNGR_POSTRUN_TESTS)
   2349              {
   2350                  // Perform the Shut Down pin plausibility check
   2351                  SRMCPwm__DiagnosticHandler();
   2352              }
   2353          
   2354          }
   2355          
   2356          
   2357          
   2358          /**
   2359           *  @brief      Manage the  Class A Pwm Access
   2360           *  @return     none
   2361           *
   2362           */
   2363          #ifdef __IAR_SYSTEMS_ICC__
   2364          #pragma inline = forced
   2365          #endif
   2366          void ClassAPwmAccess(void)
   2367          {
   2368              // Class A Pwm Access management
   2369              if (SR_SafetyMngr_State == SAFETY_MNGR_RUNNING)
   2370              {
   2371                  if(SR_Motor_Fault == 0 && (BIT_TEST(SR_Motor_Flags, SR_FLAG_REQUESTED_TO_STOP) == 0))
   2372                  {// No safety fault and request to stop are detected
   2373          
   2374                      // Allow the pwm access by Class A software,
   2375                      // the Class A shall start accessing the pwm driver from this moment...
   2376                      BIT_SET(SR_Motor_Flags, SR_FLAG_CLASS_A_PWM_ACCESS);
   2377                      SR_MCU_MOTOR_UPDATE_N_VAR(SR_Motor_Flags);
   2378          
   2379                  }
   2380                  else
   2381                  {
   2382                      // Class A software is not allowed to access the peripheral
   2383                      BIT_CLR(SR_Motor_Flags, SR_FLAG_CLASS_A_PWM_ACCESS);
   2384                      SR_MCU_MOTOR_UPDATE_N_VAR(SR_Motor_Flags);
   2385          
   2386                      // The state machine is still in running and a fault is detected,
   2387                      // apply the pwm error reaction before the 5 ms handler action
   2388                      SR_MOTORSAFETY_MGR_ERROR_REACTION();
   2389                  }
   2390          
   2391              }
   2392              else
   2393              {
   2394                  // Class A software is not allowed to access the peripheral
   2395                  BIT_CLR(SR_Motor_Flags, SR_FLAG_CLASS_A_PWM_ACCESS);
   2396                  SR_MCU_MOTOR_UPDATE_N_VAR(SR_Motor_Flags);
   2397              }
   2398          }
   2399          
   2400          
   2401          /**
   2402           *  @brief      Test if the power up condition for the MCU have already reached.
   2403           *              If the sum of the square of each current is smaller than the following
   2404           *              threshold, then the powering up is done in the current sensoring point
   2405           *              of view. The trick is: when the micro is powering up, the current offset
   2406           *              will take long time to stabilize, due to a low pass filter with a very
   2407           *              low cut off frequency. As for starting, then a current will be reading
   2408           *              (there is no current flowing the shunt resistors), so, when the offset
   2409           *              filter is stabilized, then the read current (i1, i2, i3) will be very
   2410           *              close to zero. It is not zero, since there is some noise in those sensors.
   2411           *  @return     TRUE: power up is already finished
   2412           *              FALSE: power up it not completed yet.
   2413           *
   2414           */
   2415          #ifdef __IAR_SYSTEMS_ICC__
   2416          #pragma inline = forced
   2417          #endif
   2418          void PowerUpSensors(void)
   2419          {
   2420              sint16 temp;
   2421              uint32 temp1;
   2422              uint32 temp2;
   2423          
   2424              SR_DATA_MCU_CHECK_SHORT(SR_PowerUpTimer);
   2425          
   2426              // Just count up a dummy timer, only used
   2427              // to prevent any hardware noise from the hardware power-up
   2428              temp = SR_PowerUpTimer;
   2429              if(temp < SR_POWER_UP_DELAY_TIMER)
   2430              {
   2431                  temp++;
   2432                  SR_DATA_MCU_UPDATE_SHORT(SR_PowerUpTimer,temp);
   2433              }
   2434              else
   2435              {
   2436                  // If the sum of the square current has converged to zero
   2437                  // then declare the power up is finished.
   2438                  temp1 = SR_SquaredCurrentsSum;
   2439                  temp2 = SR_CalibrationCntr;
   2440                  if(temp1 < SR_POWERING_UP_CURRENTS_THRESHOLD)
   2441                  {
   2442                      temp2++;
   2443                      SR_DATA_MCU_UPDATE_LONG(SR_CalibrationCntr,temp2);
   2444                      if (temp2 > SR_CALIBRATION_CNTR_THRESHOLD)
   2445                      {
   2446                          SR_DATA_MCU_UPDATE_LONG(SR_CalibrationCntr,0);
   2447                          // The currents readings are stabilized, so, transitory is finished!
   2448                          temp = (uint16)SR_Motor_Flags;
   2449                          BIT_CLR(temp, SR_FLAG_MICRO_POWERING_UP);
   2450                          SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,(uint16)temp);
   2451                      }
   2452                  }
   2453              }
   2454          
   2455          }
   2456          
   2457          
   2458          
   2459          /**
   2460           *  @brief      Calculate the average of the sensors offsets
   2461           *  @return     none
   2462           */
   2463          #ifdef __IAR_SYSTEMS_ICC__
   2464          #pragma inline = forced
   2465          #endif
   2466          void AverageSensorsOffset(void)
   2467          {
   2468              sint32 tempS32_1;
   2469              sint32 tempS32_2;
   2470          
   2471          
   2472              CheckAnalogVariables4Failure();
   2473              SR_DATA_MCU_CHECK_LONG(SR_CurrentOffsetHistA);
   2474              SR_DATA_MCU_CHECK_LONG(SR_CurrentOffsetHistB);
   2475              SR_DATA_MCU_CHECK_LONG(SR_CurrentOffsetHistC);
   2476          
   2477          
   2478              //////////////////////////////////////////////////////////////////////////////////////////////////////
   2479              tempS32_1 = SR_CurrentOffsetHistA;
   2480          
   2481              //tempS32_2 = SRMCATOD__GETADC1();                  // Read the converted values...
   2482              tempS32_2 = SR_CurrentA + SR_CurrentOffsetA;
   2483          
   2484              tempS32_2 -= (tempS32_1 >> 16);                 // Subtract zero offset
   2485              // this make 400ms time constant for 16kHz sampling frequency, i.e. reach final value in 6 x 400ms
   2486              tempS32_1 += tempS32_2 * AVERAGE_CURR_SENSOR_OFFSET_LPF_FACTOR;
   2487          
   2488              SR_DATA_MCU_UPDATE_LONG(SR_CurrentOffsetHistA,tempS32_1);
   2489              tempS32_1 = tempS32_1 >> 16;
   2490              SR_DATA_MCU_UPDATE_SHORT(SR_CurrentOffsetA,(sint16)tempS32_1);
   2491          
   2492          
   2493              //////////////////////////////////////////////////////////////////////////////////////////////////////
   2494              tempS32_1 = SR_CurrentOffsetHistB;
   2495          
   2496              //tempS32_2 = SRMCATOD__GETADC2();                  // Read the converted values...
   2497              tempS32_2 = SR_CurrentB + SR_CurrentOffsetB;
   2498          
   2499              tempS32_2 -= (tempS32_1 >> 16);                 // Subtract zero offset
   2500              // this make 400ms time constant for 16kHz sampling frequency, i.e. reach final value in 6 x 400ms
   2501              tempS32_1 += tempS32_2 * AVERAGE_CURR_SENSOR_OFFSET_LPF_FACTOR; 
   2502              
   2503              SR_DATA_MCU_UPDATE_LONG(SR_CurrentOffsetHistB,tempS32_1);
   2504              tempS32_1 = tempS32_1 >> 16;
   2505              SR_DATA_MCU_UPDATE_SHORT(SR_CurrentOffsetB,(sint16)tempS32_1);
   2506          
   2507          
   2508              //////////////////////////////////////////////////////////////////////////////////////////////////////
   2509              tempS32_1 = SR_CurrentOffsetHistC;
   2510          
   2511              //tempS32_2 = SRMCATOD__GETADC3();                  // Read the converted values...
   2512              tempS32_2 = SR_CurrentC + SR_CurrentOffsetC;
   2513          
   2514              tempS32_2 -= (tempS32_1 >> 16);                 // Subtract zero offset
   2515              // this make 400ms time constant for 16kHz sampling frequency, i.e. reach final value in 6 x 400ms
   2516              tempS32_1 += tempS32_2 * AVERAGE_CURR_SENSOR_OFFSET_LPF_FACTOR;
   2517              
   2518              SR_DATA_MCU_UPDATE_LONG(SR_CurrentOffsetHistC,tempS32_1);
   2519              tempS32_1 = tempS32_1 >> 16;
   2520              SR_DATA_MCU_UPDATE_SHORT(SR_CurrentOffsetC,(sint16)tempS32_1);
   2521          }
   2522          
   2523          
   2524          
   2525          
   2526          /**
   2527           *  @brief      Get the feed about the shut down pin and feeds back
   2528           *              in the case of a failure.
   2529           *  @return     TRUE: fault found; FALSE: nothing wrong
   2530           */
   2531          #ifdef __IAR_SYSTEMS_ICC__
   2532          #pragma inline = forced
   2533          #endif
   2534          uint8 CheckHwFaultStatus(void)
   2535          {
   2536              uint8 temp = FALSE;                     // Return variable
   2537              uint8 temp1;                            // temporary variable for SD pin feedback
   2538          
   2539              temp1 = SRMCPwm__GetHwFaultStatus();            // Gets SD pin status
   2540              if(temp1 == TRUE)                               // In case HW fault detected
   2541              {
   2542                  SetFault(SR_FAULT_OVER_CURRENT);
   2543          
   2544                  temp = TRUE;                                // Updates flags in classB and returns failure detected
   2545              }
   2546              return(temp);                                   // Returns check response
   2547          }
   2548          
   2549          
   2550          
   2551          
   2552          /**
   2553           *  @brief      Calculate the average of the sensors offsets
   2554           *  @return     none
   2555           */
   2556          #ifdef __IAR_SYSTEMS_ICC__
   2557          #pragma inline = forced
   2558          #endif
   2559          MOTOR_ANALOG_CHECK_TYPE MotorAnalogCircuitCheck(void)
   2560          {
   2561              MOTOR_ANALOG_CHECK_TYPE response;

   \                                 In section .bss, align 4
   \   00000000                      DS8 4
   2562              static sint32 delta_curr_a;

   \                                 In section .bss, align 4
   \   00000000                      DS8 4
   2563              static sint32 delta_curr_b;

   \                                 In section .bss, align 4
   \   00000000                      DS8 4
   2564              static sint32 delta_curr_c;

   \                                 In section .bss, align 2
   \   00000000                      DS8 2
   2565              static sint16 vbus;
   2566          
   2567              //Check of offset for current of phase A
   2568              delta_curr_a = SR_CurrentOffsetA - CURR_OFFSET_REF;
   2569              if(delta_curr_a<0)
   2570              {
   2571                  delta_curr_a = -delta_curr_a;
   2572              }
   2573          
   2574              //Check of offset for current of phase B
   2575              delta_curr_b = SR_CurrentOffsetB - CURR_OFFSET_REF;
   2576              if(delta_curr_b<0)
   2577              {
   2578                  delta_curr_b = -delta_curr_b;
   2579              }
   2580          
   2581              //Check of offset for current of phase C
   2582              delta_curr_c = SR_CurrentOffsetC - CURR_OFFSET_REF;
   2583              if(delta_curr_c<0)
   2584              {
   2585                  delta_curr_c = -delta_curr_c;
   2586              }
   2587          
   2588              //Check for consistency of vbus reading
   2589              vbus = SR_DCBus;
   2590          
   2591              if( (delta_curr_a > CURR_OFFSET_THD) ||
   2592                  (delta_curr_b > CURR_OFFSET_THD) ||
   2593                  (delta_curr_c > CURR_OFFSET_THD))
   2594              {
   2595                  response = MOTOR_ANALOG_CHECK_CURR_FAIL;
   2596              }
   2597              else if( (vbus > VBUS_SR_HIGH_LIM) ||
   2598                       (vbus < VBUS_SR_LOW_LIM)  )
   2599              {
   2600                  response = MOTOR_ANALOG_CHECK_VBUS_FAIL;
   2601              }
   2602              else
   2603              {
   2604                  response = MOTOR_ANALOG_CHECK_CORRECT;
   2605              }
   2606          
   2607              return(response);
   2608          }
   2609          
   2610          
   2611          
   2612          
   2613          /**
   2614           *  @brief      Evaluate if the voltage is within allowed range
   2615           *  @return     none
   2616           */
   2617          void OverVoltageCheck(void)
   2618          {
   2619              sint16 vbus;
   2620              uint16 temp;
   2621          
   2622              temp = (uint16)SR_SafetyMngr_State;
   2623              if((temp != SAFETY_MNGR_PRERUN_TESTS)&&(temp != SAFETY_MNGR_ERROR_FOUND)) //DC-Bus adc value is not reliable during adc diagnostic execution
   2624              {
   2625                  //Check for consistency of vbus reading
   2626                  SR_DATA_MCU_CHECK_SHORT(SR_DCBus);
   2627                  vbus = SR_DCBus;
   2628          
   2629                  // Powering up stage is completed -> adc signals are reliable
   2630                  if(vbus < VBUS_SR_LOW_THR_AD_COUNTS)
   2631                  {
   2632                      SetFault(SR_FAULT_DCBUS_UNDER_VOLTAGE);
   2633          
   2634                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,VOLTAGE_ERROR_TIMEOUT); //Load time out
   2635                  }
   2636                  else if(vbus > VBUS_SR_HIGH_THR_AD_COUNTS)
   2637                  {
   2638                      SetFault(SR_FAULT_DCBUS_OVER_VOLTAGE);
   2639          
   2640                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,VOLTAGE_ERROR_TIMEOUT); //Load time out
   2641                  }
   2642              }
   2643          }
   2644          
   2645          
   2646          
   2647          
   2648          /**
   2649           *  @brief      In the case the dc bus voltage is outside safe levels, take some
   2650           *              action to keep the voltage within safe level.
   2651           *  @oaram      none
   2652           *  @return     none
   2653           */
   2654          void OverVoltageProtection(void)
   2655          {
   2656              sint16 vbus;
   2657              uint16 temp;
   2658          
   2659              temp = SR_Motor_Fault;
   2660              temp  = BIT_TEST(temp, SR_FAULT_DCBUS_UNDER_VOLTAGE);
   2661              temp += BIT_TEST(temp, SR_FAULT_DCBUS_OVER_VOLTAGE);
   2662          
   2663              if(temp)
   2664              {
   2665                  //Check for consistency of vbus reading
   2666                  SR_DATA_MCU_CHECK_SHORT(SR_DCBus);
   2667                  vbus = SR_DCBus;
   2668          
   2669                  // Powering up stage is completed -> adc signals are reliable
   2670                  // Dc Voltage out of range fault detected
   2671                  if(vbus > VBUS_SR_HIGH_THR_AD_COUNTS)
   2672                  {
   2673                      SR_MOTORSAFETY_MGR_ERROR_REACTION();
   2674                  }
   2675                  else if(vbus < VBUS_SR_LOW_THR_AD_COUNTS)
   2676                  {
   2677                      SRMCPwm__TurnOffAllGates();
   2678                  }
   2679              }
   2680              else
   2681              {
   2682                  SR_MOTORSAFETY_MGR_ERROR_REACTION();
   2683              }
   2684          }
   2685          
   2686          #ifdef SR_CIM_MOTOR
   2687          
   2688          #ifdef __IAR_SYSTEMS_ICC__
   2689          #pragma inline = forced
   2690          #endif
   2691          void InitMotorMovingHandlerCim(void)
   2692          {
   2693              uint16 temp;
   2694          
   2695              //! To be safe start the motor warning that it is moving.
   2696          
   2697              // Reset the zero speed flag, i.e., the motor is moving
   2698              temp = SR_Motor_Flags;
   2699              BIT_CLR(temp, SR_FLAG_UNLOCK_DOOR_SPEED);
   2700              SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,temp);
   2701          
   2702              // Set the rotor moving flag, i.e., the motor is moving
   2703              ClearFault(SR_FAULT_UNLOCK_DOOR_SPEED_FAILED);
   2704          
   2705              // Reset the Tacho zero speed check counter
   2706              SR_DATA_MCU_UPDATE_LONG(SR_VerifyTargetCounter,0);
   2707          
   2708          
   2709          }
   2710          
   2711          /**
   2712           *  @brief      Handler the unlock door speed (or rotor not moving) detection sub module. This shall be a part of the
   2713           *              whole class B protection. It uses two flags, one is to detect when the speed is really zero and,
   2714           *              when there is no movement in at the motor shaft. For safety issues, the zero speed detection
   2715           *              shall be used as flag for lid opening. There is also a flag which warns that the unlock door speed
   2716           *              was not able to be detected, this is not a fault and will not prevent the motor to start over.
   2717           *              This error in the unlock door speed flag shall be used in the door lock routine.
   2718           */
   2719          void MotorMovingHandlerCim(void)
   2720          {
   2721              uint32 temp;
   2722          #ifndef SKIP_MOTOR_MOVING_CHECK
   2723              if (SRMCInputCapture__GetMovementStatus(SR_UNLOCKDOORSPEED_LOW_COUNTER_THR))
   2724              {
   2725                  // motor is moving
   2726                  // update the state
   2727          
   2728                  // Clear the unlock door speed flag.
   2729                  temp = (uint32)SR_Motor_Flags;
   2730                  BIT_CLR(temp, SR_FLAG_UNLOCK_DOOR_SPEED);
   2731                  SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,(uint16)temp);
   2732          
   2733                  temp = SR_VerifyTargetCounter;
   2734                  if (temp < SR_UNLOCKDOORSPEED_TARGET_NOT_REACHED_TIMEOUT)
   2735                  {
   2736                      // wait state
   2737                      temp++;
   2738                      SR_DATA_MCU_UPDATE_LONG(SR_VerifyTargetCounter,temp);
   2739                  }
   2740                  else
   2741                  {
   2742                      // timeout state
   2743                      // Set the flag that a failure has happened while detecting the unlock door speed flag
   2744                      SetFault(SR_FAULT_UNLOCK_DOOR_SPEED_FAILED);
   2745                  }
   2746              }
   2747              else
   2748          #endif
   2749              {
   2750                  // motor is stopped
   2751          
   2752                  // Set the unlock door speed flag.
   2753                  temp = (uint32)SR_Motor_Flags;
   2754                  BIT_SET(temp, SR_FLAG_UNLOCK_DOOR_SPEED);
   2755                  SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,(uint16)temp);
   2756              }
   2757          }
   2758          
