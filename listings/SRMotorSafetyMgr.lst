   2145          
   2146              motor_speed_f = 0.0f;
   2147          
   2148          #endif
   2149          
   2150              ///////////////////////Losses being generated in the Motor - Steel + Joulse Losses/////////////////
   2151              //Steel Losses
   2152              psteel = SR_MotorSafety_Params->Rc_Thermal.A1 * motor_speed_f + SR_MotorSafety_Params->Rc_Thermal.A2 * (motor_speed_f*motor_speed_f);
   \   00000078   0x6C60             LDR      R0,[R4, #+68]
   \   0000007A   0xEEF8 0x0A60      VCVT.F32.U32 S1,S1
   \   0000007E   0xEEB7 0x1A00      VMOV.F32 S2,#1.0
   \   00000082   0xEE70 0x0A81      VADD.F32 S1,S1,S2
   \   00000086   0xEE80 0x9A20      VDIV.F32 S18,S0,S1
   \   0000008A   0xED90 0x0A05      VLDR     S0,[R0, #+20]
   \   0000008E   0xED90 0x1A06      VLDR     S2,[R0, #+24]
   \   00000092   0xEE20 0x0A09      VMUL.F32 S0,S0,S18
   \   00000096   0xEE69 0x0A09      VMUL.F32 S1,S18,S18
   \   0000009A   0xEE00 0x0A81      VMLA.F32 S0,S1,S2
   2153          
   2154              //Joule losses    - considering variation of resitance with temperature
   2155              qjoule=3*SR_MotorSafety_Params->Rc_Thermal.Rwind*(1.0f+SR_MotorSafety_Params->Rc_Thermal.Alfa_Winding*(temp_delta))*squared_current_f;
   \   0000009E   0xEDD0 0x0A07      VLDR     S1,[R0, #+28]
   2156          
   2157              /////////////////////////////heat being dissipated by the motor to the air///////////////////////////////
   2158              //Overall thermal conductance from motor mass to the environment
   2159              if (motor_speed_f > SR_MotorSafety_Params->Rc_Thermal.SSpeed)
   \   000000A2   0xF9B0 0x100A      LDRSH    R1,[R0, #+10]
   \   000000A6   0xEEB0 0x1A08      VMOV.F32 S2,#3.0
   \   000000AA   0xEE60 0x0A81      VMUL.F32 S1,S1,S2
   \   000000AE   0xED90 0x1A08      VLDR     S2,[R0, #+32]
   \   000000B2   0xEEF7 0x1A00      VMOV.F32 S3,#1.0
   \   000000B6   0xEE41 0x1A28      VMLA.F32 S3,S2,S17
   \   000000BA   0xEE01 0x1A10      VMOV     S2,R1
   \   000000BE   0xEEB8 0x1AC1      VCVT.F32.S32 S2,S2
   \   000000C2   0xEE60 0x0AA1      VMUL.F32 S1,S1,S3
   \   000000C6   0xEEB4 0x1A49      VCMP.F32 S2,S18
   \   000000CA   0xEE60 0x0A88      VMUL.F32 S1,S1,S16
   \   000000CE   0xEEF1 0xFA10      FMSTAT   
   \   000000D2   0xBF4F             ITEEE    MI 
   2160              {
   2161                  gt = SR_MotorSafety_Params->Rc_Thermal.Gspin; //Spinning  SSpeed is the threshold to switch
   \   000000D4   0xED90 0x1A0B      VLDRMI   S2,[R0, #+44]
   2162              }
   2163              else
   2164              {
   2165                  gt = SR_MotorSafety_Params->Rc_Thermal.Gtumb1*(temp_delta) + SR_MotorSafety_Params->Rc_Thermal.Gtumb;  //Tumble
   \   000000D8   0xEDD0 0x1A0A      VLDRPL   S3,[R0, #+40]
   \   000000DC   0xED90 0x1A09      VLDRPL   S2,[R0, #+36]
   \   000000E0   0xEE01 0x1AA8      VMLAPL.F32 S2,S3,S17
   2166              }
   2167          
   2168          
   2169              //Dissipated Heat
   2170              qdiss =  gt*(temp_delta);
   2171          
   2172              //Net heat stored inside the motor - that generated the temperature variation
   2173              qnet =  qjoule + psteel - qdiss;
   2174          
   2175              //Temperature derivative with time
   2176              dTdt= qnet*SR_MotorSafety_Params->Rc_Thermal.Cmot_Inv;
   2177          
   2178              //Update motor temperature
   2179              SR_Overload_Temp = SR_Overload_Temp + dTdt*(SR_MotorSafety_Params->Rc_Thermal.Dt);
   \   000000E4   0xEE30 0x0A80      VADD.F32 S0,S1,S0
   \   000000E8   0xEE01 0x0A68      VMLS.F32 S0,S2,S17
   \   000000EC   0xEDD0 0x0A03      VLDR     S1,[R0, #+12]
   \   000000F0   0xEE20 0x0A20      VMUL.F32 S0,S0,S1
   \   000000F4   0xEDD0 0x0A04      VLDR     S1,[R0, #+16]
   \   000000F8   0xED94 0x1A21      VLDR     S2,[R4, #+132]
   \   000000FC   0xEE00 0x1A20      VMLA.F32 S2,S0,S1
   \   00000100   0xED84 0x1A21      VSTR     S2,[R4, #+132]
   2180          
   2181              // Check and update variables to communicate to other modules.
   2182              SR_DATA_MCU_CHECK_FLOAT(SR_Squared_Current);
   \   00000104   0xF504 0x7194      ADD      R1,R4,#+296
   \   00000108   0xF104 0x008C      ADD      R0,R4,#+140
   \   0000010C   0x.... 0x....      BL       SRData__CheckFloat
   2183              SR_DATA_MCU_CHECK_FLOAT(SR_Voltage_Frequency);
   \   00000110   0xF504 0x7196      ADD      R1,R4,#+300
   \   00000114   0xF104 0x0088      ADD      R0,R4,#+136
   \   00000118   0x.... 0x....      BL       SRData__CheckFloat
   2184          
   2185              SR_DATA_MCU_UPDATE_FLOAT(SR_Squared_Current, squared_current_f);
   \   0000011C   0xEEB0 0x0A48      VMOV.F32 S0,S16
   \   00000120   0xF504 0x7194      ADD      R1,R4,#+296
   \   00000124   0xF104 0x008C      ADD      R0,R4,#+140
   \   00000128   0x.... 0x....      BL       SRData__UpdateFloat
   2186              SR_DATA_MCU_UPDATE_FLOAT(SR_Voltage_Frequency, motor_speed_f);
   \   0000012C   0xEEB0 0x0A49      VMOV.F32 S0,S18
   \   00000130   0xF504 0x7196      ADD      R1,R4,#+300
   \   00000134   0xF104 0x0088      ADD      R0,R4,#+136
   \   00000138   0xECBD 0x8B04      VPOP     {D8-D9}
   \   0000013C   0xE8BD 0x4010      POP      {R4,LR}
