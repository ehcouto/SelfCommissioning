   2192          /**
   2193           *  @brief      Motor overload Protection based on a simplified motor thermal model.
   2194           *
   2195           *  @return     none
   2196           */
   2197          #ifdef __IAR_SYSTEMS_ICC__
   2198          #pragma inline = forced
   2199          #endif
   2200          void InitOverLoadProtection(void)
   2201          {
   2202              SR_DATA_MCU_UPDATE_SHORT(SR_Overload_Counter,0);             // Reset the overload counter
   2203              SR_DATA_MCU_UPDATE_FLOAT(SR_Overload_Temp,(float)SR_MotorSafety_Params->OverLoad_Temp_Init); // Init the overload temperature
   2204          
   2205              SR_DATA_MCU_UPDATE_FLOAT(SR_Squared_Current, 0.0f);
   2206              SR_DATA_MCU_UPDATE_FLOAT(SR_Voltage_Frequency, 0.0f);
   2207          }
   2208          
   2209          
   2210          
   2211          
   2212          /**
   2213           *  @brief      Motor OverLoad Protection based on a simplified motor thermal model.
   2214           *
   2215           *  @return     none
   2216           */
   2217          #ifdef __IAR_SYSTEMS_ICC__
   2218          #pragma inline = forced
   2219          #endif
   2220          void OverLoadProtection(void)
   2221          {
   2222              sint16 temp;
   2223              uint16 temp1;
   2224          
   2225              SR_Overload_Counter++;
   2226          
   2227              if(SR_Overload_Counter >= ONE_SEC_TICK)
   2228              {
   2229                  RcThermalUpdate();
   2230          
   2231                  SR_Overload_Counter = 0;
   2232              }
   2233          
   2234              temp = (sint16)SR_Overload_Temp;             // Conversion from float to int
   2235          
   2236              temp1 = SR_Motor_Fault;
   2237              temp1 = BIT_TEST(temp1, SR_FAULT_OVER_LOAD);
   2238              if(temp1) // If overload condition detected
   2239              {
   2240                  if(temp < SR_MotorSafety_Params->OverLoad_Temp_Low)
   2241                  {
   2242                      // Motor temperature is lower than the lower threshold  -> Clear the overload fault
   2243                      ClearFault(SR_FAULT_OVER_LOAD);
   2244                  }
   2245              }
   2246              else
   2247              {
   2248                  if(temp > SR_MotorSafety_Params->OverLoad_Temp_High)
   2249                  {
   2250                      // Motor temperature is higher than the maximum allowed  -> Set the overload fault
   2251                      SetFault(SR_FAULT_OVER_LOAD);
   2252                  }
   2253              }
   2254          
   2255          
   2256              SR_DATA_MCU_UPDATE_SHORT(SR_Overload_Counter,SR_Overload_Counter);
   2257              SR_DATA_MCU_UPDATE_FLOAT(SR_Overload_Temp,SR_Overload_Temp);
   2258          }
   2259          
