   1891          /**
   1892           *  @brief      Calculate the difference between the instantaneous adc value with the
   1893           *              average (if applicable) and save this values in SR variables. rate: 250 us
   1894           *  @return     none
   1895           *
   1896           */
   1897          #ifdef __IAR_SYSTEMS_ICC__
   1898          #pragma inline = forced
   1899          #endif
   1900          void CalculateRawAnalogData_250us(void)
   1901          {
   1902              sint16 raw_ia;
   1903              sint16 raw_ib;
   1904              sint16 raw_ic;
   1905          
   1906              raw_ia = SR_Raw_CurrentA - SR_CurrentOffsetA;   // Subtract zero offset
   1907              SR_DATA_MCU_UPDATE_SHORT(SR_CurrentA, raw_ia);
   1908          
   1909              raw_ib = SR_Raw_CurrentB - SR_CurrentOffsetB;   // Subtract zero offset
   1910              SR_DATA_MCU_UPDATE_SHORT(SR_CurrentB, raw_ib);
   1911          
   1912              raw_ic = SR_Raw_CurrentC - SR_CurrentOffsetC;   // Subtract zero offset
   1913              SR_DATA_MCU_UPDATE_SHORT(SR_CurrentC, raw_ic);
   1914          }
   1915          
   1916          /**
   1917           *  @brief      Checks for motor currents plausibility. If one of the three currents
   1918           *              is found out of the reading range, a fault is triggered.
   1919           *  @return     none
   1920           *
   1921           */
   1922          #ifdef __IAR_SYSTEMS_ICC__
   1923          #pragma inline = forced
   1924          #endif
   1925          void CheckCurrentsPlausibility(void)
   1926          {
   1927              if(SR_SafetyMngr_State == SAFETY_MNGR_RUNNING)
   1928              {
   1929                  if((SR_Raw_CurrentA < SR_CURRENT_PLAUSIBILITY_LOW_LIM) ||
   1930                     (SR_Raw_CurrentA > SR_CURRENT_PLAUSIBILITY_HIGH_LIM))
   1931                  {
   1932                      SetFault(SR_FAULT_CURRENT_SENSOR_FAILED);
   1933                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry, ELECTRONIC_FAIL_TIMEOUT); //Load time out
   1934                  }
   1935          
   1936                  if((SR_Raw_CurrentB < SR_CURRENT_PLAUSIBILITY_LOW_LIM) ||
   1937                     (SR_Raw_CurrentB > SR_CURRENT_PLAUSIBILITY_HIGH_LIM))
   1938                  {
   1939                      SetFault(SR_FAULT_CURRENT_SENSOR_FAILED);
   1940                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry, ELECTRONIC_FAIL_TIMEOUT); //Load time out
   1941                  }
   1942          
   1943                  if((SR_Raw_CurrentC < SR_CURRENT_PLAUSIBILITY_LOW_LIM) ||
   1944                     (SR_Raw_CurrentC > SR_CURRENT_PLAUSIBILITY_HIGH_LIM))
   1945                  {
   1946                      SetFault(SR_FAULT_CURRENT_SENSOR_FAILED);
   1947                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry, ELECTRONIC_FAIL_TIMEOUT); //Load time out
   1948                  }
   1949              }
   1950          }
   1951          
   1952          
   1953          /**
   1954           *  @brief      Calculate the rms for each phase current
   1955           *  @return     none
   1956           *
   1957           */
   1958          #ifdef __IAR_SYSTEMS_ICC__
   1959          #pragma inline = forced
   1960          #endif
   1961          void CalculateRmsAnalogData(void)
   1962          {
   1963              sint32 temp_s32_1;
   1964              sint32 temp_s32_2;
   1965              sint32 temp_s32_3;
   1966              sint32 temp_counter_s32;
   1967          
   1968              /* This block calculate the rms for each phase current*/
   1969              temp_s32_1 = (sint32)SR_CurrentA;
   1970              temp_s32_1 = SR_SquaredCurrentSumA + ((temp_s32_1 * temp_s32_1)>>7);   //desired output format 17.15, input current are 21.11 format, 21.11*21.11 = 10.22 -> 17.15 = 10.22>>7
   1971          
   1972              temp_s32_2 = (sint32)SR_CurrentB;
   1973              temp_s32_2 = SR_SquaredCurrentSumB + ((temp_s32_2 * temp_s32_2)>>7);   //desired output format 17.15, input current are 21.11 format, 21.11*21.11 = 10.22 -> 17.15 = 10.22>>7
   1974          
   1975              temp_s32_3 = (sint32)SR_CurrentC;
   1976              temp_s32_3 = SR_SquaredCurrentSumC + ((temp_s32_3 * temp_s32_3)>>7);   //desired output format 17.15, input current are 21.11 format, 21.11*21.11 = 10.22 -> 17.15 = 10.22>>7
   1977          
   1978              temp_counter_s32 = SR_Curr_Rms_Counter;
   1979              temp_counter_s32++;
   1980          
   1981              if(temp_counter_s32 > RMS_COUNTER_SAMPLES_AT_TS) // Time elapsed - RMS_SAMPLING_TIME_MS
   1982              {
   1983                  /* Average of squared current */
   1984                  temp_s32_1 = temp_s32_1 / temp_counter_s32;
   1985                  SR_DATA_MCU_UPDATE_LONG(SR_SquaredCurrentRmsA, temp_s32_1);
   1986          
   1987                  temp_s32_2 = temp_s32_2 / temp_counter_s32;
   1988                  SR_DATA_MCU_UPDATE_LONG(SR_SquaredCurrentRmsB, temp_s32_2);
   1989          
   1990                  temp_s32_3 = temp_s32_3 / temp_counter_s32;
   1991                  SR_DATA_MCU_UPDATE_LONG(SR_SquaredCurrentRmsC, temp_s32_3);
   1992          
   1993                  // Reset of the sum terms
   1994                  temp_counter_s32 = 0;
   1995                  temp_s32_1 = 0;
   1996                  temp_s32_2 = 0;
   1997                  temp_s32_3 = 0;
   1998              }
   1999          
   2000              //Update Sr Data
   2001              SR_DATA_MCU_UPDATE_LONG(SR_SquaredCurrentSumA, temp_s32_1);
   2002              SR_DATA_MCU_UPDATE_LONG(SR_SquaredCurrentSumB, temp_s32_2);
   2003              SR_DATA_MCU_UPDATE_LONG(SR_SquaredCurrentSumC, temp_s32_3);
   2004              SR_DATA_MCU_UPDATE_LONG(SR_Curr_Rms_Counter, temp_counter_s32);
   2005          
   2006          }
