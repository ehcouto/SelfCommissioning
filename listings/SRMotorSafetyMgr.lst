   1721          
   1722          /**
   1723           *  @brief      It tests the integrity of each variable used in this Class B module. It performs an OR
   1724           *              operation between all used variable.
   1725           *  @return     TRUE: at least one variable is corrupted
   1726           *              FALSE: all variables are ok (not corrupted)
   1727           */
   1728          #ifdef __IAR_SYSTEMS_ICC__
   1729          #pragma inline = forced
   1730          #endif
   1731          void CheckAnalogVariables4Failure(void)
   1732          {
   1733              sint16 check = SRDATA_OK;
   1734          
   1735              MICRO_DECLARE_INTERRUPT_CONTEXT_LOCAL();
   1736          
   1737              MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
   1738          
   1739              SR_MCU_MOTOR_CHECK_SHORT(check,SR_CurrentA);
   1740              SR_MCU_MOTOR_CHECK_SHORT(check,SR_CurrentB);
   1741              SR_MCU_MOTOR_CHECK_SHORT(check,SR_CurrentC);
   1742              SR_MCU_MOTOR_CHECK_SHORT(check,SR_CurrentOffsetA);
   1743              SR_MCU_MOTOR_CHECK_SHORT(check,SR_CurrentOffsetB);
   1744              SR_MCU_MOTOR_CHECK_SHORT(check,SR_CurrentOffsetC);
   1745              SR_MCU_MOTOR_CHECK_SHORT(check,SR_DCBus);
   1746          
   1747              if(check)
   1748              {
   1749                  SRDATA_CORRUPTION_EXCEPTION(DATA_CORRUPTION_ANALOG_VAR_SECTION);
   1750              }
   1751          
   1752              MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
   1753          }
