   2010          //---------------------------------------------------------------------------------------------------------------------
   2011          /**
   2012           *  @brief      Handler of the over current detection (locked rotor and over load).
   2013           *              It uses one single counter for two different periods. The time is counted when some shaft movement
   2014           *              is detected. The sum of the squared current is used in order to compare to a threshold. A debouncer is
   2015           *              implemented in order filter out some noise due to some current threshold crossings. This
   2016           *              current threshold is a sum of the squared value of the currents, it also considers the worst case
   2017           *              for noise in the current sensors. This debouncer implements a counting up and down
   2018           *              according to the comparison to this zero speed current threshold; the debounce is not zeroed after
   2019           *              crossing down the threshold because the "history" of some previous values shall be considered in the
   2020           *              future decisions. There is also a said starting time, which it is used todetect either a locked rotor
   2021           *              or overload. No speed information is used in this method, only sensed current.
   2022           *
   2023           *  @param      none
   2024           *  @return     none.
   2025           */
   2026          #ifdef __IAR_SYSTEMS_ICC__
   2027          #pragma inline = forced
   2028          #endif
   2029          void PhaseLostHandler(void)
   2030          {
   2031              uint32 tmp32;
   2032              uint16 temp;
   2033          
   2034          
   2035              //** phase lost management
   2036              if(SR_SquaredCurrentRmsB < CURRENT_LOW_THLD_A)
   2037              {
   2038                  if( (SR_SquaredCurrentRmsC > CURRENT_HIGH_THLD_A) &&
   2039                  (SR_SquaredCurrentRmsA > CURRENT_HIGH_THLD_A))// &&
   2040                      //(MATHCALC__ABS( SR_SquaredCurrentRmsA - SR_SquaredCurrentRmsC ) )< CURRENT_NOISE)
   2041                  {
   2042                      tmp32 = (uint32)SR_Motor_Flags;
   2043                      BIT_SET(tmp32, SR_FLAG_DETECTION_PHASE_LOST);
   2044                      SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,tmp32);
   2045                  }
   2046              }
   2047              else if(SR_SquaredCurrentRmsC < CURRENT_LOW_THLD_A)
   2048              {
   2049                  if( (SR_SquaredCurrentRmsB > CURRENT_HIGH_THLD_A) &&
   2050                      (SR_SquaredCurrentRmsA > CURRENT_HIGH_THLD_A) )//&&
   2051                      //(MATHCALC__ABS( SR_SquaredCurrentRmsA - SR_SquaredCurrentRmsB ) )< CURRENT_NOISE)
   2052                  {
   2053                      tmp32 = (uint32)SR_Motor_Flags;
   2054                      BIT_SET(tmp32, SR_FLAG_DETECTION_PHASE_LOST);
   2055                      SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,tmp32);
   2056                  }
   2057              }
   2058              else if(SR_SquaredCurrentRmsA < CURRENT_LOW_THLD_A)
   2059              {
   2060                  if( (SR_SquaredCurrentRmsC > CURRENT_HIGH_THLD_A) &&
   2061                      (SR_SquaredCurrentRmsB > CURRENT_HIGH_THLD_A) )//&&
   2062                      //(MATHCALC__ABS( SR_SquaredCurrentRmsB - SR_SquaredCurrentRmsC ) )< CURRENT_NOISE)
   2063                  {
   2064                      tmp32 = (uint32)SR_Motor_Flags;
   2065                      BIT_SET(tmp32, SR_FLAG_DETECTION_PHASE_LOST);
   2066                      SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,tmp32);
   2067                  }
   2068              }
   2069              else
   2070              {
   2071                  tmp32 = (uint32)SR_Motor_Flags;
   2072                  BIT_CLR(tmp32, SR_FLAG_DETECTION_PHASE_LOST);
   2073                  SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Flags,tmp32);
   2074              }
   2075          
   2076              temp = SR_Motor_Flags;
   2077              temp = BIT_TEST(temp, SR_FLAG_DETECTION_PHASE_LOST);
   2078          
   2079              if(temp)
   2080              {
   2081                  SR_Phase_Lost_Counter++;
   2082                  if(SR_Phase_Lost_Counter > PHASE_LOST_COUNTER_THLD)
   2083                  {
   2084                      SR_Phase_Lost_Counter = PHASE_LOST_COUNTER_THLD;
   2085          
   2086                      SetFault(SR_FAULT_PHASE_LOST);
   2087          
   2088                      SR_DATA_MCU_UPDATE_LONG(SR_Timeout_Failure_Retry,PHASE_LOST_TIMEOUT); //Load time out
   2089                  }
   2090              }
   2091              else
   2092              {
   2093                  if(SR_Phase_Lost_Counter>0)
   2094                  {
   2095                      SR_Phase_Lost_Counter--;
   2096                  }
   2097              }
   2098          
   2099              SR_DATA_MCU_UPDATE_SHORT(SR_Phase_Lost_Counter,SR_Phase_Lost_Counter);
   2100          
   2101          }
   2102          
   2103          
   2104          /**
   2105           *  @brief      Simplified RC motor thermal model.
   2106           *
   2107           *  @return     none
   2108           */

   \                                 In section .text, align 4, keep-with-next
   2109          void RcThermalUpdate(void)
   2110          {
   \                     RcThermalUpdate: (+1)
   \   00000000   0xB510             PUSH     {R4,LR}
   2111              float gt;                                       //overall conductance from motor to environment
   2112              float psteel;                                   //steel heat loss dissipation in the motor
   2113              float qjoule;                                   //Winding joule loss dissipation in the motor
   2114              float qdiss;                                    //overall heat dissipation in the motor (qjoule+qsteel)
   2115              float qnet;                                     //net heat accumulated in the motor Capacitance (qdiss-gt(twind-tamb))
   2116              float dTdt;                                     //time derivative of the temperature
   2117              float temp_delta;                               //difference between motor temperature and enviroment temperature
   2118              float squared_current_f;                        //motor squared current in floating point
   2119              float squared_current_pu;                       //motor squared current in fixed point
   2120              float motor_speed_f;                            //motor speed in floating point
   2121          
   2122          
   2123              // delta temperature calculation
   2124              temp_delta = SR_Overload_Temp - SR_MotorSafety_Params->Rc_Thermal.Tamb;
   \   00000002   0x....             LDR.N    R4,??DataTable29_3
   \   00000004   0xED2D 0x8B04      VPUSH    {D8-D9}
   \   00000008   0x6C60             LDR      R0,[R4, #+68]
   \   0000000A   0xF9B0 0x0008      LDRSH    R0,[R0, #+8]
   \   0000000E   0xEDD4 0x0A21      VLDR     S1,[R4, #+132]
   \   00000012   0xEE00 0x0A10      VMOV     S0,R0
   \   00000016   0xEEB8 0x0AC0      VCVT.F32.S32 S0,S0
   \   0000001A   0xEE70 0x8AC0      VSUB.F32 S17,S1,S0
   2125          
   2126          
   2127              // Calculation of Motor Thermal Model Input -> Motor current RMS (Ia^2 + Ib^2 + Ic^2)
   2128              squared_current_pu = SR_SquaredCurrentRmsA;
   \   0000001E   0xED94 0x0A19      VLDR     S0,[R4, #+100]
   2129              squared_current_pu += SR_SquaredCurrentRmsB;
   \   00000022   0xEDD4 0x0A1A      VLDR     S1,[R4, #+104]
   2130              squared_current_pu += SR_SquaredCurrentRmsC;
   2131          
   2132              // motor square current format transformation: from fixed point to floating
   2133              squared_current_f = SRMC__IQ2REALF(squared_current_pu, BASE_CURRENT*BASE_CURRENT*ONE_THIRD, 15);
   \   00000026   0xEEB8 0x0AC0      VCVT.F32.S32 S0,S0
   \   0000002A   0xEEF8 0x0AE0      VCVT.F32.S32 S1,S1
   \   0000002E   0xEE30 0x0A20      VADD.F32 S0,S0,S1
   \   00000032   0xEDD4 0x0A1B      VLDR     S1,[R4, #+108]
   \   00000036   0xEEF8 0x0AE0      VCVT.F32.S32 S1,S1
   \   0000003A   0xEE30 0x0A20      VADD.F32 S0,S0,S1
   \   0000003E   0xEDDF 0x....      VLDR.W   S1,??DataTable29  ;; 0x41b3d4f4
   \   00000042   0xEE20 0x0A20      VMUL.F32 S0,S0,S1
   \   00000046   0xEDDF 0x....      VLDR.W   S1,??DataTable29_1  ;; 0x38000000
   \   0000004A   0xEE20 0x8A20      VMUL.F32 S16,S0,S1
   2134          
   2135          #ifdef SR_BPM_MOTOR
   2136          
   2137              // Check variable integrity
   2138              SR_DATA_MCU_CHECK_BYTE(SR_Avg_Fund_Period_Cycle_Total);
   \   0000004E   0x1D61             ADDS     R1,R4,#+5
   \   00000050   0x1CA0             ADDS     R0,R4,#+2
   \   00000052   0x.... 0x....      BL       SRData__CheckByte
   2139              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period);
   \   00000056   0xF104 0x01D0      ADD      R1,R4,#+208
   \   0000005A   0xF104 0x00AC      ADD      R0,R4,#+172
   \   0000005E   0x.... 0x....      BL       SRData__CheckLong
   2140          
   2141              // motor speed format transformation: from fixed point to floating
   2142              motor_speed_f = (RMS_SAMPLER_FREQUENCY * SR_Avg_Fund_Period_Cycle_Total)/(1.0f + SR_Avg_Fund_Period);  // +1 to prevent zero division
   \   00000062   0x78A0             LDRB     R0,[R4, #+2]
   \   00000064   0xEE00 0x0A10      VMOV     S0,R0
   \   00000068   0xEEB8 0x0A40      VCVT.F32.U32 S0,S0
   \   0000006C   0xEDDF 0x....      VLDR.W   S1,??DataTable29_2  ;; 0x457a0000
   \   00000070   0xEE20 0x0A20      VMUL.F32 S0,S0,S1
   \   00000074   0xEDD4 0x0A2B      VLDR     S1,[R4, #+172]
   2143          
