   1691          
   1692          /**
   1693           *  @brief      Handler the unlock door speed (or rotor not moving) detection sub module. This shall be a part of the
   1694           *              whole class B protection. It uses two flags, one is to detect when the speed is really zero and,
   1695           *              when there is no movement in at the motor shaft. For safety issues, the zero speed detection
   1696           *              shall be used as flag for lid opening. There is also a flag which warns that the unlock door speed
   1697           *              was not able to be detected, this is not a fault and will not prevent the motor to start over.
   1698           *              This error in the unlock door speed flag shall be used in the door lock routine.
   1699           */
   1700          #ifdef __IAR_SYSTEMS_ICC__
   1701          #pragma inline = forced
   1702          #endif
   1703          uint8 CheckSafetyParameters(void)
   1704          {
   1705              sint16 check = SRDATA_OK;
   1706              uint16 crc;
   1707          
   1708              crc = Crc16__RangeProcess((uint8 *)&(SR_MotorSafety_Params->OverLoad_Temp_Init),0xFFFF,(SAFETY_MOTOR_PARAMETERS_NUM-2)); //lint !e928
   1709          
   1710              if( crc !=  SR_MotorSafety_Params->SrCrc)
   1711              {
   1712                  SRDATA_CORRUPTION_EXCEPTION(DATA_CORRUPTION_SAFETY_PARAMS_SECTION);
   1713                  check = 1;
   1714              }
   1715          
   1716              return( (uint8)check);
   1717          }
