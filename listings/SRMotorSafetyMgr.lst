     42          //! Macros to update safety relevant data
     43          //! Update SR variable and its negate
     44          #define SR_MCU_MOTOR_UPDATE_VAR(var, value)             (var) = (value); (N##var) = ~((sint32)value)
     45          
     46          #define SR_MCU_MOTOR_UPDATE_N_VAR(var)                  (N##var) = ~((sint32)var)
     47          
     48          
     49          
     50          //! Macros to check safety relevant data
     51          //! Check SR byte
     52          #define SR_MCU_MOTOR_CHECK_BYTE(check,var)              {auto uint8 temp_u8;  temp_u8 = (uint8)(var); check += (temp_u8 !=  (uint8)(~(sint32)(N##var)));}
     53          //! Check SR short
     54          #define SR_MCU_MOTOR_CHECK_SHORT(check,var)             {auto uint16 temp_u16;  temp_u16 = (uint16)(var); check += (temp_u16 != (uint16)(~(sint32)(N##var)));}
     55          //! Check SR long
     56          #define SR_MCU_MOTOR_CHECK_LONG(check,var)              {auto uint32 temp_u32;  temp_u32 = (uint32)(var); check += (temp_u32 != (uint32)(~(sint32)(N##var)));}
     57          
     58          // Check MACRO definitions
     59          #define SR_DATA_MCU_CHECK_BYTE(var)                     SRData__CheckByte((uint8 *)&var, (uint8 *)&(N##var))
     60          #define SR_DATA_MCU_CHECK_SHORT(var)                    SRData__CheckShort((uint16 *)&var, (uint16 *)&(N##var))
     61          #define SR_DATA_MCU_CHECK_LONG(var)                     SRData__CheckLong((uint32 *)&var, (uint32 *)&(N##var))
     62          #define SR_DATA_MCU_CHECK_FLOAT(var)                    SRData__CheckFloat((float *)&var, (float *)&(N##var))
     63          
     64          #define SR_DATA_MCU_UPDATE_BYTE(var,value)              SRData__UpdateByte((uint8 *)&var, (uint8 *)&(N##var), (uint8)(value))
     65          #define SR_DATA_MCU_UPDATE_SHORT(var,value)             SRData__UpdateShort((uint16 *)&var, (uint16 *)&(N##var), (uint16)(value))
     66          #define SR_DATA_MCU_UPDATE_LONG(var,value)              SRData__UpdateLong((uint32 *)&var, (uint32 *)&(N##var), (uint32)(value))
     67          #define SR_DATA_MCU_UPDATE_FLOAT(var,value)             SRData__UpdateFloat((float *)&var, (float *)&(N##var), (float)(value))
