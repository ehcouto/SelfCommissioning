   2994          /**
   2995           *  @brief      Initialize the variables used by the frequency measurement module.
   2996           *  @details    Called every motor control state machine starting up
   2997           *  @param      None
   2998           *  @return     None
   2999           *
   3000           */
   3001          #ifdef __IAR_SYSTEMS_ICC__
   3002          #pragma inline = forced
   3003          #endif
   3004          void Init_Avg_Frequency(void)
   3005          {
   3006          #ifdef SR_BPM_MOTOR
   3007          
   3008              sint32 temp_s32;
   3009          
   3010              SR_DATA_MCU_CHECK_BYTE(SR_Avg_Cross_Event);
   3011              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_High_Threshold);
   3012              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_Low_Threshold);
   3013              SR_DATA_MCU_CHECK_LONG(SR_Avg_Threshold);
   3014              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_Time_Counter);
   3015              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_Cycle_Counter);
   3016              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period);
   3017              SR_DATA_MCU_CHECK_LONG(SR_Applied_Duty_A_Sum);
   3018              SR_DATA_MCU_CHECK_BYTE(SR_Avg_Fund_Ignored_First);
   3019          
   3020              temp_s32 = SRMCPWM__GETMAXPWM();
   3021              temp_s32 = (sint32)(SR_MODULATION_LIMIT * (float)temp_s32);
   3022              temp_s32 = temp_s32>>1;                         //!< Half value of the maximum duty, e.g. 0.5 pu
   3023              SR_Avg_Fund_Period_High_Threshold = (sint32)(((100.0f + AVG_THRESHOLD_HT)/100.0f) * temp_s32);  //!< High threshold hysteresis value;
   3024              SR_Avg_Fund_Period_Low_Threshold =  (sint32)(((100.0f - AVG_THRESHOLD_HT)/100.0f) * temp_s32);  //!< Low threshold hysteresis value
   3025          
   3026              SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_High_Threshold, SR_Avg_Fund_Period_High_Threshold);
   3027              SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Low_Threshold, SR_Avg_Fund_Period_Low_Threshold);
   3028              SR_DATA_MCU_UPDATE_LONG(SR_Avg_Threshold, SR_Avg_Fund_Period_Low_Threshold);
   3029          
   3030              SR_DATA_MCU_UPDATE_BYTE(SR_Avg_Cross_Event, FALSE);
   3031              SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Time_Counter, 0);
   3032              SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Cycle_Counter, SR_MOTOR_SAFETY_MNGR_MAX_PERIOD_COUNTER);
   3033              SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period, SR_MOTOR_SAFETY_MNGR_MAX_PERIOD_COUNTER);
   3034              SR_DATA_MCU_UPDATE_LONG(SR_Applied_Duty_A_Sum, 0);
   3035              SR_DATA_MCU_UPDATE_LONG(SR_Applied_Duty_A_Sum_High, 0);
   3036          
   3037              SR_DATA_MCU_UPDATE_BYTE(SR_Avg_Fund_Ignored_First, FALSE);
   3038          
   3039          #else // SR_CIM_MOTOR
   3040          
   3041          
   3042          #endif
   3043          }
   3044          
   3045          
   3046          
   3047          
   3048          /**
   3049           *  @brief      Measure the avereage frequency
   3050           *  @details    Call rate every motor control rate (pwm rate)
   3051           *  @param      None
   3052           *  @return     None
   3053           *
   3054           */
   3055          #ifdef __IAR_SYSTEMS_ICC__
   3056          #pragma inline = forced
   3057          #endif
   3058          void Calc_Avg_Frequency(void)
   3059          {
   3060          #ifdef SR_BPM_MOTOR
   3061          
   3062              uint32 temp_u32;
   3063              sint32 temp_s32;
   3064              sint32 temp_s32_1;
   3065              sint32 temp_s32_low;
   3066              sint32 temp_s32_high;
   3067          
   3068              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_Time_Counter);
   3069              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_Cycle_Counter);
   3070              SR_DATA_MCU_CHECK_LONG(SR_Applied_Duty_A_Sum);
   3071              SR_DATA_MCU_CHECK_LONG(SR_Applied_Duty_A_Sum_High);
   3072              SR_DATA_MCU_CHECK_LONG(SR_Avg_Threshold);
   3073              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_Low_Threshold);
   3074              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period_High_Threshold);
   3075              SR_DATA_MCU_CHECK_BYTE(SR_Avg_Cross_Event);
   3076              SR_DATA_MCU_CHECK_BYTE(SR_Avg_Fund_Period_Cycle_Total);
   3077              SR_DATA_MCU_CHECK_BYTE(SR_Avg_Fund_Ignored_First);
   3078          
   3079              temp_u32 = SR_Avg_Fund_Period_Time_Counter;
   3080              if(temp_u32 < SR_MOTOR_SAFETY_MNGR_MAX_PERIOD_COUNTER)
   3081              {
   3082                  temp_u32++;
   3083                  SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Time_Counter, temp_u32);
   3084              }
   3085          
   3086              temp_s32 = SRMCPWM__GET_PWM_A();
   3087          
   3088              temp_s32_1 = SR_Applied_Duty_A_Sum;
   3089              SRMC__FILTER_CALC(temp_s32, temp_s32_1, SRMOTOR_SAFETY_AVG_CALC_COFF_FREQ_LOW_SPD);
   3090              SR_DATA_MCU_UPDATE_LONG(SR_Applied_Duty_A_Sum, temp_s32_1);
   3091              temp_s32_low = SRMC__FILTER_GET_FILTERED_VAR(temp_s32_1, SRMOTOR_SAFETY_AVG_CALC_COFF_FREQ_LOW_SPD);
   3092          
   3093              temp_s32_1 = SR_Applied_Duty_A_Sum_High;
   3094              SRMC__FILTER_CALC(temp_s32, temp_s32_1, SRMOTOR_SAFETY_AVG_CALC_COFF_FREQ_HI_SPD);
   3095              SR_DATA_MCU_UPDATE_LONG(SR_Applied_Duty_A_Sum_High, temp_s32_1);
   3096              temp_s32_high = SRMC__FILTER_GET_FILTERED_VAR(temp_s32_1, SRMOTOR_SAFETY_AVG_CALC_COFF_FREQ_HI_SPD);
   3097          
   3098              // Select which filtered value will be used in the threshold, there is a small glitch
   3099              // when jumping from filter to other one but the error is small.
   3100              temp_s32 = SR_Avg_Fund_Period;
   3101              if(temp_s32 < SRMOTOR_SAFETY_AVG_HIST_LOW_TO_HIGH_THRES)
   3102              {
   3103                  temp_s32 = temp_s32_high;
   3104              }
   3105              else
   3106              {
   3107                  temp_s32 = temp_s32_low;
   3108              }
   3109          
   3110              // Look for complete cycles and count the time accordingly.
   3111              if(temp_s32 > SR_Avg_Threshold)
   3112              {
   3113                  SR_DATA_MCU_UPDATE_LONG(SR_Avg_Threshold, SR_Avg_Fund_Period_Low_Threshold);
   3114          
   3115                  if(SR_Avg_Cross_Event == TRUE)
   3116                  {
   3117                      SR_DATA_MCU_UPDATE_BYTE(SR_Avg_Cross_Event, FALSE);
   3118          
   3119                      temp_u32 = SR_Avg_Fund_Period_Cycle_Counter;
   3120                      temp_u32++;
   3121                      SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Cycle_Counter, temp_u32);
   3122          
   3123                      if(SR_Avg_Fund_Period_Cycle_Counter >= SR_Avg_Fund_Period_Cycle_Total)
   3124                      {
   3125                      	if(SR_Avg_Fund_Ignored_First == TRUE)
   3126                      	{
   3127                      		SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period, SR_Avg_Fund_Period_Time_Counter);
   3128                      	}
   3129                      	else
   3130                      	{
   3131                      		SR_DATA_MCU_UPDATE_BYTE(SR_Avg_Fund_Ignored_First, TRUE);
   3132                      	}
   3133          
   3134                          SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Cycle_Counter, 0);
   3135                          SR_DATA_MCU_UPDATE_LONG(SR_Avg_Fund_Period_Time_Counter, 0);
   3136                      }
   3137                  }
   3138              }
   3139              else if(temp_s32 < SR_Avg_Threshold)
   3140              {
   3141                  SR_DATA_MCU_UPDATE_LONG(SR_Avg_Threshold, SR_Avg_Fund_Period_High_Threshold);
   3142                  SR_DATA_MCU_UPDATE_BYTE(SR_Avg_Cross_Event, TRUE);
   3143              }
   3144          
   3145          #endif
   3146          }
   3147          
   3148          
   3149          
   3150          
   3151          /**
   3152           *  @brief      Compare the averaged speed to a threshold.
   3153           *  @details    Called every 5 ms
   3154           *  @param      None
   3155           *  @return     None - calls back the Speed Monitor with TRUE (speed above) or FALSE (speed below) threshold.
   3156           *
   3157           */
   3158          #ifdef __IAR_SYSTEMS_ICC__
   3159          #pragma inline = forced
   3160          #endif
   3161          void Check_Avg_Frequency(void)
   3162          {
   3163          #ifdef SR_BPM_MOTOR
   3164          
   3165              uint16 temp;
   3166          
   3167              SR_DATA_MCU_CHECK_LONG(SR_Avg_Fund_Period);
   3168          
   3169          
   3170              temp = SR_Motor_Flags;
   3171              temp = BIT_TEST(temp, SR_FLAG_MC_PARAMETERS_LOADED);
   3172          
   3173              if(temp) // ensure parameters are loaded
   3174              {
   3175          
   3176                  if(SR_Avg_Fund_Period < SR_MotorSafety_Params->Avg_Fund_Period_Threshold_1)
   3177                  {
   3178                      // Call back warning the frequency is above the threshold set
   3179                      SR_MOTOR_SAFETY_MGR__AVG_FREQUENCY_ABOVE_THREHOLD();
   3180                  }
   3181                  else
   3182                  {
   3183                      // Call back warning the frequency is below the threshold set
   3184                      SR_MOTOR_SAFETY_MGR__AVG_FREQUENCY_BELOW_THREHOLD();
   3185                  }
   3186              }
   3187          #else //SR_CIM_MOTOR
   3188          
   3189              // To be implemented.
   3190          
   3191          #endif
   3192          }
   3193          
   3194          
   3195          
   3196          
   3197          
   3198          //---------------------------------------------------------------------------------------------------------------------
   3199          /**
   3200           *  @brief      Update Pwm variables - shall be only used by class B part
   3201           *  @param      pwm values
   3202           *
   3203           */
   3204          #ifdef __IAR_SYSTEMS_ICC__
   3205          #pragma inline = forced
   3206          #endif
   3207          
   3208          #ifdef SR_THIRD_CURRENT_RECONSTRUCTION
   3209          //---------------------------------------------------------------------------------------------------------------------
   3210          /**
   3211           *  @brief      Update ADC configuration according to duty-cycle pattern
   3212           *  @details    The ADC is configured so that the two currents corresponding to the
   3213           *              shortest duties are sampled on the first trigger event
   3214           *  @param
   3215           *
   3216           */
   3217          #ifdef __IAR_SYSTEMS_ICC__
   3218          #pragma inline = forced
   3219          #endif
   3220          void UpdateAdcConfig()
   3221          {
   3222              sint32 temp_s32;
   3223              uint16 index;   
   3224              sint32 b;
   3225              sint32 c;
   3226              if(SR_SafetyMngr_State != SAFETY_MNGR_PRERUN_TESTS)  // in prerun we must not touch the ADC configuration
   3227              {
   3228                  // Reconfigure ADC connections according to sector for third current reconstruction strategy
   3229                  if (SR_SafetyMngr_State != SAFETY_MNGR_RUNNING)
   3230                  {   // read all currents for correct offset update
   3231                      index = 0;
   3232                  }
   3233                  else
   3234                  {
   3235                      // calculate the index of the current corresponding to the longest duty (SR_sector)
   3236                      b = SRMCPWM__GET_PWM_B();
   3237                      c = SRMCPWM__GET_PWM_C();
   3238          
   3239                      temp_s32 = SRMCPWM__GET_PWM_A();
   3240                      index = 1;
   3241          
   3242                      if (b > temp_s32)
   3243                      {
   3244                          temp_s32 = b;
   3245                          index = 2;
   3246                      }
   3247          
   3248                      if (c > temp_s32)
   3249                      {
   3250                          index = 3;
   3251                      }
   3252                  }
   3253          
   3254                  SR_Sector = index;
   3255                  SR_MCU_MOTOR_UPDATE_N_VAR(SR_Sector);
   3256          
   3257                  // and reconfigure ADC accordingly
   3258                  switch (SR_Sector)
   3259                  {
   3260                      case 1:
   3261                          SRMCATOD__SETADC2_REC1();
   3262                          SRMCATOD__SETADC3_REC1();
   3263                          break;
   3264          
   3265                      case 2:
   3266                          SRMCATOD__SETADC1_REC2();
   3267                          SRMCATOD__SETADC3_REC2();
   3268                          break;
   3269          
   3270                      case 3:
   3271                          SRMCATOD__SETADC1_REC3();
   3272                          SRMCATOD__SETADC2_REC3();
   3273                          break;
   3274          
   3275                      default:
   3276                          SRMCATOD__SETADC1_DEFAULT();
   3277                          SRMCATOD__SETADC2_DEFAULT();
   3278                          SRMCATOD__SETADC3_DEFAULT();
   3279                          SRMCATOD__SETDCBUSVOLTAGE_DEFAULT();
   3280                          break;
   3281                  }
   3282              }
   3283          }
   3284          #endif
   3285          
   3286          
   3287          
   3288          //---------------------------------------------------------------------------------------------------------------------
   3289          /**
   3290           *  @brief      Set a bit fault in the fault and fault holder registers and deny access from class A.
   3291           *  @param[in]  error bit - refer to the SR_MOTOR_FAULT_LIST_TYPE for the bit definition
   3292           *
   3293           */
   3294          void SetFault(uint16 fault)
   3295          {
   3296          	uint16 temp_u16;
   3297          
   3298          	temp_u16 = SR_Motor_Fault;
   3299          	BIT_SET(temp_u16, fault);
   3300          	SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Fault, temp_u16);
   3301          
   3302          	temp_u16 = SR_Motor_Fault_Holder;
   3303          	BIT_SET(temp_u16, fault);
   3304          	SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Fault_Holder, temp_u16);
   3305          }
   3306          
   3307          
   3308          
   3309          
   3310          //---------------------------------------------------------------------------------------------------------------------
   3311          /**
   3312           *  @brief      Only clears the bit fault in the fault register.
   3313           *  @param[in]  error bit - refer to the SR_MOTOR_FAULT_LIST_TYPE for the bit definition
   3314           *
   3315           */
   3316          void ClearFault(uint16 fault)
   3317          {
   3318          	uint16 temp_fault;
   3319          	temp_fault = SR_Motor_Fault;
   3320          	BIT_CLR(temp_fault, (fault));
   3321          	SR_DATA_MCU_UPDATE_SHORT(SR_Motor_Fault, temp_fault);
   3322          }
   3323          
   3324          
   3325          #ifdef SRMOTORSAFETYMGR_INTERNAL_ISR_CHECK
   3326          //----------------------------------------------------------------------------------------------------------------------
   3327          /**
   3328           *  @brief      On entering Motor Control interrupt.
   3329           *
   3330           */
   3331          static void SrIsrMcEnterIsr(void)
   3332          {
   3333              sint16 check = SRDATA_OK;
   3334          
   3335              SR_MCU_MOTOR_CHECK_SHORT(check, SR_MC_Isr_Enter_Cntr);
   3336              SR_MCU_MOTOR_CHECK_SHORT(check, SR_MC_Isr_Exit_Cntr);
   3337              if(check)
   3338              {
   3339                  SRDATA_CORRUPTION_EXCEPTION(DATA_CORRUPTION_ISR_ENTER_SECTION);
   3340              }
   3341          
   3342              if (SR_MC_Isr_Enter_Cntr > SR_MC_ISRMONITOR_MAX)
   3343              {
   3344                  SRMOTORSAFETYMGR_ISR_FLOW_FAIL_OVERRUN();
   3345              }
   3346              else
   3347              {
   3348                  SR_MC_Isr_Enter_Cntr += 1;
   3349                  SR_MCU_MOTOR_UPDATE_N_VAR(SR_MC_Isr_Enter_Cntr);
   3350              }
   3351          }
   3352          
   3353          //----------------------------------------------------------------------------------------------------------------------
   3354          /**
   3355           *  @brief      On exiting Motor Control interrupt.
   3356           *
   3357           */
   3358          static void SrIsrMcExitIsr(void)
   3359          {
   3360              SR_MC_Isr_Exit_Cntr += 1;
   3361              SR_MCU_MOTOR_UPDATE_N_VAR(SR_MC_Isr_Exit_Cntr);
   3362          }
   3363          
   3364          
   3365          //----------------------------------------------------------------------------------------------------------------------
   3366          /**
   3367           *  @brief      On entering 250us interrupt.
   3368           *
   3369           */
   3370          static void SrIsr250usEnterIsr(void)
   3371          {
   3372              SR_DATA_MCU_CHECK_SHORT(SR_250us_Isr_Enter_Cntr);
   3373              SR_DATA_MCU_CHECK_SHORT(SR_250us_Isr_Exit_Cntr);
   3374              if (SR_250us_Isr_Enter_Cntr > SR_250US_ISRMONITOR_MAX)
   3375              {
   3376                  SRMOTORSAFETYMGR_ISR_FLOW_FAIL_OVERRUN();
   3377              }
   3378              else
   3379              {
   3380                  SR_DATA_MCU_UPDATE_SHORT(SR_250us_Isr_Enter_Cntr, (SR_250us_Isr_Enter_Cntr+1));
   3381              }
   3382          }
   3383          
   3384          
   3385          //----------------------------------------------------------------------------------------------------------------------
   3386          /**
   3387           *  @brief      Handler for ISR Internal checks.
   3388           *
   3389           */
   3390          static void SrIsrHandler(void)
   3391          {
   3392              sint16 check = SRDATA_OK;
   3393          
   3394              MICRO_DECLARE_INTERRUPT_CONTEXT_LOCAL();
   3395          
   3396              //------- ISR Protected Code --------------------------------------------------------------------------------------
   3397              MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
   3398          
   3399              SR_MCU_MOTOR_CHECK_BYTE(check, SR_Isr_Init_Flag);
   3400              SR_MCU_MOTOR_CHECK_SHORT(check, SR_MC_Isr_Enter_Cntr);
   3401              SR_MCU_MOTOR_CHECK_SHORT(check, SR_MC_Isr_Exit_Cntr);
   3402              SR_MCU_MOTOR_CHECK_SHORT(check, SR_250us_Isr_Enter_Cntr);
   3403              SR_MCU_MOTOR_CHECK_SHORT(check, SR_250us_Isr_Exit_Cntr);
   3404          
   3405              if(check)
   3406              {
   3407                  SRDATA_CORRUPTION_EXCEPTION(DATA_CORRUPTION_ISR_HANDLER_SECTION);
   3408              }
   3409          
   3410              if (SR_Isr_Init_Flag == 1)
   3411              {   // Isr check already initialized
   3412                  // Catch an Enter/Exit mismatch - at this point they must be equal!
   3413                  if (SR_MC_Isr_Enter_Cntr != SR_MC_Isr_Exit_Cntr)
   3414                  {
   3415                      SRMOTORSAFETYMGR_ISR_FLOW_FAIL_SEQUENCE(SR_MC_Isr_Enter_Cntr,SR_MC_Isr_Exit_Cntr);
   3416                  }
   3417          
   3418                  if (SR_250us_Isr_Enter_Cntr != SR_250us_Isr_Exit_Cntr)
   3419                  {
   3420                      SRMOTORSAFETYMGR_ISR_FLOW_FAIL_SEQUENCE(SR_250us_Isr_Enter_Cntr,SR_250us_Isr_Exit_Cntr);
   3421                  }
   3422          
   3423                  // Catch interrupts less than lower threshold set
   3424                  if (SR_MC_Isr_Enter_Cntr < SR_MC_SRISRMONITOR_MIN)
   3425                  {
   3426                      SRMOTORSAFETYMGR_ISR_FLOW_FAIL_TIMEOUT();
   3427                  }
   3428          
   3429                  if (SR_250us_Isr_Enter_Cntr < SR_250US_SRISRMONITOR_MIN)
   3430                  {
   3431                      SRMOTORSAFETYMGR_ISR_FLOW_FAIL_TIMEOUT();
   3432                  }
   3433          
   3434                  // Everything is going OK - reset all counters for next check
   3435                  SR_DATA_MCU_UPDATE_SHORT(SR_MC_Isr_Enter_Cntr,0);
   3436                  SR_DATA_MCU_UPDATE_SHORT(SR_MC_Isr_Exit_Cntr,0);
   3437                  SR_DATA_MCU_UPDATE_SHORT(SR_250us_Isr_Enter_Cntr,0);
   3438                  SR_DATA_MCU_UPDATE_SHORT(SR_250us_Isr_Exit_Cntr,0);
   3439              }
   3440              else
   3441              {  // First time entering the ISR check --> skip the check to get the correct synchronization
   3442                  SR_DATA_MCU_UPDATE_SHORT(SR_MC_Isr_Enter_Cntr,0);
   3443                  SR_DATA_MCU_UPDATE_SHORT(SR_MC_Isr_Exit_Cntr,0);
   3444                  SR_DATA_MCU_UPDATE_SHORT(SR_250us_Isr_Enter_Cntr,0);
   3445                  SR_DATA_MCU_UPDATE_SHORT(SR_250us_Isr_Exit_Cntr,0);
   3446                  SR_DATA_MCU_UPDATE_BYTE(SR_Isr_Init_Flag, 1); // start executing the check
   3447              }
   3448              MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
   3449              //------- End ISR Protected Code ----------------------------------------------------------------------------------
   3450          }
   3451          
   3452          #endif

