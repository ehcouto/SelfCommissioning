   1220          //=====================================================================================================================
   1221          //  --- Private State Machine Customization Functions -----------------------------------------------------------------
   1222          //=====================================================================================================================
   1223          
   1224          
   1225          //---------------------------------------------------------------------------------------------------------------------
   1226          /**
   1227           * Check if any data is due for publication.
   1228           * First checks the time to see if the periodic data should be published.
   1229           * Then checks for any changes in variables that are monitored "on change".
   1230           * If data is due for publication, then it will generate the evProceed event.
   1231           */
   1232          static void CheckDataDue(void)
   1233          {
   1234              if (Api010.Is_Periodic_Data_Due == TRUE)
   1235              {
   1236                  Api010.Is_Periodic_Data_Due = FALSE;
   1237                  // Start publishing the periodic data.
   1238                  if (BuildStream(TRUE) == TRUE)
   1239                  {
   1240                      EventProceed();
   1241                  }
   1242              }
   1243              else if (IsOnChangeDataDue() == TRUE)
   1244              {
   1245                  // Start publishing the changed data.
   1246                  if (BuildStream(FALSE) == TRUE)
   1247                  {
   1248                      EventProceed();
   1249                  }
   1250              }
   1251              else
   1252              {
   1253                  // Check if there is still variable metadata that must be sent.
   1254                  CheckMetadataDue();
   1255              }
   1256          }
   1257          
   1258          
   1259          //---------------------------------------------------------------------------------------------------------------------
   1260          /**
   1261           * Check if more variable metadata should be sent out.
   1262           */
   1263          static void CheckMetadataDue(void)
   1264          {
   1265              #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
   1266                  // Check if there is still variable metadata that must be sent.
   1267                  if (Api010.Remaining_Metadata > 0)
   1268                  {
   1269                      PublishNextMetadata();
   1270                  }
   1271              #endif      // #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
   1272          }
   1273          
