    579                              REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API010POLLVAR_NUM, API010_FBK_PUBLISH_FIXED_VARIABLE_METADATA, cmd->node_id, sizeof(API010_VARIABLE_METADATA_TYPE));
    580                              if ((msg != NULL) &&
    581                                  (RevealAppendMetadata(msg, variable_index) == PASS) &&
    582                                  (Reveal__QueueCommand(msg) == TRUE))
    583                              {
    584                                  reveal_response = NVO_RS_READY;
    585                              }
    586                              else
    587                              {
    588                                  // Reveal rejected the request to publish a message.
    589                                  reveal_response = NVO_RS_UNSUP_OUT_OF_MEMORY;
    590                              }
    591                          }
    592                          else if (variable_index == 255)
    593                          {
    594                              // Publish metadata for all fixed variables.
    595                              Api010.Reply_To = cmd->node_id;
    596                              Api010.Remaining_Metadata = API010_FIXED_VARS_COUNT;
    597                              reveal_response = NVO_RS_READY;
    598                          }
    599                      }
    600                      break;
    601              #endif      // #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    602          
    603              #if (API010_MMAP_VARS_COUNT > 0)
    604                  case API010_CMD_DEFINE_MEMORY_MAPPED_VARIABLE:
    605                      // Expected Payload:
    606                      //      One byte for the variable index.
    607                      //      One byte for the size of the variable's data.
    608                      //      Four big-endian bytes for the variable's pointer.
    609                      if (size >= 6)
    610                      {
    611                          uint8 variable_index = payload[0];
    612                          if (
    613                              #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    614                               (API010_FIXED_VARS_COUNT <= variable_index) &&
    615                              #endif
    616                               (variable_index < API010_VARS_COUNT))
    617                          {
    618                              // adjust index
    619                              uint8 mmap_index = variable_index - API010_FIXED_VARS_COUNT;
    620                              Api010.Mem_Mapped_Vars[mmap_index].Size = payload[1];
    621                              Api010.Mem_Mapped_Vars[mmap_index].Address = (void*)Utilities__ConvertArrayTo32bits(&payload[2]); //lint !e923 Suppress Info: cast from unsigned long to pointer [Encompasses MISRA 2004 Rule 11.1]
    622                              reveal_response = NVO_RS_READY;
    623                          }
    624                      }
    625                      break;
    626          
    627                  case API010_CMD_UNDEFINE_MEMORY_MAPPED_VARIABLE:
    628                      // Expected Payload:
    629                      //      One byte for each undefined variable index.
    630                      if ((size == 1) && (payload[0] == 255))
    631                      {
    632                          // Undefine all memory-mapped variables.
    633                          for (uint8 mmap_index = 0; mmap_index < API010_MMAP_VARS_COUNT; mmap_index++)
    634                          {
    635                              RemoveMemoryMappedVariable(mmap_index);
    636                          }
    637                          reveal_response = NVO_RS_READY;
    638                      }
    639                      else
    640                      {
    641                          for (uint8 index = 0; index < size; index++)
    642                          {
    643                              uint8 variable_index = payload[index];
    644                              if (
    645                                  #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    646                                   (API010_FIXED_VARS_COUNT <= variable_index) &&
    647                                  #endif
    648                                   (variable_index < API010_VARS_COUNT))
    649                              {
    650                                  // Undefine the specified memory-mapped variable.
    651                                  uint8 mmap_index = variable_index - API010_FIXED_VARS_COUNT;
    652                                  RemoveMemoryMappedVariable(mmap_index);
    653                                  reveal_response = NVO_RS_READY;
    654                              }
    655                          }
    656                      }
    657                      break;
    658              #endif      // #if (API010_MMAP_VARS_COUNT > 0)
    659          
    660                  case API010_CMD_REQUEST_SPECIFIC_VARIABLE:
    661                      // Expected Payload:
    662                      //      One byte for the variable index.
    663                      if (size >= 1)
    664                      {
    665                          // This opcode sends the data of one specific variable, this opcode doesn't take care of endianess, it will be send out in the endianess of the micro
    666                          // The same process used by the stream transmission.
    667                          uint8 variable_index = payload[0];
    668                          API010_VARIABLE_TYPE variable;
    669                          if (GetVariableInfo(variable_index, &variable) == TRUE)
    670                          {
    671                              REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API010POLLVAR_NUM, API010_FBK_PUBLISH_SPECIFIC_VARIABLE, cmd->node_id, variable.Size + 1);
    672                              if ((Reveal__AddDataU8(msg, variable_index) == PASS) &&
    673                                  (Reveal__AddDataU8Buffer(msg, variable.Address, variable.Size) == PASS) &&
    674                                  (Reveal__QueueCommand(msg) == TRUE))
    675                              {
    676                                  reveal_response = NVO_RS_READY;
    677                              }
    678                              else
    679                              {
    680                                  // Reveal rejected the request to publish a message.
    681                                  reveal_response = NVO_RS_UNSUP_OUT_OF_MEMORY;
    682                              }
    683                          }
    684                      }
    685                      break;
    686          
    687              #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    688                  case API010_CMD_WRITE_FIXED_VARIABLE_VALUE:
    689                      // Expected Payload
    690                      //      One byte for the variable index.
    691                      //      One byte for the array position.
    692                      //      One or more bytes for the variable value in native endian format.
    693                      if (size >= 3)
    694                      {
    695                          VARIABLE_ID_TYPE variable_index = (VARIABLE_ID_TYPE)payload[0];
    696                          if (variable_index < API010_FIXED_VARS_COUNT)
    697                          {
    698                              VARIABLE_TYPE variable;
    699                              Variable__GetByIndex(variable_index, &variable);
    700                              if (variable.Is_Writable == TRUE)
    701                              {
    702                                  uint8 array_position = payload[1];
    703                                  uint8 data_size = size - 2;
    704                                  uint8 variable_size = VARIABLE_SIZE[variable.Type];
    705                                  uint8 element_count = data_size / variable_size;
    706                                  if (((data_size % variable_size) == 0) &&
    707                                      (array_position + element_count <= variable.Length))
    708                                  {
    709                                      uint8* data_source = &payload[2];
    710                                      uint8* data_destination = variable.Address;
    711                                      data_destination += array_position * variable_size;
    712                                      memcpy(data_destination, data_source, data_size);
    713                                      reveal_response = NVO_RS_READY;
    714                                  }
    715                              }
    716                          }
    717                      }
    718                      break;
    719              #endif      // #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    720          
    721              #if (API010_DEBUG_ACQ_CONFIG == ENABLED)
    722                  case API010_CMD_REQUEST_ACQUISITION_CONFIGURATION:
    723                  {
    724                      // Expected No Payload
    725                      uint8 selected[BIT_STORAGE_SIZE(API010_VARS_COUNT)];
    726                      uint8 on_change[BIT_STORAGE_SIZE(API010_VARS_COUNT)];
    727                      for (uint8 index = 0; index < API010_VARS_COUNT; index++)
    728                      {
    729                          Utilities__SetBitInArray(selected, index, Api010.Control[index].Selected);
    730                          Utilities__SetBitInArray(on_change, index, Api010.Control[index].On_Change);
    731                      }
    732                      REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API010POLLVAR_NUM, API010_FBK_PUBLISH_ACQUISITION_CONFIGURATION, cmd->node_id, 2 * BIT_STORAGE_SIZE(API010_VARS_COUNT) + 4);
    733                      if ((Reveal__AddDataU8(msg, Api010.Method) == PASS) &&
    734                          (Reveal__AddDataU16(msg, Api010.Publication_Period) == PASS) &&
    735                          (Reveal__AddDataU8(msg, BIT_STORAGE_SIZE(API010_VARS_COUNT)) == PASS) &&
    736                          (Reveal__AddDataU8Buffer(msg, selected, BIT_STORAGE_SIZE(API010_VARS_COUNT)) == PASS) &&
    737                          (Reveal__AddDataU8Buffer(msg, on_change, BIT_STORAGE_SIZE(API010_VARS_COUNT)) == PASS) &&
    738                          (Reveal__QueueCommand(msg) == TRUE))
    739                      {
    740                          reveal_response = NVO_RS_READY;
    741                      }
    742                      else
    743                      {
    744                          reveal_response = NVO_RS_UNSUP_OUT_OF_MEMORY;
    745                      }
    746                      break;
    747                  }
    748              #endif      // #if (API010_DEBUG_ACQ_CONFIG == ENABLED)
    749          
    750                  case API010_CMD_REQUEST_NUM_OF_VARIABLES:
    751                  {
    752                      // Expected No Payload
    753                      REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API010POLLVAR_NUM, API010_FBK_PUBLISH_NUM_OF_VARIABLES, cmd->node_id, 2);
    754                      if ((Reveal__AddDataU8(msg, API010_FIXED_VARS_COUNT) == PASS) &&
    755                          (Reveal__AddDataU8(msg, API010_MMAP_VARS_COUNT) == PASS) &&
    756                          (Reveal__AddDataU8(msg, GetMMapVarsCount()) == PASS) &&
    757                          (Reveal__QueueCommand(msg) == TRUE))
    758                      {
    759                          reveal_response = NVO_RS_READY;
