   \   00000026   0xB2C0             UXTB     R0,R0
   \   00000028   0x4770             BX       LR               ;; return
    830          }
    831          
    832          
    833          //---------------------------------------------------------------------------------------------------------------------
    834          /**
    835           * Build the stream of data for the specified variables.
    836           * The stream of data consists of the following:
    837           *      One byte for the stream sequence number. Incremented for each new stream of data.
    838           *      For each published variable:
    839           *          One byte for the variable index.
    840           *          One or more bytes for the variable value.
    841           * @param selected = A flag that specifies which set of variables to put in the data stream.
    842           *              FALSE = Only put the variables that have changed in the data stream.
    843           *              TRUE = Put all the variables that were selected as part of the periodic data.
    844           * @return TRUE if the data stream was built and there is data in it.
    845           */
    846          static BOOL_TYPE BuildStream(BOOL_TYPE selected)
    847          {
    848              Api010.Stream_Buffer[0] = Api010.Sequence_Number;
    849              Api010.Sequence_Number++;
    850              Api010.Stream_Length = 1;
    851              for (uint8 index = 0; index < API010_VARS_COUNT; index++)
    852              {
    853          #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
    854                  if ((Api010.Control[index].Selected == TRUE) &&
    855                      ((selected == TRUE) ||
    856                       ((Api010.Control[index].On_Change == TRUE) &&
    857                        (Api010.Control[index].Changed == TRUE))))
    858          #else
    859                  if ((Api010.Control[index].Selected == TRUE) &&
    860                      (selected == TRUE))
    861          #endif
    862                  {
    863                      API010_VARIABLE_TYPE variable;
    864                      if ((GetVariableInfo(index, &variable) == TRUE) &&
    865                          (Api010.Stream_Length + variable.Size + 1 < API010_STREAM_BUFFER_SIZE))
    866                      {
    867                          Api010.Stream_Buffer[Api010.Stream_Length] = index;
    868                          Api010.Stream_Length++;
    869                          memcpy(&Api010.Stream_Buffer[Api010.Stream_Length], variable.Address, variable.Size);
    870                          #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
    871                              if (Api010.Control[index].On_Change == TRUE)
    872                              {
    873                                  uint16 offset = Api010.Last_Sent_Offset[index];
    874                                  memcpy(&Api010.Last_Sent[offset], variable.Address, variable.Size);
    875                              }
    876                              Api010.Control[index].Changed = FALSE;
    877                          #endif
    878                          Api010.Stream_Length += variable.Size;
    879                      }
    880                      else
    881                      {
    882                          if (Api010.Enable_Error_Reporting == TRUE)
    883                          {
    884                              Api010.Enable_Error_Reporting = FALSE;
    885                              LOG_ADD_EXCEPTION(TOO_MUCH_DATA, index);
    886                          }
    887                          break;                              // Out of the for() loop.
    888                      }
    889                  }
    890              }
    891              if (Api010.Stream_Length > 1)
    892              {
    893                  // Setup the supporting stream variables.
    894                  Api010.Stream_Csum = 0;
    895                  for (API010_STREAM_INDEX_TYPE i = 0; i < Api010.Stream_Length; i++)
    896                  {
    897                      Api010.Stream_Csum += Api010.Stream_Buffer[i];
    898                  }
    899                  Api010.Stream_Index = 0;
    900              }
    901              return (BOOL_TYPE)(Api010.Stream_Length > 1);
    902          }
    903          
    904          
    905          //---------------------------------------------------------------------------------------------------------------------
    906          /**
    907           * Get generic information about a variable whether it is a fixed variable or a memory-mapped variable.
    908           * @param variable_index = The variable to get.
    909           * @param var_info = Pointer to a structure to fill with the variable information.
    910           * @return TRUE if the var_info structure was filled. Otherwise FALSE.
    911           */
    912          static BOOL_TYPE GetVariableInfo(uint8 variable_index, API010_VARIABLE_TYPE* var_info)
    913          {
    914              #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    915                  if (variable_index <= API010_FIXED_VARS_COUNT)
    916                  {
    917                      VARIABLE_TYPE variable;
    918                      if (Variable__GetByIndex((VARIABLE_ID_TYPE)variable_index, &variable) == TRUE)
    919                      {
    920                          var_info->Address = variable.Address;
    921                          var_info->Size = VARIABLE_SIZE[variable.Type] * variable.Length;
    922                          return TRUE;
    923                      }
    924                  }
    925                  #if (API010_MMAP_VARS_COUNT > 0)
    926                  else
    927                  #endif      // #if (API010_MMAP_VARS_COUNT > 0)
    928              #endif          // #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
    929              #if (API010_MMAP_VARS_COUNT > 0)
    930                  if (variable_index < API010_VARS_COUNT)
    931                  {
    932                      uint8 mmap_index = variable_index - API010_FIXED_VARS_COUNT;
    933                      API010_VARIABLE_TYPE* mmap_var = &Api010.Mem_Mapped_Vars[mmap_index];
    934                      if (mmap_var->Address != NULL)
    935                      {
    936                          memcpy(var_info, mmap_var, sizeof(API010_VARIABLE_TYPE));
    937                          return TRUE;
    938                      }
    939                  }
    940              #endif      // #if (API010_MMAP_VARS_COUNT > 0)
    941              return FALSE;
    942          }
    943          
    944          
    945          //---------------------------------------------------------------------------------------------------------------------
    946          /**
    947           * Scan the variables that are setup for publication on change for any new changes.
    948           * @return TRUE if any variables are set as changed.
    949           */
    950          static BOOL_TYPE IsOnChangeDataDue(void)
    951          {
    952              BOOL_TYPE change_found = FALSE;
    953              #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
    954                  for (uint8 variable_index = 0; variable_index < API010_VARS_COUNT; variable_index++)
    955                  {
    956                      if ((Api010.Control[variable_index].Selected == TRUE) &&
    957                          (Api010.Control[variable_index].On_Change == TRUE))
    958                      {
    959                          if (Api010.Control[variable_index].Changed == TRUE)
    960                          {
    961                              change_found = TRUE;
    962                          }
    963                          else
    964                          {
    965                              API010_VARIABLE_TYPE variable;
    966                              if (GetVariableInfo(variable_index, &variable) == TRUE)
    967                              {
    968                                  uint16 offset = Api010.Last_Sent_Offset[variable_index];
    969                                  uint8* last_sent = &Api010.Last_Sent[offset];
    970                                  if (memcmp(variable.Address, last_sent, variable.Size) != 0)
    971                                  {
    972                                      Api010.Control[variable_index].Changed = TRUE;
    973                                      change_found = TRUE;
    974                                  }
    975                              }
    976                          }
    977                      }
    978                  }
    979              #endif      // #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
    980              return change_found;
    981          }
    982          
    983          
    984          #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
    985          //---------------------------------------------------------------------------------------------------------------------
    986          /**
    987           * Add or subtract a delta value from the Last_Sent_OFfset[] array.
    988           * @param first_index = The first index that needs updating.
    989           * @param delta = The amount of change to add or subtract.
    990           *                Positive values are added. Negative values are subtracted.
    991           */
    992          static void AddToOffsets(uint8 first_index, sint16 delta)
    993          {
    994              for (uint8 variable_index = first_index; variable_index <= API010_VARS_COUNT; variable_index++)
    995              {
    996                  Api010.Last_Sent_Offset[variable_index] += delta;
    997              }
    998          }
    999          
   1000          
   1001          //---------------------------------------------------------------------------------------------------------------------
   1002          /**
   1003           * Insert the specified variable into the on change monitoring.
   1004           * @param variable_index = The variable to insert into "on change" monitoring.
   1005           * @return TRUE if the specified variable was inserted into "on change" monitoring. Otherwise FALSE.
   1006           */
   1007          static BOOL_TYPE OnChangeInsertVariable(uint8 variable_index)
   1008          {
   1009              // Only insert the variable if it is not already inserted.
   1010              if ((variable_index < API010_VARS_COUNT) &&
   1011                  (Api010.Control[variable_index].On_Change == FALSE))
   1012              {
   1013                  // Make sure there is space in the Last_Sent[] array for this variable.
   1014                  uint16 space_consumed = Api010.Last_Sent_Offset[API010_VARS_COUNT];
   1015                  uint16 space_available = API010_ON_CHANGE_BUFFER_SIZE - space_consumed;
   1016                  API010_VARIABLE_TYPE variable;
   1017                  if ((GetVariableInfo(variable_index, &variable) == TRUE) &&
   1018                      (variable.Size <= space_available))
   1019                  {
   1020                      // Update all the offsets to the Last_Sent[] data.
   1021                      AddToOffsets(variable_index + 1, variable.Size);
   1022          
   1023                      // Setup automatic variables to reference the variable's Last_Sent value.
   1024                      uint16 var_offset = Api010.Last_Sent_Offset[variable_index];
   1025                      uint8* var_data = &Api010.Last_Sent[var_offset];
   1026          
   1027                      // Shift the Last_Sent[] values to make space for the new variable.
   1028                      if (variable_index + 1 < API010_VARS_COUNT)
   1029                      {
   1030                          // Shift the other values to make space for this variable.
   1031                          uint8* move_to = &Api010.Last_Sent[var_offset + variable.Size];
   1032                          memmove(move_to, var_data, space_consumed - var_offset);
   1033                      }
   1034          
   1035                      // Update the Control of the variable so that it is selected, monitored, and changed.
   1036                      Api010.Control[variable_index].Selected = TRUE;
   1037                      Api010.Control[variable_index].On_Change = TRUE;
   1038                      memcpy(var_data, variable.Address, variable.Size);
   1039                      Api010.Control[variable_index].Changed = TRUE;
   1040                      return TRUE;
   1041                  }
   1042              }
   1043              return FALSE;
   1044          }
   1045          
   1046          
   1047          //---------------------------------------------------------------------------------------------------------------------
   1048          /**
   1049           * Remove the specified variable from the on change monitoring.
   1050           * @param variable_index = The variable to remove from "on change" monitoring.
   1051           */
   1052          static void OnChangeRemoveVariable(uint8 variable_index)
   1053          {
   1054              // Only remove the variable if it is already inserted.
   1055              if ((variable_index < API010_VARS_COUNT) &&
   1056                  (Api010.Control[variable_index].On_Change == TRUE))
   1057              {
   1058                  // Get the variable information.
   1059                  API010_VARIABLE_TYPE variable;
   1060                  if (GetVariableInfo(variable_index, &variable) == TRUE)
   1061                  {
   1062                      // Update all the offsets to the Last_Sent[] data.
   1063                      AddToOffsets(variable_index + 1, -variable.Size);
   1064          
   1065                      // Setup automatic variables to reference the variable's Last_Sent value.
   1066                      uint16 var_offset = Api010.Last_Sent_Offset[variable_index];
   1067                      uint8* var_data = &Api010.Last_Sent[var_offset];
   1068          
   1069                      // Shift the Last_Sent[] values to collapse the space that is no longer needed.
   1070                      if (variable_index + 1 < API010_VARS_COUNT)
   1071                      {
   1072                          // Shift the other values to make space for this variable.
   1073                          uint8 space_consumed = Api010.Last_Sent_Offset[API010_VARS_COUNT];
   1074                          uint8* move_from = &var_data[variable.Size];
   1075                          memmove(var_data, move_from, space_consumed - var_offset);
   1076                      }
   1077          
   1078                      // Update the Control of the variable so that it is not monitored or changed.
   1079                      Api010.Control[variable_index].On_Change = FALSE;
   1080                      Api010.Control[variable_index].Changed = FALSE;
   1081                  }
   1082              }
   1083          }
   1084          
   1085          
   1086          //---------------------------------------------------------------------------------------------------------------------
   1087          /**
   1088           * Set the "on change" behavior for one or more variables.
   1089           * There are no checks for out of range values.
   1090           *      first_index should be less than or equal to last_index.
   1091           *      Both values should be in the range [0 .. API010_VARS_COUNT).
   1092           * @param on_change = Desired "on change" behavior for the selected variable(s).
   1093           * @param first_index = First variable index in the range of variables to affect.
   1094           * @param last_index = Last variable index in the range of variables to affect.
   1095           * @return TRUE if the on change behavior was updated. Otherwise FALSE.
   1096           */
   1097          static BOOL_TYPE SetOnChangeBehavior(BOOL_TYPE on_change, uint8 first_index, uint8 last_index)
   1098          {
   1099              uint8 variables_added = 0;
   1100              for (uint8 variable_index = first_index; variable_index <= last_index; variable_index++)
   1101              {
   1102                  if (on_change == TRUE)
   1103                  {
   1104                      if ((Api010.Control[variable_index].Selected == TRUE) &&
   1105                          (OnChangeInsertVariable(variable_index) == TRUE))
   1106                      {
   1107                          variables_added++;
   1108                      }
   1109                  }
   1110                  else
   1111                  {
   1112                      OnChangeRemoveVariable(variable_index);
   1113                  }
   1114              }
   1115              return (BOOL_TYPE)((on_change == FALSE) || (variables_added > 0));
   1116          }
   1117          #endif      // #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
   1118          
   1119          
   1120          #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
   1121          //---------------------------------------------------------------------------------------------------------------------
   1122          /**
   1123           * Send the next packet of metadata information.
   1124           * If Reveal returns an error, then the function will try to send the same packet on the next call.
   1125           */
   1126          static void PublishNextMetadata(void)
   1127          {
   1128              // Determine the size of the payload.
   1129              uint8 metadata_in_packet = Api010.Remaining_Metadata;
   1130              if (metadata_in_packet > API010_MAXIMUM_METADATA_PER_PACKET)
   1131              {
   1132                  metadata_in_packet = API010_MAXIMUM_METADATA_PER_PACKET;
   1133              }
   1134              uint8 payload_size = metadata_in_packet * sizeof(API010_VARIABLE_METADATA_TYPE);
   1135              REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API010POLLVAR_NUM, API010_FBK_PUBLISH_FIXED_VARIABLE_METADATA, Api010.Reply_To, payload_size);
   1136          
   1137              // Determine the number of variables whose metadata will fit in the payload.
   1138              if (msg != NULL)
   1139              {
   1140                  BOOL_TYPE success = TRUE;       // Assume no errors while building the packet.
   1141                  uint8 metadata_in_packet = payload_size / sizeof(API010_VARIABLE_METADATA_TYPE);
   1142                  uint8 first_variable_in_packet = API010_FIXED_VARS_COUNT - Api010.Remaining_Metadata;
   1143                  for (uint8 i = 0; i < metadata_in_packet; i++)
   1144                  {
   1145                      uint8 variable_index = first_variable_in_packet + i;
   1146                      if (RevealAppendMetadata(msg, variable_index) == FAIL)
   1147                      {
   1148                          success = FALSE;
   1149                          break;                  // Out of the for() loop.
   1150                      }
   1151                  }
   1152                  if (success == TRUE)
   1153                  {
   1154                      // If we have more messages to send, we set the MMP flag.
   1155                      if (metadata_in_packet < Api010.Remaining_Metadata)
   1156                      {
   1157                          BIT_SET(msg->opcode, 7);
   1158                      }
   1159                      //Queuing and updating the index.
   1160                      if (Reveal__QueueCommand(msg) == TRUE)
   1161                      {
   1162                          Api010.Remaining_Metadata -= metadata_in_packet;
   1163                      }
   1164                  }
   1165              }
   1166          }
   1167          
   1168          
   1169          //---------------------------------------------------------------------------------------------------------------------
   1170          /**
   1171           * Append the specified variable's metadata information to the provided Reveal message.
   1172           * @param variable_index = The index of the requested variable.
   1173           * @param msg = Pointer to the previously allocated Reveal message. This value must not be NULL.
   1174           * @return PASS if the metadata was successfully appended. Otherwise FAIL.
   1175           */
   1176          static PASS_FAIL_TYPE RevealAppendMetadata(REVEAL_COMMAND_TYPE *msg, uint8 variable_index)
   1177          {
   1178              VARIABLE_TYPE variable;
   1179              API010_VARIABLE_METADATA_TYPE metadata;
   1180              memset(&metadata, 0, sizeof(API010_VARIABLE_METADATA_TYPE));
   1181              if (variable_index < API010_FIXED_VARS_COUNT)
   1182              {
   1183                  if (Variable__GetByIndex((VARIABLE_ID_TYPE)variable_index, &variable) == TRUE)
   1184                  {
   1185                      metadata.Variable_Index = variable_index;
   1186                      metadata.Variable_Array_Elements = variable.Length;
   1187                      metadata.Variable_Element_Type = variable.Type;
   1188                      // TODO: add key from KVP here when available.
   1189                      metadata.Key = variable_index;
   1190                      return Reveal__AddDataU8Buffer(msg, (uint8*)(void*)&metadata, sizeof(metadata));
   1191                  }
   1192              }
   1193              return FAIL;
   1194          }
   1195          #endif      // #if (API010_USES_FIXED_VARIABLES_FEATURE == ENABLED)
   1196          
   1197          
   1198          #if (API010_MMAP_VARS_COUNT > 0)
   1199          //---------------------------------------------------------------------------------------------------------------------
   1200          /**
   1201           * Remove the specified memory-mapped variable from the list of variables in the periodic data.
   1202           * @param mmap_index = An index that identifies the memory-mapped variable configuration slot.
   1203           *                     This value must be in the range [0..API010_MMAP_VARS_COUNT).
   1204           *                     A value not in this range will have no effect.
   1205           */
   1206          static void RemoveMemoryMappedVariable(uint8 mmap_index)
   1207          {
   1208              if (mmap_index < API010_MMAP_VARS_COUNT)
   1209              {
   1210                  memset(&Api010.Mem_Mapped_Vars[mmap_index], 0, sizeof(API010_VARIABLE_TYPE));
   1211                  Api010.Control[mmap_index + API010_FIXED_VARS_COUNT].Selected = FALSE;
   1212                  #if (API010_ON_CHANGE_BUFFER_SIZE > 0)
   1213                      Api010.Control[mmap_index + API010_FIXED_VARS_COUNT].On_Change = FALSE;
   1214                  #endif
   1215              }
   1216          }
   1217          #endif      // #if (API010_MMAP_VARS_COUNT > 0)
   1218          
