    239          /**
    240           *  @brief      Motor Control Loop Dq Controller 2nd Running Handler.
    241           *  @details    This routine is called in second pwm slots.
    242           *
    243           *
    244           *  @param[in]
    245           *  @param[Out]
    246           *  @param[in]
    247           *  @return
    248           */
    249          void MclDqCtrl__2ndRunningHandler(MCL_DQ_CTRL_IO_F_TYPE *io, MCL_DQ_CTRL_PARAMS_TYPE *params)
    250          {
    251              float32 temp_vd;
    252              float32 temp_vq;
    253              float32 temp;
    254              DQ_COOR_SYST_F_TYPE dq_in;
    255              SIN_COS_F_TYPE sin_cos;
    256          
    257              dq_in.D = (io->Vs_DQ->D);
    258              dq_in.Q = (io->Vs_DQ->Q);
    259          
    260              //==========================================================================//
    261              //                        Phase Advance (advance of 1Ts)                    //
    262              //==========================================================================//
    263          #ifdef SIM_SENSORED_MODE
    264              temp = ( *(io->Ctrl_Specific->Speed_Rotor_Observed) * params->Phase_Advance_Coeff * 0.5f); // the sincos is updated from simulation so we just need one phase advance step (halved due to double slot)
    265          #else
    266              temp = ( *(io->Ctrl_Specific->Speed_Rotor_Observed) * params->Phase_Advance_Coeff ); // the sincos is the internal one, so we need two steps (halved due to double slot)
    267          #endif
    268              MathCalc__SinCosF(temp,  &sin_cos);
    269          
    270              temp_vd  = (dq_in.D * sin_cos.Cos); //(Flux_Controller.Out * sin_cos.Cos)>>15;
    271              temp_vd -= (dq_in.Q * sin_cos.Sin); //(Torque_Controller.Out * sin_cos.Sin)>>15;
    272              temp_vq  = (dq_in.D * sin_cos.Sin); //(Flux_Controller.Out * sin_cos.Sin)>>15;
    273              temp_vq += (dq_in.Q * sin_cos.Cos); //(Torque_Controller.Out * sin_cos.Cos)>>15;
    274          
    275              dq_in.D = temp_vd;//Flux_Controller.Out = temp_vd;
    276              dq_in.Q = temp_vq;//Torque_Controller.Out = temp_vq;
    277          
    278          
    279              //==========================================================================//
    280              //                Inverse Park transformation (dq-abc)                      //
    281              //==========================================================================//
    282              ClrkPark__InverseParkF(&dq_in, io->Vs_Alpha_Beta, io->Sin_Cos);
    283          
    284          }
    285          #endif
