    414          #ifdef DQCTRL__HEXAGON_LIMIT
    415          #ifdef __IAR_SYSTEMS_ICC__
    416          #pragma inline = forced
    417          #endif
    418          static float32 HexagonTrajectoryCalculation(MCL_DQ_CTRL_IO_F_TYPE *io)
    419          {
    420              SIN_COS_F_TYPE sin_cos_reduced;
    421              float32 hexagon;
    422              //reduced sine and cosine to 0 - pi/3 range
    423              sin_cos_reduced.Cos = io->Sin_Cos->Cos;
    424              sin_cos_reduced.Sin = io->Sin_Cos->Sin;
    425          
    426              if (sin_cos_reduced.Sin < 0)
    427              {
    428                  sin_cos_reduced.Sin = -sin_cos_reduced.Sin;
    429                  sin_cos_reduced.Cos = -sin_cos_reduced.Cos;
    430              }
    431          
    432              if ((sin_cos_reduced.Cos < 0.5f) && (sin_cos_reduced.Cos > -0.5f))
    433              {
    434                  hexagon = 1.0f/sin_cos_reduced.Sin;
    435              }
    436              else if ((sin_cos_reduced.Cos < -0.5f))
    437              {
    438                  hexagon = 2.0f / (-F_SQRT3 * sin_cos_reduced.Cos + sin_cos_reduced.Sin);
    439              }
    440              else
    441              {
    442                  hexagon = 2.0f / (F_SQRT3 * sin_cos_reduced.Cos + sin_cos_reduced.Sin);
    443              }
    444              return(hexagon);
    445          }
    446          #endif

