    328          #ifdef __IAR_SYSTEMS_ICC__
    329          #pragma inline = forced
    330          #endif
    331          //---------------------------------------------------------------------------------------------------------------------
    332          /**
    333           *  @brief      Reconstruct applied phase voltage from the last pwm command duty cycles.
    334           *  @details
    335           *
    336           *  @param[in]  MCL_INPUT_PROC_IO_TYPE *io
    337           *  @param[out] MCL_INPUT_PROC_IO_TYPE *io
    338           *  @return     none
    339           */
    340          static void PhaseVoltageReconstruction(MCL_INPUT_PROC_IO_F_TYPE *io)
    341          {
    342              float32 temp_vdc;
    343              float32 temp_common_mode;
    344          
    345              // Check if the command to enable lowers on was enabled, if it was enabled
    346              if( *(io->Ctrl_Specific->Lowers_On) )
    347              {
    348                  // voltages applied to the motor is zero.
    349                  io->Vs_Alpha_Beta_Rec->Alpha = 0.0f;
    350                  io->Vs_Alpha_Beta_Rec->Beta = 0.0f;
    351          
    352                  io->Vabc_Rec->A = 0.0f;
    353                  io->Vabc_Rec->B = 0.0f;
    354                  io->Vabc_Rec->C = 0.0f;
    355          
    356              }
    357              else
    358              {
    359                  // Read the last duty cycle and scale it to the DC bus voltage.
    360                  // Note: assume the DC bus voltage is kept constant within one pwm period.
    361                  temp_vdc = *(io->Vdc);
    362                  io->Vabc_Rec->A = (io->Duty->A * temp_vdc);
    363                  io->Vabc_Rec->B = (io->Duty->B * temp_vdc);
    364                  io->Vabc_Rec->C = (io->Duty->C * temp_vdc);
    365          
    366                  //ClrkPark__DirectClarkeF(io->Vabc_Rec, io->Vs_Alpha_Beta_Rec);
    367          
    368                  temp_common_mode = (io->Vabc_Rec->A) + (io->Vabc_Rec->B) + (io->Vabc_Rec->C);
    369                  temp_common_mode = temp_common_mode * INV_3 ;
    370          
    371                  io->Vabc_Rec->A -= temp_common_mode;
    372                  io->Vabc_Rec->B -= temp_common_mode;
    373                  io->Vabc_Rec->C -= temp_common_mode;
    374          
    375                  ClrkPark__DirectClarkeF(io->Vabc_Rec, io->Vs_Alpha_Beta_Rec);
    376              }
    377          }
