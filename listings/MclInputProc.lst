    461          
    462          
    463          static void CurrentOffSetLogicEnable(MCL_INPUT_PROC_IO_F_TYPE *io, MCL_INPUT_PROC_JOINT_PARAMS_TYPE *params)
    464          {
    465              float32 temp_abs_cur;
    466              float32 temp_abs_speed;
    467          
    468              temp_abs_cur = *(io->Ctrl_Specific->Is_Abs);
    469              temp_abs_speed = *(io->Ctrl_Specific->Speed_Rot_Ref_Abs);
    470          
    471              if(params->InputProcPrm->Current_Offset_Comp_Speed_Thr != 0)
    472              {
    473                  if((temp_abs_speed >= Speed_Threshold_High_CurOffComp) &&(temp_abs_cur > params->InputProcAddPrm->Current_Offset_Comp_Current_Thr))
    474                  {
    475                      Cur_Offset_Compensation = TRUE;
    476                  }
    477                  if(temp_abs_speed <= Speed_Threshold_Low_CurOffComp)
    478                  {
    479                      Cur_Offset_Compensation = FALSE;
    480                  }
    481              }
    482              else
    483              {
    484                  Cur_Offset_Compensation = FALSE;
    485              }
    486          
    487              if(Cur_Offset_Compensation == FALSE)
    488              {
    489                  Cur_Offset_Comp_Factor -= 0.0005f;  // At the rate of 1 ms, 1.0f will take almost 2 sec
    490          
    491                  if(Cur_Offset_Comp_Factor <0.0f)
    492                  {
    493                      Cur_Offset_Comp_Factor = 0.0f;
    494                  }
    495              }
    496              else
    497              {
    498                  Cur_Offset_Comp_Factor += 0.0005f;
    499                  if(Cur_Offset_Comp_Factor > 1.0f)
    500                  {
    501                      Cur_Offset_Comp_Factor = 1.0f;
    502                  }
    503              }
    504          }
    505          #endif

