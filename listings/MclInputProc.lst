    212          //---------------------------------------------------------------------------------------------------------------------
    213          /**
    214           *  @brief      Apply Clarke transform to the currents.
    215           *  @details    By applying Clarke transformation to the currents, it shall provide the alpha and beta currents
    216           *              from the measured currents a, b and c.
    217           *
    218           *  @param[in]  MCL_INPUT_PROC_IO_TYPE *io
    219           *  @param[out] MCL_INPUT_PROC_IO_TYPE *io
    220           *  @return     none
    221           */
    222          static void CurrentClarkTransform(MCL_INPUT_PROC_IO_F_TYPE *io)
    223          {
    224              ClrkPark__DirectClarkeF(io->Is_ABC, io->Is_Alpha_Beta);
    225          }
    226          
    227          
    228          
    229          
    230          //---------------------------------------------------------------------------------------------------------------------
    231          /**
    232           *  @brief      Calculate the peak current (magnitude) from alpha and beta currents
    233           *  @details    By applying Clarke transformation to the currents, it shall provide the alpha and beta currents
    234           *              from the measured currents a, b and c.
    235           *
    236           *  @param[in]  MCL_INPUT_PROC_IO_TYPE *io
    237           *  @param[out] MCL_INPUT_PROC_IO_TYPE *io
    238           *  @return     none
    239           */
    240          static void CalcStatorCurrentMagnitude(MCL_INPUT_PROC_IO_F_TYPE *io)
    241          {
    242              float32 temp;
    243          
    244              temp  = (io->Is_Alpha_Beta->Alpha) * (io->Is_Alpha_Beta->Alpha);
    245              temp += (io->Is_Alpha_Beta->Beta)  * (io->Is_Alpha_Beta->Beta);
    246          
    247              *(io->Ctrl_Specific->Is_Abs) = MC_SQRT_F(temp);
    248          }
    249          
    250          
    251          //---------------------------------------------------------------------------------------------------------------------
    252          /**
    253           *  @brief      Tracks the minimum instant dc bus voltage
    254           *  @details    This algorithm tracks the minimum instant dc bus voltage voltage, keep the minimum for certain
    255           *              amount of time before reseting the temporary minimum and update the value. In this algorithm,
    256           *              the minimum is always keep at the minimum of the instant voltage.
    257           *
    258           *  @param[in]  MCL_INPUT_PROC_IO_TYPE *io
    259           *  @param[out] MCL_INPUT_PROC_IO_TYPE *io
    260           *  @return     none
    261           */
    262          static void VdcFilter(MCL_INPUT_PROC_IO_F_TYPE *io, MCL_INPUT_PROC_PARAMS_TYPE *params)
                                                                                                 ^
Remark[Pe826]: parameter "params" was never referenced
    263          {
    264          #if (INPUTPROC__VDCFILTER_MINIMUM == ENABLED)
    265              static uint8 prescaler_25ms = (uint8)(MCL_INPUT_1MS_CALL_RATE_HZ/40.0f);
    266          #endif
    267          #if (INPUTPROC__VDC_RMS == ENABLED)
    268              static uint8 window_avg = 80;
    269              float32 Vdc;
    270          #endif
    271          #if (INPUTPROC__VDCFILTER_MINIMUM == ENABLED)
    272              // Filter the minimum instant dc bus voltage
    273              DC_Bus_Min_Sum = FILTERS__LOWPASSFILTER_F(DC_Bus_Min_Sum, DC_BUS_LPF_COEF, DC_Bus_Min);
    274          
    275          	DC_Bus_Min_Sum_2nd = FILTERS__LOWPASSFILTER_F(DC_Bus_Min_Sum_2nd, DC_BUS_LPF_COEF, DC_Bus_Min_Sum);
    276          
    277          	*(io->Vs_Max_Filt) = DC_Bus_Min_Sum_2nd;
    278          
    279          	*(io->Vs_Max_Filt) = params->Max_Available_Voltage_Factor * *(io->Vs_Max_Filt);
    280          
    281          
    282              // every 25 ms, the temporary minimum is reset
    283              prescaler_25ms--;
    284              if(!prescaler_25ms)
    285              {
    286                  prescaler_25ms = (uint8)(MCL_INPUT_1MS_CALL_RATE_HZ/40.0f);
    287          
    288                  // This is to bring up the Dc_Bus_Pu_Min because in AtodISR it only get reduced.
    289                  // dcbus_pu_min_target is reset periodically.
    290                  if(DC_Bus_Min < DC_Bus_Min_temp)
    291                  {
    292                      DC_Bus_Min = DC_Bus_Min_temp;
    293                  }
    294          
    295                  //Reset dcbus_pu_min_target. Bring it up. It get reduced at AtodISR.
    296                  DC_Bus_Min_temp = *(io->Vdc);
    297              }
    298          
    299          
    300              // Look for the minimum value
    301              if(*(io->Vdc) < DC_Bus_Min)
    302              {
    303                  DC_Bus_Min = *(io->Vdc);
    304              }
    305              if(*(io->Vdc) < DC_Bus_Min_temp)
    306              {
    307                  DC_Bus_Min_temp = *(io->Vdc);
    308              }
    309          #endif
    310          #if (INPUTPROC__VDC_RMS == ENABLED)
    311          
    312              Vdc = *(io->Vdc);
    313              DC_Bus_RMS_Sum += (Vdc * Vdc);
    314          
    315              // every 80 samples we update the RMS (8000Hz / 100Hz = 80)
    316              window_avg--;
    317              if(!window_avg)
    318              {
    319                  window_avg = 80;
    320                  DC_Bus_RMS = MC_SQRT_F(0.0125f * DC_Bus_RMS_Sum);  // RMS calculation
    321                  DC_Bus_RMS_Sum = 0.0f;
    322              }
    323          #endif
    324          
    325          }
