   \                                 In section .text, align 2, keep-with-next
     53          void PowerModuleManager__25msHandler(void)
     54          {
     55              uint32 temperature;
     56              uint32 current_rms;
     57              BOOL_TYPE low_power_mode;
     58          
     59          
     60              if (PowerModuleMgr_Temp_Params_Loaded == TRUE && POWERMODULEMGR__IS_MOTOR_RUNNING())
     61              {
     62                  // sample the temperature
     63                  temperature = POWERMODULEMGR__GET_INVERTER_TEMP();
     64                  // sample the current
     65                  current_rms = POWERMODULEMGR__GET_I_RMS_S16();
     66          
     67                  low_power_mode = POWERMODULEMGR__IS_LOW_POWER();
     68                  if (low_power_mode)
     69                  {
     70                      // Low power request - turn off
     71                      if (current_rms < POWERMODULEMGR_I_RMS_THR_LOW_S16)
     72                      {
     73                          if (Pm_Mgr_Modulation_Time <= 0)
     74                          {
     75                              if (temperature < POWERMODULEMGR_INV_TEMP_THR_LOW)
     76                              {
     77                                  // switch off request
     78                                  low_power_mode = FALSE;
     79                              }
     80                          }
     81                          else
     82                          {
     83                              Pm_Mgr_Modulation_Time--;
     84                          }
     85                      }
     86                      else
     87                      {
     88                          Pm_Mgr_Modulation_Time = POWERMODULEMGR_MODULATION_WINDOW;
     89                      }
     90                  }
     91                  else
     92                  {
     93                      if (temperature > POWERMODULEMGR_INV_TEMP_THR_HIGH)
     94                      {
     95                          // switch on request
     96                          low_power_mode = TRUE;
     97                      }
     98                      else
     99                      {
    100                          if (current_rms > POWERMODULEMGR_I_RMS_THR_HIGH_S16)
    101                          {
    102                              if (Pm_Mgr_Modulation_Time >= POWERMODULEMGR_MODULATION_WINDOW)
    103                              {
    104                                  // switch on request
    105                                  low_power_mode = TRUE;
    106                                  Pm_Mgr_Modulation_Time = POWERMODULEMGR_MODULATION_WINDOW;
    107                              }
    108                              else
    109                              {
    110                                  Pm_Mgr_Modulation_Time++;
    111                              }
    112                          }
    113                          else
    114                          {
    115                              Pm_Mgr_Modulation_Time = 0;
    116                          }
    117                      }
    118                  }
    119          
    120                  // Enable only after steady state
    121                  if (low_power_mode == TRUE && POWERMODULEMGR__IS_STABLE())
    122                  {
    123                      POWERMODULEMGR__ENTER_LOW_POWER();
    124                  }
    125                  else
    126                  {
    127                      POWERMODULEMGR__EXIT_LOW_POWER();
    128                  }
    129              }
    130          }
