    444          /**
    445           * @brief This method returns the index in the API info table about a specific API id.
    446           * @param api define which API is been searched.
    447           * @return index in the API info table related to the searched API id, if the API is not found it returst 0xFF.
    448           */
    449          static uint8 GetAPIIndex(uint8 api)
    450          {
    451              uint8 count;
    452              uint8 index;
    453              index = 0xFF;
    454          
    455              for (count=0; count<API003_NUM_APIS_REG; count++)
    456              {
    457                  if (API003_APIS[count].id == api)
    458                  {
    459                      index = count;
    460                      break;
    461                  }
    462              }
    463              return (index);
    464          
    465          }
