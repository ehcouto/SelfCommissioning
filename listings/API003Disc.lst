    429          /**
    430           * @brief This method publishes the message relate to being an REVEAL node along with the password
    431           */
    432          static void PublishRevealNodes(void)
    433          {
    434              REVEAL_COMMAND_TYPE * ptr;
    435              ptr = Reveal__NewFeedback(API003DISC_NUM,API003_OP_PUB_REVEAL_NODES,REVEAL_BROADCAST_NODE,2);
