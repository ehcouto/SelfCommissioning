    654          
    655          
    656          //---------------------------------------------------------------------------------------------------------------------
    657          /**
    658           *  @brief  Performs current control
    659           */
    660          void DC_Current_Injection_Control(void)
    661          {
    662              DQ_COOR_SYST_F_TYPE manual_dq;
    663          
    664              // Input Processing Handler
    665              MclInputProc__RunningHandler(&Mcl_Input_Proc_IO,&MclInput_Params);
    666          
    667              // Zero the forced voltage, this allows the controller to proper
    668              // generate the voltage references
    669              Mcl_DQ_Ctrl_IO.Force_Out_Volt->D = 0.0f;
    670              Mcl_DQ_Ctrl_IO.Force_Out_Volt->Q = 0.0f;
    671          
    672              // Handle the voltage target increase
    673              if(MclFvt_Injection_Inst_Level < MclFvt_Injection_Level)
    674              {
    675                  MclFvt_Injection_Inst_Level += MclFvt_Injection_Level_Rate;
    676              }
    677              else if(MclFvt_Injection_Inst_Level > MclFvt_Injection_Level)
    678              {
    679                  MclFvt_Injection_Inst_Level -= MclFvt_Injection_Level_Rate;
    680          
    681                  if(MclFvt_Injection_Inst_Level <= 0)
    682                  {
    683                      MclFvt_Injection_Inst_Level = 0.0f;
    684                  }
    685              }
    686              else
    687              {
    688                  MclFvt_Injection_Inst_Level = MclFvt_Injection_Level;
    689              }
    690          
    691          
    692              MathCalc__SinCosF(MclFvt_Injection_Position, Mcl_DQ_Ctrl_IO.Sin_Cos);
    693          
    694              manual_dq.ZeroSequence = 0.0f;
    695          
    696              ClrkPark__DirectParkF(Mcl_Input_Proc_IO.Is_Alpha_Beta, &manual_dq, Mcl_DQ_Ctrl_IO.Sin_Cos);
    697          
    698              *Mcl_DQ_Ctrl_IO.D_Ref = 0.0f;
    699              *Mcl_DQ_Ctrl_IO.D_Est = manual_dq.D;
    700          
    701              *Mcl_DQ_Ctrl_IO.Q_Ref = MclFvt_Injection_Inst_Level;
    702              *Mcl_DQ_Ctrl_IO.Q_Est = manual_dq.Q;
    703          
    704              MclDqCtrl__OverrideRegGains(&Mcl_Params_Displ1->Manual_Injection);
    705              // Dq controllers Handler
    706              MclDqCtrl__RunningHandler(&Mcl_DQ_Ctrl_IO, &Mcl_Params_Displ1->Manual_Injection);
    707          
    708              // Pwm Handler
    709              MclPwm__RunningHandler(&Mcl_Pwm_IO, &MclPwm_Params);
    710          }
    711          
    712          
    713          
    714          
    715          //---------------------------------------------------------------------------------------------------------------------
    716          /**
    717           *  @brief  Check if signal of Over Current (OC) hardware is triggered
    718           */
    719          uint8 Polls_Hw_OC(void)
    720          {
    721          #if (defined MCI_HW_OC_DEBOUNCE_TIME) && (defined MCI_HW_OC_PORT) && (defined MCI_HW_OC_PIN) && (defined MCI_HW_OC_LEVEL)
    722              static uint8 hw_oc_debouncer = (uint8)(MCI_HW_OC_DEBOUNCE_TIME/0.005f);
    723              uint8 hw_pin_in;
    724          #endif
    725          
    726              uint8 temp_u8;
    727          
    728              //////////////////////////////////////////////////////////////////////////////////////////
    729              // DC Bus (over) current monitor
    730              temp_u8 = MotorSafetyMgr__GetFault(SR_FAULT_OVER_CURRENT);
    731          
    732          #if (defined MCI_HW_OC_DEBOUNCE_TIME) && (defined MCI_HW_OC_PORT) && (defined MCI_HW_OC_PIN) && (defined MCI_HW_OC_LEVEL)
    733          
    734              // Refresh input config
    735              Gpio__PinConfig(MCI_HW_OC_PORT, MCI_HW_OC_PIN, INPUT_FLOAT);
    736          
    737              // Read input oc pin
    738              hw_pin_in = Gpio__PinRead(MCI_HW_OC_PORT, MCI_HW_OC_PIN);
    739          
    740              // Debounce oc pin, if the failure is found
    741              if(hw_pin_in == MCI_HW_OC_LEVEL)
    742              {
    743                  // count up the time
    744                  if(hw_oc_debouncer < (uint8)(MCI_HW_OC_DEBOUNCE_TIME/0.005f))
    745                  {
    746                      hw_oc_debouncer++;
    747                  }
    748                  else
    749                  {
    750                      temp_u8 = TRUE;
    751                  }
    752              }
    753              else
    754              {
    755                  // count down the time
    756                  if(hw_oc_debouncer)
    757                  {
    758                      hw_oc_debouncer--;
    759                  }
    760              }
    761          
