    756              /*
    757              Ton Duration Formulas, Ts is Pwm Switching Period:
    758              T_low_on = T0/2 = (Ts-T1-T2)/2;
    759              T_mid_on = T0/2 + T2 = Tlow_on + T2;
    760              T_high_on = T0/2 + T1 + T2 = T_mid_on + T1;
