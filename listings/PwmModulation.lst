    168          
    169          
    170          /**
    171           *  @brief      Space vector modulation (improved version, including not saturated ripple compensation and limitations).
    172           *  @details
    173           *
    174           * This function calculates the space vector modulation of the alpha/beta input
    175           * into the a,b,c output. The calculation is the following:
    176           *
    177           *
    178           * Ripple compensation function equations.
    179           *
    180           *  Implemented equations:
    181           *   \f[
    182           *      \begin{aligned}
    183           *         & V_{\alpha-comp}' = \frac{V_{\alpha}'}{V_{dc}'} = \frac{V_{\alpha}}{V_{dc}}\cdot\sqrt{3} \\
    184           *         & V_{\beta-comp}' = \frac{V_{\beta}'}{V_{dc}'} = \frac{V_{\beta}}{V_{dc}}\cdot\sqrt{3} \\
    185           *      \end{aligned}
    186           *    \f]
    187           *
    188           * where
    189           *
    190           * \f$ V_{dc}' \f$: DC bus voltage in Q17.15 notation
    191           *
    192           * \f$ V_{dc} \f$: DC bus voltage [physical value]
    193           *
    194           * \f$ V_{\alpha}' \f$: motor voltage reference on Alpha-axis in Q17.15 notation
    195           *
    196           * \f$ V_{\beta}' \f$: motor voltage reference on Beta-axis in Q17.15 notation
    197           *
    198           * \f$ V_{\alpha} \f$: motor voltage reference on Alpha-axis [physical value]
    199           *
    200           * \f$ V_{\beta} \f$: motor voltage reference on Beta-axis [physical value]
    201           *
    202           * \f$ V_{\alpha-comp}' \f$: motor voltage reference compensated on Alpha-axis in Q17.15 notation
    203           *
    204           * \f$ V_{\beta-comp}' \f$: motor voltage reference compensated on Beta-axis in Q17.15 notation
    205           *
    206           *
    207           * The algorithm is scaled into the fractional arithmetic
    208           * There are two different scaling ranges:
    209           *   - one for DC Bus voltage           ->    BASE_BUS_VOLTAGE
    210           *   - second for motor phase voltage   ->    BASE_VOLTAGE
    211           *
    212           * Relation between two scales mentioned above is the following:
    213           *
    214           * BASE_VOLTAGE = BASE_BUS_VOLTAGE / sqrt(3)
    215           *
    216           *
    217           *  Space Vector Modulation Algorithm
    218           *
    219           *  <b>1 - X, Y, Z calculation:</b>
    220           *
    221           *   Original requirement for X, Y, Z:
    222           *
    223           *   \f[
    224           *      \begin{aligned}
    225           *
    226           *          & X = \sqrt{3} \cdot \frac{V_{\beta}}{V_{dc}}\\
    227           *          & Y = \frac{\sqrt{3}}{2}\cdot\frac{(\sqrt{3} \cdot V_{\alpha} + V_{\beta})}{V_{dc}}\\
    228           *          & Z = \frac{\sqrt{3}}{2}\cdot\frac{(-\sqrt{3} \cdot V_{\alpha} + V_{\beta})}{V_{dc}}\\
    229           *      \end{aligned}
    230           *    \f]
    231           *
    232           *   The Sqrt(3) is not used in the calculation because the compensated voltages are used.
    233           *   So the modified equation used for X, Y, Z are:
    234           *
    235           *   \f[
    236           *      \begin{aligned}
    237           *          & X = V_{\beta-comp}\\
    238           *          & Y = \frac{\sqrt{3}}{2}\cdot V_{\alpha-comp} + \frac{1}{2}\cdot V_{\beta-comp}\\
    239           *          & Z = \frac{-\sqrt{3}}{2}\cdot V_{\alpha-comp} + \frac{1}{2}\cdot V_{\beta-comp}\\
    240           *      \end{aligned}
    241           *    \f]
    242           *  \n
    243           *
    244           *  <b>2 - SECTOR IDENTIFICATION:</b>
    245           *
    246           *   Sector 1: X >= 0 and Y > 0 and Z <= 0 \n
    247           *   Sector 2: X >= 0 and Y > 0 and Z > 0 \n
    248           *   Sector 3: X >= 0 and Y <= 0 and Z > 0 \n
    249           *   Sector 4: X < 0 and Z > 0 \n
    250           *   Sector 5: X < 0 and Y <= 0 and Z <= 0 \n
    251           *   Sector 6: X < 0 and Y > 0 and Z <= 0 \n
    252           *   Sector 7: X >= 0 and Y <=0 and Z <=0 => Sector 6 \n \n
    253           *
    254           *
    255           *  <b>3 - T1, T2 calculation:</b>
    256           *
    257           *   Sector 1: T1 = X, T2 = -Z \n
    258           *   Sector 2: T1 = Y, T2 = Z \n
    259           *   Sector 3: T1 = -Y, T2 = X \n
    260           *   Sector 4: T1 = Z, T2 = -X \n
    261           *   Sector 5: T1 = -Z, T2 = -Y \n
    262           *   Sector 6: T1 = -X, T2 = Y \n \n
    263           *
    264           *
    265           *
    266           *  <b>4 - T1, T2 Limitation:</b>
    267           *
    268           *   \f[
    269           *      \begin{aligned}
    270           *         &if \quad T1 + T2 >= 1  \quad then  \quad T1=\frac{T1}{(T1 + T2)}  \quad and \quad T2=\frac{T2}{(T1 + T2)}
    271           *      \end{aligned}
    272           *    \f]
    273           *
    274           *  <b>5 - Duty cycles T0_on, T1_on and T2_on calculation:</b>
    275           *
    276           *   Original equations are:
    277           *
    278           *   \f[
    279           *      \begin{aligned}
    280           *         &T0_{on} =\frac{1-T1-T2}{2}=\frac{1}{2} -\frac{T1+T2}{2}\\
    281           *         &T1_{on} =T0_{on}+T1 = \frac{1}{2} +\frac{T1-T2}{2}\\
    282           *         &T2_{on} =T1_{on}+T2 = \frac{1}{2} +\frac{T1+T2}{2}\\
    283           *      \end{aligned}
    284           *    \f]
    285           *
    286           *   As As mentioned in (1) the X, Y, Z equations are not multiplied by Sqrt(3) therefore
    287           *   the equations must be modified like this:
    288           *
    289           *   \f[
    290           *      \begin{aligned}
    291           *         &T0_{on} =\frac{1}{2} -\frac{\sqrt{3}}{2}\cdot(T1 + T2)\\
    292           *         &T1_{on} =\frac{1}{2} +\frac{\sqrt{3}}{2}\cdot(T1 - T2)\\
    293           *         &T2_{on} =\frac{1}{2} +\frac{\sqrt{3}}{2}\cdot(T1 + T2)\\
    294           *      \end{aligned}
    295           *    \f]
    296           *
    297           *   \n
    298           *
    299           *  <b>6 - Saturation:</b>
    300           *
    301           *   To avoid extremly small duty cycle (thanks to current measurement) it is necessary
    302           *   to assure the T1_on and T2_on values to be greater than the minimum value.
    303           *
    304           *   if T1_on < MIN_DUTY_CYCLE then T1_on = MIN_DUTY_CYCLE \n
    305           *   if T2_on < MIN_DUTY_CYCLE then T2_on = MIN_DUTY_CYCLE \n
    306           *
    307           *   \n
    308           *
    309           *  <b>7 - a, b, c assignment:</b>
    310           *
    311           *   Sector 1: PhaseA = T2_on, PhaseB = T1_on, PhaseC = T0_on \n
    312           *   Sector 2: PhaseA = T1_on, PhaseB = T2_on, PhaseC = T0_on \n
    313           *   Sector 3: PhaseA = T0_on, PhaseB = T2_on, PhaseC = T1_on \n
    314           *   Sector 4: PhaseA = T0_on, PhaseB = T1_on, PhaseC = T2_on \n
    315           *   Sector 5: PhaseA = T1_on, PhaseB = T0_on, PhaseC = T2_on \n
    316           *   Sector 6: PhaseA = T2_on, PhaseB = T0_on, PhaseC = T1_on \n
    317           *
    318           *   \n
    319           *
    320           *
    321           *  @param[in]      v_dc              = DC bus voltage in Q17.15 notation
    322           *  @param[in]      v_alphabeta_in    = motor compensated voltage alpha-beta components
    323           *  @param[out]     duty_out          = PWM duties in abc components
    324           *  @param[in]      duty_cycle_limit  = duty cycle limitation
    325           *  @return         sector_3rd_current = current to be reconstructed
    326           */

