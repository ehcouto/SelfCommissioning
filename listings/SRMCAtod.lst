    916          /**
    917           *  @brief      This function enables conversion interruption for selected engine.
    918           *
    919           *  @param[in]  engine Selected engine may be AD_ENGINE_0 or AD_ENGINE_1
    920           *
    921           */
    922          static void EnableEndOfConversionInteruption(SRMCATOD_CONVERTER_TYPE engine)
    923          {
    924              if (engine == SR_AD_ENGINE_0)
    925              {
    926              	Micro__NVICEnableIRQ(ADC0_IRQ_CHANNEL, SRMCATOD_INTERRUPT_ADC_PREEMPTION_PRIORITY,SRMCATOD_ADC_INTERRUPT_SUB_PRIORITY);
    927              }
    928              else if (engine == SR_AD_ENGINE_1)
    929              {
    930              	Micro__NVICEnableIRQ(ADC1_IRQ_CHANNEL, SRMCATOD_INTERRUPT_ADC_PREEMPTION_PRIORITY,SRMCATOD_ADC_INTERRUPT_SUB_PRIORITY);
    931              }
    932          }
    933          
    934          /**
    935           *  @brief      This function disables conversion interruption for selected engine.
    936           *
    937           *  @param      engine Selected engine may be AD_ENGINE_0 or AD_ENGINE_1
    938           *
    939           */
    940          static void DisableEndOfConversionInteruption(SRMCATOD_CONVERTER_TYPE engine)
    941          {
    942              if (engine == SR_AD_ENGINE_0)
    943              {
    944              	Micro__NVICDisableIRQ(ADC0_IRQ_CHANNEL);			// Disables ADC0 interruption during configuration
    945              }
    946              else if (engine == SR_AD_ENGINE_1)
    947              {
    948              	Micro__NVICDisableIRQ(ADC1_IRQ_CHANNEL);			// Disables ADC0 interruption during configuration
    949              }
    950          }
