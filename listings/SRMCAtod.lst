    790              ADC1.ADC_CFG1 = ADC_CFG1_ADIV(SRMCATOD_ADC1_CLOCK_DIVIDE_SEL)
    791              				| ADC_CFG1_ADICLK(SRMCATOD_ADC1_CLK_INPUT)
    792          					| ADC_CFG1_MODE(SRMCATOD_ADC1_RES_MODE);
