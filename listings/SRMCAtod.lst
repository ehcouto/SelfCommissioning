    872          /**
    873           *  @brief      PDB0 peripheral initialization
    874           *
    875           */
    876          static void SRInitializePDB0(void)
    877          {
    878              // PDB configuration
    879          	SIM.SCGC6 |= SIM_SCGC6_PDB_MASK;				// Enables PDB clock
    880          
    881          	Micro__NVICDisableIRQ(PDB_IRQ_CHANNEL);
    882          
    883          	PDB.MOD = SRMCATOD_PDB_MODULUS_RELOAD & 0xFFFF;			// Specifies counter duration. When the counter reaches this value, it will be reset back to zero (16 bits  read/write).
    884          
    885          	PDB.CH[0].DLY[0] = SRMCATOD_PDB_DELAY_FIRST_CONVERSION;	// Defines a delay to avoid ringing noise in respect to center aligned PWM reload trigger event
    886          	PDB.CH[1].DLY[0] = SRMCATOD_PDB_DELAY_FIRST_CONVERSION; // Defines a delay to avoid ringing noise in respect to center aligned PWM reload trigger event
    887          
    888          
    889          	PDB.CH[0].C1 = PDB_C1_BB(SRMCATOD_PDB_PRE_TRIGGER_CHN_1) // back-to-back mode enabled
    890          			| PDB_C1_TOS(SRMCATOD_PDB_PRE_TRIGGER_CHN_0)
    891          			| PDB_C1_EN(SRMCATOD_PDB_PRE_TRIGGER_CHN_0)
    892          			| PDB_C1_TOS(SRMCATOD_PDB_PRE_TRIGGER_CHN_1)
    893          			| PDB_C1_EN(SRMCATOD_PDB_PRE_TRIGGER_CHN_1);
    894          
    895          	PDB.CH[1].C1 = PDB_C1_BB(SRMCATOD_PDB_PRE_TRIGGER_CHN_1) // back-to-back mode enabled
    896          			| PDB_C1_TOS(SRMCATOD_PDB_PRE_TRIGGER_CHN_0)
    897          			| PDB_C1_EN(SRMCATOD_PDB_PRE_TRIGGER_CHN_0)
    898          			| PDB_C1_TOS(SRMCATOD_PDB_PRE_TRIGGER_CHN_1)
    899          			| PDB_C1_EN(SRMCATOD_PDB_PRE_TRIGGER_CHN_1);
    900          
    901          	PDB.SC = 		PDB_SC_LDMOD(SRMCATOD_PDB_LD_MOD_SETTING)	// Configures PDB to load after trigger event and LDOK set
    902          			| PDB_SC_PRESCALER(SRMCATOD_PDB_PRESCALER_SETTING)
    903          			| PDB_SC_TRGSEL(SRMCATOD_PDB_TRIGGER_SEL)
    904          			| PDB_SC_MULT(SRMCATOD_PDB_MULT_PRESCALER)
    905          			| PDB_SC_PDBEIE_MASK					// Enables interruption error
    906          			| PDB_SC_PDBEN_MASK;       				// PDB enabled
    907          
    908          	PDB.SC |= PDB_SC_LDOK_MASK;						// PDB load OK
    909          
    910          	Micro__NVICEnableIRQ(PDB_IRQ_CHANNEL, SRMCATOD_INTERRUPT_PDB0_PREEMPTION_PRIORITY,SRMCATOD_PDB0_INTERRUPT_SUB_PRIORITY);
    911          	/* switch the trigger of the ADC to PDB */
    912          	SIM.SOPT7 = 0;
    913          }
