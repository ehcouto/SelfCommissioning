    804          
    805          /**
    806           *  @brief      ADC self calibration procedure start
    807           *
    808           *  @details    Recommended on AN3949 to operate with ADC clock between 2MHz and 4MHz, in high speed mode and 32 samples averaged.
    809           *              Calibration should be run with both VDDA and VREFH at or above 3V.
    810           *              The input channel, conversion mode setting, compare function values, resolution, and differential and single-ended
    811           *              settings have no effect on the calibration result.
    812           *              Software trigger selected: ADCx_SC2 bit ADTRG must be cleared before calibration.
    813           *              Disable interruptions during calibration.
    814           *              Calibration must be performed at least every reset.
    815           *              For single ended calibrations, minus side gain register can be skipped.
    816           *              Calibration may take as long as 15,000 ADCK cycles + 100 bus cycles
    817           *
    818           */
    819          static void SRCalibrateAD1(void)
    820          {
    821              uint16 calib;
    822          	// setting the clock to 7 MHz (ADIV and ADICLK bits), long sample time and single-ended 12-bit conversion (MODE bits);
    823          	ADC1.ADC_CFG1 = ADC_CFG1_ADIV(SRMCATOD_ADC1_CAL_CLOCK_DIVIDE_SEL)
    824          					| ADC_CFG1_MODE(SRMCATOD_ADC1_RES_MODE)
    825          					| ADC_CFG1_ADICLK(SRMCATOD_ADC1_CLK_INPUT)
    826          					| ADC_CFG1_ADLSMP_MASK;
    827          
    828          	ADC1.ADC_CFG2 = ADC_CFG2_ADHSC_MASK;            // High speed configuration with longest sampling time(20 extra ADCK cycles, 24 total)
    829          
    830          	ADC1.ADC_SC2 = 0;                               // Software trigger selected
    831          
    832          	// HW averaging enabled, 32 samples averaged, one shot conversion mode
    833          	ADC1.ADC_SC3 = ADC_SC3_AVGE_MASK | ADC_SC3_AVGS(SRMCATOD_ADC1_CAL_HW_AVG_SEL);// | ADC_SC3_ADCO_MASK;
    834          
    835          	// starting the calibration of ADC1
    836          	ADC1.ADC_SC3 |= ADC_SC3_CAL_MASK;
    837          
    838          	do
    839          	{
    840          		// waits until the calibration completes
    841          		if ((ADC1.ADC_SC3 & ADC_SC3_CALF_MASK ) == ADC_SC3_CALF_MASK)
    842          		{
    843          			Micro__Trap();								// traps in here in case calibration failed, waiting for the watchdog (must be enabled before calling this configuration)
    844          		}
    845          		SERVICE_WATCHDOG();
    846          		
    847          	} while (((ADC1.ADC_SC1[0] & ADC_SC1_COCO_MASK) != ADC_SC1_COCO_MASK));
    848          
    849          	calib = 0;										//16 bit RAM initialized
    850          	calib += ADC1.ADC_CLP0;
    851          	calib += ADC1.ADC_CLP1;
    852          	calib += ADC1.ADC_CLP2;
    853          	calib += ADC1.ADC_CLP3;
    854          	calib += ADC1.ADC_CLP4;
    855          	calib += ADC1.ADC_CLPS;							// Calibration results added
    856          	calib = calib >> 1;								// Divided by 2
    857          	calib = calib | 0x8000; 						// set the MSB (2's complement)
    858          	ADC1.ADC_PG = calib; 							// Plus side gain register updated
    859          	// Minus side gain register updated (not required for single ended calibrations)
    860          	calib = 0;										//16 bit RAM initialized again, just in case
    861          	calib += ADC1.ADC_CLM0;
    862          	calib += ADC1.ADC_CLM1;
    863          	calib += ADC1.ADC_CLM2;
    864          	calib += ADC1.ADC_CLM3;
    865          	calib += ADC1.ADC_CLM4;
    866          	calib += ADC1.ADC_CLMS;                         // Calibration results added
    867          	calib = calib >> 1;                             // Divided by 2
    868          	calib = calib | 0x8000;                         // set the MSB (2's complement)
    869          	ADC1.ADC_MG = calib;                            // Minus side gain register updated
    870          }
