    653          /**
    654           *  @brief      ADC self calibration procedure start
    655           *
    656           *  @details    Recommended on AN3949 to operate with ADC clock between 2MHz and 4MHz, in high speed mode and 32 samples averaged.
    657           *              Calibration should be run with both VDDA and VREFH at or above 3V.
    658           *              The input channel, conversion mode setting, compare function values, resolution, and differential and single-ended
    659           *              settings have no effect on the calibration result.
    660           *              Software trigger selected: ADCx_SC2 bit ADTRG must be cleared before calibration.
    661           *              Disable interruptions during calibration.
    662           *              Calibration must be performed at least every reset.
    663           *              For single ended calibrations, minus side gain register can be skipped.
    664           *              Calibration may take as long as 15,000 ADCK cycles + 100 bus cycles
    665           *
    666           */
    667          static void SRCalibrateAD0(void)
    668          {
    669              uint16 calib;
    670          	// setting the clock to 7 MHz (ADIV and ADICLK bits), long sample time and single-ended 12-bit conversion (MODE bits);
    671          	ADC0.ADC_CFG1 = ADC_CFG1_ADIV(SRMCATOD_ADC0_CAL_CLOCK_DIVIDE_SEL)
    672          					| ADC_CFG1_MODE(SRMCATOD_ADC0_RES_MODE)
    673          					| ADC_CFG1_ADICLK(SRMCATOD_ADC0_CLK_INPUT)
    674          					| ADC_CFG1_ADLSMP_MASK;
    675          
    676          	ADC0.ADC_CFG2 = ADC_CFG2_ADHSC_MASK;			// High speed configuration with longest sampling time(20 extra ADCK cycles, 24 total)
    677          
    678          	ADC0.ADC_SC2 = 0;								// Software trigger selected
    679          
    680          	// HW averaging enabled, 32 samples averaged, one shot conversion mode
    681          	ADC0.ADC_SC3 = ADC_SC3_AVGE_MASK
    682          					| ADC_SC3_AVGS(SRMCATOD_ADC1_CAL_HW_AVG_SEL);
    683          
    684          	// starting the calibration of ADC0
    685          	ADC0.ADC_SC3 |= ADC_SC3_CAL_MASK;
    686          	do
    687          	{
    688          		// waits until the calibration completes
    689          		if(( ADC0.ADC_SC3 & ADC_SC3_CALF_MASK ) == ADC_SC3_CALF_MASK)
    690          		{
    691          			Micro__Trap();						    // traps in here in case calibration failed, waiting for the watchdog (must be enabled before calling this configuration)
    692          		}
    693          		SERVICE_WATCHDOG();
    694          		
    695          	} while (((ADC0.ADC_SC1[0] & ADC_SC1_COCO_MASK) != ADC_SC1_COCO_MASK));
    696          
    697          	calib = 0;										//16 bit RAM initialized
    698          	calib += ADC0.ADC_CLP0;
    699          	calib += ADC0.ADC_CLP1;
    700          	calib += ADC0.ADC_CLP2;
    701          	calib += ADC0.ADC_CLP3;
    702          	calib += ADC0.ADC_CLP4;
    703          	calib += ADC0.ADC_CLPS;							// Calibration results added
    704          	calib = calib >> 1;								// Divided by 2
    705          	calib = calib | 0x8000; 						// set the MSB (2's complement)
    706          	ADC0.ADC_PG = calib; 							// Plus side gain register updated
    707          	// Minus side gain register updated (not required for single ended calibrations)
    708          	calib = 0;										//16 bit RAM initialized again, just in case
    709          	calib += ADC0.ADC_CLM0;
    710          	calib += ADC0.ADC_CLM1;
    711          	calib += ADC0.ADC_CLM2;
    712          	calib += ADC0.ADC_CLM3;
    713          	calib += ADC0.ADC_CLM4;
    714          	calib += ADC0.ADC_CLMS;                         // Calibration results added
    715          	calib = calib >> 1;                             // Divided by 2
    716          	calib = calib | 0x8000;                         // set the MSB (2's complement)
    717          	ADC0.ADC_MG = calib;                            // Minus side gain register updated
    718          }
