    953          /**
    954           *  @brief      Enable self diagnostic mode
    955           *
    956           *  @details    This function is used to enable/disable self check hardware for converter and register integrity.
    957           *              Drives to VREFH0, (VREFH0 x 1/2) and (VREFH0 x 0)
    958           *
    959           *  @param[in]  engine Defines which converter will be configured: AD_ENGINE_0 or AD_ENGINE_1
    960           *  @param[in]  mode Defines configuration mode:
    961           *              SELF_TEST_DISABLED,SELF_TEST_VREFH0_SCALE_0,SELF_TEST_VREFH0_SCALE_0_5,SELF_TEST_VREFH0_SCALE_1, AUTOMATED_SELF_TEST
    962           *
    963           */
    964          static void SREnableSelfDiagMode(SRMCATOD_CONVERTER_TYPE engine, SRMCATOD_DIAG_CONFIG_TYPE mode)
    965          {
    966          	if (engine == SR_AD_ENGINE_0)                  	// Configuration for S12AD0
    967          	{
    968          		switch (mode)                            	// Mode for self check
    969          		{
    970          			case SR_MCATOD_SELF_TEST_DISABLED:
    971          
    972          				ADC0.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC0_FIRST_SAMPLE_CHN);
    973          				ADC0.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC0_SECOND_SAMPLE_CHN);
    974          				break;
    975          
    976          			case SR_MCATOD_SELF_TEST_VREFH0_SCALE_0:
    977          				ADC0.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_LOW);
    978          				ADC0.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_LOW);
    979          
    980          				break;
    981          
    982          			case SR_MCATOD_SELF_TEST_VREFH0_SCALE_0_5:
    983          
    984          				ADC0.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC0_VREF_INTERMEDIATE);
    985          				ADC0.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC0_VREF_INTERMEDIATE);
    986          				break;
    987          
    988          			case SR_MCATOD_SELF_TEST_VREFH0_SCALE_1:
    989          
    990          				ADC0.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_HIGH);
    991          				ADC0.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_HIGH);
    992          				break;
    993          
    994          			case SR_MCATOD_AUTOMATED_SELF_TEST:
    995          
    996          				SRInitializeAD0();					// Performs self calibration routine and initializes converter configuration
    997          				break;
    998          
    999          			default:                                // In case it's not properly defined
   1000          
   1001          				SRInitializeAD0();					// Initializes converter configuration
   1002          				break;
   1003          		}
   1004          	}                                               // Uploads mirror data
   1005          	else if (engine == SR_AD_ENGINE_1)             	// Configuration for S12AD0
   1006          	{
   1007          		switch (mode)                               // Mode for self check
   1008          		{
   1009          			case SR_MCATOD_SELF_TEST_DISABLED:
   1010          
   1011          			    ADC1.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC1_FIRST_SAMPLE_CHN);
   1012          			    ADC1.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC1_SECOND_SAMPLE_CHN) | ADC_SC1_AIEN_MASK;
   1013          				break;
   1014          
   1015          			case SR_MCATOD_SELF_TEST_VREFH0_SCALE_0:
   1016          
   1017          				ADC1.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_LOW);
   1018          				ADC1.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_LOW) | ADC_SC1_AIEN_MASK;
   1019          				break;
   1020          
   1021          			case SR_MCATOD_SELF_TEST_VREFH0_SCALE_0_5:
   1022          
   1023          				ADC1.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC1_VREF_INTERMEDIATE);
   1024          				ADC1.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC1_VREF_INTERMEDIATE) | ADC_SC1_AIEN_MASK;
   1025          				break;
   1026          
   1027          			case SR_MCATOD_SELF_TEST_VREFH0_SCALE_1:
   1028          
   1029          				ADC1.ADC_SC1[0] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_HIGH);
   1030          				ADC1.ADC_SC1[1] = ADC_SC1_ADCH(SRMCATOD_ADC_VREF_HIGH) | ADC_SC1_AIEN_MASK;
   1031          				break;
   1032          
   1033          			case SR_MCATOD_AUTOMATED_SELF_TEST:
   1034          
   1035          				SRInitializeAD1();					// Performs self calibration routine and initializes converter configuration
   1036          				break;
   1037          
   1038          			default:                                // In case it's not properly defined
   1039          
   1040          				SRInitializeAD1();					// Performs self calibration routine and initializes converter configuration
   1041          				break;
   1042          		}
   1043              }
   1044          }
   1045          
   1046          /**
   1047           *  @brief      Detect if the peripheral is in safe status
   1048           *
   1049           *  @details    This function is used to check register and converter status.
   1050           *              May be used to test stuck at register failure and conversion errors.
   1051           *
   1052           *  @param[in]  engine defines which engine will be tested
   1053           *  @param[in]  threshold allows adjustable error for 1/2 VREFH0 conversion
   1054           *  @param[in]  mode The test mode that we need to check:
   1055           *              SELF_TEST_DISABLED,SELF_TEST_VREFH0_SCALE_0,SELF_TEST_VREFH0_SCALE_0_5,SELF_TEST_VREFH0_SCALE_1, AUTOMATED_SELF_TEST
   1056           *
   1057           *  @return     returns if peripheral test result TEST_NOT_PERFORMED, REGISTER_BIT_STUCK_AT_0,
   1058           *              REGISTER_BIT_STUCK_AT_1, CONVERTER_ERROR or PERIPHERAL_SAFE
   1059           */
   1060          static SRMCATOD_DIAG_ERROR_TYPE IsConverterSafe(SRMCATOD_CONVERTER_TYPE engine,sint16 local_threshold, SRMCATOD_DIAG_CONFIG_TYPE mode)
   1061          {
   1062              SRMCATOD_DIAG_ERROR_TYPE status;                // returns test result
   1063              sint16 temp;                        	// Gets converted result for check
   1064              sint16 temp_a;                        // Gets converted result for check
   1065              sint16 temp_b;                        // Gets converted result for check
   1066          
   1067              temp_a = 0;
   1068              temp_b = 0;
   1069          
   1070              if (engine == SR_AD_ENGINE_0)                   // Configuration for testing ADC0
   1071              {
   1072                  // Get data
   1073              	temp_a = SRMCATOD__ADC0_RA();
   1074              	temp_b = SRMCATOD__ADC0_RB();
   1075              }
   1076              else if (engine == SR_AD_ENGINE_1)              // Configuration for testing ADC1
   1077              {
   1078                  // Get data
   1079              	temp_a = SRMCATOD__ADC1_RA();
   1080              	temp_b = SRMCATOD__ADC1_RB();
   1081              }
   1082              switch (mode)                                   // Now it's all set for checking data according to test mode
   1083              {
   1084                  case SR_MCATOD_SELF_TEST_DISABLED:                 // If it wasn't tested
   1085                      status = SR_MCATOD_ERROR_TEST_NOT_PERFORMED;         // It's not possible to return peripheral is safe
   1086                      break;
   1087          
   1088                  case SR_MCATOD_SELF_TEST_VREFH0_SCALE_0:           // If connected to minimum reference
   1089                      status = SR_MCATOD_ERROR_REGISTER_BIT_STUCK_AT_1;    // Possible fault is bit stuck at 1
   1090                      temp = temp_a | temp_b;
   1091          
   1092                      if (temp <= ((sint16)(SR_MCATOD_MINIMUM_12BITS_AD_VALUE) + local_threshold))
   1093                      {                                       // Expected data on register is found
   1094                          status = SR_MCATOD_ERROR_PERIPHERAL_SAFE;        // Peripheral doesn't show this failure mode
   1095                      }
   1096                      break;
   1097          
   1098                  case SR_MCATOD_SELF_TEST_VREFH0_SCALE_0_5:         // If connected to half maximum value
   1099                      status = SR_MCATOD_ERROR_CONVERTER_ERROR;            // Possible fault is erroneous conversion
   1100                      temp = (temp_a + temp_b) >> 1;
   1101          
   1102                      if ((temp >= ((sint16)(SR_MCATOD_HALF_RANGE_12BITS_AD_VALUE) - local_threshold)) &&
   1103                          (temp <= ((sint16)(SR_MCATOD_HALF_RANGE_12BITS_AD_VALUE) + local_threshold)))
   1104                      {                                       // Expected data on register is found
   1105                          status = SR_MCATOD_ERROR_PERIPHERAL_SAFE;        // Peripheral doesn't show this failure mode
   1106                      }
   1107                      break;
   1108          
   1109                  case SR_MCATOD_SELF_TEST_VREFH0_SCALE_1:           // If connected to maximum value
   1110                      status = SR_MCATOD_ERROR_REGISTER_BIT_STUCK_AT_0;    // Possible fault is bit stuck at 0
   1111                      temp = temp_a & temp_b;
   1112          
   1113                      if (temp >= ((sint16)(SR_MCATOD_MAXIMUM_12BITS_AD_VALUE) - local_threshold))
   1114                      {                                       // Expected data on register is found
   1115                          status = SR_MCATOD_ERROR_PERIPHERAL_SAFE;        // Peripheral doesn't show this failure mode
   1116                      }
   1117                      break;
   1118          
   1119                  default:
   1120                      status = SR_MCATOD_ERROR_TEST_NOT_PERFORMED;         // It's not possible to return peripheral is safe
   1121                      break;
   1122              }
   1123          
   1124              return (status);                                // Returns status
   1125          }

