    423          //---------------------------------------------------------------------------------------------------------------------
    424          /**
    425           *  @brief      Convert a sample value with a manual request.
    426           *
    427           *  @details    This function starts a new conversion using a SW trigger and returns when the conversion has finished.
    428           *
    429           *  @remark     The engine and channel to use need to be configured in the prm file and / or calling the
    430           *              SRMCAtod__ConfigureManualReading function
    431           *
    432           *  @remark     Call this function with caution!
    433           *              This function stops the Motor Control framework until the requested value is converted.
    434           *              If not called properly, this may cause the application to malfunction or even damage the board!
    435           *
    436           */
    437          void SRMCAtod__ConvertManualSample(void)
    438          {
    439              uint8 prev_mux_bit;
    440              uint8 prev_channel;
    441          
    442              // store the configuration
    443              prev_mux_bit = (Manual_Cfg_Hdlr.Base_Reg->ADC_CFG2 & ADC_CFG2_MUXSEL_MASK) >> ADC_CFG2_MUXSEL_SHIFT;
    444              prev_channel = (Manual_Cfg_Hdlr.Base_Reg->ADC_SC1[0] & ADC_SC1_ADCH_MASK);
    445          
    446              // Disable ADC EOS interrupt
    447              ADC1.ADC_SC1[1] &= ~ADC_SC1_AIEN_MASK;
    448              // Disable PDB module
    449              PDB.SC &= ~PDB_SC_PDBEN_MASK;
    450              // hardware trigger disabled
    451              Manual_Cfg_Hdlr.Base_Reg->ADC_SC2 &= ~ADC_SC2_ADTRG_MASK;
    452          
    453              // configure to the new channel & start the conversion
    454              if (Manual_Cfg_Hdlr.Use_Mux)
    455              {
    456                  Manual_Cfg_Hdlr.Base_Reg->ADC_CFG2 |= ADC_CFG2_MUXSEL_MASK;
    457              }
    458              else
    459              {
    460                  Manual_Cfg_Hdlr.Base_Reg->ADC_CFG2 &= ~ADC_CFG2_MUXSEL_MASK;
    461              }
    462              Manual_Cfg_Hdlr.Base_Reg->ADC_SC1[0] = (Manual_Cfg_Hdlr.Base_Reg->ADC_SC1[0] & 0x60) | Manual_Cfg_Hdlr.Channel;
    463          
    464              // wait for the conversion complete
    465              while ((Manual_Cfg_Hdlr.Base_Reg->ADC_SC1[0] & ADC_SC1_COCO_MASK) != ADC_SC1_COCO_MASK)
    466              {
    467                  // If too close to the reload event
    468                  if ((FTM0.MOD - FTM0.CNT) < CONVERSION_TIME_THR)
    469                  {
    470                      // Conversion is taking too much time
    471                      SRMCATOD_MANUAL_CONVERSION_EXCEPTION();
    472                  }
    473              }
    474              // read the result
    475              Last_Manual_Sample = (signed short int)(Manual_Cfg_Hdlr.Base_Reg->ADC_R[0]);
    476          
    477              // restore previous configuration
    478              // enable HW trigger
    479              Manual_Cfg_Hdlr.Base_Reg->ADC_SC2 |= ADC_SC2_ADTRG_MASK;
    480              // reconfigure the channel to default value
    481              Manual_Cfg_Hdlr.Base_Reg->ADC_CFG2 |= (prev_mux_bit << ADC_CFG2_MUXSEL_SHIFT);
    482              Manual_Cfg_Hdlr.Base_Reg->ADC_SC1[0] = (Manual_Cfg_Hdlr.Base_Reg->ADC_SC1[0] & 0x60) | prev_channel;
    483          
    484              // Enable PDB module
    485              PDB.SC |= PDB_SC_PDBEN_MASK;
    486              // Enable ADC EOS interrupt
    487              ADC1.ADC_SC1[1] |= ADC_SC1_AIEN_MASK;
    488          }
    489          
    490          //---------------------------------------------------------------------------------------------------------------------
    491          /**
    492           *  @brief      Get the last manually converted value.
    493           *
    494           *  @remark     Call the SRMCAtod__ConvertManualSample function first to ensure an updated value
    495           *
    496           *  @return     The converted value, in AD Counts.
    497           */
    498          sint16 SRMCAtod__GetLastManualSample(void)
    499          {
    500              MICRO_DECLARE_INTERRUPT_CONTEXT_LOCAL();
    501              sint16 ret = 0;
    502          
    503              MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
    504              ret = Last_Manual_Sample;
    505              MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
    506          
    507              return ret;
    508          }
    509          
    510          //---------------------------------------------------------------------------------------------------------------------
    511          /**
    512           *  @brief      Configure the manual reading operation
    513           *
    514           *  @param      engine      ADC engine to use for the manual reading
    515           *              channel     The channel number, according to the SRMCATOD_CHANNEL_DEF type
    516           *              use_mux     MUX select setting for the selected additional channel
    517           *
    518           *  @return
    519           */
    520          void SRMCAtod__ConfigureManualReading(SRMCATOD_CONVERTER_TYPE engine, SRMCATOD_CHANNEL_DEF channel, BOOL_TYPE use_mux)
    521          {
    522              Manual_Cfg_Hdlr.Engine = engine;
    523              Manual_Cfg_Hdlr.Channel = channel;
    524              Manual_Cfg_Hdlr.Use_Mux = use_mux;
    525          
    526              if (engine == SR_AD_ENGINE_0)
    527              {
    528                  Manual_Cfg_Hdlr.Base_Reg = &ADC0;
    529              }
    530              else if (engine == SR_AD_ENGINE_1)
    531              {
    532                  Manual_Cfg_Hdlr.Base_Reg = &ADC1;
    533              }
    534              else
    535              {
    536                  // intentionally left blank
    537              }
    538          }
    539          #endif
