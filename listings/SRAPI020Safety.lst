    302          /**
    303           * Publishes the API020 messages for the specified Rx channel.
    304           * The private array is cleared when this API function is called.
    305           * @param rx_channel = Specifies which RX channel to read. The specified Rx channel must support message arrays.
    306           * @param message_array = Pointer to an array to fill with the recently received data.
    307           * 						  Array pointed to should be equal than or greater to the array size defined in
    308           * 						  API020_RX_CHANNEL[rx_channel].Array_Size.
    309           * @param messages_received = Number of messages received since the last call to this function.
    310           *                            Returns 0 if no messages have been received.
    311           * @retval TRUE buffer has overflowed since previous read
    312           * @retval FALSE buffer has not overflowed prior to being read
    313           *
    314           *	@startuml{SRAPI020Safety_Get_Buffer.jpg}
    315           *		title SRAPI020Safety Get Buffer
    316           *
    317           *		participant Application as App
    318           *		participant SRAPI020Safety as Api020
    319           *
    320           *		App -> Api020 : SRAPI020Safety__GetRxArray(rx_channel, *message_array, *messages_received)
    321           *		alt any function argument is invalid
    322           *			Api020 -> Api020 : set *messages_received = 0
    323           *			App <-- Api020 : FALSE
    324           *		else function arguments are valid
    325           *			Api020 -> Api020 : write all the messages in the private array to *message_array
    326           *			Api020 -> Api020 : *messages_received = number of messages in *message_array
    327           *			Api020 -> Api020 : clear private buffer
    328           *			alt buffer has overflowed since previous call to SRAPI020Safety__GetRxArray()
    329           *				App <-- Api020 : TRUE
    330           *			else buffer has not overflowed since previous call to SRAPI020Safety__GetRxArray()
    331           *				App <-- Api020 : FALSE
    332           *			end
    333           *		end
    334           *	@enduml
    335           */
    336          BOOL_TYPE SRAPI020Safety__GetRxArray(API020_RX_CHANNEL_INDEX_TYPE rx_channel, void* message_array, uint8* messages_received)
    337          {
    338          	if (( rx_channel >= ELEMENTS_IN_ARRAY(API020_RX_CHANNEL) ) ||
    339          		( API020_RX_CHANNEL[rx_channel].Array_Size < 2 ))
    340          	{
    341          		*messages_received = 0;
    342          		return ( FALSE );
    343          	}
    344          
    345          	API020_RX_CONFIG_TYPE const * config = &API020_RX_CHANNEL[rx_channel];
    346          	uint32 now = SRTimerReference__GetTimer();
    347          
    348          	MICRO_DECLARE_INTERRUPT_CONTEXT_LOCAL();
    349          	MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
    350          
    351          	/* write the Error_Value to the array if the Rx_Time has exceeded the Period for the channel */
    352          	SR_CHECK_LONG(Api020.Rx_Time[rx_channel]);
    353          	if ( IS_MESSAGE_PERIOD_VALID(rx_channel, now) == FALSE )
    354          	{
    355          		WriteToArray(rx_channel, config->Error_Value);
    356          		ResetRxChannel(rx_channel);
    357          	}
    358          
    359          	MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
    360          	MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
    361          
    362          	/* get the current number of readings in the array and reset the static RAM variable */
    363          	SR_CHECK_BYTE(Api020.Rx_Num_Of_Readings[rx_channel]);
    364          	uint8 num_of_readings = Api020.Rx_Num_Of_Readings[rx_channel];
    365          	SR_SET_BYTE(Api020.Rx_Num_Of_Readings[rx_channel], 0);
    366          
    367          	/* get if the array has overflowed since the previous read and reset the static RAM variable */
    368          	SR_CHECK_BYTE(Api020.Rx_Overflowed[rx_channel]);
    369          	uint8 overflowed = Api020.Rx_Overflowed[rx_channel];
    370          	SR_SET_BYTE(Api020.Rx_Overflowed[rx_channel], 0);
    371          
    372          	/* write the array to the application only if there are readings in the array */
    373          	if ( num_of_readings > 0 )
    374          	{
    375          		SRData__CheckArray(config->Address, config->N_Address, num_of_readings * config->Length);
    376          		memcpy(message_array, config->Address, num_of_readings * config->Length);
    377          	}
    378          
    379          	MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
    380          
    381          	*messages_received = num_of_readings;
    382          	return ( overflowed != 0 ? TRUE : FALSE );
    383          }
