     83          
     84          //! The number of bytes that each API020 payload consumes as overhead when transferring safety data.
     85          #define API020_PACKET_OVERHEAD (sizeof(API020_SAFETY_PACKET_TYPE) - MAX_CLASSB_DATA_SIZE)
     86          
     87          //! The maximum size of Class B Safety Data on a single Transmit Channel or Receive Channel.
     88          #define MAX_CLASSB_DATA_SIZE 11
     89          
     90          #if (API020_NUMBER_OF_TX_CHANNELS > 0)
     91              //! The first Sequence Number used on a Transmit Channel after a reset.
     92          	#define SEQUENCE_RESET 0
     93          #endif
     94          
     95          //! The Sequence Number that sequentially follows the SEQUENCE_LAST Sequence Number.
     96          //! This is also the first Sequence Number that represents a potentially valid sequence.
     97          #define SEQUENCE_FIRST 1
     98          
     99          //! The last Sequence Number before having to restart counting at a lower value.
    100          #define SEQUENCE_LAST 253
    101          
    102          #if (API020_NUMBER_OF_TX_CHANNELS > 0)
    103          	//! A Sequence Number that represents that the Transmit Channel did not satisfy the timing requirements.
    104          	#define SEQUENCE_LOST 254
    105          #endif
    106          
    107          //! A Sequence Number used internally to represent an invalid Sequence Number.
    108          //! This Sequence Number is not expected in the API020 messages.
    109          #define SEQUENCE_INVALID 255
