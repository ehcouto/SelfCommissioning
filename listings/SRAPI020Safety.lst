    155          #if (API020_NUMBER_OF_RX_CHANNELS > 0)
    156          	/*
    157          	 * Returns if the message Period time has been exceeded.
    158          	 * @param rx_channel = The Receive Channel whose Class B Safety Data is requested.
    159          	 * @param now the current free running timer ticks
    160          	 * @return TRUE time between messages is valid
    161          	 * @return FALSE the time between messages has exceeded the maximum Period
    162          	 */
    163          	#define IS_MESSAGE_PERIOD_VALID(rx_channel, now)\
    164          		( (now - Api020.Rx_Time[rx_channel] <= API020_RX_CHANNEL[rx_channel].Period) ? TRUE : FALSE )
    165          #endif
