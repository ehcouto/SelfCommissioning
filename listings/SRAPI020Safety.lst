    492          //---------------------------------------------------------------------------------------------------------------------
    493          /**
    494           * Save the received safety data.
    495           * @param rx_channel = The receive channel to which the safety data is related.
    496           *                     Used as an index into the API020_RX_CHANNEL[rx_channel] array.
    497           * @param sequence = The sequence of the newly received data.
    498           * @param data = The safety data that was received.
    499           */
    500          static void ResetRxChannel(API020_RX_CHANNEL_INDEX_TYPE rx_channel)
    501          {
    502          	SR_SET_BYTE(Api020.Rx_Expected_Sequence[rx_channel], SEQUENCE_INVALID);
    503          	SR_SET_BYTE(Api020.Rx_Sequence_Valid[rx_channel], FALSE);
    504          }
    505          
    506          //---------------------------------------------------------------------------------------------------------------------
    507          /**
    508           * Save the received safety data.
    509           * @param rx_channel = The receive channel to which the safety data is related.
    510           *                     Used as an index into the API020_RX_CHANNEL[rx_channel] array.
    511           * @param sequence = The sequence of the newly received data.
    512           * @param data = The safety data that was received.
    513           */
    514          static void SaveSafetyData(API020_RX_CHANNEL_INDEX_TYPE rx_channel, uint8 sequence, void* data)
    515          {
    516              API020_RX_CONFIG_TYPE const* config = &API020_RX_CHANNEL[rx_channel];
    517          
    518              // Determine if the Class B packet sequence was preserved by this message.
    519              SR_CHECK_BYTE(Api020.Rx_Expected_Sequence[rx_channel]);
    520              SR_CHECK_LONG(Api020.Rx_Time[rx_channel]);
    521              uint32 now = SRTimerReference__GetTimer();
    522              uint8 sequence_preserved = (( sequence == Api020.Rx_Expected_Sequence[rx_channel] ) &&	/* is the sequence id valid AND */
    523              							( IS_MESSAGE_PERIOD_VALID(rx_channel, now) == TRUE ));		/* is the time between messages valid */
    524          
    525          	#if (API020_USE_RX_ARRAY == ENABLED)
    526              if ( API020_RX_CHANNEL[rx_channel].Array_Size >= 2 )
    527              {
    528              	/* if the sequence id and time have been met, write the data to the array, else write the Error_Value */
    529              	WriteToArray(rx_channel, sequence_preserved ? data : config->Error_Value);
    530              }
    531              else /* config->Array_Size < 2 */
    532          	/* write the data to a variable */
    533          	#endif
    534              {
    535          		if ( sequence_preserved )
    536          		{
    537          			// This is a valid packet received in the expected sequence.
    538          			// Save the received data.
    539          			SRData__UpdateArray(config->Address, config->N_Address, data, config->Length);
    540          		}
    541              }
    542          
    543              // Determine the next expected Sequence Number for this RX channel.
    544              sequence = (sequence < SEQUENCE_LAST) ? sequence + 1 : SEQUENCE_FIRST;
    545          
    546              // Save the RX channel status information.
    547              SR_SET_BYTE(Api020.Rx_Expected_Sequence[rx_channel], sequence);
    548              SR_SET_LONG(Api020.Rx_Time[rx_channel], now);
    549              SR_SET_BYTE(Api020.Rx_Sequence_Valid[rx_channel], sequence_preserved);
    550          }
    551          
    552          
    553          #if (API020_USE_RX_ARRAY == ENABLED)
    554          
    555          //---------------------------------------------------------------------------------------------------------------------
    556          /**
    557           * Write data to the array.
    558           * @param rx_channel = Specifies which RX channel to read. The specified Rx channel must support message arrays.
    559           * @retval void * pointer to the memory address at which the data is stored
    560           */
    561          static void WriteToArray(API020_RX_CHANNEL_INDEX_TYPE rx_channel, void * value)
    562          {
    563          	API020_RX_CONFIG_TYPE const* config = &API020_RX_CHANNEL[rx_channel];
    564          
    565          	SR_CHECK_BYTE(Api020.Rx_Num_Of_Readings[rx_channel]);
    566          	uint8 num_of_readings = Api020.Rx_Num_Of_Readings[rx_channel];
    567          
    568          	/* calculate the address of the slot within the array */
    569          	#define SLOT_ADDR(slot)\
    570          		( slot * API020_RX_CHANNEL[rx_channel].Length )
    571          
    572          	BOOL_TYPE write_to_array = TRUE;
    573          
    574          	/*
    575          	 * If the data is equal to the Error_Value, write the Error_Value to the array only if the most recently
    576          	 * written to slot in the array does not contain the Error_Value.
    577          	 */
    578          	if (( memcmp(value, config->Error_Value, config->Length) == 0 ) &&		/* the data to write is the Error_Value AND */
    579          		( num_of_readings >= 1 ))											/* the array is not empty */
    580          	{
    581          		uint8 slot = num_of_readings - 1;
    582          		(void)SRData__CheckArray((void*)((uint8*)config->Address + SLOT_ADDR(slot)), (void*)((uint8*)config->N_Address + SLOT_ADDR(slot)), config->Length);
    583          		if ( memcmp((void*)((uint8*)config->Address + SLOT_ADDR(slot)), config->Error_Value, config->Length) == 0 )
    584          		{
    585          			/* the most recently written to slot in the buffer already has the Error_Value written to it, do not write another Error_Value to the array */
    586          			write_to_array = FALSE;
    587          		}
    588          	}
    589          
    590          	if ( write_to_array == TRUE )
    591          	{
    592          		/* if the array is full, shift all the readings in the array back by 1 to make room for the new data value to write to the array */
    593          		if ( num_of_readings >= config->Array_Size )
    594          		{
    595          			/* array is full */
    596          			SR_SET_BYTE(Api020.Rx_Overflowed[rx_channel], 1);
    597          			SRData__UpdateArray(config->Address, config->N_Address, (void*)((uint8*)config->Address + SLOT_ADDR(1)), (config->Array_Size - 1) * config->Length);
    598          			num_of_readings = config->Array_Size - 1;
    599          		}
    600          
    601          		/* write the value to the array */
    602          		SRData__UpdateArray((void*)((uint8*)config->Address + SLOT_ADDR(num_of_readings)), (void*)((uint8*)config->N_Address + SLOT_ADDR(num_of_readings)), value, config->Length);
    603          		SR_SET_BYTE(Api020.Rx_Num_Of_Readings[rx_channel], num_of_readings + 1);
    604          	}
    605          }
    606          
    607          #endif /* (API020_USE_RX_ARRAY == ENABLED) */
    608          
    609          #endif      // #if (API020_NUMBER_OF_RX_CHANNELS > 0)
    610          
    611          #endif      // #if (API020SAFETY_FEATURE == ENABLED)
