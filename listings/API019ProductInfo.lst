    289                  case API019PRODUCTINFO_OP_SET_EOL_DATA_RESULT:
    290                      aux8 = sizeof(API019_EOL_Test_Data[0].Test_Result);
    291                      if ( buffer->size == ((2*aux8) + 1))
    292                      {
    293                          // Byte 0 index
    294                          // Byte 1 to size+!       = Data
    295                          // Byte size+! to 2xsize+1 = MAsk
    296                          if (buffer->payload[0] < API019_NUM_EOL_DATA_TEST)
    297                          {
    298                              UpdateMaskedArray(API019_EOL_Test_Data[buffer->payload[0]].Test_Result,&buffer->payload[1], &buffer->payload[aux8+1], aux8);
    299                          }
    300                      }
    301                      break;
    302          #if (CALIBRATION_DATA_FEATURE == ENABLED)
    303                  case API019PRODUCTINFO_OP_SET_CALIB_DATA:
    304                      // Expected payload:
    305                      //      First byte = Calibration Item ID
    306                      //      Additional bytes = Calibration data
    307                      if (buffer->size >= 2)
    308                      {
    309                          CALIBRATION_ITEM_ID_TYPE cal_item = (CALIBRATION_ITEM_ID_TYPE)(buffer->payload[0]);
    310                          uint8 data_length = Calibration__GetDataSize(cal_item);
    311                          if ((data_length > 0) &&
    312                              (buffer->size == data_length + 1))
    313                          {
    314                              uint8* data_ptr = Calibration__GetDataPointer(cal_item);
    315                              memcpy(data_ptr, &buffer->payload[1], data_length);
    316                          }
    317                          else
    318                          {
    319                              retval = NVO_RS_UNSUP_INVALID_PARAM;
    320                          }
    321                      }
    322                      else
    323                      {
    324                          retval = NVO_RS_UNSUP_INVALID_PARAM;
    325                      }
    326                      break;
    327                  case API019PRODUCTINFO_OP_REQ_PUB_CALIB_DATA:
    328                      // Expected payload:
    329                      //      First byte = Calibration Item ID
    330                      if (buffer->size >= 1)
    331                      {
    332                          CALIBRATION_ITEM_ID_TYPE cal_item = (CALIBRATION_ITEM_ID_TYPE)(buffer->payload[0]);
    333                          uint8 data_length = Calibration__GetDataSize(cal_item);
    334                          if (data_length > 0)
    335                          {
    336                              uint8* data_ptr = Calibration__GetDataPointer(cal_item);
    337                              REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API019PRODUCTINFO_NUM, API019PRODUCTINFO_OP_REQ_PUB_CALIB_DATA, buffer->node_id, data_length + 1);
    338                              if ((msg == NULL) ||
    339                                  (Reveal__AddDataU8(msg, cal_item) == FAIL) ||
    340                                  (Reveal__AddDataU8Buffer(msg, data_ptr, data_length) == FAIL) ||
    341                                  (Reveal__QueueCommand(msg) == FALSE))
    342                              {
    343                                  retval = NVO_RS_BUSY;
    344                              }
    345                          }
    346                          else
    347                          {
    348                              retval = NVO_RS_UNSUP_INVALID_PARAM;
    349                          }
    350                      }
    351                      else
    352                      {
    353                          retval = NVO_RS_UNSUP_INVALID_PARAM;
    354                      }
    355                      break;
    356          #endif // #if (CALIBRATION_DATA_FEATURE == ENABLED)
    357                  case API019PRODUCTINFO_OP_REQ_PUB_CLASS_B_SIGN:
    358                      if (PublishSignatureData(buffer->node_id, API019PRODUCTINFO_OP_REQ_PUB_CLASS_B_SIGN) == FAIL)
    359                      {
    360                          retval = NVO_RS_BUSY;
    361                      }
    362                      break;
    363                  case API019PRODUCTINFO_OP_STORE_DATA:
    364                      #if (NVDATA_STORE_STATIC_FEATURE == ENABLED)
    365                          if (NVData__StoreStaticData() != PASS)
    366                          {
    367                              //Failed to store the static data
    368                              retval = NVO_RS_BUSY;
    369                          }
    370                      #else
    371                          retval = NVO_RS_UNSUP_OP_CODE;
    372                      #endif
    373                      break;
    374                  default:
    375          			retval = NVO_RS_UNSUP_OP_CODE;
    376                      break;
    377              }
    378          
    379              return (retval);
