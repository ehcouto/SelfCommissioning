    725              #if (SETTINGFILE_MASTER_FILE_FEATURE == ENABLED)
    726                  API019_PROJECT_DATA_TYPE settingfileprojectdata;
    727                  SETTINGFILE_LOADER_TYPE load_sf_data;
    728          
    729                  if (project_index == API019_PROJECT_SETTINGFILE)
    730                  {
    731                      //Setting File information is available only with the ACU board
    732          
    733                      //Clear the variable
    734                      memset(&settingfileprojectdata, 0, sizeof(settingfileprojectdata));
    735          
    736                      //Project_Name
    737                      strcpy(settingfileprojectdata.Project_Name, "Setting FL");
    738          
    739                      //Project_Release_Number
    740                      if (SettingFile__BasicLoader(SF_PTR_ACU_SERIAL_NUMBER, SF_DISPL_PART_NUMBER, &load_sf_data) == PASS)
    741                      {
    742                          memcpy(settingfileprojectdata.Project_Release_Number, load_sf_data.Data, sizeof(settingfileprojectdata.Project_Release_Number));
    743          
    744                      }
    745                      else
    746                      {
    747                          memset(settingfileprojectdata.Project_Release_Number,' ' ,sizeof(settingfileprojectdata.Project_Release_Number));
    748                      }
    749          
    750          
    751                      //Project_Release_Date[8]
    752                      //Release Hour
    753                      //Release Minute
    754                      if (SettingFile__BasicLoader(SF_PTR_ACU_SERIAL_NUMBER, SF_DISPL_PROJECT_TIMESTAMP, &load_sf_data) == PASS)
    755                      {
    756                          memcpy(settingfileprojectdata.Project_Release_Date, load_sf_data.Data, sizeof(settingfileprojectdata.Project_Release_Date));
    757          
    758                          #define SF_DISPLACEMENT_TIMESTAMP_TIME_INDEX        8
    759                          #define PROJECT_CLASSB_ID_TIMESTAMP_TIME_SIZE       6
    760                          memcpy(settingfileprojectdata.Project_ClassB_Id, &load_sf_data.Data[SF_DISPLACEMENT_TIMESTAMP_TIME_INDEX], PROJECT_CLASSB_ID_TIMESTAMP_TIME_SIZE);
    761          
    762                          //Fill the rest of the string with the NULL character
    763                          #define PROJECT_CLASSB_ID_UNUSED_BYTES              5
    764                          #define PROJECT_CLASSB_ID_UNUSED_BYTES_INDEX        6
    765          
    766                          memset(&settingfileprojectdata.Project_ClassB_Id[PROJECT_CLASSB_ID_UNUSED_BYTES_INDEX], ' ', PROJECT_CLASSB_ID_UNUSED_BYTES);
    767          
    768                      }
    769                      else
    770                      {
    771                          memset(settingfileprojectdata.Project_Release_Date,' ' ,sizeof(settingfileprojectdata.Project_Release_Date));
    772                      }
    773          
    774                      //GESE Project_Release_Version
    775                      if (SettingFile__BasicLoader(SF_PTR_ACU_SERIAL_NUMBER, SF_DISPL_GESE_VERSION, &load_sf_data) == PASS)
    776                      {
    777                          memcpy(settingfileprojectdata.Project_Release_Version, load_sf_data.Data, sizeof(settingfileprojectdata.Project_Release_Version));
    778                      }
    779          
    780                      // Project Status
    781                      if (SettingFile__BasicLoader(SF_PTR_ACU_SERIAL_NUMBER, SF_DISPL_PROJECT_STATUS, &load_sf_data) == PASS)
    782                      {
    783                          memcpy(&settingfileprojectdata.Micro_Vendor, load_sf_data.Data, sizeof(settingfileprojectdata.Micro_Vendor));
    784                      }
    785          
    786                      //Platform_Type
    787                      //Product_Type
    788                      if (SettingFile__BasicLoader(SF_PTR_ACU_SERIAL_NUMBER, SF_DISPL_PLATFORM_PRODUCT_TYPE, &load_sf_data) == PASS)
    789                      {
    790                          #define SF_PLATFORM_TYPE_INDEX          0
    791                          #define SF_PRODUCT_TYPE_INDEX           1
    792          
    793                          settingfileprojectdata.Platform_Type = (API019_PLATFORM_TYPE)load_sf_data.Data[SF_PLATFORM_TYPE_INDEX];
    794                          settingfileprojectdata.Product_Type = load_sf_data.Data[SF_PRODUCT_TYPE_INDEX];
    795                      }
    796          
    797                      // Set the Endianess bit from C_Extensions.h
    798                      settingfileprojectdata.Product_Cfg1 = MICRO_IS_LITTLE_ENDIAN;
    799          
    800                      //ClassB_CRC
    801                      if (SettingFile__BasicLoader(SF_PTR_ACU_SERIAL_NUMBER, SF_DISPL_CLASSB_CRC, &load_sf_data) == PASS)
    802                      {
    803                          settingfileprojectdata.ClassB_CRC = *(uint16 *)(void *)(load_sf_data.Data);
    804                      }
    805          
    806                      pt_data = &settingfileprojectdata;
    807                  }
    808                  else
    809              #endif
    810                  {
    811                      pt_data = ProductInfo__GetProjectData(board_index, project_index);
    812                      if (pt_data != NULL)
    813                      {
    814                          // Set the Endianess bit from C_Extensions.h
    815                          pt_data->Product_Cfg1 &= (0xFE); // Clear bit
    816                          pt_data->Product_Cfg1 |= (0x01 & MICRO_IS_LITTLE_ENDIAN); // Set bit according to macro.
    817                      }
    818                  }
    819          
    820                  if (pt_data != NULL)
    821                  {
    822                      //Prepare the Reveal message
    823                      ptr = Reveal__NewFeedback(API019PRODUCTINFO_NUM, API019PRODUCTINFO_OP_REQ_PUB_PROJECT_DATA, address,sizeof(API019_PROJECT_DATA_TYPE)+2);
    824          
    825                      if (ptr != (REVEAL_COMMAND_TYPE *) NULL)
    826                      {
    827                          Reveal__AddDataU8(ptr,board_index);
    828                          Reveal__AddDataU8(ptr,project_index);
    829                          Reveal__AddDataU8Buffer(ptr, (uint8*)pt_data,sizeof(API019_PROJECT_DATA_TYPE));     //lint !e928 cast from pointer to pointer [MISRA 2004 Rule 11.4]
    830                          Reveal__QueueCommand(ptr);
    831                          retval = PASS;
    832                      }
    833                  }
    834          
    835          
    836              return (retval);
    837          }
