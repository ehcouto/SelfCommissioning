    912          static void UpdateMaskedArray(uint8 * data, uint8 * value, uint8 * mask, uint8 size)
    913          {
    914          
    915              uint8 aux;
    916              uint8 index;
    917          
    918              for (index=0; index< size; index++)
    919              {
    920                  aux = mask[index] & (~value[index]);
                                              ^
Remark[Pa091]: operator operates on value promoted to int (with possibly
          unexpected result)
    921                  data[index] = data[index] & (~aux);
                                                      ^
Remark[Pa091]: operator operates on value promoted to int (with possibly
          unexpected result)
    922                  data[index] = data[index] | (mask[index] & value[index]);
    923              }
    924          
    925          }
