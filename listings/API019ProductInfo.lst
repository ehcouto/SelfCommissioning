    672          //----------------------------------------------------------------------------------------------------------
    673          /**
    674           *
    675           * @param address
    676           * @param board_index
    677           * @return
    678           */
    679          static PASS_FAIL_TYPE PublishBoardData(uint8 address, uint8 board_index)
    680          {
    681              REVEAL_COMMAND_TYPE * ptr;
    682              PASS_FAIL_TYPE retval;
    683              retval = FAIL;
    684              if (board_index < API019_Appliance_Data.Appliance_Number_Boadrs)
    685              {
    686                  ptr = Reveal__NewFeedback(API019PRODUCTINFO_NUM, API019PRODUCTINFO_OP_REQ_PUB_BOARD_DATA, address,sizeof(API019_BOARD_DATA_TYPE)+1 + API019_Board_Data[board_index].Board_Num_Projects);
    687          
    688                  if (ptr != (REVEAL_COMMAND_TYPE *) NULL)
    689                  {
    690                      Reveal__AddDataU8(ptr,board_index);
    691                      Reveal__AddDataU8Buffer(ptr, (uint8*)&API019_Board_Data[board_index],sizeof(API019_BOARD_DATA_TYPE));   //lint !e928 cast from pointer to pointer [MISRA 2004 Rule 11.4]
    692          
    693                      API019_PROJECT_TYPE *project_type_pt = ProductInfo__GetProjectIDs((API019_BOARD_TYPE)board_index);
    694          
    695                      if(project_type_pt != NULL)
    696                      {
    697                          Reveal__AddDataU8Buffer(ptr, (uint8*)project_type_pt, API019_Board_Data[board_index].Board_Num_Projects);   //lint !e928 cast from pointer to pointer [MISRA 2004 Rule 11.4]
    698                      }
    699          
    700                      Reveal__QueueCommand(ptr);
    701                      retval = PASS;
    702                  }
    703              }
    704              return (retval);
    705          }
