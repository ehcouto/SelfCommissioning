    653           * @return
    654           */
    655          static PASS_FAIL_TYPE PublishApplianceData(uint8 address)
    656          {
    657              REVEAL_COMMAND_TYPE * ptr;
    658              ptr = Reveal__NewFeedback(API019PRODUCTINFO_NUM, API019PRODUCTINFO_OP_REQ_PUB_APPLIANCE_DATA, address,sizeof(API019_APPLIANCE_DATA_TYPE));
    659          
    660              if (ptr != (REVEAL_COMMAND_TYPE *) NULL)
    661              {
    662                  Reveal__AddDataU8Buffer(ptr, (uint8*)&API019_Appliance_Data,sizeof(API019_APPLIANCE_DATA_TYPE));    //lint !e928 cast from pointer to pointer [MISRA 2004 Rule 11.4]
    663                  Reveal__QueueCommand(ptr);
    664                  return (PASS);
    665              }
    666              else
    667              {
    668                  return (FAIL);
    669              }
    670          }
