    645          
    646          static void Beagle_FastHandler(void)
    647          {
    648          
    649          
    650          #ifdef MANUAL_BEAGLE_CHANNEL_CONFIG
    651          
    652          	Beagle_Data_Buffer[0]  =  *Beagle_Data_Points[0];
    653          	Beagle_Data_Buffer[1]  =  *Beagle_Data_Points[1];
    654          	Beagle_Data_Buffer[2]  =  *Beagle_Data_Points[2];
    655          	Beagle_Data_Buffer[3]  =  *Beagle_Data_Points[3];
    656          	Beagle_Data_Buffer[4]  =  *Beagle_Data_Points[4];
    657          	Beagle_Data_Buffer[5]  =  *Beagle_Data_Points[5];
    658          	Beagle_Data_Buffer[6]  =  *Beagle_Data_Points[6];
    659          	Beagle_Data_Buffer[7]  =  *Beagle_Data_Points[7];
    660          	Beagle_Data_Buffer[8]  =  *Beagle_Data_Points[8];
    661          	Beagle_Data_Buffer[9]  =  *Beagle_Data_Points[9];
    662          	Beagle_Data_Buffer[10] =  *Beagle_Data_Points[10];
    663          	Beagle_Data_Buffer[11] =  *Beagle_Data_Points[11];
    664          
    665          
    666          #else  //Channel configuration via API010 or MAC
    667          	void *temp = NULL;
    668          	sint32 bgl_temp;
    669          	uint8 bgl_index =0;
    670          
    671          	for(bgl_index=0; bgl_index  <BEAGLE_CHANNEL_NUM; bgl_index++)
    672          	{
    673          		if (Spi_Address[bgl_index].Address != NULL)
    674          		{
    675          			temp =  Spi_Address[bgl_index].Address;
    676          			if(Spi_Address[bgl_index].Size == 1)
    677          			{
    678          				bgl_temp = (*(sint8*)(temp));
    679          				Beagle_Data_Buffer[bgl_index] = (float)bgl_temp;//int8
    680          			}
    681          			else if (Spi_Address[bgl_index].Size == 2)
    682          			{
    683          				bgl_temp = (*(sint16*)(temp));
    684          				Beagle_Data_Buffer[bgl_index] = (float)bgl_temp;//int16
    685          			}
    686          			else
    687          			{
    688          				//As of now there is no way to differentiate between float and sint32, we will assume all 4 bytes variables are flaot.
    689          				// In otherwords , we can't read sint32 variables via beagle as of now.
    690          				Beagle_Data_Buffer[bgl_index] = *(float*)temp; //float
    691          			}
    692          		}
    693          		else
    694          		{
    695          			Beagle_Data_Buffer[bgl_index] = 0.0f;
    696          		}
    697          	}
    698          #endif
    699          	//! High Speed handler Beagle function
    700          	Beagle__TriggerTXData();
    701          	Beagle__HighSpeedHandler();
    702          }
    703          
    704          #endif

