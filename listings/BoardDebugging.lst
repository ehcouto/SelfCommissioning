    555          #if (BD_ADC_NOISE_ASSESSMENT == ENABLED)
    556          static void AdcNoiseInit()
    557          {
    558              //Adc Noise counters initialization
    559              Current_A.Signal_K_1     = 0;
    560              Current_B.Signal_K_1     = 0;
    561              Current_C.Signal_K_1     = 0;
    562              DcBus.Signal_K_1         = 0;
    563          
    564              Current_A.Signal_K_2     = 0;
    565              Current_B.Signal_K_2     = 0;
    566              Current_C.Signal_K_2     = 0;
    567              DcBus.Signal_K_2         = 0;
    568          
    569          
    570              Current_A.Noise_Ampl_Max = 0;
    571              Current_B.Noise_Ampl_Max = 0;
    572              Current_C.Noise_Ampl_Max = 0;
    573              DcBus.Noise_Ampl_Max     = 0;
    574          
    575              Current_A.Noise_Cnt      = 0;
    576              Current_B.Noise_Cnt      = 0;
    577              Current_C.Noise_Cnt      = 0;
    578              DcBus.Noise_Cnt          = 0;
    579          
    580              Current_Noise_Thr = BD_CURRENT_NOISE_THR;
    581              DcBus_Noise_Thr = BD_DC_BUS_NOISE_THR;
    582          
    583              Noise_Measure_Window = BD_NOISE_WINDOW;
    584              Noise_Measure_Window_Cnt = 0;
    585          
    586          }
    587          
    588          static void AdcNoiseHandler()
    589          {
    590              sint16 current_a;
    591              sint16 current_b;
    592              sint16 current_c;
    593              sint16 dc_bus;
    594          
    595              // convert floating point mcl currents and DCbus voltage back to 1.15 notation
    596              // (to be used, for instance, in case of third current reconstruction)
    597              current_a = (sint16) BD_CURRENT(Mcl_IO.Is_ABC.A);
    598              current_b = (sint16) BD_CURRENT(Mcl_IO.Is_ABC.B);
    599              current_c = (sint16) BD_CURRENT(Mcl_IO.Is_ABC.C);
    600              dc_bus    = (sint16) BD_VOLTAGE(Mcl_IO.Vdc);
    601          
    602          
    603              //--------------- Motor Current Adc Noise measurement -----------------------
    604              AdcNoiseMeasure(current_a, &Current_A, Current_Noise_Thr);
    605              AdcNoiseMeasure(current_b, &Current_B, Current_Noise_Thr);
    606              AdcNoiseMeasure(current_c, &Current_C, Current_Noise_Thr);
    607          
    608              //--------------- Dc Bus  Noise measurement -------------------------
    609              AdcNoiseMeasure(dc_bus, &DcBus, DcBus_Noise_Thr);
    610          
    611          }
    612          
    613          
    614          static void AdcNoiseMeasure(sint16 signal, NOISE_SIGNAL_TYPE* noise_signal, uint16 noise_thr)
    615          {
    616              sint16 signal_mean;
    617              sint16 signal_delta;
    618          
    619          
    620              signal_mean = (signal>>1) + (noise_signal->Signal_K_2 >>1);
    621          
    622              signal_delta = MATHCALC__ABS(noise_signal->Signal_K_1 - signal_mean);
    623          
    624              if(signal_delta > noise_thr)
    625              {
    626                  if(noise_signal->Noise_Ampl_Max < signal_delta)
    627                  {
    628                      noise_signal->Noise_Ampl_Max = signal_delta;
    629                  }
    630          
    631                  noise_signal->Noise_Cnt++;
    632              }
    633          
    634              noise_signal->Signal_K_2 = noise_signal->Signal_K_1;
    635              noise_signal->Signal_K_1 = signal;
    636          
    637          }
    638          
    639          
    640          #endif
