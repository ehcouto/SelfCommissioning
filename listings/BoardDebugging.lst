    315          /**
    316           *  @brief      Pwm handler for MasterCommander. Rate: every 62.5 us
    317           *
    318           */
    319          
    320          

   \                                 In section .text, align 2, keep-with-next
    321          void BoardDebugging__PwmHandler(void)
    322          {
    323          #if (BD_ADC_NOISE_ASSESSMENT == ENABLED)
    324              // Adc noise calculation
    325              // make sure this is executed after offset calculation
    326              if (MotorSafetyMgr__IsInIdle() || (Mci__GetAnalog(MOTOR0, MCI_AI_INTERNAL_MCI_STATE) >= 3)) // >= MCI_IDLE
    327              {
    328                  AdcNoiseHandler();
    329              }
    330          #endif
    331          
    332          
    333          #if (BD_PWM_ACCESS == ENABLED)
    334              if(Pwm_Turn_On_Flag && (MotorSafetyMgr__DoesClassAHaveAccessToPwm() == TRUE))
    335              {
    336                  if (BD_Update_Cmd != 0)
    337                  {
    338                      // Apply the PWM
    339                      MotorSafetyMgr__UpdatePwm(Pwm_Duty_Hw_Dbg.A, Pwm_Duty_Hw_Dbg.B, Pwm_Duty_Hw_Dbg.C);
    340          
    341                      BD_Update_Cmd = 0;
    342                  }
    343              }
    344          #endif
    345          
    346          
    347          #if (BD_ADC_SYNCH_ADJUST == ENABLED)
    348              if (Adc_Conv_Synch_Adjust != 0)
    349              {
    350                  SRMCAtod__SetSyncDelay(Adc_Conv_Synch_Value);
    351                  Adc_Conv_Synch_Adjust  = 0;
    352              }
    353          #endif
    354          
    355          #if (DEBUG_MASTERCOMMANDER == ENABLED)
    356              MasterCommander__PwmHandler();
   \                     BoardDebugging__PwmHandler: (+1)
   \   00000000   0x.... 0x....      B.W      MasterCommander__PwmHandler
    357          #endif
    358          }
