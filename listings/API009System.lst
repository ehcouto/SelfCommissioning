    232          //----------------------------------------------------------------------------------------------------------
    233          /**
    234           * @brief This method parses feedbacks to the API009System sent to a broadcast or exclusively to this node.
    235           * @param buffer contains the Wide package that contains the message.
    236           */

   \                                 In section .text, align 2, keep-with-next
    237          void API009System__FeedbackParser(REVEAL_MSG_TYPE * buffer)
    238          {
    239              switch ((API009_OPCODE_TYPE)buffer->op_code)
    240              {
    241                  case API009_OP_RESET:
    242                  case API009_OP_REQUEST_RESET_STATUS:
    243          
    244                      API009SYSTEM__NODE_RESET_MSG(buffer->node_id,
    245                                                  buffer->payload[0],                                 // MICRO_LAST_RESET_TYPE information
    246                                                  (MICRO_RESET_MODE_TYPE)buffer->payload[1]);         // MICRO_RESET_MODE_TYPE
    247                      break;
    248          
    249                  case API009_OP_ENDIANESS:
    250                      API009SYSTEM__ENDIANESS_REQUESTG(buffer->node_id,buffer->payload[0]);
    251                      break;
    252          
    253                  #if (LOW_POWER_FEATURE == ENABLED)
    254                  case API009_OP_WAKEUP_SOURCE:
    255                          SRPowerMgr__ReceivedWakeUpNodeID(buffer->node_id);
