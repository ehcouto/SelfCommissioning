    193          //---------------------------------------------------------------------------------------------------------------------
    194          /**
    195           *  @brief      It Initializes the module SRPowerMgr and its variables
    196           *
    197           */
    198          void SRPowerMgr__Initialize(void)
    199          {
    200              #if (MICRO_SR_FEATURE_TEST == ENABLED)
    201                  #if (MICRO_SRPOWERMGR_FEATURE == ENABLED)
    202                      if ((Micro_Flow != MICRO_FLOW_SRPOWERMGR_INIT) &&
    203                          (N_Micro_Flow != SRDATA__COMPLEMENT(MICRO_FLOW_SRPOWERMGR_INIT)))
    204                      {
    205                          Micro__Trap();
    206                      }
    207                  #endif
    208              #endif
    209          
    210              #if (SRPOWERMGR_LOWPOWER_MODE != 0)
    211                  SRPOWERMGR_INITIALIZE();
    212          
    213                  #if (SRPOWERMGR_WAKEUP_SEQUENCE_GENERATOR == ENABLED)
    214                      SRPowerMgr_Timeout = 0;
    215                      SRPowerMgr_IsThisWakeUpSource = FALSE;
    216                      SRPowerMgr__ReceivedWakeUpNode  = SRPOWERMGR_INVALID_WAKEUP_NODE;
    217                      SRPowerMgr_WakeUpRetry = 0;
    218          
    219                      if (Micro__GetResetMode() == MICRO_RESET_MODE_COLD)
    220                      {
    221                          SRPowerMgr_State      = SRPOWERMGR_STATE_IDLE;
    222                          SRPowerMgr_WakeUpTrig = SRPOWERMGR_WAKEUP_TRIG_EXTERNAL;
    223                      }
    224                  #endif
    225          
    226                  #if (SRPOWERMGR_LOWPOWER_MODE == 3)
    227                      MICRO_DECLARE_INTERRUPT_CONTEXT_LOCAL();
    228                  #endif
    229          
    230                  #if (SRPOWERMGR_LOWPOWER_MODE == 1)
    231                      if (Mode__GetMode() == MODE_LOWPOWER)
    232                      {
    233                          //SRPOWERMGR_DEEP_SLEEP_MODE
    234                          Micro__DisableWarmResetAction(MICRO_WARM_RESET_ACTION_ENTER_LOWPOWER);
    235                          DISABLE_INTERRUPTS();
    236                          Gpio__Initialize();
    237                          ExtInterrupt__Initialize();
    238                          ExtInterrupt__Config(SRPOWERMGR_DEEP_SLEEP_EXTERNAL_INTERRUPT_CHANNEL,
    239                                               SRPOWERMGR_DEEP_SLEEP_EXTERNAL_INTERRUPT_PORT,
    240                                               SRPOWERMGR_DEEP_SLEEP_EXTERNAL_INTERRUPT_PIN,
    241                                               SRPOWERMGR_DEEP_SLEEP_EXTERNAL_INTERRUPT_PIN_REMAP,
    242                                               SRPOWERMGR_DEEP_SLEEP_EXTERNAL_INTERRUPT_TRIGGER_MODE);
    243                          ENABLE_INTERRUPTS();
    244                          DEEP_SLEEP_MODE();
    245                          DISABLE_INTERRUPTS();
    246                      }
    247                  #elif (SRPOWERMGR_LOWPOWER_MODE == 2)
    248                      if (Mode__GetMode() == MODE_LOWPOWER)
    249                      {
    250                          #if (SYSTEM_ACU_HANDLING == ENABLED)
    251                              //backup the NVData
    252                              NVData__Store();
    253                          #endif
    254          
    255                          //retry for 3 times
    256                          for (uint8 count = 0; count < 3; count++)
    257                          {
    258                              //SRPOWERMGR_AUTO_WAKEUP_MODE
    259                              //this condition because if the micro is reset and running due to LVD
    260                              Gpio__Initialize();
    261                              Gpio__PinWrite(SRPOWERMGR_AUTO_WAKEUP_HW_PORT, SRPOWERMGR_AUTO_WAKEUP_HW_PIN, (BOOL_TYPE)(~SRPOWERMGR_AUTO_WAKEUP_HW_PIN_DRIVE & 0x01));
    262                              Gpio__PinConfig(SRPOWERMGR_AUTO_WAKEUP_HW_PORT, SRPOWERMGR_AUTO_WAKEUP_HW_PIN, OUTPUT_PUSHPULL);
    263          
    264                              //add a delay to die the power
    265                              Micro__DelayNumNops(SRPOWERMGR_AUTO_WAKEUP_HW_PORT_NOP_DELAY);
    266                          }
    267          
    268                          //cold reset if it fails to put the micro in sleep mode
    269                          Micro__ForceReset(MICRO_RESET_MODE_COLD);
    270                      }
    271                      else
    272                      {
    273                          //SRPOWERMGR_AUTO_WAKEUP_MODE
    274                          Micro__DisableWarmResetAction(MICRO_WARM_RESET_ACTION_ENTER_LOWPOWER);
    275          
    276                          Gpio__Initialize();
    277                          Gpio__PinWrite(SRPOWERMGR_AUTO_WAKEUP_HW_PORT, SRPOWERMGR_AUTO_WAKEUP_HW_PIN, (BOOL_TYPE)(SRPOWERMGR_AUTO_WAKEUP_HW_PIN_DRIVE & 0x01));
    278                          Gpio__PinConfig(SRPOWERMGR_AUTO_WAKEUP_HW_PORT, SRPOWERMGR_AUTO_WAKEUP_HW_PIN, OUTPUT_PUSHPULL);
    279          
    280                          SRPowerMgr_Mode = SRPOWERMGR_NORMAL_SPEED_MODE;
    281                      }
    282          
    283                  #elif (SRPOWERMGR_LOWPOWER_MODE == 3)
    284                      if (Mode__GetMode() == MODE_LOWPOWER)
    285                      {
    286                          //SRPOWERMGR_LOW_SPEED_MODE
    287                          MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
    288                          Micro__SetLowSpeedMode();                     // This change the speed of the micro controller to the LowSpeed mode
    289                          TimerInterrupt__SetLongInterval();
    290                          MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
    291          
    292                          SRPowerMgr_Mode = SRPOWERMGR_LOW_SPEED_MODE;
    293                      }
    294                      else
    295                      {
    296                          #if (SRPOWERMGR_WAKEUP_SEQUENCE_GENERATOR == ENABLED)
    297                              if (SRPowerMgr_State != SRPOWERMGR_STATE_WAKEUP_ITSELF)
    298                              {
    299                                  SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_NETWORK_STATUS;
    300                              }
    301                          #endif
    302                          SRPowerMgr_Mode = SRPOWERMGR_NORMAL_SPEED_MODE;
    303                      }
    304                  #else
    305                      SRPowerMgr_Mode = SRPOWERMGR_NORMAL_SPEED_MODE;
    306                  #endif
    307              #endif
    308          }
    309          
    310          //---------------------------------------------------------------------------------------------------------------------
    311          /**
    312           *
    313           * @param mode
    314           * @return
    315           */
    316          
    317          
    318          BOOL_TYPE SRPowerMgr__GoLowPowerMode(void)
    319          {
    320              BOOL_TYPE result;
    321          
    322              result = TRUE;
    323          
    324              SRPOWERMGR__GO_LOW_POWER_RECEIVED();
    325          
    326              #if (SRPOWERMGR_LOWPOWER_MODE == 1)
    327                  //SRPOWERMGR_DEEP_SLEEP_MODE
    328                  SRPowerMgr_Mode = SRPOWERMGR_DEEP_SLEEP_MODE;
    329                  Micro__EnableWarmResetAction(MICRO_WARM_RESET_ACTION_ENTER_LOWPOWER);
    330                  Micro__GoSleep();
    331              #elif (SRPOWERMGR_LOWPOWER_MODE == 2)
    332                  //SRPOWERMGR_AUTO_WAKEUP_MODE
    333                  SRPowerMgr_Mode = SRPOWERMGR_AUTO_WAKEUP_MODE;
    334                  Micro__EnableWarmResetAction(MICRO_WARM_RESET_ACTION_ENTER_LOWPOWER);
    335                  Mode__SetMode(MODE_LOWPOWER);
    336              #elif (SRPOWERMGR_LOWPOWER_MODE == 3)
    337                  SRPowerMgr_Mode = SRPOWERMGR_LOW_SPEED_MODE;
    338                  Micro__EnableWarmResetAction(MICRO_WARM_RESET_ACTION_ENTER_LOWPOWER);
    339                  Mode__SetMode(MODE_LOWPOWER);
    340              #else
    341                  result = FALSE;
    342              #endif
    343          
    344              return result;
    345          }
    346          
    347          //---------------------------------------------------------------------------------------------------------------------
    348          /**
    349           *  @brief      It Initializes the module SRPowerMgr and its variables
    350           *
    351           */
    352          void SRPowerMgr__GoNormalMode(void)
    353          {
    354              #if (SRPOWERMGR_LOWPOWER_MODE != 0)
    355          
    356                  SRPowerMgr_Mode = SRPOWERMGR_NORMAL_SPEED_MODE;
    357                  Micro__DisableWarmResetAction(MICRO_WARM_RESET_ACTION_ENTER_LOWPOWER);
    358          
    359                  #if (SRPOWERMGR_IS_THIS_IS_INTERNAL_WAKEUP() == ENABLED)
    360                      SRPowerMgr_WakeUpTrig = SRPOWERMGR_WAKEUP_TRIG_INTERNAL;
    361                  #endif
    362          
    363                  #if (SRPOWERMGR_WAKEUP_SEQUENCE_GENERATOR == ENABLED)
    364                      SRPowerMgr_State = SRPOWERMGR_STATE_WAKEUP_ITSELF;
    365                  #else
    366                      Mode__SetMode(MODE_NORMAL);
    367                  #endif
    368              #endif
    369          }
    370          
    371          //---------------------------------------------------------------------------------------------------------------------
    372          /**
    373           *  @brief      It Initializes the module SRPowerMgr and its variables
    374           * @return
    375           */
    376          SRPOWERMGR_MODE SRPowerMgr__GetMode(void)
    377          {
    378              #if (SRPOWERMGR_LOWPOWER_MODE != 0)
    379                  return SRPowerMgr_Mode;
    380              #else
    381                  return (SRPOWERMGR_NORMAL_SPEED_MODE);
    382              #endif
    383          }
