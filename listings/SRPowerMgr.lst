    385          //---------------------------------------------------------------------------------------------------------------------
    386          /**
    387           *  @brief      It Initializes the module SRPowerMgr and its variables
    388           *
    389           * @return
    390           */
    391          //---------------------------------------------------------------------------------------------------------------------
    392          /**
    393           * @brief This API is called to check if this node was the source of the wake-up signal
    394           * @details This function should return FALSE if the wake-up wasn't generated in this board and TRUE is it was generated in this board
    395           */
    396          
    397          BOOL_TYPE SRPowerMgr__IsThisNodeWakeUpSource(void)
    398          {
    399              #if ((SRPOWERMGR_WAKEUP_SEQUENCE_GENERATOR == ENABLED) && (SRPOWERMGR_LOWPOWER_MODE != 0))
    400                  return (SRPowerMgr_IsThisWakeUpSource);
    401              #else
    402                      return(FALSE);
    403              #endif
    404          }
    405          
    406          //---------------------------------------------------------------------------------------------------------------------
    407          /**
    408           * @brief This function is called once another node publish a message letting the other nodes know that it generated the wake-up
    409           * @param node the parameter is the source of the wake-up signal
    410           */
    411          void SRPowerMgr__ReceivedWakeUpNodeID(uint8 node)
    412          {
    413              #if ((SRPOWERMGR_WAKEUP_SEQUENCE_GENERATOR == ENABLED) && (SRPOWERMGR_LOWPOWER_MODE != 0))
    414                  SRPowerMgr__ReceivedWakeUpNode = node;
    415              #endif
    416          }
    417          
    418          //---------------------------------------------------------------------------------------------------------------------
    419          /**
    420           *  @brief      It Initializes the module SRPowerMgr and its variables
    421           */
    422          void SRPowerMgr__Handler(void)
    423          {
    424              #if (SRPOWERMGR_LOWPOWER_MODE != 0)
    425          
    426                  uint16 node_status;
    427                  uint8 aux;
    428                  BOOL_TYPE network_status;
    429          
    430                  if (Mode__GetMode() == MODE_LOWPOWER)
    431                  {
    432                      #if (SRPOWERMGR_LOWPOWER_MODE == 1)
    433                          //SRPOWERMGR_DEEP_SLEEP_MODE
    434                      #elif (SRPOWERMGR_LOWPOWER_MODE == 2)
    435                          //SRPOWERMGR_AUTO_WAKEUP_MODE
    436                      #elif (SRPOWERMGR_LOWPOWER_MODE == 3)
    437                          //SRPOWERMGR_LOW_SPEED_MODE
    438                          if (SRPOWERMGR_LOW_SPEED_MODE_IS_READY_TO_WAKEUP() != 0)
    439                          {
    440                              SRPowerMgr__GoNormalMode();
    441                          }
    442                      #else
    443                      #endif
    444                  }
    445          
    446                  #if (SRPOWERMGR_WAKEUP_SEQUENCE_GENERATOR == ENABLED)
    447                      SRPowerMgr_Timeout++;
    448          
    449                      switch(SRPowerMgr_State)
    450                      {
    451                          case SRPOWERMGR_STATE_IDLE:
    452                              if (Mode__GetMode() == MODE_NORMAL)
    453                              {
    454                                  node_status = Reveal__GetNodestatus();
    455                                  network_status = TRUE;
    456          
    457                                  for (aux = 0; aux < sizeof(SRPOWERMGR_WAKEUP_LIST)/sizeof(SRPOWERMGR_WAKEUP_TYPE); aux++)
    458                                  {
    459                                      if(BIT_TEST(node_status, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Node) == 0)
    460                                      {
    461                                          network_status = FALSE;
    462                                          break;
    463                                      }
    464                                  }
    465          
    466                                  if (network_status == FALSE)
    467                                  {
    468                                      SRPowerMgr_Timeout = 0;
    469                                      SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_NETWORK_STATUS;
    470                                  }
    471                              }
    472                              break;
    473          
    474                          case SRPOWERMGR_STATE_WAKEUP_ITSELF:
    475                              if (Mode__GetMode() == MODE_LOWPOWER)
    476                              {
    477                                  Mode__SetMode(MODE_NORMAL);
    478                              }
    479                              else
    480                              {
    481                                  SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_COM_STATUS;
    482                              }
    483          
    484                              SRPowerMgr_Timeout = 0;
    485                              break;
    486          
    487                          case SRPOWERMGR_STATE_CHECK_COM_STATUS:
    488                              if (Win__GetBusStatus(WIN_BUS_STATUS_RX_PIN) == TRUE)
    489                              {
    490                                  if (SRPowerMgr_WakeUpTrig == SRPOWERMGR_WAKEUP_TRIG_INTERNAL)
    491                                  {
    492                                      SRPowerMgr_Timeout = SRPOWERMGR_NODE_RESPONSE_TIMEOUT_AFTER_WAKEUP_SEQUENCE_IN_COUNT;
    493                                      SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_NETWORK_STATUS;
    494                                  }
    495                                  else
    496                                  {
    497                                      SRPowerMgr_State = SRPOWERMGR_STATE_REQUEST_WAKEUPSOURCCE;
    498                                  }
    499                              }
    500                              else
    501                              {
    502                                  if (SRPowerMgr_Timeout > SRPOWERMGR_COM_CHECK_TIMEOUT_IN_COUNT)
    503                                  {
    504                                      SRPowerMgr_State = SRPOWERMGR_STATE_IDLE;
    505                                  }
    506                              }
    507                              break;
    508          
    509                          case SRPOWERMGR_STATE_REQUEST_WAKEUPSOURCCE:
    510                              API009System__RequestWakeUpSource();
    511                              SRPowerMgr_Timeout = 0;
    512                              SRPowerMgr__ReceivedWakeUpNode  = SRPOWERMGR_INVALID_WAKEUP_NODE;
    513                              SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_WAKEUPSOURCCE;
    514                              break;
    515          
    516                          case SRPOWERMGR_STATE_CHECK_WAKEUPSOURCCE:
    517                              if (SRPowerMgr_Timeout < SRPOWERMGR_FEEDBACK_MESSAGE_TIMEOUT_COUNT)
    518                              {
    519                                  if (SRPowerMgr__ReceivedWakeUpNode  != SRPOWERMGR_INVALID_WAKEUP_NODE)
    520                                  {
    521                                      //found the wakeup source
    522                                      SRPowerMgr_State = SRPOWERMGR_STATE_IDLE;
    523                                  }
    524                              }
    525                              else
    526                              {
    527                                  //I am the wakeup source
    528                                  if (SRPOWERMGR_IS_WAKEUP_CONDITION_MET())
    529                                  {
    530                                      SRPowerMgr_IsThisWakeUpSource = TRUE;
    531                                      SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_NETWORK_STATUS;
    532                                  }
    533                                  else
    534                                  {
    535                                      //then its an error
    536                                      SRPowerMgr_State = SRPOWERMGR_STATE_IDLE;
    537                                      SRPowerMgr__GoLowPowerMode();
    538                                  }
    539                              }
    540          
    541                              SRPowerMgr_WakeUpRetry = 0;
    542                              break;
    543          
    544                          case SRPOWERMGR_STATE_CHECK_NETWORK_STATUS:
    545                              //This time is to wakeup the other nodes after the Wakeup sequence
    546                              node_status = Reveal__GetNodestatus();
    547                              network_status = TRUE;
    548          
    549                              for (aux = 0; aux < sizeof(SRPOWERMGR_WAKEUP_LIST)/sizeof(SRPOWERMGR_WAKEUP_TYPE); aux++)
    550                              {
    551                                  if(BIT_TEST(node_status, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Node) == 0)
    552                                  {
    553                                      network_status = FALSE;
    554                                      break;
    555                                  }
    556                              }
    557          
    558                              if (network_status == TRUE)
    559                              {
    560                                  //All are alive
    561                                  SRPOWERMGR_WAKEUP_SEQUENCE_COMPLETE();
    562                                  SRPowerMgr_State = SRPOWERMGR_STATE_IDLE;
    563                              }
    564                              else if (SRPowerMgr_Timeout > SRPOWERMGR_NODE_RESPONSE_TIMEOUT_AFTER_WAKEUP_SEQUENCE_IN_COUNT)
    565                              {
    566                                  SRPowerMgr_State = SRPOWERMGR_STATE_WAKEUP_OTHERS_SEQ1;
    567                              }
    568          
    569                              break;
    570          
    571                          case SRPOWERMGR_STATE_WAKEUP_OTHERS_SEQ1:
    572                              for (aux = 0; aux < sizeof(SRPOWERMGR_WAKEUP_LIST)/sizeof(SRPOWERMGR_WAKEUP_TYPE); aux++)
    573                              {
    574                                  if (Win__GetBusStatus(WIN_BUS_STATUS_BREAK_OUT) == FALSE)
    575                                  {
    576                                      Win__SendBreak();
    577                                  }
    578          
    579                                  if (SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port != PORT_NULL)
    580                                  {
    581                                      //De assert
    582                                      Gpio__PinWrite(SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Pin, (BOOL_TYPE)((SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Value ^ 0x01) & 0x01));
    583          
    584                                      Gpio__PinConfig(SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Pin, OUTPUT_PUSHPULL);
    585          
    586                                      //assert
    587                                      Gpio__PinWrite(SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Pin, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Value);
    588                                  }
    589          
    590                                  if (SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Func != SRPOWER_ACTIVATION_FUNC_NULL)
    591                                  {
    592                                      SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Func();
    593                                  }
    594                              }
    595          
    596                              SRPowerMgr_Timeout  = 0;
    597                              SRPowerMgr_State = SRPOWERMGR_STATE_WAKEUP_OTHERS_SEQ2;
    598          
    599                              break;
    600          
    601                          case SRPOWERMGR_STATE_WAKEUP_OTHERS_SEQ2:
    602                              if (SRPowerMgr_Timeout > SRPOWERMGR_EXECUTE_WAKEUP_SEQUENCE_IN_COUNT)
    603                              {
    604                                  Win__StopBreak();
    605          
    606                                  for (aux = 0; aux < sizeof(SRPOWERMGR_WAKEUP_LIST)/sizeof(SRPOWERMGR_WAKEUP_TYPE); aux++)
    607                                  {
    608                                      if (SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port != PORT_NULL)
    609                                      {
    610                                          //De assert
    611                                          Gpio__PinWrite(SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Pin, (BOOL_TYPE)((SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Value ^ 0x01) & 0x01));
    612                                          Gpio__PinConfig(SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Port, SRPOWERMGR_WAKEUP_LIST[aux].WakeUp_Pin, OUTPUT_PUSHPULL);
    613                                      }
    614                                  }
    615          
    616                                  SRPowerMgr_WakeUpRetry++;
    617                                  if (SRPowerMgr_WakeUpRetry >= SRPOWERMGR_WAKEUP_RETRY)
    618                                  {
    619                                      //Failed to wakeup the network
    620                                      SRPOWERMGR_FAILED_TO_WAKEUP_NETWORK();
    621          
    622                                      SRPowerMgr_State = SRPOWERMGR_STATE_FAILED_TO_WAKEUP_NETWORK;
    623                                  }
    624                                  else
    625                                  {
    626                                      SRPowerMgr_Timeout = 0;
    627                                      SRPowerMgr_State = SRPOWERMGR_STATE_CHECK_NETWORK_STATUS;
    628                                  }
    629                              }
    630                              break;
    631          
    632                          case SRPOWERMGR_STATE_FAILED_TO_WAKEUP_NETWORK:
    633                              break;
    634          
    635                          default:
    636                              SRPowerMgr_State = SRPOWERMGR_STATE_IDLE;
    637                              break;
    638                      }
    639                  #endif
    640              #endif
    641          }
    642          
    643          //=====================================================================================================================
    644          //-------------------------------------- Private Functions ------------------------------------------------------------
    645          //=====================================================================================================================
    646          #endif  //LOW_POWER_FEATURE


 

 


