    462          static void Emf_Calc(MCL_OBSERVER_IO_F_TYPE *io)
    463          {
    464              /*! Emf calculation:
    465               * \f[
    466               * \begin{aligned}
    467               *      & Emf_{alpha} = v_{alpha} - R_{s} * i_{alpha} - vdt_{alpha} \\
    468               *      & Emf_{beta} =  v_{beta}  - R_{s} * i_{beta}  - vdt_{beta} \\
    469               * \end{aligned}
    470               * \f]
    471               */
    472          
    473              // EMF Alpha calculation
    474              Stator_Emf.Alpha  = (io->Vs_Alpha_Beta->Alpha) - (*(io->Ctrl_Specific->Stator_Resistance) * (io->Is_Alpha_Beta->Alpha));
    475          
    476              // EMF Beta calculation
    477              Stator_Emf.Beta   = (io->Vs_Alpha_Beta->Beta)  - (*(io->Ctrl_Specific->Stator_Resistance) * (io->Is_Alpha_Beta->Beta ));
    478          
    479          #if (OBS__INVERTER_DISTORSION_COMPENSATION == ENABLED)
    480              Stator_Emf.Alpha -= Inverter_Distortion.Alpha;
    481              Stator_Emf.Beta -= Inverter_Distortion.Beta;
    482          #endif
    483          
    484              Stator_Emf.Alpha -= Stator_Resistance_Corr * (io->Is_Alpha_Beta->Alpha);
    485              Stator_Emf.Beta  -= Stator_Resistance_Corr * (io->Is_Alpha_Beta->Beta );
    486          
    487          }
    488          
