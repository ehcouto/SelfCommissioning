    363          #if (OBS__VOLTAGE_PHASE_SHIFT == ENABLED)
    364          //========================================================//
    365          //          Phase Shift on reconstructed voltage          //
    366          //========================================================//
    367          static void Voltage_Phase_Shift(MCL_OBSERVER_IO_F_TYPE *io, MCLOBSERVER_JOINT_PARAMS_TYPE *params)
    368          {
    369              ALPHA_BETA_COOR_SYST_F_TYPE vs_alpha_beta;
    370              DQ_COOR_SYST_F_TYPE vs_dq;
    371              float32 angle_advance;
    372              SIN_COS_F_TYPE sin_cos_adv;
    373              ALPHA_BETA_COOR_SYST_F_TYPE tmp_dq_adv;
    374          
    375          
    376              vs_alpha_beta.Alpha = io->Vs_Alpha_Beta->Alpha;
    377              vs_alpha_beta.Beta  = io->Vs_Alpha_Beta->Beta;
    378          
    379              // from vs alpha\beta to vs in dq stator flux reference frame
    380              ClrkPark__DirectParkF(&vs_alpha_beta,&vs_dq,io->Sin_Cos_Position_Flux);
    381          
    382              angle_advance = ( *(io->Ctrl_Specific->Speed_Rotor_Observed) * params->ObsAddPrm->Phase_Advance_Coeff);
    383          
    384              MathCalc__SinCosF(angle_advance,  &sin_cos_adv);
    385          
    386              ClrkPark__InverseParkF(&vs_dq, &tmp_dq_adv,  &sin_cos_adv);
    387          
    388              vs_dq.D = tmp_dq_adv.Alpha;
    389              vs_dq.Q = tmp_dq_adv.Beta;
    390          
    391              //==========================================================================//
    392              //                Inverse Park transformation (dq-alpha beta)               //
    393              //==========================================================================//
    394              ClrkPark__InverseParkF(&vs_dq, io->Vs_Alpha_Beta, io->Sin_Cos_Position_Flux);
    395          
    396          }
    397          #endif
