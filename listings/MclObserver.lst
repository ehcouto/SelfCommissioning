    511          static void RotorFlux_Correction(MCL_OBSERVER_IO_F_TYPE *io, MCLOBSERVER_JOINT_PARAMS_TYPE *params)
    512          {
    513              float32 temp;
    514          
    515              temp = *(io->Ctrl_Specific->Is_Abs);
    516              *(io->Ctrl_Specific->Rotor_Flux) = MathCalc__GetInterpolationFastF(temp, &params->Rotor_Flux_lut);
    517          }
    518          
    519          
    520          #if (OBS__SWAP_ANGLE_IN_LOCKED_ROTOR == ENABLED)
    521          #ifdef __IAR_SYSTEMS_ICC__
    522          #pragma inline = forced
    523          #endif
    524          static void SwapPhase_Correction(MCL_OBSERVER_IO_F_TYPE *io, MCL_OBSERVER_ADDITIONAL_PARAMS_TYPE *params)
    525          {
    526              float32 temp_1;
    527          
    528              if((*(io->Ctrl_Specific->Speed_Rotor_Observed_Mech_Abs) <= (params->Swap_Phase_Speed_Thr))&& \
    529                 (*(io->Ctrl_Specific->Is_Abs) > (params->Swap_Phase_Current_Thr))&& \
    530                   (Swap_Phase_Flag == 0)&& \
    531                   (params->Swap_Phase_Time_Thr != 0))
    532              {
    533                  Swap_Phase_Cnt++;
    534          
    535                  if(Swap_Phase_Cnt > params->Swap_Phase_Time_Thr)
    536                  {
    537                      Swap_Phase_Flag = 1;
    538                      Swap_Phase_Cnt = 0;
    539          
    540                      dLambdas_alpha_old = Stator_Emf.Alpha;
    541                      dLambdas_beta_old = Stator_Emf.Beta;
    542          
    543                      if(*(io->Ctrl_Specific->Torque) < 0.0f)
    544                      {// park transformation of 90°
    545                          temp_1 = Cos_Rot_k1;
    546                          Cos_Rot_k1 = Sin_Rot_k1;
    547                          Sin_Rot_k1 = -temp_1;
    548          
    549                          temp_1 = Rotor_Flux.Alpha;
    550                          Rotor_Flux.Alpha = Rotor_Flux.Beta;
    551                          Rotor_Flux.Beta = -temp_1;
    552                      }
    553                      else
    554                      {// park transformation of -90°
    555                          temp_1 = Cos_Rot_k1;
    556                          Cos_Rot_k1 = -Sin_Rot_k1;
    557                          Sin_Rot_k1 = temp_1;
    558          
    559                          temp_1 = Rotor_Flux.Alpha;
    560                          Rotor_Flux.Alpha = -Rotor_Flux.Beta;
    561                          Rotor_Flux.Beta = temp_1;
    562                      }
    563          
    564                      Stator_Flux.Alpha = Rotor_Flux.Alpha + (io->Ctrl_Specific->Ldq_Ind->Q) * io->Is_Alpha_Beta->Alpha;
    565                      Stator_Flux.Beta  = Rotor_Flux.Beta  + (io->Ctrl_Specific->Ldq_Ind->Q) * io->Is_Alpha_Beta->Beta;
    566                  }
    567              }
    568          }
    569          #endif
