    571          
    572          //---------------------------------------------------------------------------------------------------------------------
    573          /**
    574           *  @brief      Stator flux observer (Generic) which supports salient motors, it contains more updates from Prof. Radu.
    575           *
    576           *  @param      motor phase voltages and phase currents => which will result in stator flux, rotor flux and speed computations.
    577           *  @return     none.
    578           */
    579          #ifdef __IAR_SYSTEMS_ICC__
    580          #pragma inline = forced
    581          #endif
    582          static void StatorFlux_Calc(MCL_OBSERVER_IO_F_TYPE *io, MCL_OBSERVER_PARAMS_TYPE *params)
    583          {
    584              float32 temp_1;
    585              float32 dLambdas_alpha;
    586              float32 dLambdas_beta;
    587              MATHCALC_MOD_SIN_COS_F_TYPE trig_alpha_beta_mod;
    588          
    589              float32 sin_rot;
    590              float32 cos_rot;
    591          
    592              float32 stator_flux_fbk_d;
    593              float32 stator_flux_fbk_q;
    594              float32 stator_flux_fbk_alpha;
    595              float32 stator_flux_fbk_beta;
    596              float32 stator_flux_fbk_d_forward;
    597              float32 error_flux_alpha;
    598              float32 error_flux_beta;
    599          
    600          
    601              float32 load_angle_cos;
    602              float32 load_angle_sin;
    603          
    604          #if (OBS__ROTOR_MECH_POSITION  == ENABLED)  // not used
    605              float32 rotor_pos_delta;
    606          #endif
    607          
    608          
    609              //******************************************************************//
    610              //                                                                  //
    611              //              Integrate the emf to find the stator flux           //
    612              //                                                                  //
    613              //******************************************************************//
    614          
    615              //// Alpha flux - trapezoidal integration
    616              dLambdas_alpha  = Stator_Emf.Alpha + Stator_Emf_Err.Alpha;
    617              Stator_Flux.Alpha += (dLambdas_alpha + dLambdas_alpha_old) * PARAMS_EMF_INT_CONSTANT;
    618              dLambdas_alpha_old = dLambdas_alpha;
    619          
    620          
    621          
    622              //// Beta flux - trapezoidal integration
    623              dLambdas_beta  = Stator_Emf.Beta + Stator_Emf_Err.Beta;
    624              Stator_Flux.Beta += (dLambdas_beta + dLambdas_beta_old) * PARAMS_EMF_INT_CONSTANT;
    625              dLambdas_beta_old = dLambdas_beta;
    626          
    627          
    628          
    629              //******************************************************************//
    630              //                                                                  //
    631              //                     Estimate rotor flux                          //
    632              //                                                                  //
    633              //******************************************************************//
    634              // Alpha axis rotor flux
    635              Rotor_Flux.Alpha = Stator_Flux.Alpha - (io->Ctrl_Specific->Ldq_Ind->Q) * io->Is_Alpha_Beta->Alpha;
    636              // Beta axis rotor flux
    637              Rotor_Flux.Beta  = Stator_Flux.Beta  - (io->Ctrl_Specific->Ldq_Ind->Q) * io->Is_Alpha_Beta->Beta;
    638          
    639              // Magnitude (modulus) rotor flux
    640              temp_1 =  Rotor_Flux.Alpha*Rotor_Flux.Alpha + Rotor_Flux.Beta*Rotor_Flux.Beta;
    641              Rotor_Flux_Mod = MC_SQRT_F(temp_1);  // Result in Q17.15
    642          
    643          
    644          
    645          
    646              //******************************************************************//
    647              //                                                                  //
    648              //                   ROTOR Sin and Cos calculations                 //
    649              //                                                                  //
    650              //******************************************************************//
    651              trig_alpha_beta_mod.Alpha = Rotor_Flux.Alpha;
    652              trig_alpha_beta_mod.Beta  = Rotor_Flux.Beta;
    653              trig_alpha_beta_mod.Mod = Rotor_Flux_Mod;
    654              MathCalc__GetSinCosF(&trig_alpha_beta_mod);
    655              sin_rot = trig_alpha_beta_mod.Sin;
    656              cos_rot = trig_alpha_beta_mod.Cos;
    657          
    658          
    659          
    660              //******************************************************************//
    661              //                                                                  //
    662              //             Id & Iq calculation => Transformation to             //
    663              //                     the ROTOR reference frame                    //
    664              //                                                                  //
    665              //******************************************************************//
    666              Rotor_Curr_Id = ((io->Is_Alpha_Beta->Alpha) * cos_rot) + ((io->Is_Alpha_Beta->Beta) * sin_rot);
    667              Rotor_Curr_Id_Abs = MATHCALC__FABS(Rotor_Curr_Id);
    668              *io->Ctrl_Specific->Id_Rotor_Current = Rotor_Curr_Id;
    669          
    670          
    671              Rotor_Curr_Iq = ((-(io->Is_Alpha_Beta->Alpha)) * sin_rot) + ((io->Is_Alpha_Beta->Beta) * cos_rot);
    672              Rotor_Curr_Iq_Abs = MATHCALC__FABS(Rotor_Curr_Iq);
    673          
    674              // Compute stator flux components in (d,q) frame from magnetic model
    675              stator_flux_fbk_d  = *(io->Ctrl_Specific->Rotor_Flux) + Rotor_Curr_Id * (io->Ctrl_Specific->Ldq_Ind->D);
    676              stator_flux_fbk_q  = Rotor_Curr_Iq * (io->Ctrl_Specific->Ldq_Ind->Q);
    677          
    678              stator_flux_fbk_d  = stator_flux_fbk_d - (Rotor_Curr_Iq_Abs * (*io->Ctrl_Specific->Ldq_Cross_Ind));
    679              stator_flux_fbk_q  = stator_flux_fbk_q - (Rotor_Curr_Id * (*io->Ctrl_Specific->Lqd_Cross_Ind));
    680          
    681          
    682          
    683              //******************************************************************//
    684              //                                                                  //
    685              //             Transform fluxes back to stationary frame            //
    686              //                                                                  //
    687              //******************************************************************//
    688              stator_flux_fbk_alpha  = stator_flux_fbk_d * cos_rot - stator_flux_fbk_q * sin_rot;
    689              stator_flux_fbk_beta   = stator_flux_fbk_d * sin_rot + stator_flux_fbk_q * cos_rot;
    690          
    691              // flux error calculation
    692              error_flux_alpha = stator_flux_fbk_alpha - Stator_Flux.Alpha;
    693              error_flux_beta  = stator_flux_fbk_beta  - Stator_Flux.Beta;
    694          
    695              Stator_Emf_Err.Alpha = error_flux_alpha * (params->Observer_G_gain);
    696              Stator_Emf_Err.Beta  = error_flux_beta  * (params->Observer_G_gain);
    697          
    698          
    699              // Integral action
    700              temp_1 = Error_Flux_Alpha_1 + error_flux_alpha * params->Observer_G_integ_gain;
    701              Error_Flux_Alpha_1 = MATHCALC__SATURATE(Err_Lim_Lower, temp_1, Err_Lim_Upper); // limit the integral
    702              Stator_Emf_Err.Alpha += Error_Flux_Alpha_1;
    703          
    704              temp_1 = Error_Flux_Beta_1 + error_flux_beta *  params->Observer_G_integ_gain;
    705              Error_Flux_Beta_1 = MATHCALC__SATURATE(Err_Lim_Lower, temp_1, Err_Lim_Upper); // limit the integral
    706              Stator_Emf_Err.Beta += Error_Flux_Beta_1;
    707          
    708              //******************************************************************//
    709              //                                                                  //
    710              //      Stator flux magnitude and Angle Sin and Cos calculations    //
    711              //                                                                  //
    712              //******************************************************************//
    713          	if (io->Ctrl_Specific->flags.bit.overflux_active == 1)
    714              {
    715          	    // if overflux is active, stator flux angle is calculated from current model data
    716                  trig_alpha_beta_mod.Alpha = stator_flux_fbk_alpha;
    717                  trig_alpha_beta_mod.Beta  = stator_flux_fbk_beta;
    718              }
    719              else
    720              {
    721                  // if overflux is disabled, stator flux angle is calculated from voltage model data
    722                  trig_alpha_beta_mod.Alpha = Stator_Flux.Alpha;
    723                  trig_alpha_beta_mod.Beta  = Stator_Flux.Beta;
    724              }
    725          
    726              // Square the stator flux, sum and take the square root.
    727              temp_1 = trig_alpha_beta_mod.Alpha * trig_alpha_beta_mod.Alpha + trig_alpha_beta_mod.Beta  * trig_alpha_beta_mod.Beta;
    728          
    729          	// Stator flux magnitute calculation
    730              *(io->Ctrl_Specific->Stator_Flux_Mag) = MC_SQRT_F(temp_1);
    731          
    732          
    733              // Stator flux sin cos calculation
    734              trig_alpha_beta_mod.Mod   = *(io->Ctrl_Specific->Stator_Flux_Mag);
    735              MathCalc__GetSinCosF(&trig_alpha_beta_mod);
    736              io->Sin_Cos_Position_Flux->Sin = trig_alpha_beta_mod.Sin;
    737              io->Sin_Cos_Position_Flux->Cos = trig_alpha_beta_mod.Cos;
    738          
    739          
    740              *(io->Ctrl_Specific->Id_stator_current) =  (io->Is_Alpha_Beta->Alpha) * (io->Sin_Cos_Position_Flux->Cos) + (io->Is_Alpha_Beta->Beta) * (io->Sin_Cos_Position_Flux->Sin);
    741              *(io->Ctrl_Specific->Iq_stator_current) = -(io->Is_Alpha_Beta->Alpha) * (io->Sin_Cos_Position_Flux->Sin) + (io->Is_Alpha_Beta->Beta) * (io->Sin_Cos_Position_Flux->Cos);
    742          
    743          
    744          #if (OBS__ROTOR_MECH_POSITION  == ENABLED)  // not used
    745              //******************************************************************//
    746              //                                                                  //
    747              //        Calculate accurately the mechanical rotor position        //
    748              //                                                                  //
    749              //******************************************************************//
    750              Rotor_Position = MC_ATAN2_F(cos_rot, sin_rot);
    751             // rotor_pos_delta = Rotor_Position - Last_Mech_Rotor_Pos;
    752             // Rotor_Mech_Position += (rotor_pos_delta + Mech_Rotor_Pos_Acc_Err) / (params->Pole_Pairs);
    753             // Mech_Rotor_Pos_Acc_Err = (rotor_pos_delta + Mech_Rotor_Pos_Acc_Err) % (params->Pole_Pairs);
    754             // Last_Mech_Rotor_Pos = Rotor_Position;
    755              *(io->Rotor_Position) = Rotor_Position;
    756          
    757          #endif
    758          
    759              //******************************************************************//
    760              //                                                                  //
    761              //       Compute load angle using the same (d,q) stator flux        //
    762              //           components, but computed from (alpha,beta)             //
    763              //                    forward path components                       //
    764              //                                                                  //
    765              //******************************************************************//
    766              load_angle_cos = io->Sin_Cos_Position_Flux->Cos * cos_rot + io->Sin_Cos_Position_Flux->Sin *sin_rot;
    767              load_angle_sin = io->Sin_Cos_Position_Flux->Sin * cos_rot - io->Sin_Cos_Position_Flux->Cos *sin_rot;
    768          
    769              io->Ctrl_Specific->Load_Angle_Sin_Cos->Cos = load_angle_cos;
    770              io->Ctrl_Specific->Load_Angle_Sin_Cos->Sin = load_angle_sin;
    771          #if(OBS__LOAD_ANGLE_CALCULATION == ENABLED)  // avoid performing load angle calculation if not needed
    772                  *(io->Load_Angle) = MC_ATAN2_F((load_angle_cos), (load_angle_sin));
    773          #endif
    774          
    775          
    776          
    777              //******************************************************************//
    778              //                                                                  //
    779              //              Compute error for stability improvement             //
    780              //                                                                  //
    781              //******************************************************************//
    782          
    783          
    784              //This equation helps on steady state stability at low load (rs correction works fine)
    785              //However the term LdObs*curr_id introduced a big error_flux at starting which may cause failures
    786              stator_flux_fbk_d_forward  = Stator_Flux.Alpha * cos_rot + Stator_Flux.Beta  * sin_rot;
    787              Flux_Error  = stator_flux_fbk_d_forward - stator_flux_fbk_d;
    788          
    789          
    790          
    791              //******************************************************************//
    792              //                                                                  //
    793              //     Calculate speed from rotor frame and low pass filter it      //
    794              //                                                                  //
    795              //******************************************************************//
    796              temp_1 = (sin_rot * Cos_Rot_k1) - (Sin_Rot_k1 * cos_rot);
    797              Obs_Speed_Rotor_Flux = temp_1 * (1.0f/TSW);
    798          
    799              // Save the previous rotor sine and cosine
    800              Sin_Rot_k1 = sin_rot;
    801              Cos_Rot_k1 = cos_rot;
    802          }
    803          
    804          
    805          
    806          
    807          
    808          #ifdef __IAR_SYSTEMS_ICC__
    809          #pragma inline = forced
    810          #endif
    811          /*==========================================================================*/
    812          /*                         Speed Calculation                                */
    813          /*==========================================================================*/
    814          static void Speed_PLL_Calc()
    815          {
    816              Speed_PLL.in_alpha = Cos_Rot_k1;
    817              Speed_PLL.in_beta  = Sin_Rot_k1;
    818          
    819              PLL__fCalc(&Speed_PLL);
    820          }
    821          
    822          
    823          #ifdef __IAR_SYSTEMS_ICC__
    824          #pragma inline = forced
    825          #endif
    826          static void PLL__fReset(XPLL_TYPE *XPLLVars)
    827          {
    828              XPLLVars->speed = 0.0f;
    829              XPLLVars->speed_old = 0.0f;
    830              XPLLVars->error = 0.0f;
    831              XPLLVars->error_old = 0.0f;
    832              XPLLVars->integral = 0.0f;
    833              XPLLVars->angle = 0.0f;
    834          
    835              XPLLVars->alpha = 0.0f;
    836              XPLLVars->beta = 0.0f;
    837              XPLLVars->in_alpha = 0.0f;
    838              XPLLVars->in_beta = 0.0f;
    839          }
    840          
    841          
    842          #ifdef __IAR_SYSTEMS_ICC__
    843          #pragma inline = forced
    844          #endif
    845          static void PLL__fCalc(XPLL_TYPE *XPLLVars)
    846          {
    847              SIN_COS_F_TYPE sin_cos;
    848          
    849              MathCalc__SinCosF(XPLLVars->angle, &sin_cos);
    850          
    851              XPLLVars->alpha =  sin_cos.Cos;
    852              XPLLVars->beta  = -sin_cos.Sin;
    853          
    854              XPLLVars->error =  (XPLLVars->in_alpha * XPLLVars->beta) + (XPLLVars->in_beta * XPLLVars->alpha);
    855          
    856              XPLLVars->integral += (XPLLVars->error + XPLLVars->error_old) * (XPLLVars->ki);
    857              XPLLVars->error_old = XPLLVars->error;
    858              XPLLVars->speed = XPLLVars->integral + XPLLVars->error * XPLLVars->kp;
    859              XPLLVars->angle += (XPLLVars->speed + XPLLVars->speed_old) * XPLLVars->integ_k;
    860              XPLLVars->speed_old = XPLLVars->speed;
    861          
    862          #if(OBS__PLL_FILTERED_OMEGA == ENABLED)
    863          	// use integral + fraction of proportional as filtered speed
    864          #ifdef OBS__PLL_FILTERED_OMEGA_COEF
    865              XPLLVars->speed = XPLLVars->integral + OBS__PLL_FILTERED_OMEGA_COEF*XPLLVars->error * XPLLVars->kp; //add this line to reduce speed ripple;
    866          #else
    867              XPLLVars->speed = XPLLVars->integral;
    868          #endif
    869          #endif
    870          
    871              if(XPLLVars->angle > PI)
    872              {
    873                  XPLLVars->angle -= (2.0f * PI);
    874              }
    875          
    876              if(XPLLVars->angle < (-PI))
    877              {
    878                  XPLLVars->angle += (2.0f * PI);
    879              }
    880          }
