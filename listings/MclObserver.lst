    917          static void Speed_Selector_Check(MCL_OBSERVER_IO_F_TYPE *io, MCLOBSERVER_JOINT_PARAMS_TYPE *params)
    918          {
    919              BOOL_TYPE speed_cond_1;
    920              BOOL_TYPE speed_cond_2;
    921              BOOL_TYPE speed_cond_3;
    922          
    923              speed_cond_1 = (BOOL_TYPE) (MATHCALC__FABS(Obs_Speed_Rotor_Flux_sum) > params->ObsAddPrm->Pll_Engage_Speed_Thr);
    924              speed_cond_2 = (BOOL_TYPE) (MATHCALC__FABS(Obs_Speed_Rotor_Flux_sum-Speed_PLL.speed) < params->ObsAddPrm->Pll_Engage_Speed_Err_Thr);
    925              speed_cond_3 = (BOOL_TYPE) (io->Ctrl_Specific->flags.bit.wrong_speed_direction == 0);
    926          
    927              // condition for speed commutation to pll
    928              if (io->Ctrl_Specific->flags.bit.pll_engaged == 0)
    929              {
    930                  if (speed_cond_1  && speed_cond_2 && speed_cond_3)
    931                  {
    932                      Speed_Transition_Counter++;
    933                  }
    934                  else
    935                  {
    936                      Speed_Transition_Counter = 0;
    937                  }
    938                  if( Speed_Transition_Counter > (params->ObsPrm->Pll_Starting_Threshold))
    939                  {
    940                      io->Ctrl_Specific->flags.bit.pll_engaged = 1;
    941                      io->Ctrl_Specific->flags.bit.wait_pll_engagement = 0;
    942                  }
    943              }
    944              else
    945              {
    946                  if (speed_cond_1 == FALSE)
    947                  {
    948                      io->Ctrl_Specific->flags.bit.pll_engaged = 0;
    949                      io->Ctrl_Specific->flags.bit.wait_pll_engagement = 1;
    950                  }
    951              }
    952          
    953          
    954              if( *(io->Ctrl_Specific->Lowers_On) )
    955              {
    956                  // Rotor speed is being used when applying lowers on because since PLL gets lost.
    957                  io->Ctrl_Specific->flags.bit.pll_engaged = 0;
    958              }
    959          
    960          }
    961          
    962          
    963          //==========================================================================//
    964          //                       Torque estimator                                   //
    965          /*! Torque estimation is given by:
    966           * \f[
    967           * \begin{aligned}
    968           *      & \hat{T}_e = \hat{\lambda}_{s_{alpha}} * i_{beta} - \hat{\lambda}_{s_{beta}} * i_{alpha} \\
    969           * \end{aligned}
    970           * \f]
    971           */
    972          //==========================================================================//
    973          //uint8 EM_Torque_By_Flux = 1;
    974          #ifdef __IAR_SYSTEMS_ICC__
    975          #pragma inline = forced
    976          #endif
    977          static void ElectroMagneticTorqueCalc(MCL_OBSERVER_IO_F_TYPE *io, MCL_OBSERVER_PARAMS_TYPE *params)
    978          {
    979              float32 tmp_1;
    980              float32 tmp_2;
    981          
    982              if(io->Ctrl_Specific->flags.bit.overflux_active == 0)
    983              {
    984              	EM_Torque = Stator_Flux.Alpha * io->Is_Alpha_Beta->Beta - Stator_Flux.Beta * io->Is_Alpha_Beta->Alpha;
    985              }
    986              else
    987              {
    988          		tmp_1  = *(io->Ctrl_Specific->Rotor_Flux) * Rotor_Curr_Iq;
    989          		tmp_2 = (Rotor_Curr_Iq*Rotor_Curr_Id);
    990          		EM_Torque = tmp_1 + ((io->Ctrl_Specific->Ldq_Ind->D - io->Ctrl_Specific->Ldq_Ind->Q)*tmp_2);
    991              }
    992          
    993              // Low pass filter the electromagnetic torque
    994              EM_Torque = 1.5f * params->Pole_Pairs * EM_Torque;
    995          
    996              EM_Torque_Filt_Sum = FILTERS__LOWPASSFILTER_F(EM_Torque_Filt_Sum, EM_TORQUE_LPF_COEF, EM_Torque);
    997              *(io->Ctrl_Specific->Torque) = EM_Torque_Filt_Sum;
    998          }

