     43          /**
     44           *  @brief      Back-EMF observer for PMSM motor.
     45           *  @details
     46           *
     47           * That observer estimates the D-Q components of back-emf generated by the permanent magnet flux on the stator windings according to the following equations:
     48           *
     49           *
     50           * \f[
     51           *  \begin{aligned}
     52           *     &\frac{\hat{dI_{d}}(t)}{dt}  =  -\frac{R}{L_{d}}\cdot {\hat{I}_{d}(t)} +\frac{1}{L_{d}}\cdot {\hat{E}_{d}(t)} + \frac{1}{L_{d}}\cdot {(V_{sd}(t)+ L_{q}w_{el}{I}_{q}(t))}\\
     53           *     &\frac{\hat{dI_{q}}(t)}{dt}  =  -\frac{R}{L_{d}}\cdot {\hat{I}_{q}(t)} +\frac{1}{L_{d}}\cdot {\hat{E}_{q}(t)} + \frac{1}{L_{d}}\cdot {(V_{sq}(t)- L_{q}w_{el}{I}_{d}(t))}\\
     54           *     &\frac{\hat{dE_{d}}(t)}{dt}  =  K_{i}\cdot {(I_{d}(t) - \hat{I}_{d}(t))} +K_{p}\cdot {(\frac{dI_{d}(t)}{dt} - \frac{\hat{dI_{d}}(t)}{dt})} \\
     55           *       &\frac{\hat{dE_{q}}(t)}{dt}  =  K_{i}\cdot {(I_{q}(t) - \hat{I}_{q}(t))} +K_{p}\cdot {(\frac{dI_{q}(t)}{dt} - \frac{\hat{dI_{q}}(t)}{dt})} \\
     56           *  \end{aligned}
     57           * \f]
     58           *
     59           * where
     60           *
     61           * \f$ V_{d} \f$: voltage on d axis
     62           *
     63           * \f$ V_{q} \f$: voltage on q axis
     64           *
     65           * \f$ I_{d} \f$: current on d axis
     66           *
     67           * \f$ I_{q} \f$: current on q axis
     68           *
     69           * \f$ \hat{I_{d}} \f$: estimated current on d axis
     70           *
     71           * \f$ \hat{I_{q}} \f$: estimated current on q axis
     72           *
     73           * \f$ \hat{E_{d}} \f$: estimated back-emf on d axis
     74           *
     75           * \f$ \hat{E_{q}} \f$: estimated back-emf on q axis
     76           *
     77           * \f$ w_{el} \f$: rotor flux speed
     78           *
     79           * The observer model uses the back-emf extended formula
     80           *
     81           *
     82           * \f[
     83           *  \begin{aligned}
     84           *     &E_{d}(t) = 0 \\
     85           *     &E_{q}(t) = E_{a} = {(L_{q}-L_{d})}\cdot \frac{{dI_{q}}(t)}{dt} +   {(L_{d}-L_{q})}\cdot {w_{el}I_{d}}  + w_{el}\cdot{Phi_{m}}\\
     86           *  \end{aligned}
     87           * \f]
     88           *
     89           *
     90           * The estimated back-emf depend on the d-q position estimation error
     91           *
     92           * \f[
     93           *  \begin{aligned}
     94           *     &\hat{E_{d}}(t) =  E_{a}\cdot{sin(Theta_{Err})} \\
     95           *     &\hat{E_{q}}(t) =  -E_{a}\cdot{cos(Theta_{Err})}\\
     96           *  \end{aligned}
     97           * \f]
     98           *
     99           * Tha estimated back-emfs are used to calculate the position estimation error.
    100           *
    101           * \f[
    102           *  \begin{aligned}
    103           *     &Theta_{Err} = atan(\frac{\hat{E}_{d}(t)}{-\hat{E_{q}}(t)}) =  atan(\frac{E_{a}\cdot{sin(Theta_{Err})}}{E_{a}\cdot{cos(Theta_{Err})}})  \\
    104           *  \end{aligned}
    105           * \f]
    106           *
    107          
    108           * Discretizing the previous equations using backward Euler transformation:
    109           *
    110           * \f[
    111           *  \begin{aligned}
    112           *     & IntegralStateD(k) =  Ki*Ts\cdot{(I_{d}(k) - \hat{I}_{d}(k-1))}  +  IntegralStateD(k-1)\\
    113           *     &\hat{E_{d}}(k)  =  (Kp\cdot{(I_{d}(k) - \hat{I}_{d}(k-1))}  +  IntegralStateD(k))\\
    114           *     &\hat{I_{d}}(k)  =  (Ld/(Ld+Ts\cdot{Rs}))\cdot {\hat{I}_{d}(k-1)}  +  (Ts/(Ld+Ts\cdot{Rs}))\cdot {E_{d}(k)} + (Ts/(Ld+Ts\cdot{Rs}))\cdot {V_{d}(k)}  +  (Ts\cdot{Lq}/(Ld+Ts\cdot{Rs}))\cdot {L_{q}w_{el}(k){I}_{q}(k)} \\
    115           *     & IntegralStateQ(k) =  Ki*Ts\cdot{(I_{d}(k) - \hat{I}_{d}(k-1))}  +  IntegralStateQ(k-1)\\
    116           *     &\hat{E_{q}}(k)  =  (Kp\cdot{(I_{q}(k) - \hat{I}_{q}(k-1))}  +  IntegralStateQ(k))\\
    117           *     &\hat{I_{d}}(k)  =  (Ld/(Ld+Ts\cdot{Rs}))\cdot {\hat{I}_{q}(k-1)}  +  (Ts/(Ld+Ts\cdot{Rs}))\cdot {E_{q}(k)} + (Ts/(Ld+Ts\cdot{Rs}))\cdot {V_{d}(k)}  -  (Ts\cdot{Lq}/(Ld+Ts\cdot{Rs}))\cdot {L_{q}w_{el}(k){I}_{q}(k)} \\
    118           *  \end{aligned}
    119           * \f]
    120           *
    121           * where
    122           *
    123           * Ts is the sampling period
    124           *
    125           *  @param[in]      i_dq   = motor current components in d-q reference frame (aligned with rotor flux position)
    126           *  @param[in]      v_dq   = motor voltage components in d-q reference frame (aligned with rotor flux position)
    127           *  @param[in]      OmegaFlux   = rotor electrical speed in Q17.15 notation
    128           *  @param[in,out]      params = this structure contains parameters used for back-emf equation, rotor-flux position, PI gains, estimated quantities [current/bemf]
    129           */

   \                                 In section .text, align 2, keep-with-next
