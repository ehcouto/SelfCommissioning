    216          //---------------------------------------------------------------------------------------------------------------------
    217          /**
    218           *  @brief      Tracking observer for PMSM motor.
    219           *  @details
    220           *
    221           * This module estimates the rotor flux speed and position starting from the position error calculated by the bemf observer according to the following equations:
    222           *
    223           *
    224           * \f[
    225           *  \begin{aligned}
    226           *     & \hat{\omega}(t) = \frac{\hat{d\theta}(t)}{dt} = K_{p}\cdot {\theta_{err}}  +  K_{i}\cdot {\int{\theta_{err}\cdot{dt}}}\\
    227           *     & \hat{\theta}(t) = {\int{\hat{\omega}(t)\cdot{dt}}}\\
    228           *  \end{aligned}
    229           * \f]
    230           *
    231           * where
    232           *
    233           * \f$ \hat{\omega}(t) \f$: estimated rotor flux speed
    234           *
    235           * \f$ \hat{\theta}(t) \f$: estimated rotor flux position
    236           *
    237           * \f$ \hat{\theta}_{err}(t) \f$: rotor flux estimated position error
    238           *
    239           * Discretizing the previous equations using backward Euler transformation:
    240           *
    241           * \f[
    242           *  \begin{aligned}
    243           *     & IntegralState(k) =  Ki*Ts\cdot{\theta_{err}(k)}  +  IntegralState(k-1)\\
    244           *     &\hat{\omega}(k) =  Kp\cdot{\theta_{err}(k)}  +  IntegralState(k)\\
    245           *     &\hat{\theta}(k) =  \hat{\theta}(k-1)  +  Ts\cdot {\omega}(k)\\
    246           *  \end{aligned}
    247           * \f]
    248           *
    249           * where
    250           *
    251           * Ts is the sampling period
    252           *
    253           *
    254           *  @param[in]      theta_err  = position estimation error in Q1.15 notation
    255           *  @param[in,out]  params = this structure contains parameters used for PI gains, estimated speed and position
    256           *  @return            theta_inj_short   = estimated position in Q1.15 notation
    257           */

   \                                 In section .text, align 2, keep-with-next
    258          mc_sint16 ObserverPmsm__TrackingObs(mc_sint16 theta_err, TRACKING_OBSERVER_PARAMS_TYPE *params)
    259          {
   \                     ObserverPmsm__TrackingObs: (+1)
   \   00000000   0xB510             PUSH     {R4,LR}
   \   00000002   0x460C             MOV      R4,R1
    260              mc_sint32 temp32;
    261              mc_sint16 theta_inj_short;
    262          
    263              //Pi Execution -> Speed estimation
    264              params->Omega_Est =    Pi__PiRegNoAntiWindup((mc_sint32)theta_err, &params->State_PI, &params->Pi_Parameters);
   \   00000004   0x1D22             ADDS     R2,R4,#+4
   \   00000006   0x.... 0x....      BL       Pi__PiRegNoAntiWindup
   \   0000000A   0x62A0             STR      R0,[R4, #+40]
    265          
    266              temp32 = MC_SCALE(params->Omega_Est,IQ30,IQ15); //17.15 = 2.30>>15
    267          
    268              //Angle update according the estimated speed
    269              theta_inj_short = (mc_sint16)Pi__IntegBE(temp32, &params->Theta_Est, &params->Integ_Parameters); // Thet_inj = Theta_inj_k + Ts*2*pi*SpeedEst
    270          
    271              return theta_inj_short;
   \   0000000C   0xF104 0x0218      ADD      R2,R4,#+24
   \   00000010   0xF104 0x012C      ADD      R1,R4,#+44
   \   00000014   0x13C0             ASRS     R0,R0,#+15
   \   00000016   0x.... 0x....      BL       Pi__IntegBE
   \   0000001A   0xB200             SXTH     R0,R0
   \   0000001C   0xBD10             POP      {R4,PC}          ;; return
    272          }
