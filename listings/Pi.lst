     31          /**
     32           *  @brief      PI Regulator with back-calculation anti-windup strategy
     33           *  @details    PI controller algorithm.
     34           *              Definitions:
     35           *
     36           *              <b>e(t)</b> - input error in continuous time domain.
     37           *
     38           *              <b>u(t)</b> - controller output in continuous time domain.
     39           *
     40           *              <b>e(k)</b> - input error at step k - discrete time domain.
     41           *
     42           *              <b>u(k)</b> - controller output at step k - discrete time domain.
     43           *
     44           *              <b>e_max</b> - max range of e(k).
     45           *
     46           *              <b>u_max</b> - max range of u(k).
     47           *
     48           *            PI controller algorithm in <b>continuous time domain</b>:
     49           *
     50           *          \f[ u(t) = K\left(e(t) +\frac{1}{T_i}\int_0^t \! e(t) \, \mathrm{d}t. \right)\f]
     51           *           where:
     52           *            K :  controller gain
     53           *
     54           *            Ti: integral time constant
     55           *
     56           *           PI controller algorithm in <b>fractional arithmetic</b>:
     57           *
     58           *           \f[
     59           *             \begin{aligned}
     60           *                & u_f(k) = K_{p_{sc}} \cdot e_f(k) + u_f(k - 1) + K_{i_{sc}} \cdot e_f(k) \\
     61           *                & e_f(k) = \frac{e(k)}{e_{max}}\\
     62           *                & u_f(k) = \frac{u(k)}{u_{max}}\\
     63           *                & K_{p_{sc}} =  K \frac{e(k)}{e_{max}}\\
     64           *                & K_{i_{sc}} =  K \frac{T}{T_i}\frac{e(k)}{e_{max}}\\
     65           *             \end{aligned}
     66           *           \f]
     67           *           where:
     68           *           <b>T</b> : sampling time
     69           *
     70           *  The <b>anti-windup</b> technique is implemented as follows:
     71           *  when the output saturates, the integral
     72           *  term in the controller is recomputed so that its new value gives an
     73           *  output at the saturation limit
     74           *
     75           *  @param[in]      pi_params       = PI parameters: gains and limits
     76           *  @param[in]      err             = PI input error in Q17.15 notation
     77           *  @param[in, out] integ_term_k_1  = PI state variable in Q2.30 notation
     78           *  @return         PI output after saturation in Q17.15 notation
     79           */

   \                                 In section .text, align 2, keep-with-next
