   \   00000012   0xFBA7 0x0102      UMULL    R0,R1,R7,R2
   \   00000016   0xFB07 0x1103      MLA      R1,R7,R3,R1
   \   0000001A   0xFB0B 0x1102      MLA      R1,R11,R2,R1
   \   0000001E   0xF994 0x2010      LDRSB    R2,[R4, #+16]
