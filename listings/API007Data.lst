    994          /**
    995           * @brief Publish the Setting information (ACU Checksum, UI Checksum and Size)
    996           * @param address
    997           * @return
    998           */
    999          static BOOL_TYPE PublishSettingFileInfo(uint8 address)
   1000          {
   1001              BOOL_TYPE retval;
   1002              REVEAL_COMMAND_TYPE * ptr;
   1003              retval = FALSE;
   1004              #if (API007DATA_USE_PRIORITY_QUEUE == ENABLED)
   1005                  ptr = Reveal__PriorityNewFeedback(API007DATA_NUM, API007_OP_REQ_PUB_SETTING_FILE_INFO, address,20);
   1006              #else
   1007                  ptr = Reveal__NewFeedback(API007DATA_NUM, API007_OP_REQ_PUB_SETTING_FILE_INFO, address,28);
   1008              #endif
   1009              if (ptr != (REVEAL_COMMAND_TYPE *) NULL)
   1010              {
