    901          #if (API007DATA_BULK_DATA_FEATURE == ENABLED)
    902          //---------------------------------------------------------------------------------------------------------------------
    903          /**
    904           * @brief Publish list of segment ID's to the external node.
    905           * @param address   Node address who send data
    906           */
    907          static void PublishSegmentList(uint8 address )
    908          {
    909              uint8 index = 0;
    910              REVEAL_COMMAND_TYPE * ptr = NULL;
    911              uint8 size = 0;
    912          
    913              index = 0;
    914          
    915              while (index < sizeof(API007BulkDataMgr__GetSegmentListSize()))
    916              {
    917                  if ((API007BulkDataMgr__GetSegmentListSize() - index) > API007DATA_MAX_PAYLOAD)
    918                  {
    919                      size = API007DATA_MAX_PAYLOAD;
    920          
    921                  }
    922                  else
    923                  {
    924                      size = API007BulkDataMgr__GetSegmentListSize() - index;
    925                  }
    926          
    927          
    928                  #if (API007DATA_USE_PRIORITY_QUEUE == ENABLED)
    929                  ptr = Reveal__PriorityNewFeedback(API007DATA_NUM, API007_OP_SEGMENT_LIST,address, size);
    930                  #else
    931                  ptr = Reveal__NewFeedback(API007DATA_NUM, API007_OP_SEGMENT_LIST, address, size);
    932                  #endif
    933                  if (ptr != (REVEAL_COMMAND_TYPE *) NULL)
    934                  {
    935                      Reveal__AddDataU8Buffer(ptr, (void *) &(API007BulkDataMgr__GetSegmentList()[index]), size);
    936          
    937                      index += size;
    938          
    939                      //Check is their required to send more then one messages
    940                      if ((API007BulkDataMgr__GetSegmentListSize() - index) > 0)
    941                      {
    942                          //set the MMP(More message Pending) bit if their are more than one message needs to be send
    943                          ptr->opcode |= REVEAL_MMP_BIT;
    944                      }
    945          
    946                      Reveal__QueueCommand(ptr);
    947                  }
    948                  else
    949                  {
    950                      break;
    951                  }
    952              }
    953          }
    954          
    955          //---------------------------------------------------------------------------------------------------------------------
    956          /**
    957           * @brief Publish segment ID detailed information to the external node for requested segment ID.
    958           * @param address        Node address who send data.
    959           * @param segment_id     Segment ID for a single logical block of data.
    960           */
    961          static void PublishSegmentInfo(uint8 address, API007APP_SEGMENT_ID segment_id)
    962          {
    963              REVEAL_COMMAND_TYPE * ptr;
    964              API007_SEGMENT_INFO_TYPE * info;
    965          
    966              info = API007BulkDataMgr__GetSegmentInfo(segment_id);
    967          
    968              if (info == NULL)
    969              {
    970                  API007Data__SendError(address, segment_id,API007_ERROR_SEGMENT_NOT_FOUND);
    971              }
    972              else
    973              {
    974                  #if (API007DATA_USE_PRIORITY_QUEUE == ENABLED)
    975                      ptr = Reveal__PriorityNewFeedback(API007DATA_NUM, API007_OP_SEGMENT_INFO, address ,6);
    976                  #else
    977                      ptr = Reveal__NewFeedback(API007DATA_NUM, API007_OP_SEGMENT_INFO, address, 6);
    978                  #endif
    979                  if (ptr != (REVEAL_COMMAND_TYPE *) NULL)
    980                  {
    981                      Reveal__AddDataU8(ptr, segment_id);
    982                      Reveal__AddDataU16(ptr, info->size);
    983                      Reveal__AddDataU8(ptr, info->segment_role);
    984                      Reveal__AddDataU16(ptr, info->crc);
    985                      Reveal__QueueCommand(ptr);
    986                  }
    987              }
    988          }
    989          
    990          #endif
