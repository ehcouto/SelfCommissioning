   \                     ??API007Data__CommandParser_3: (+1)
   \   00000074   0x.... 0x....      BL       __aeabi_memcpy
    232          
    233                          break;
    234                  #endif  //API007DATA_WRITE_RAMDATA_ONLY_REQUIRED
    235          
    236                  #if(API007DATA_BULK_DATA_FEATURE == ENABLED)
    237                          case API007_OP_SEGMENT_LIST:
    238                              //Publish list of segment ID's.
    239                              PublishSegmentList(REVEAL_BROADCAST_NODE);
    240                              break;
    241          
    242                          case API007_OP_SEGMENT_INFO:
    243                              //Publish segment detailed info for the requested segment id from this node.
    244                              PublishSegmentInfo(REVEAL_BROADCAST_NODE, (API007APP_SEGMENT_ID)data[0]);
    245                              break;
    246          
    247                          case API007_OP_GET_SEGMENT_ALL_DATA:
    248                              //Publish segment data for requested segment ID node.
    249                              if (API007BulkDataMgr__GetSegmentData(buffer->node_id, (API007APP_SEGMENT_ID)data[0]) == FALSE)
    250                              {
    251                                  retval = NVO_RS_BUSY;
    252                              }
    253                              break;
    254          
    255                          case API007_OP_SERVER_TRANSMISSION_COMPLETE:
    256                              //Received End of Transmission command from external node segment (server) ID side.
    257                              API007BulkDataMgr__ReceivedTransmissionCompleted(buffer->node_id);
    258                              break;
    259          
    260                          case API007_OP_DEBUG:
    261                              API007__RequestGetDataSegment(buffer->node_id,data[0]);
    262                              break;
    263          
    264                          case API007_OP_SEND_SEGMENT_DATA:// receive data from the other side
    265                              // Write this Received data to the destination and then reply with write completed command message.
    266                              API007BulkDataMgr__WriteSegmentData(buffer->node_id, (API007APP_SEGMENT_ID)data[0],Utilities__Merg2BytesTo16bits(data[1],data[2]),&data[3],buffer->sdu_length-5);
    267                              break;
    268          
    269                          case API007_OP_CLIENT_WRITE_COMPLETE:
    270                              //Received command message as "ACK" from the external node for each successful segment (index) data write to the client side.
    271                              API007BulkDataMgr__ReceivedWriteCompleted(buffer->node_id);
    272                              break;
    273                  #endif //API007DATA_BULK_DATA_FEATURE
    274          
    275                  case API007_OP_REQ_PUB_SETTING_FILE_INFO:
    276                      PublishSettingFileInfo(buffer->node_id);
    277                      break;
    278          
    279                  case API007_OP_REQ_PUB_SETTING_FILE_DATA:
    280                  	if (PublishUISettingFileData(buffer->node_id,Utilities__ConvertArrayTo32bits(data), data[4]) == FALSE)
    281                      {
    282          				retval = NVO_RS_UNSUP_OUT_OF_MEMORY;
    283          			}
    284                      break;
    285          
    286                  case API007_OP_REQ_PUB_SETTING_FILE_ID_INFO:
    287                      PublishSettingFileIDInfo(buffer->node_id, (SF_ID_TYPE)buffer->payload[0]);
    288                      break;
    289          
    290                  case API007_OP_REQ_PUB_SETTING_FILE_ID_DATA:
    291                      /*
    292                       * Data[0]   - SF_ID
    293                       * Data[1-2] - Data_Index
    294                       * Data[3]   - SF_ID_Size
    295                       */
    296                      if (PublishSettingFileIDData(buffer->node_id, (SF_ID_TYPE)data[0], Utilities__ConvertArrayTo16bits(&data[1]), data[3]) == FALSE)
    297                      {
    298                      	retval = NVO_RS_UNSUP_OUT_OF_MEMORY;
    299                      }
    300                      break;
    301          
    302                  case API007_OP_REQ_PUB_SETTING_FILE_DISPLACEMENT_INFO:
    303                      /*
    304                       * Data[0-1] - SF_POINTER_ID
    305                       * Data[2-3] - SF_DISPLACEMENT
    306                       */
    307          
    308                      PublishSettingFileDisplacementInfo(buffer->node_id, (SETTINGFILE_OFFSET_TYPE)Utilities__ConvertArrayTo16bits(&data[0]), (SETTINGFILE_OFFSET_TYPE)Utilities__ConvertArrayTo16bits(&data[2]));
    309                      break;
    310          
    311                  case API007_OP_REQ_PUB_SETTING_FILE_DISPLACEMENT_DATA:
    312                      /*
    313                       * Data[0-1] - SF_POINTER_ID
    314                       * Data[2-3] - SF_DISPLACEMENT
    315                       * Data[4-5] - Data_Index
    316                       * Data[6]   - Size
    317                       */
    318                      if (PublishSettingFileDisplacementData(buffer->node_id, (SETTINGFILE_OFFSET_TYPE)Utilities__ConvertArrayTo16bits(&data[0]), Utilities__ConvertArrayTo16bits(&data[2]), Utilities__ConvertArrayTo16bits(&data[4]), data[6]) == FALSE)
    319                      {
    320                      	retval = NVO_RS_UNSUP_OUT_OF_MEMORY;
    321                      }
    322                      break;
    323          
    324                  case API007_OP_ERASE_FLASH:
    325                      if (Mode__IsProgrammingEngaged() == TRUE)
    326                      {
    327                          address_start = Utilities__ConvertArrayTo32bits(buffer->payload);
    328                          address_end   = Utilities__ConvertArrayTo32bits(&buffer->payload[4]);
    329          
    330                          SUSPEND_TASK_MONITORING();
    331                          if (Flash__Format(address_start,address_end) == FLASH_RESPONSE_DONE)
    332                          {
    333                              Reveal__QueueMessageU8(API007DATA_NUM,API007_OP_FLASH_PROCESS_DONE,buffer->node_id,FALSE,FALSE,API007_OP_ERASE_FLASH);
    334                          }
    335                          else
    336                          {
    337                              retval = NVO_RS_UNSUP_UNAVAILABLE;
    338                          }
    339                          RESUME_TASK_MONITORING();
    340                      }
    341                      else
    342                      {
    343                          retval = NVO_RS_REJECTED;
    344                      }
    345                      break;
    346                  case API007_OP_WRITE_FLASH:
    347                      if (Mode__IsProgrammingEngaged() == TRUE)
    348                      {
    349                          if (Flash__Write(Utilities__ConvertArrayTo32bits(data),&data[4],(uint32)buffer->size-4) == FLASH_RESPONSE_DONE)
    350                          {
    351                              Reveal__QueueMessageU8(API007DATA_NUM,API007_OP_FLASH_PROCESS_DONE,buffer->node_id,FALSE,FALSE,API007_OP_WRITE_FLASH);
    352                          }
    353                          else
    354                          {
    355                              retval = NVO_RS_UNSUP_UNAVAILABLE;
    356                          }
    357                      }
    358                      else
    359                      {
    360                          retval = NVO_RS_REJECTED;
    361                      }
    362                      break;
    363                  case API007_OP_REQ_PUB_FLASH_ALIGNMENT:
    364                      Reveal__QueueMessageU8(API007DATA_NUM,API007_OP_REQ_PUB_FLASH_ALIGNMENT,buffer->node_id,FALSE,FALSE,FLASH_ALIGNMENT);
    365                      break;
    366          
    367                  default:
    368                      retval = NVO_RS_UNSUP_OP_CODE;
    369                      break;
    370              }
    371          
    372              return (retval);
