    387          #ifdef __IAR_SYSTEMS_ICC__
    388          #pragma inline = forced
    389          #endif
    390          static float32 Calculate_MTPV(MCL_SPEED_CTRL_IO_F_TYPE *io, MCLSPEEDCTRL_JOINT_PARAMS_TYPE *params)
    391          {
    392              float32 max_torque_voltage;
    393              float32 temp_1;
    394          
    395              temp_1 = * io->Ctrl_Specific->Flux_Limit_By_Speed;
    396              max_torque_voltage = MathCalc__GetInterpolationFastF(temp_1, &params->MTPVPrm);
    397          
    398              return(max_torque_voltage);
    399          }
