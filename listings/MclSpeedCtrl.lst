    343          #ifdef __IAR_SYSTEMS_ICC__
    344          #pragma inline = forced
    345          #endif
    346          static float32 CurrentLimitation(MCL_SPEED_CTRL_IO_F_TYPE *io, MCL_SPEED_CTRL_PARAMS_TYPE *params)
    347          {
    348              float32 max_torque_curr_limit;
    349              float32 temp_1;
    350              float32 temp_2;
    351          
    352          
    353              // Limit the maximum torque according to the available current and maximum current of the inverter
    354              temp_1 = params->Max_Squared_Inv_Current;
    355          
    356              temp_2 = *(io->Ctrl_Specific->Id_stator_current);
    357          
    358          #if (SPEEDCTRL__CURR_LIM_IDS_FILTER==ENABLED)
    359              // Filtering ...
    360              Id_Stator_Current_Sum = FILTERS__LOWPASSFILTER_F(Id_Stator_Current_Sum, CURR_LIM_IDS_LPF_COEF, temp_2);
    361              temp_2 = Id_Stator_Current_Sum;
    362          #endif
    363          
    364              temp_2 = (temp_2*temp_2);
    365          
    366              // (Max inverter current)^2 - (Id)^2
    367              temp_1 = temp_1 - temp_2;
    368          
    369              if (temp_1>0)
    370              {
    371                  // Max current = sqrt((Max inverter current)^2 - (Id)^2)
    372                  temp_1 = MC_SQRT_F(temp_1);
    373          
    374                  // Max torque according to available current
    375          		max_torque_curr_limit = params->pole_pairs_factor * (temp_1 * *(io->Ctrl_Specific->Stator_Flux_Mag));
    376          		 
    377              }
    378              else
    379              {
    380                  max_torque_curr_limit = 0.0f;
    381              }
    382          
    383              return max_torque_curr_limit;
    384          }
    385          
