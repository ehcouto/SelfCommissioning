    209           */
    210          typedef struct
    211          {
    212              volatile uint32 SADDR;     /*!< SADDR register, used to save source address */
    213              volatile uint16 SOFF;      /*!< SOFF register, save offset bytes every transfer */
    214              volatile uint16 ATTR;      /*!< ATTR register, source/destination transfer size and modulo */
    215              volatile uint32 NBYTES;    /*!< Nbytes register, minor loop length in bytes */
    216              volatile uint32 SLAST;     /*!< SLAST register */
