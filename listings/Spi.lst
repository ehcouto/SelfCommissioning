    284          } dspi_transfer;
    285          /*!
    286           * @brief eDMA transfer configuration
    287           *
    288           * This structure configures the source/destination transfer attribute.
    289           * This figure shows the eDMA's transfer model:
    290           *  _________________________________________________
    291           *              | Transfer Size |                    |
    292           *   Minor Loop |_______________| Major loop Count 1 |
    293           *     Bytes    | Transfer Size |                    |
    294           *  ____________|_______________|____________________|--> Minor loop complete
    295           *               ____________________________________
    296           *              |               |                    |
    297           *              |_______________| Major Loop Count 2 |
    298           *              |               |                    |
    299           *              |_______________|____________________|--> Minor loop  Complete
    300           *
    301           *               ---------------------------------------------------------> Transfer complete
    302           */
    303          /*! @brief DSPI master command data configuration used for the SPIx_PUSHR.*/
    304          typedef struct
    305          {
    306              BOOL_TYPE is_pcs_continuous;            /*!< Option to enable the continuous assertion of the chip select between transfers.*/
    307              BOOL_TYPE is_end_of_queue;               /*!< Signals that the current transfer is the last in the queue.*/
    308              BOOL_TYPE clear_transfer_count;         /*!< Clears the SPI Transfer Counter (SPI_TCNT) before transmission starts.*/
    309          } DSPI_COMMAND_DATA_CONFIG;
    310          
    311          /*! @brief DSPI master transfer data configuration used for the transfer*/
    312          typedef struct
    313          {
    314              uint32 src_addr;                      /*!< Source data address. */
    315              uint32 dest_addr;                     /*!< Destination data address. */
    316              EDMA_TRANSFER_SIZE source_transfer_size;  /*!< Source data transfer size. */
    317              EDMA_TRANSFER_SIZE dest_transfer_size; /*!< Destination data transfer size. */
    318              uint16 source_offset;                     /*!< Sign-extended offset applied to the current source address to
    319                                                          form the next-state value as each source read is completed. */
    320              uint16 dest_offset;                    /*!< Sign-extended offset applied to the current destination address to
    321                                                          form the next-state value as each destination write is completed. */
    322              uint32 minor_loop_bytes;               /*!< Bytes to transfer in a minor loop*/
    323              uint32 major_loop_counts;              /*!< Major loop iteration count. */
    324          }EDMA_TRANSFER_CONFIG;
    325          
    326          /*! @brief DSPI master ctar configuration structure.*/
    327          typedef struct
    328          {
    329              uint32 baud_rate;                /*!< Baud Rate for DSPI. */
    330              uint32 bits_per_frame;            /*!< Bits per frame, minimum 4, maximum 16.*/
    331              DSPI_CLOCK_POLARITY cpol;       /*!< Clock polarity. */
