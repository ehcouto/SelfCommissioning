    337              uint32 last_sck_to_pcs_delay_nano_sec;    /*!< The last SCK to PCS delay time in nanoseconds; setting to 0 sets the
    338                                                         minimum delay. It also sets the boundary value if out of range.*/
    339          
    340              uint32 between_transfer_delay_in_nano_sec; /*!< After the SCK delay time in nanoseconds; setting to 0 sets the minimum
    341                                                       delay. It also sets the boundary value if out of range.*/
    342          }DSPI_MASTER_CTAR_CONFIG;
    343          
    344          /*! @brief DSPI master configuration structure.*/
