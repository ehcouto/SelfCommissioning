    500          //---------------------------------------------------------------------------------------------------------------------
    501          /**
    502           * Get the most recently received value of the specified data.
    503           * Returns the same value if called again and no new value has been received.
    504           * @param client_function_index = The client-side function index that identifies the remote function.
    505           * @param channel = The index of the remote function data.
    506           * @param value = A pointer to where the value should be stored if it is available.
    507           * @return TRUE if the remote function data value was available and copied into *data; otherwise FALSE.
    508           */
    509          BOOL_TYPE API013RemoteFunction__GetData(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint8 channel, sint16* value)
    510          {
    511              uint8 index;
    512          
    513              index = FindDataIndex(client_function_index, channel);
    514              if (index != UCHAR_MAX)
    515              {
    516                  *value = Api013.Data[index].Value;
    517                  return TRUE;
    518              }
    519          
    520              return FALSE;
    521          }
    522          
    523          
    524          //---------------------------------------------------------------------------------------------------------------------
    525          /**
    526           * Get the specified remote function data only if it is a new value that was not previously read.
    527           * @param client_function_index = The client-side function index that identifies the remote function.
    528           * @param channel = The index of the remote function data.
    529           * @param sync = The synchronization byte used to detect new values that were not previously read.
    530           * @param value = A pointer to where the value should be stored if it is available.
    531           * @return TRUE if the remote function data value was available, new, and copied into *data; otherwise FALSE.
    532           */
    533          BOOL_TYPE API013RemoteFunction__GetSynchronizedData(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint8 channel, uint8* sync, uint16* value)
    534          {
    535              uint8 index;
    536          
    537              index = FindDataIndex(client_function_index, channel);
    538              if (index != UCHAR_MAX)
    539              {
    540                  if (Api013.Data[index].Sequence != *sync)
    541                  {
    542                      *sync = Api013.Data[index].Sequence;
    543                      *value = Api013.Data[index].Value;
    544                      return TRUE;
    545                  }
    546              }
    547          
    548              return FALSE;
    549          }
