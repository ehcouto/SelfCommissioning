    856          /**
    857           * Call the DoControl function for the specified function and pass the specified control.
    858           * @param server_function_index = The server-side function index that identifies the remote function.
    859           * @param control = The control that the function should execute.
    860           * @param params = Pointer to bytes that make up the parameters.
    861           * @param size = Number of bytes referenced in the parameters.
    862           * @retval REMOTE_FUNCTION_CONTROL_RESPONSE_INVALID = The function does not exist or the control is not supported.
    863           * @retval REMOTE_FUNCTION_CONTROL_RESPONSE_INACTIVE = The function evaluated the control and is now INACTIVE.
    864           * @retval REMOTE_FUNCTION_CONTROL_RESPONSE_ACTIVE = The function evaluated the control and is now ACTIVE.
    865           */
    866          static REMOTE_FUNCTION_CONTROL_RESPONSE_TYPE RemoteFunctionDoControl(uint8 server_function_index, uint8 control, uint8* params, uint8 size)
    867          {
    868              REMOTE_FUNCTION_CONTROL_RESPONSE_TYPE control_response = REMOTE_FUNCTION_CONTROL_RESPONSE_INVALID;
    869              if (server_function_index < API013_NUM_OF_SERVER_FUNCTIONS)
    870              {
    871                  REMOTE_FUNCTION_DO_CONTROL_TYPE do_control = API013_SERVER_FUNCTIONS[server_function_index].Do_Control_Function;
    872                  if (do_control != REMOTE_FUNCTION_DO_CONTROL_NULL)
    873                  {
    874                      control_response = do_control(control, params, size);
    875                      if ((control != REMOTE_FUNCTION_COMMAND_DISABLE) &&
    876                          (control_response == REMOTE_FUNCTION_CONTROL_RESPONSE_ACTIVE))
    877                      {
    878                          Utilities__SetBitInArray(Api013.Functions_Active, server_function_index, ACTIVE);
    879                      }
    880                      else
    881                      {
    882                          Utilities__SetBitInArray(Api013.Functions_Active, server_function_index, INACTIVE);
    883                      }
    884                  }
    885              }
    886          
    887              return (control_response);
    888          }
