    582          
    583          //---------------------------------------------------------------------------------------------------------------------
    584          /**
    585           * Synchronize the receiver so that it can receive only new samples of the remote function data.
    586           * @param client_function_index = The client-side function index that identifies the remote function.
    587           * @param channel = The index of the remote function data.
    588           * @param sync = Pointer to a byte used to synchronize the caller with API013 messages.
    589           */
    590          void API013RemoteFunction__SynchronizeData(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint8 channel, uint8* sync)
    591          {
    592              uint8 index;
    593          
    594              index = FindDataIndex(client_function_index, channel);
    595              if (index == UCHAR_MAX)
    596              {
    597                  // This remote function data has not been received, so if one is found, it will be new.
    598                  *sync = UCHAR_MAX;
    599              }
    600              else
    601              {
    602                  // This remote function data has been received.
    603                  *sync = Api013.Data[index].Sequence;
    604              }
    605          }
