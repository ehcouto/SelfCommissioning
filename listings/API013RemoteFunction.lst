    671          //---------------------------------------------------------------------------------------------------------------------
    672          /**
    673           * Get the index to the data associated with the specified remote function and the specified data channel.
    674           * @param client_function_index = The client-side function index that identifies the remote function.
    675           * @param channel = The index of the data from the remote function.
    676           * @return The index to the stored data that corresponds with the client_function_index and channel.
    677           *         If there is no stored data, then it returns UCHAR_MAX.
    678           */
    679          static uint8 FindDataIndex(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint8 channel)
    680          {
    681              for (uint8 index = 0; index < API013_MAX_STORED_DATA; index++)
    682              {
    683                  if ((Api013.Data[index].Client_Function_Index == client_function_index) &&
    684                      (Api013.Data[index].Channel == channel))
    685                  {
    686                      return index;
    687                  }
    688              }
    689              return UCHAR_MAX;
    690          }
