    651          /**
    652           * Convert the server-side function index to a client-side function index.
    653           * @param node_id = The server communication node.
    654           * @param server_function_index = The server-side function index that identifies the remote function.
    655           * @return The client-side function index that identifies the remote function.
    656           */
    657          static API013_CLIENT_FUNCTION_INDEX_TYPE ConvertServerIndexToClientIndex(uint8 node_id, uint8 server_function_index)
    658          {
    659              for (uint8 index = 0; index < API013_NUM_OF_CLIENT_FUNCTIONS; index++)
    660              {
    661                  if ((API013_CLIENT_FUNCTIONS[index].Communication_Node == node_id) &&
    662                      (API013_CLIENT_FUNCTIONS[index].Server_Function_Index == server_function_index))
    663                  {
    664                      return (API013_CLIENT_FUNCTION_INDEX_TYPE)index;
    665                  }
    666              }
    667              return (API013_CLIENT_FUNCTION_INDEX_TYPE)API013_NUM_OF_CLIENT_FUNCTIONS;
    668          }
