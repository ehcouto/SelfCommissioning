    566                  Client -> Server : (39/6) SetPublicationPeriod(milliseconds)
    567                  alt Milliseconds are Supported
    568                      Client <-- Server : ACK
    569                  else else
    570                      Client <-- Server : NAK
    571                  end alt
    572              @enduml
    573          
    574           * @param client_function_index = The client-side function index that identifies the remote function.
    575           * @param milliseconds = The target period between publication of data elements.
    576           */
    577          void API013RemoteFunction__SetPublicationPeriod(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint16 milliseconds)
    578          {
    579              Reveal__QueueMessageU16(API013RMTFCN_NUM, API013_CMD_SET_PUBLICATION_PERIOD, API013_CLIENT_FUNCTIONS[client_function_index].Communication_Node, TRUE, FALSE, milliseconds);
    580          }
