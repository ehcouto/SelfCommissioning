    692          
    693          //---------------------------------------------------------------------------------------------------------------------
    694          /**
    695           * Insert a received value from a remote function into the array of all stored values.
    696           * Replace any previously stored value with the client_function_index and channel.
    697           * Maintain the array order so that the values are sorted from newest to oldest.
    698           * Drop the oldest value if it does not fit in the array.
    699           * Api013.Data[0] will contain the inserted analog input value when done.
    700           * @param client_function_index = The client-side function index that identifies the remote function.
    701           * @param channel = The remote function's channel for generating this value.
    702           * @param value = The new value to store.
    703           */
    704          static void StoreReceivedData(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint8 channel, sint16 value)
    705          {
    706              // Look for the presence of the analog input ID in the existing stored data array.
    707              uint8 num_of_analog_inputs_to_shift = API013_MAX_STORED_DATA - 1;
    708              uint8 new_sequence_number = 0;                  // Assume this is the first occurrence in the stored data.
    709          
    710              // The last analog input must be checked to avoid unnecessarily losing the sequence number.
    711              for (uint8 i = 0; i < API013_MAX_STORED_DATA; i++)
    712              {
    713                  API013_STORED_DATA_TYPE* stored = &Api013.Data[i];
    714          
    715                  if ((stored->Channel == channel) &&
    716                      (stored->Client_Function_Index == client_function_index))
    717                  {
    718                      num_of_analog_inputs_to_shift = i;
    719                      if (stored->Sequence < UCHAR_MAX - 1)
    720                      {
    721                          new_sequence_number = stored->Sequence + 1;
    722                      }
    723                      else
    724                      {
    725                          new_sequence_number = 1;
    726                      }
    727                      break;                                  // Out of the for() loop.
    728                  }
    729              }
    730          
    731              // Shift the array elements.
    732              //      This will remove any previously stored copy of the analog input, and...
    733              //      it will make space for the new analog input at the start of the array.
    734              if (num_of_analog_inputs_to_shift > 0)
    735              {
