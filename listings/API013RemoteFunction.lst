    790          //---------------------------------------------------------------------------------------------------------------------
    791          /**
    792           * Publish a set of data elements to Reveal.
    793           * @param data_elements = The data that must be published.
    794           * @param count = The number of data elements in the 'data_elements' array.
    795           */
    796          static void PublishPreparedData(REMOTE_FUNCTION_DATA_TYPE* data_elements, uint8 count)
    797          {
    798          
    799              // Get a pointer to the feedback message.
    800              uint8 payload_size = count * sizeof(REMOTE_FUNCTION_DATA_TYPE);
    801              REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API013RMTFCN_NUM, API013_FBK_PUBLISH_FUNCTION_DATA, Api013.Data_Receiver_Node, payload_size);
    802              if (msg != NULL)
    803              {
    804                  Reveal__AddDataU8Buffer(msg, (uint8*)(void*)data_elements, payload_size);
    805                  Reveal__QueueCommand(msg);
    806              }
    807          }
