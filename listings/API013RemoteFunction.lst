    430                  participant "API013RemoteFunction\n(Client)" as Client
    431                  participant "API013RemoteFunction\n(Server)" as Server
    432                  participant FunctionX
    433          
    434                  ACU -> Client : API013RemoteFunction__SendControl(function, control, ...)
    435                  Client  -> Server : (39/4) ControlBackgroundFunction(function, control, ...)
    436                  Server -> FunctionX : FunctionX__Control(control, ...)
    437                  Client <-- Server : ACK
    438              @enduml
    439          
    440           * @param client_function_index = The client-side function index that identifies the remote function.
    441           * @param control = The control command byte to send to the remote function.
    442           * @param params = Pointer to bytes that make up parameters for the control command.
    443           *                  The memory must be valid during the function call.
    444           * @param size = Number of bytes in the params buffer.
    445           */
    446          BOOL_TYPE API013RemoteFunction__SendControl(API013_CLIENT_FUNCTION_INDEX_TYPE client_function_index, uint8 control, uint8* params, uint8 size)
    447          {
    448              REVEAL_COMMAND_TYPE* cmd = Reveal__NewCommand(API013RMTFCN_NUM, API013_CMD_SEND_FUNCTION_CONTROL, API013_CLIENT_FUNCTIONS[client_function_index].Communication_Node, size + 2);
    449              return (BOOL_TYPE)((Reveal__AddDataU8(cmd, API013_CLIENT_FUNCTIONS[client_function_index].Server_Function_Index) == PASS) &&
    450                                 (Reveal__AddDataU8(cmd, control) == PASS) &&
    451                                 (Reveal__AddDataU8Buffer(cmd, params, size) == PASS) &&
    452                                 (Reveal__QueueCommand(cmd) == TRUE));
    453          }
