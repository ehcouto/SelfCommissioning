    936          /**
    937           * Set the publication period that the server uses to publish remote function data.
    938           * @param milliseconds = Time between publications of remote function data in milliseconds.
    939           *              Set to 0 to disable publications of all remote function data.
    940           * @return TRUE if the publication period is supported by the server; otherwise FALSE.
    941           */
    942          static BOOL_TYPE SetPublicationPeriod(uint16 milliseconds)
    943          {
    944              uint16 calls_to_background;
    945          
    946              if (milliseconds == 0)
    947              {
    948                  Api013.Publication_Period = 0;                     // Disable data publications.
    949                  return TRUE;
    950              }
    951              else if (milliseconds >= MIN_PUBLICATION_PERIOD)
    952              {
    953                  calls_to_background = milliseconds / API013_MS_PER_BACKGROUND_CALL;
    954                  if ((calls_to_background <= UCHAR_MAX) &&
    955                      (calls_to_background* API013_MS_PER_BACKGROUND_CALL == milliseconds))
    956                  {
    957                      Api013.Publication_Period = calls_to_background;
    958                      return TRUE;
    959                  }
    960              }
    961          
    962              return FALSE;
    963          }
