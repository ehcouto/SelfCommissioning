    750          /**
    751           * Send a feedback message with all the data from all the remote functions active on this server.
    752           */
    753          static void PublishAllRemoteFunctionData(void)
    754          {
    755              REMOTE_FUNCTION_DATA_TYPE data_elements[API013_MAX_PUBLISHED_DATA];
    756          
    757              // Determine the size of the payload required for all the data elements.
    758              ACTIVE_TYPE active = INACTIVE;
    759              uint8 total = 0;
    760              for (uint8 index = 0; index < API013_NUM_OF_SERVER_FUNCTIONS; index++)
    761              {
    762                  if (Utilities__GetBitInArray(Api013.Functions_Active, index) == ACTIVE)
    763                  {
    764                      active = ACTIVE;
    765                      total += RemoteFunctionGetData(index, &data_elements[total]);
    766                  }
    767                  else if (active == ACTIVE)
    768                  {
    769                      // Support sequentially linked remote function indices where additional remote functions only provide additional data.
    770                      if ((API013_SERVER_FUNCTIONS[index].Background_Function == REMOTE_FUNCTION_BACKGROUND_NULL) &&
    771                          (API013_SERVER_FUNCTIONS[index].Do_Control_Function == REMOTE_FUNCTION_DO_CONTROL_NULL) &&
    772                          (API013_SERVER_FUNCTIONS[index].Get_Status_Function == REMOTE_FUNCTION_GET_STATUS_NULL))
    773                      {
    774                          total += RemoteFunctionGetData(index, &data_elements[total]);
    775                      }
    776                      else
    777                      {
    778                          active = INACTIVE;
    779                      }
    780                  }
    781              }
    782          
    783              if (total > 0)
    784              {
    785                  PublishPreparedData(data_elements, total);
    786              }
    787          }
