   1632          static void TimeHandler(void)
   1633          {
   1634              // Count time after every starting
   1635              if( Mcl_Quantities.Elapsed_Time_After_Starting < MAX_UINT32)
   1636              {
   1637              	Mcl_Quantities.Elapsed_Time_After_Starting = Mcl_Quantities.Elapsed_Time_After_Starting + 1;
   1638              }
   1639          }
