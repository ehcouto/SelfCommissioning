   1571          #endif
   1572          /**
   1573           *  @brief      Calculate RMS values and mean speed value in 4khz handler (256ms time windows)
   1574           *  @param[in]  Motor currents and rotor speed.
   1575           *  @param[out] Mean RMS current of the three motor phasesa and the mean speed.
   1576           *  @param[in]  SAMPLES_NUMBER: 10 suitable choice to have ~250ms of time window at 4Khz
   1577           *  @return none
   1578           */
   1579          static void Calc_ElectricalPower(void)
   1580          {
   1581              float32 electrical_power;
   1582              // instantaneous power
   1583              electrical_power = 1.5f * (Mcl_Quantities.Vs_Alpha_Beta_Rec.Alpha * Mcl_Quantities.Is_Alpha_Beta.Alpha + Mcl_Quantities.Vs_Alpha_Beta_Rec.Beta * Mcl_Quantities.Is_Alpha_Beta.Beta);
   1584          
   1585              if ((Mcl_IO.All_Devices_Off == FALSE) && (MotorSafetyMgr__DoesClassAHaveAccessToPwm() == TRUE))
   1586              {
   1587                  Mcl_Quantities.Electrical_Power = FILTERS__LOWPASSFILTER_F(Mcl_Quantities.Electrical_Power, MCL__EL_POWER_LPF, electrical_power);
   1588              }
   1589              else
   1590              {
   1591                  Mcl_Quantities.Electrical_Power = 0.0f;
   1592              }
   1593          }
   1594          #endif
   1595          
   1596          #if (MCL__SHAFT_POWER == ENABLED)
   1597          #ifdef __IAR_SYSTEMS_ICC__
   1598          #pragma inline = forced
   1599          #endif
   1600          
   1601          /**
   1602           *  @brief      Calculate values and mean speed value in 4khz handler (256ms time windows)
   1603           *  @param[in]  Eletromagnetic Torque and rotor speed.
   1604           *  @param[out] Mechanical motor power without considering the rotational losses.
   1605           *  @param[in]  SAMPLES_NUMBER: 10 suitable choice to have ~250ms of time window at 4Khz
   1606           *  @return none
   1607           */
   1608          void Calc_ShaftPower(void)
   1609          {
   1610              float32 shaft_power;
   1611              // Motor mechanical power output/Shaft Power =T*w
   1612              shaft_power = (Mcl_Quantities.Torque * Mcl_Quantities.Speed_Rot_Mech_Abs);
   1613          
   1614              if ((Mcl_IO.All_Devices_Off == FALSE) && (MotorSafetyMgr__DoesClassAHaveAccessToPwm() == TRUE))
   1615              {
   1616                 Mcl_Quantities.Shaft_Power = FILTERS__LOWPASSFILTER_F(Mcl_Quantities.Shaft_Power, MCL__ML_POWER_LPF, shaft_power);
   1617              }
   1618              else
   1619              {
   1620                 Mcl_Quantities.Shaft_Power = 0.0f;
   1621              }
   1622          }
   1623          
   1624          
   1625          #endif
