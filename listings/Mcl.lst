   1645          /**
   1646           *  @brief      Calculate the torque value for the application layer according to the following convention:
   1647           *              torque is positive when motoring and negative when braking whatever is the motor speed direction.
   1648           *  @param[in]  Motor Torque (from Observer) and motor speed reference.
   1649           *  @param[out] Torque for the application layer.
   1650           *  @return none
   1651           */
   1652          static void Calc_TorqueForApplication(void)
   1653          {
   1654              // check the sign of the speed reference
   1655              if (Mcl_IO.Speed_Rot_Ref<0)
   1656              {   //adjust the sign of the torque if needed
   1657                  Mcl_Quantities.Torque_Application = -Mcl_Quantities.Torque;
   1658              }
   1659              else
   1660              {// sign is correct
   1661                  Mcl_Quantities.Torque_Application = Mcl_Quantities.Torque;
   1662              }
   1663          
   1664          }
   1665          
   1666          /**
   1667           *  @brief      Management of some MCL flags during the running handler
   1668           *  @return none
   1669           */
   1670          static void Flags_Management(void)
   1671          {
   1672              float32 target_speed;
   1673              // logic to detect wrong speed direction
   1674              target_speed   = SpeedRefGen__GetSpeedTarget();
   1675              if ((target_speed * Mcl_Quantities.Speed_Rot) < 0)
   1676              {
   1677                  Mcl_Cs.flags.bit.wrong_speed_direction = 1;
   1678              }
   1679              else
   1680              {
   1681                  Mcl_Cs.flags.bit.wrong_speed_direction = 0;
   1682              }
   1683          
   1684          
   1685              if (Mcl_Cs.flags.bit.braking_active == 1)
   1686              {
   1687          #if (STOP_RAMP_DURING_INVERSION == ENABLED)
   1688                  // stop the ramp if the reference is accelerating while in braking mode
   1689                  if (SpeedRefGen__GetStatus() == SPEED_REF_ACCELERATING)
   1690                  {
   1691                      SpeedRefGen__SetSpeedParams(0.0f);
   1692                      SpeedRefGen__ApplyDefaultAccel(TRUE);
   1693                      Mcl_Cs.flags.bit.stopped_ramp = 1;
   1694                  }
   1695          #endif
   1696              }
   1697              else
   1698              {
   1699          #if (STOP_RAMP_DURING_INVERSION == ENABLED)
   1700                  // braking is ended: restart the ramp if it was stopped (default deceleration is 0)
   1701                  if (Mcl_Cs.flags.bit.stopped_ramp == 1)
   1702                  {
   1703                      SpeedRefGen__ApplyDefaultAccel(FALSE);
   1704                      Mcl_Cs.flags.bit.stopped_ramp = 0;
   1705                  }
   1706          #endif
   1707                  // logic to detect motor direction
   1708                  // update motor direction (if not braking)
   1709                  if (Mcl_IO.Speed_Rot_Ref>0)
   1710                  {
   1711                      Mcl_Cs.flags.bit.motor_direction = 1;
   1712                  }
   1713                  else if (Mcl_IO.Speed_Rot_Ref<0)
   1714                  {
   1715                      Mcl_Cs.flags.bit.motor_direction = 0;
   1716                  }
   1717              }
   1718          }

