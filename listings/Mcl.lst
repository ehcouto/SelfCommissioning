   1492          /**
   1493           *  @brief      Calculate RMS values and mean speed value in 4khz handler (256ms time windows)
   1494           *  @param[in]  Motor currents and rotor speed.
   1495           *  @param[out] Mean RMS current of the three motor phasesa and the mean speed.
   1496           *  @param[in]  SAMPLES_NUMBER: 10 suitable choice to have ~250ms of time window at 4Khz
   1497           *  @return none
   1498           */
   1499          static void Calc_MeanSpeed_CurrentRMS(void)
   1500          {
   1501          
   1502              I1_Rms_Sum += (Mcl_IO.Is_ABC.A * Mcl_IO.Is_ABC.A);
   1503              I2_Rms_Sum += (Mcl_IO.Is_ABC.B * Mcl_IO.Is_ABC.B);
   1504              I3_Rms_Sum += (Mcl_IO.Is_ABC.C * Mcl_IO.Is_ABC.C);
   1505              Mean_Speed_Sum += Mcl_Quantities.Speed_Rot_Mech_Abs;
   1506          
   1507              N_Samples++;
   1508          
   1509              if(N_Samples >= Mcl_Params_Displ1->ResTempCalc.Samples_Number)
   1510              {
   1511          
   1512                  Mcl_Quantities.IsRMS = MC_SQRT_F((I1_Rms_Sum+I2_Rms_Sum+I3_Rms_Sum)*INV_3* N_Samples_inv);
   1513                  Mcl_Quantities.Mean_Speed = Mean_Speed_Sum * N_Samples_inv;
   1514          
   1515                  N_Samples  = 0;
   1516                  I1_Rms_Sum = 0.0f;
   1517                  I2_Rms_Sum = 0.0f;
   1518                  I3_Rms_Sum = 0.0f;
   1519                  Mean_Speed_Sum = 0.0f;
   1520              }
   1521          }
   1522          
   1523          
   1524          
   1525          
   1526          /**
   1527           *  @brief      Calculating temperature from resistance
   1528           *  @param[in]
   1529           *  @param[out]
   1530           *  @param[in]  Temperature coefficient and Resistance base temperature
   1531           *  @return     Stator temperature in [C]
   1532           */
   1533          static float32 Calc_Temperature_By_Resistance(void)
   1534          {
   1535              float32 temp_1;
   1536              float32 temp_2;
   1537          
   1538              // T = (R-Rs0)/(Rs0*alpha)  + T0
   1539          
   1540              temp_1 = Mcl_Quantities.Stator_Resistance - Mcl_Params_Displ1->ResTempCalc.Rs0;
   1541          
   1542              temp_2 = Mcl_Params_Displ1->ResTempCalc.Temp_Coeff * temp_1 * Mcl_Params_Displ1->ResTempCalc.Rs0_inv;
   1543              temp_2 += Mcl_Params_Displ1->ResTempCalc.T0;
   1544          
   1545              return(temp_2);
   1546          }
   1547          
   1548          
   1549          
   1550          /**
   1551           *  @brief      Calculating resistance from temperature
   1552           *  @param[in]  Temperature coefficient and Resistance base temperature
   1553           *  @param[out]
   1554           *  @param[in]
   1555           *  @return Updated stator resistance in [Ohm]
   1556           */
   1557          static float32 Calc_Resistance_By_Temperature(void)
   1558          {
   1559              float32 temp_1;
   1560              float32 temp_2;
   1561              // Rs = Rs0*(1+1/alpha (T - T0))
   1562              temp_1 = 1 + Mcl_Params_Displ1->ResTempCalc.Temp_Coeff_inv * (Mcl_Quantities.Stator_Temperature - Mcl_Params_Displ1->ResTempCalc.T0);
   1563              temp_2 = Mcl_Params_Displ1->ResTempCalc.Rs0 * temp_1;
   1564          
   1565              return(temp_2);
   1566          }
