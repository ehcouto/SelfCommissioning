    255          
    256          //---------------------------------------------------------------------------------------------------------------------
    257          /**
    258           * Background function for the API018Diagnostic module.
    259           */
    260          void API018Diagnostic__Handler25ms(void)
    261          {
    262              #if (API018_SERVER_FEATURE == ENABLED)
    263                  if (Api018.Requested_Sections != API018_INACTIVE)
    264                  {
    265                      // Setup local variables to build the transmission packet.
    266                      // If any failures are detected, the static variables are unchanged and we can try again after 25ms.
    267                      uint8  sending_sections       = Api018.Sending_Sections_Mask ;
    268                      uint16 sending_section_offset = Api018.Sending_Section_Offset;
    269                      uint16 sending_total_offset   = Api018.Sending_Total_Offset  ;
    270          
    271                      // Setup a message packet for transmission with the requested sections and the buffer offset.
    272                      REVEAL_COMMAND_TYPE* msg = Reveal__NewFeedback(API018DIAGNOSTIC_NUM, API018_FBK_PUBLISH_STATISTICS, Api018.Requesting_Node, REVEAL_PAYLOAD_SIZE);
    273                      uint8 payload_remaining = REVEAL_PAYLOAD_SIZE;
    274                      PASS_FAIL_TYPE success = PASS;
    275                      if (Api018.Sending_Total_Offset == 0)
    276                      {
    277                          // This is the first packet. Include the section(s) and the size of the section(s).
    278                          success = Reveal__AddDataU8(msg, Api018.Requested_Sections);
    279                          payload_remaining -= sizeof(uint8);
    280                          BOOL_TYPE use_version_numbers = (BOOL_TYPE)BIT_TEST(Api018.Requested_Sections, API018_USE_VERSION_NUMBERS);
    281                          if (use_version_numbers)
    282                          {
    283                              success &= Reveal__AddDataU8(msg, STATISTICS_CROSS_PLATFORM_VERSION);
    284                              success &= Reveal__AddDataU8(msg, STATISTICS_PLATFORM_SPECIFIC_VERSION);
    285                              payload_remaining -= 2 * sizeof(uint8);
    286                          }
    287                          API018_SECTION_TYPE section = (API018_SECTION_TYPE)(Api018.Requested_Sections & ~(1 << API018_USE_VERSION_NUMBERS));
    288                          uint16 total_size = GetSectionSize(section);
    289                          success &= Reveal__AddDataU16(msg, total_size);
    290                          payload_remaining -= sizeof(uint16);
    291                      }
    292          
    293                      // Add data to the message until the payload is full or there are no more statistics sections.
    294                      while ((success == PASS) && (payload_remaining > 0) && (sending_sections > 0))
    295                      {
    296                          // Get information on the next section that must be sent.
    297                          API018_SECTION_TYPE section = GetNextSectionID(sending_sections);
    298                          uint8* section_address = GetSectionAddress(section);
    299                          uint16 section_size = 0;
    300                          if (section != API018_SECTION_NONE_REMAINING)
    301                          {
    302                              section_size = API018_HEADER_PACKET[section - 1].Number_Of_Elements * API018_HEADER_PACKET[section - 1].Size_Of_Elements;
    303                          }
    304                          if ((section_address == NULL) || (section_size == 0))
    305                          {
    306                              // Empty section was passed successfully.
    307                              BIT_CLR(sending_sections, section);
    308                          }
    309                          else
    310                          {
    311                              // Determine what part of the section fits in the payload.
    312                              uint16 section_remaining = section_size - sending_section_offset;
    313                              uint8 section_transmit = ((section_remaining <= payload_remaining) ? section_remaining : payload_remaining);
    314          
    315                              // Send part (or all) of the next section.
    316                              success = Reveal__AddDataU8Buffer(msg, &section_address[sending_section_offset], section_transmit);
    317                              if (success == PASS)
    318                              {
    319                                  if (section_transmit == section_remaining)
    320                                  {
    321                                      // All of the statistics section was sent.
    322                                      BIT_CLR(sending_sections, section);
    323                                      sending_section_offset = 0;
    324                                  }
    325                                  else
    326                                  {
    327                                      // Only part of the statistics section was sent.
    328                                      sending_section_offset += section_transmit;
    329                                  }
    330                                  sending_total_offset += section_transmit;
    331                              }
    332                              payload_remaining -= section_transmit;
    333                          }
    334                      }
    335          
    336                      if (success == PASS)
    337                      {
    338                          if (sending_sections > 0)
    339                          {
    340                              msg->opcode |= REVEAL_MMP_BIT;
    341                          }
    342                          if (Reveal__QueueCommand(msg) == TRUE)
    343                          {
    344                              if (sending_sections > 0)
    345                              {
    346                                  // Save status for the next statistics data packet.
    347                                  Api018.Sending_Sections_Mask  = sending_sections      ;
    348                                  Api018.Sending_Section_Offset = sending_section_offset;
    349                                  Api018.Sending_Total_Offset   = sending_total_offset  ;
    350                              }
    351                              else
    352                              {
    353                                  Api018.Requested_Sections = API018_INACTIVE;
    354                              }
    355                          }
    356                      }
    357                  }
    358              #endif      // #if (API018_SERVER_FEATURE == ENABLED)
    359          }
    360          
    361          
    362          //---------------------------------------------------------------------------------------------------------------------
    363          /**
    364           * This method parses API018 commands sent to a broadcast node or exclusively to this node.
    365           * @param cmd = Pointer to the received command message.
    366           * @return REVEAL_RECIPE_STATUS_TYPE that expresses the result of the parsing.
    367           */
    368          REVEAL_RECIPE_STATUS_TYPE API018Diagnostic__CommandParser(REVEAL_MSG_TYPE* cmd)
    369          {
    370              REVEAL_RECIPE_STATUS_TYPE reveal_response = NVO_RS_UNSUP_UNAVAILABLE;
    371          
    372              switch ((API018DIAGNOSTIC_OPCODE_TYPE)cmd->op_code)
    373              {
    374              #if (API018_SERVER_FEATURE == ENABLED)
    375                  case API018_CMD_REQUEST_STATISITCS_VERSION:
    376                      // No payload
    377                      {
    378                          REVEAL_COMMAND_TYPE* fbk = Reveal__NewFeedback(API018DIAGNOSTIC_NUM, API018_FBK_PUBLISH_STATISTICS_VERSION, cmd->node_id, 2);
    379                          if ((Reveal__AddDataU8(fbk, STATISTICS_CROSS_PLATFORM_VERSION) == PASS) &&
    380                              (Reveal__AddDataU8(fbk, STATISTICS_PLATFORM_SPECIFIC_VERSION) == PASS) &&
    381                              (Reveal__QueueCommand(fbk) == TRUE))
    382                          {
    383                              reveal_response = NVO_RS_READY;
    384                          }
    385                      }
    386                      break;
    387          
    388                  case API018_CMD_GENERATE_FAULT:
    389                      // Client Fault Key (U16).
    390                      if (cmd->size >= 2)
    391                      {
    392                          API018_FAULT_KEY_TYPE fault_key = (API018_FAULT_KEY_TYPE)Utilities__ConvertArrayTo16bits(&cmd->payload[0]);
    393                          if (GenerateFault(cmd->node_id, fault_key) == TRUE)
    394                          {
    395                              reveal_response = NVO_RS_READY;
    396                          }
    397                      }
    398                      break;
    399          
    400                  case API018_CMD_CLEAR_SAVED_FAULTS:
    401                      // No payload.
    402                      Fault__ResetAllObservers();
    403                      Statistics__ClearFaultData();
    404                      reveal_response = NVO_RS_READY;
    405                      break;
    406          
    407                  case API018_CMD_REMOVE_FAULT:
    408                      // Client Fault Key (U16).
    409                      if (cmd->size >= 2)
    410                      {
    411                          API018_FAULT_KEY_TYPE fault_key = (API018_FAULT_KEY_TYPE)Utilities__ConvertArrayTo16bits(&cmd->payload[0]);
    412                          if (RemoveFault(cmd->node_id, fault_key) == TRUE)
    413                          {
    414                              reveal_response = NVO_RS_READY;
    415                          }
    416                      }
    417                      break;
    418          
    419                  case API018_CMD_REQUEST_FAULT_CODES:
    420                      // No payload = Send all fault codes.
    421                      // Or expect one parameter.
    422                      //      Fault Index (U8) 0 = Most recently fault, 1 = Next most recent fault, ..., 255 = Send all fault codes.
    423                      {
    424                          uint8 index = ((cmd->size >= 1) ? cmd->payload[0] : 255);
    425                          if (API018Diagnostic__PublishFaultBasic(index) == PASS)
    426                          {
    427                              reveal_response = NVO_RS_READY;
    428                          }
    429                      }
    430                      break;
    431          
    432                  case API018_CMD_REQUEST_STATISTICS:
    433                      // No payload = Send all statistics data.
    434                      // Or expect one parameter with which section should be published.
    435                      //      Section Number (U8) 1 = Section 1, 2 = Section 2, etc.
    436                      if (Api018.Requested_Sections == API018_INACTIVE)
    437                      {
    438                          // Save the request byte to echo back in the response.
    439                          // Valid values are [0x01..0x07,0x80..0x87]
    440                          uint8 requested = ((cmd->size > 0) ? cmd->payload[0] : API018_SECTION_ALL);
    441          
    442                          // Determine which section is requested.
    443                          uint8 section = requested;
    444                          BIT_CLR(section, API018_USE_VERSION_NUMBERS);
    445                          section = (section ? section : API018_SECTION_ALL);
    446          
    447                          // Validate the request.
    448                          if (((API018_SECTION_FIRST <= section) && (section <= API018_SECTION_LAST)) ||
    449                              (section == API018_SECTION_ALL))
    450                          {
    451                              Api018.Requesting_Node = cmd->node_id;
    452                              Api018.Requested_Sections = (API018_SECTION_TYPE)requested;
    453                              if (section == API018_SECTION_ALL)
    454                              {
    455                                  #define API018_SECTION_MASK_ALL ((1 << (API018_SECTION_LAST + 1)) - 2)
    456                                  Api018.Sending_Sections_Mask = API018_SECTION_MASK_ALL;
    457                              }
    458                              else
    459                              {
    460                                  Api018.Sending_Sections_Mask = (1 << section);
    461                              }
    462                              Api018.Sending_Section_Offset = 0;
    463                              Api018.Sending_Total_Offset = 0;
    464                              reveal_response = NVO_RS_READY;
    465                          }
    466                      }
    467                      break;
    468          
    469                  case  API018_CMD_REQUEST_COMMON_LIFETIME_DATA:
    470                      // No payload.
    471                      {
    472                          PASS_FAIL_TYPE result = PASS;
    473                          #if (STATISTICS_SAVED_CYCLES > 0)
    474                              REVEAL_COMMAND_TYPE* fbk = Reveal__NewFeedback(API018DIAGNOSTIC_NUM, API018_FBK_PUBLISH_COMMON_LIFETIME_DATA, REVEAL_BROADCAST_NODE, 10);
    475                          #else
    476                              REVEAL_COMMAND_TYPE* fbk = Reveal__NewFeedback(API018DIAGNOSTIC_NUM, API018_FBK_PUBLISH_COMMON_LIFETIME_DATA, REVEAL_BROADCAST_NODE, 6);
    477                          #endif
    478                          STATISTICS_LIFETIME_TYPE* cycle_lifetime_data = Statistics__GetLifetimeData();
    479                          #if (STATISTICS_SAVED_CYCLES > 0)
    480                              // Get cycles started if it is available.
    481                              uint16 cycle_count = cycle_lifetime_data->Cycles_Started;
    482                          #else
    483                              // Get cycles completed if cycles started is not available.
    484                              uint16 cycle_count = cycle_lifetime_data->Cycles_Completed;
    485                          #endif
    486                          // Send lifetime seconds and cycle count.
    487                          if ((Reveal__AddDataU32(fbk, cycle_lifetime_data->Seconds) != PASS) ||
    488                              (Reveal__AddDataU16(fbk, cycle_count) != PASS))
    489                          {
    490                              result = FAIL;
    491                          }
    492                          #if (STATISTICS_SAVED_CYCLES > 0)
    493                              // Send cycle run-time if available.
    494                              if (Reveal__AddDataU32(fbk, cycle_lifetime_data->Seconds_Running_Cycles) != PASS)
    495                              {
    496                                  result = FAIL;
    497                              }
    498                          #endif
    499                          // Transmit the message.
    500                          if (result == PASS)
    501                          {
    502                              if (Reveal__QueueCommand(fbk) == TRUE)
    503                              {
    504                                  reveal_response = NVO_RS_READY;
    505                              }
    506                          }
    507                      }
    508                      break;
    509          
    510                  case API018_CMD_REQUEST_DIAGNOSTIC_CONFIG:
    511                      // No payload.
    512                      {
    513                          REVEAL_COMMAND_TYPE* fbk = Reveal__NewFeedback(API018DIAGNOSTIC_NUM, API018_FBK_PUBLISH_DIAGNOSTIC_CONFIG, cmd->node_id, sizeof(API018_HEADER_PACKET));
    514                          if ((Reveal__AddDataU8Buffer(fbk, (void*)API018_HEADER_PACKET, sizeof(API018_HEADER_PACKET)) == PASS) &&
    515                              (Reveal__QueueCommand(fbk) == TRUE))
    516                          {
    517                              reveal_response = NVO_RS_READY;
    518                          }
    519                      }
    520                      break;
    521              #endif      // #if (API018_SERVER_FEATURE == ENABLED)
    522          
    523                  default:
    524                      reveal_response = NVO_RS_UNSUP_OP_CODE;
    525                      break;
    526              }
    527          
    528              return (reveal_response);
    529          }
    530          
    531          
    532          //---------------------------------------------------------------------------------------------------------------------
    533          /**
    534           * This method parses API018 feedbacks sent to a broadcast or exclusively to this node.
    535           * @param fbk = Pointer to the received feedback message.
    536           */
    537          void API018Diagnostic__FeedbackParser(REVEAL_MSG_TYPE * fbk)
    538          {
    539              #if ((API018_SERVER_FEATURE == DISABLED) && (API018_CLIENT_FEATURE == ENABLED))
    540                  switch ((API018DIAGNOSTIC_OPCODE_TYPE)fbk->op_code)
    541                  {
    542                      case API018_FBK_PUBLISH_FAULT_CODES:
    543                          // 4 bytes repeated:
    544                          //      Fault Index (U8) 0 = Most recently recorded fault, 1 = Next most recently recorded fault, etc.
    545                          //      Fault Code (U8)
    546                          //      Fault Sub-Code (U8)
    547                          //      Engineering Code (U8)
    548                          Api018.Number_Of_Error_Codes = 0;
    549                          memset(Api018.Error_Codes, UCHAR_MAX, sizeof(Api018.Error_Codes));
    550                          for (uint8 i = 0; i < fbk->size; i += 4)
    551                          {
    552                              uint8 fault_index = i / 4;
    553                              if (fault_index < API018_MAX_STORED_FAULTS)
    554                              {
    555                                  API018_ERROR_CODE_TYPE* e = &Api018.Error_Codes[fault_index];
    556                                  e->F_Code = fbk->payload[i + 1];
    557                                  e->E_Code = fbk->payload[i + 2];
    558                                  e->Eng_Code = fbk->payload[i + 3];
    559                                  Api018.Number_Of_Error_Codes++;
    560                              }
    561                          }
    562                          HmiFaultMgr__ReceiveFaultData();
    563                          break;
    564          
    565                      case API018_FBK_PUBLISH_COMMON_LIFETIME_DATA:
    566                          //Seconds-payload bytes 0 to 3
    567                          //Cycles_Count-payload bytes 4 to 5
    568                          //Seconds_Running_Cycle-payload bytes 6 to 9(When STATISTICS_SAVED_CYCLES>0)
    569                          if (fbk->size >= 6)
    570                          {
    571                              Api018.Common_Lifetime_Data.Seconds=Utilities__ConvertArrayTo32bits(&fbk->payload[0]);
    572                              Api018.Common_Lifetime_Data.Cycle_Count=Utilities__ConvertArrayTo16bits(&fbk->payload[4]);
    573                              if (fbk->size >= 10)
    574                              {
    575                                  Api018.Common_Lifetime_Data.Seconds_Running_Cycles=Utilities__ConvertArrayTo32bits(&fbk->payload[6]);
    576                              }
    577                          }
    578                          break;
    579          
    580                      default:
    581                          break;
    582                  }
    583              #endif
    584          }
