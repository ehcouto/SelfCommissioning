    588          /**
    589           * Acknowledge parser for API018.
    590           * @param node = Node address that acknowledged the command message.
    591           * @param api = The API of the previously sent command message.
    592           * @param opcode = The OpCode of the previously sent command message.
    593           * @param reasoncode = The response sent in response to the previously sent command message.
    594           */
    595          void API018Diagnostic__AckParser(uint8 node, uint8 api, uint8 op_code, REVEAL_RECIPE_STATUS_TYPE reason_code)
    596          {
    597          }
    598          
    599          
    600          #if (API018_SERVER_FEATURE == ENABLED)
    601          //---------------------------------------------------------------------------------------------------------------------
    602          /**
    603           * Publish the fault code for the indexed fault.
    604           * @param requested_fault_index = Index into the list of stored faults.
    605           *                                255 indicates that all faults are requested.
    606           * @return PASS if the message was sent. Otherwise FAIL.
    607           */
    608          PASS_FAIL_TYPE API018Diagnostic__PublishFaultBasic(uint8 requested_fault_index)
    609          {
    610              PASS_FAIL_TYPE result = FAIL;
    611          
    612              // Request a feedback message buffer with the maximum data that may be needed.
    613              uint8 fault_count = Statistics__ApplyFaultAgeCutoff();
    614              REVEAL_COMMAND_TYPE* fbk = Reveal__NewFeedback(API018DIAGNOSTIC_NUM, API018_FBK_PUBLISH_FAULT_CODES, REVEAL_BROADCAST_NODE, fault_count * STATISTICS_SAVED_FAULTS);
    615              if (fbk != NULL)
    616              {
    617                  // Iterate through the fault data.
    618                  result = (PASS_FAIL_TYPE)(requested_fault_index == 255);
    619                  STATISTICS_FAULT_TYPE* faults = Statistics__GetFaultData(0);
    620                  for (uint8 fault_index = 0; fault_index < fault_count; fault_index++, faults++)
    621                  {
    622                      if ((requested_fault_index >= STATISTICS_SAVED_FAULTS) ||
    623                          (requested_fault_index == fault_index))
    624                      {
    625                          result = PASS;
    626                          if ((Reveal__AddDataU8(fbk, fault_index) != PASS) ||
    627                              (Reveal__AddDataU8(fbk, faults->Fault_Code) != PASS) ||
    628                              (Reveal__AddDataU8(fbk, faults->Fault_Sub_Code) != PASS) ||
    629                              (Reveal__AddDataU8(fbk, faults->Fault_Eng_Code) != PASS))
    630                          {
    631                              // Failed to build the Reveal packet.
    632                              result = FAIL;
    633                              break;                              // Break out of the for() loop.
    634                          }
    635                      }
    636                  }
    637          
    638                  // Transmit the message.
    639                  if (result == PASS)
    640                  {
    641                      if (Reveal__QueueCommand(fbk) != TRUE)
    642                      {
    643                          result = FAIL;
    644                      }
    645                  }
    646              }
    647          
    648              return result;
    649          }
