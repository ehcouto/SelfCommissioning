    161          // -- Private Flash-Based Constant Definitions --
    162          
    163          #if (API018_SERVER_FEATURE == ENABLED)
    164          //! A packet that conveys platform-specific information about diagnostic information.
    165          //! This is the payload of the API018_FBK_PUBLISH_DIAGNOSTIC_CONFIG message.
    166          static const PACKED API018_HEADER_ENTRY_TYPE API018_HEADER_PACKET[] =
    167          {
    168              {
    169                  1,                                          // Number of lifetime data elements
    170                  sizeof(STATISTICS_LIFETIME_TYPE)            // Size of each lifetime data element
    171              },
    172              {
    173                  STATISTICS_SAVED_CYCLES,                    // Number of saved cycle data elements
    174                  #if (STATISTICS_SAVED_CYCLES > 0)
    175                      sizeof(STATISTICS_CYCLE_TYPE)           // Size of each saved cycle data element
    176                  #else
    177                      0
    178                  #endif
    179              },
    180              {
    181                  STATISTICS_SAVED_FAULTS,                    // Number of fault data elements
    182                  sizeof(STATISTICS_FAULT_TYPE)               // Size of each fault data element
    183              },
    184              {
    185                  STATISTICS_SAVED_PRE_FAULTS,                // Number of pre-fault data elements
    186                  sizeof(STATISTICS_FAULT_TYPE)               // Size of each pre-fault data element
    187              },
    188              {
    189                  STATISTICS_SAVED_LAST_CYCLES,               // Number of saved last cycle data elements
    190                  #if (STATISTICS_SAVED_LAST_CYCLES > 0)
    191                      sizeof(PLATFORM_LAST_CYCLE_TYPE)        // Size of each saved last cycle data element
    192                  #else
    193                      0
    194                  #endif
    195              },
    196              {
    197                  STATISTICS_SAVED_FAULT_BLACK_BOX,           // Number of black box data elements for faults
    198                  #if (STATISTICS_SAVED_FAULT_BLACK_BOX > 0)
    199                      sizeof(PLATFORM_BLACK_BOX_TYPE)         // Size of each saved black box data element
    200                  #else
    201                      0
    202                  #endif
    203              },
    204              {
    205                  STATISTICS_SAVED_PRE_FAULT_BLACK_BOX,       // Number of black box data elements for pre-faults
    206                  #if (STATISTICS_SAVED_PRE_FAULT_BLACK_BOX > 0)
    207                      sizeof(PLATFORM_BLACK_BOX_TYPE)         // Size of each saved black box data element
    208                  #else
    209                      0
    210                  #endif
    211              }
    212          };
    213          CT_ASSERT(ELEMENTS_IN_ARRAY(API018_HEADER_PACKET) == (API018_SECTION_LAST - API018_SECTION_FIRST) + 1);
    214          #endif      // #if (API018_SERVER_FEATURE == ENABLED)
