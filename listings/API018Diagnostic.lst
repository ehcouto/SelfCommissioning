    802          
    803          
    804          #if (API018_SERVER_FEATURE == ENABLED)
    805          //---------------------------------------------------------------------------------------------------------------------
    806          /**
    807           * Generate a fault.
    808           * @param node_id = The communication node that reported the fault.
    809           * @param fault_key = The unique cross-category fault key to translate to a category-specific fault ID.
    810           * @return TRUE if the fault was generated; otherwise FALSE.
    811           */
    812          static BOOL_TYPE GenerateFault(uint8 node_id, API018_FAULT_KEY_TYPE fault_key)
    813          {
    814              for (uint8 i = 0; i < ELEMENTS_IN_ARRAY(MAP_FAULT_KEYS_TO_FAULT_IDS); i++)
    815              {
    816                  if ((MAP_FAULT_KEYS_TO_FAULT_IDS[i].Node == node_id) && (MAP_FAULT_KEYS_TO_FAULT_IDS[i].Key == fault_key))
    817                  {
    818                      FAULT_ID_TYPE fault_id = MAP_FAULT_KEYS_TO_FAULT_IDS[i].Fault_Id;
    819                      if (fault_id != FAULT_ID_NONE)
    820                      {
    821                          Fault__ConditionDetected(fault_id);
    822                          return TRUE;
    823                      }
    824                  }
    825              }
    826              return FALSE;
    827          }
    828          
    829          
    830          //---------------------------------------------------------------------------------------------------------------------
    831          /**
    832           * Get the next statistics section ID based on the specified requested sections.
    833           * @param requested = The statistics sections that are requested (one for each bit).
    834           * @return The next statistics section ID based on the specified requested sections.
    835           */
    836          static API018_SECTION_TYPE GetNextSectionID(uint8 requested)
    837          {
    838              for (API018_SECTION_TYPE section = API018_SECTION_FIRST; section <= API018_SECTION_LAST; section++)
    839              {
    840                  if (BIT_TEST(requested, section) == 1)
    841                  {
    842                      return section;
    843                  }
    844              }
    845              return API018_SECTION_NONE_REMAINING;
    846          }
    847          
    848          
    849          //---------------------------------------------------------------------------------------------------------------------
    850          /**
    851           * Get a pointer to the requested statistics section.
    852           * @param requested = The requested statistics section.
    853           * @return A pointer to the requested statistics section.
    854           */
    855          static void* GetSectionAddress(API018_SECTION_TYPE requested)
    856          {
    857              switch (requested)
    858              {
    859                  case API018_SECTION_HEADER:
    860                      return (void*)API018_HEADER_PACKET;
    861          
    862                  case API018_SECTION_LIFETIME:
    863                      return Statistics__GetLifetimeData();
    864          
    865                  case API018_SECTION_CYCLES:
    866                      #if (STATISTICS_SAVED_CYCLES > 0)
    867                          return Statistics__GetCycleData(0);
    868                      #else
    869                          return NULL;
    870                      #endif
    871          
    872                  case API018_SECTION_FAULTS:
    873                      return Statistics__GetFaultData(0);
    874          
    875                  case API018_SECTION_PRE_FAULTS:
    876                      return Statistics__GetPreFaultData(0);
    877          
    878                  case API018_SECTION_LAST_CYCLES:
    879                      #if (STATISTICS_SAVED_LAST_CYCLES > 0)
    880                          return Statistics__GetLastCycleData(0);
    881                      #else
    882                          return NULL;
    883                      #endif
    884          
    885                  case API018_SECTION_FAULTS_BLACK_BOX:
    886                      #if (STATISTICS_SAVED_FAULT_BLACK_BOX > 0)
    887                          return Statistics__GetFaultBlackBoxData(0);
    888                      #else
    889                          return NULL;
    890                      #endif
    891          
    892                  case API018_SECTION_PRE_FAULTS_BLACK_BOX:
    893                      #if (STATISTICS_SAVED_PRE_FAULT_BLACK_BOX > 0)
    894                          return Statistics__GetPreFaultBlackBoxData(0);
    895                      #else
    896                          return NULL;
    897                      #endif
    898          
    899                  default:
    900                      break;
    901              }
    902              return NULL;
    903          }
    904          
    905          
    906          //---------------------------------------------------------------------------------------------------------------------
    907          /**
    908           * Get the size of the specified statistics section.
    909           * @param section = The specified statistics section.
    910           *                  All sections are assumed if value is not a valid section number.
    911           * @return The size of the specified statistics section.
    912           */
    913          static uint16 GetSectionSize(API018_SECTION_TYPE section)
    914          {
    915              uint16 size;
    916              if ((API018_SECTION_FIRST <= section) && (section <= API018_SECTION_LAST))
    917              {
    918                  uint8 index = section - 1;
    919                  size = API018_HEADER_PACKET[index].Number_Of_Elements * API018_HEADER_PACKET[index].Size_Of_Elements;
    920              }
    921              else
    922              {
    923                  size = 0;
    924                  for (uint8 section = API018_SECTION_FIRST; section <= API018_SECTION_LAST; section++)
    925                  {
    926                      uint8 index = section - 1;
    927                      size += API018_HEADER_PACKET[index].Number_Of_Elements * API018_HEADER_PACKET[index].Size_Of_Elements;
    928                  }
    929              }
    930              return size;
    931          }
    932          
    933          
    934          //---------------------------------------------------------------------------------------------------------------------
    935          /**
    936           * Remove a fault.
    937           * @param node_id = The communication node that is removing the fault.
    938           * @param fault_key = The unique cross-category fault key to translate to a category-specific fault ID.
    939           * @return TRUE if the fault was removed; otherwise FALSE.
    940           */
    941          static BOOL_TYPE RemoveFault(uint8 node_id, API018_FAULT_KEY_TYPE fault_key)
    942          {
    943              for (uint8 i = 0; i < ELEMENTS_IN_ARRAY(MAP_FAULT_KEYS_TO_FAULT_IDS); i++)
    944              {
    945                  if ((MAP_FAULT_KEYS_TO_FAULT_IDS[i].Node == node_id) && (MAP_FAULT_KEYS_TO_FAULT_IDS[i].Key == fault_key))
    946                  {
    947                      FAULT_ID_TYPE fault_id = MAP_FAULT_KEYS_TO_FAULT_IDS[i].Fault_Id;
    948                      if (fault_id != FAULT_ID_NONE)
