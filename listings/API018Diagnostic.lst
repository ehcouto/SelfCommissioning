    713          //---------------------------------------------------------------------------------------------------------------------
    714          /**
    715           * Get the error code for the specified fault index.
    716           * @param fault_index = The requested fault index. 0 = most recent fault.
    717           * @return The error code for the specified fault index.
    718           *         If there is no error code at the specified fault index, then return Fault Code UCHAR_MAX.
    719           */
    720          API018_ERROR_CODE_TYPE Api018Diagnostic__GetErrorCode(uint8 fault_index)
    721          {
    722              API018_ERROR_CODE_TYPE e = { UCHAR_MAX, UCHAR_MAX, UCHAR_MAX };
    723              #if (API018_SERVER_FEATURE == ENABLED)
    724                  uint8 fault_count = Statistics__ApplyFaultAgeCutoff();
    725                  if (fault_index < fault_count)
    726                  {
    727                      STATISTICS_FAULT_TYPE* fault = Statistics__GetFaultData(fault_index);
    728                      if ((fault != NULL) && (fault->Fault_Id != FAULT_ID_NONE))
    729                      {
    730                          FAULT_CONFIG_TYPE* fault_config = Fault__GetParameters((FAULT_ID_TYPE)fault->Fault_Id);
    731                          if (fault_config != NULL)
    732                          {
    733                              e.F_Code = fault_config->Code;
    734                              e.E_Code = fault_config->Sub_Code;
    735                              e.Eng_Code = fault_config->Engineering_Code;
    736                          }
    737                      }
    738                  }
    739              #else   /* if only API018_CLIENT_FEATURE is ENABLED */
    740                  if ((fault_index < API018_MAX_STORED_FAULTS) &&
    741                      (fault_index < Api018.Number_Of_Error_Codes))
    742                  {
    743                      e = Api018.Error_Codes[fault_index];
    744                  }
    745              #endif
    746              return e;
    747          }
