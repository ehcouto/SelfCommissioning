     40          
     41          //! maximum number of function input parameters allowed
     42          #define MAX_PARAMETERS_NUMBER   (sizeof(uint32)*2)-1
     43          
     44          //!Reveal more message pending value
     45          #define REVEAL_MMP_BIT  ((uint8)0x80)
     46          
     47          //!Maximum length of the label describing the method
     48          #define LABEL_MAX_LENGTH    40
     49          
     50          //!Value of the wrong index to address the execution of a method
     51          #define WRONG_FUNCTION_INDEX    0xFF
     52          
     53          //!Bit mask value to match the data type information of the return value inside the Signature variable
     54          #define RETURN_VALUE_POSITION_MASK  0x0000000F
     55          
     56          //! API's opcodes enumeration
     57          typedef enum
     58          {
     59              API004_CMD_EXECUTE_FUNCTION = 1, //!< API004_CMD_EXECUTE_FUNCTION
     60              API004_FBK_CONFIRM_EXECUTION = 1,//!< API004_FBK_CONFIRM_EXECUTION
     61              API004_CMD_REQUEST_FUNCTIONS_INFO = 2,//!< API004_CMD_REQUEST_FUNCTIONS_INFO
     62              API004_FBK_FUNCTIONS_INFO = 2//!< API004_FBK_FUNCTIONS_INFO
     63          }API004DEBUG_OPCODES_TYPE;
     64          
     65          #ifdef DEBUG_APIS_LIST
     66          //! The data type applied to the function pointer without a return value
     67          typedef void (*DEBUG_FUNCTION_HANDLER_TYPE)();
     68          
     69          //! The data type applied to the function pointer with a return value
     70          typedef sint32 (*DEBUG_FUNCTION_WITH_RETURN_HANDLER_TYPE)();
     71          
     72          //! Array containing the Functions info
     73          static const DEBUG_FUNCTION_TYPE DEBUG_FUNCTIONS_LIST[] = DEBUG_APIS_LIST;
     74          
     75          //!Number of functions in the DEBUG_FUNCTIONS_LIST
     76          #define NUMBER_OF_FUNCTIONS sizeof(DEBUG_FUNCTIONS_LIST)/sizeof(DEBUG_FUNCTION_TYPE)
     77          // The NUMBER_OF_FUNCTIONS must be smaller than 255
     78          CT_ASSERT(NUMBER_OF_FUNCTIONS < 0xFF);
     79          #endif
     80          //-------------------------------------- PRIVATE (Function Prototypes) ------------------------------------------------
     81          
     82          #ifdef DEBUG_APIS_LIST
     83          static REVEAL_RECIPE_STATUS_TYPE ExecuteFunction(sint32 array[],uint8 function_position,uint8 node_id,BOOL_TYPE return_value_function);
     84          static BOOL_TYPE PrintOnReveal(uint8 function_id, char* str, uint32 sign,BOOL_TYPE mmp_enabled, uint8 node_id);
     85          #endif
