   2127          /**
   2128           *  @brief  Updates the pwm output according to the required pattern.
   2129           */
   2130          #ifdef __IAR_SYSTEMS_ICC__
   2131          #pragma inline = forced
   2132          #endif
   2133          void Drive_The_Motor(void)
   2134          {
   2135              sint32 dutyA;
   2136              sint32 dutyB;
   2137              sint32 dutyC;
   2138          
   2139              // LowersOn should have higher priority than All Devices Off
   2140              if(BIT_TEST(Mci_Flow_Control, MCI_FORCE_LOWERS_ON))
   2141              {
   2142                  MotorSafetyMgr__ConfigPwmPattern(OUTPUT_PATTERN_LOWERS_ON);
   2143              }
   2144              else if(BIT_TEST(Mci_Flow_Control, MCI_ALL_DEVICES_OFF))
   2145              {
   2146                  MotorSafetyMgr__ConfigPwmPattern(OUTPUT_PATTERN_ALL_DEV_OFF);
   2147              }
   2148              else
   2149              {
   2150                  // Check if there is any lower on or all device off commands
   2151                  if(Mcl_IO.Lowers_On + Mcl_IO.All_Devices_Off)
   2152                  {
   2153                      if(Mcl_IO.Lowers_On)
   2154                      {
   2155                          MotorSafetyMgr__ConfigPwmPattern(OUTPUT_PATTERN_LOWERS_ON);
   2156                      }
   2157                      else if(Mcl_IO.All_Devices_Off)
   2158                      {
   2159                          MotorSafetyMgr__ConfigPwmPattern(OUTPUT_PATTERN_ALL_DEV_OFF);
   2160                      }
   2161                  }
   2162                  else
   2163                  {
   2164                      dutyA = MCL_DUTY(Mcl_IO.Duty.A);
   2165                      dutyB = MCL_DUTY(Mcl_IO.Duty.B);
   2166                      dutyC = MCL_DUTY(Mcl_IO.Duty.C);
   2167                      MotorSafetyMgr__UpdatePwm(dutyA, dutyB, dutyC);
   2168                  }
   2169              }
   2170          }
