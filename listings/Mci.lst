    100          static MCI_PARAMS_TYPE* Mci_Parameters;
    101          static BOOL_TYPE Mci_Parameters_Loaded;
    102          
    103          //! Define the flags used to request manual injection
    104          #define MCI_REQ_MANUAL_INJECTION_FLOW_FLAGS     ((MCI_FLOWCONTROL_TYPE)1<<MCI_REQUESTED_MANUAL_DC_VOLTAGE) +   \
    105                                                          ((MCI_FLOWCONTROL_TYPE)1<<MCI_REQUESTED_MANUAL_AC_VOLTAGE) +   \
    106                                                          ((MCI_FLOWCONTROL_TYPE)1<<MCI_REQUESTED_MANUAL_DC_CURRENT) +   \
    107                                                          ((MCI_FLOWCONTROL_TYPE)1<<MCI_REQUESTED_MANUAL_AC_CURRENT)
    108          
    109          
    110          MCI_CONTROL_STATE_TYPE Mci_Control_State;           //!< Define the states used in this controller
    111          
    112          uint32 Mci_Error;                                   //!< [MCI_ERROR_TYPE] define all flags used in the mci management, use uint32
    113                                                              //!<                  rather MCI_ERROR_TYPE to prevent lint warnings.
    114          uint32 Mci_Error_Holder;                            //!< [MCI_ERROR_TYPE] copy of the Mci_Error, use uint32 rather MCI_ERROR_TYPE
    115                                                              //!<                  to prevent lint warnings.
    116          uint32 Mci_Flow_Control;                            //!< [MCI_FLOWCONTROL_TYPE] define some actions to control the algorithm flow
    117          uint32 Mci_Status_Control;                          //!< [MCI_DI_TYPE] define some actions to control the algorithm state control
    118          uint16 Mci_GP_Timer;                                //!< [seconds / MCI_CHECKERR_POSTSCALER] General Purpose timer.
    119                                                              //!< Timer to start up after POR. This timer also helps to filter out
    120                                                              //!< the tachometer signal and to perform the timeout during start up
    121          
    122          //-------------------------------------- PRIVATE (Function Prototypes) ------------------------------------------------
    123          
    124          //! Converts a value into TRUE or FALSE; 0 is FALSE, TRUE otherwise.
    125          #ifndef GET_TRUE_FALSE
    126              #define GET_TRUE_FALSE(value)           (BOOL_TYPE)(((value) == 0) ? (FALSE) : (TRUE))
    127          #endif
    128          
    129          //! MCI_SET_ERROR sets the flags data and its holder
    130          #define MCI_SET_ERROR(mci_flags)                BIT_SET(Mci_Error_Holder, (mci_flags));                 \
    131                                                          BIT_SET(Mci_Error_Holder, MCI_ERROR_ANY_ERROR_FOUND);   \
    132                                                          BIT_SET(Mci_Error, (mci_flags))
    133          
    134          //! MCI_CLR_ERROR resets only the flags data and does not touch the holder
    135          #define MCI_CLR_ERROR(mci_flags)                BIT_CLR(Mci_Error, (mci_flags))
    136          
    137          //! MCI_FLOWCONTROL_TYPE controls the algorithm flow
    138          #define MCI_SET_FLOW_CTL(mci_flowcontrol)       BIT_SET(Mci_Flow_Control, (mci_flowcontrol))
    139          #define MCI_CLR_FLOW_CTL(mci_flowcontrol)       BIT_CLR(Mci_Flow_Control, (mci_flowcontrol))
    140          
    141          //! MCI_DI_TYPE controls the DI state of motor control
    142          #define MCI_SET_STATUS_CTL(mci_statuscontrol)   BIT_SET(Mci_Status_Control, (mci_statuscontrol))
    143          #define MCI_CLR_STATUS_CTL(mci_statuscontrol)   BIT_CLR(Mci_Status_Control, (mci_statuscontrol))
