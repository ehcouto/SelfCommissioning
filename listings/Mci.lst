   2549          //---------------------------------------------------------------------------------------------------------------------
   2550          /**
   2551           * @brief   Check for all flow control that the algorithm uses.
   2552           */
   2553          #ifdef __IAR_SYSTEMS_ICC__
   2554          #pragma inline = forced
   2555          #endif
   2556          void Update_Status(void)
   2557          {
   2558              uint8 temp_u8;
   2559          
   2560              //////////////////////////////////////////////////////////////////////////////////////////
   2561              //// Check the flag MCI_IS_MOTOR_STOPPED & MCI_MOTOR_IDLE
   2562              // If the state is in IDLE
   2563              if(Mci_Control_State == MCI_IDLE)
   2564              {
   2565                  // Motor state is idle
   2566                  MCI_SET_STATUS_CTL(MCI_DI_IDLE);
   2567          
   2568                  // Motor state is in IDLE, therefore the motor shall not be being drive anymore
   2569                  MCI_CLR_STATUS_CTL(MCI_DI_MOTOR_RUNNING);
   2570          
   2571                  MCI_SET_STATUS_CTL(MCI_DI_MOTOR_STOP);
   2572          
   2573                  MCI_CLR_STATUS_CTL(MCI_DI_REACHED_TARGET_SPEED);
   2574              }
   2575              else // otherwise
   2576              {
   2577                  // the motor is not stopped
   2578                  MCI_CLR_STATUS_CTL(MCI_DI_MOTOR_STOP);
   2579          
   2580                  // Motor state not idle
   2581                  MCI_CLR_STATUS_CTL(MCI_DI_IDLE);
   2582          
   2583                  // If the main state is running
   2584                  if(Mci_Control_State == MCI_RUNNING)
   2585                  {
   2586                      // Set the motor running flag
   2587                      MCI_SET_STATUS_CTL(MCI_DI_MOTOR_RUNNING);
   2588          
   2589                      if(SpeedRefGen__GetStatus() == SPEED_REF_AT_PLATEAU)
   2590                      {
   2591                          MCI_SET_STATUS_CTL(MCI_DI_REACHED_TARGET_SPEED);
   2592                      }
   2593                      else
   2594                      {
   2595                          MCI_CLR_STATUS_CTL(MCI_DI_REACHED_TARGET_SPEED);
   2596                      }
   2597          
   2598          #if defined MCL_GET_OVER_TORQUE
   2599          
   2600                      temp_u8 = MCL_GET_OVER_TORQUE();
   2601                      if(temp_u8)
   2602                      {
   2603                          MCI_SET_STATUS_CTL(MCI_DI_OVER_TORQUE);
   2604                      }
   2605                      else
   2606                      {
   2607                          MCI_CLR_STATUS_CTL(MCI_DI_OVER_TORQUE);
   2608                      }
   2609          
   2610          #else
   2611          
   2612                      MCI_CLR_STATUS_CTL(MCI_DI_OVER_TORQUE);
   2613          
   2614          #endif
   2615                  }
   2616                  else
   2617                  {
   2618                          MCI_CLR_STATUS_CTL(MCI_DI_REACHED_TARGET_SPEED);
   2619                  }
   2620              }
   2621          
   2622          
   2623              // Check if parameters are loaded
   2624              temp_u8  = MotorSafetyMgr__GetFlag(SR_FLAG_MC_PARAMETERS_LOADED);
   2625              temp_u8 += MCL_GET_PARAMETERS_LOADED();
   2626              temp_u8 += (uint8)Mci_Parameters_Loaded;
   2627          #if (INVERTER_TEMP_SETTINGFILE_SUPPORT == ENABLED)
   2628              temp_u8 += (uint8) InverterTemp__GetParameterLoaded();
   2629          #endif
   2630          #if (POWERMODULE_MANAGER_USED == ENABLED)
   2631              temp_u8 += (uint8) PowerModuleManager__GetParameterLoaded();
   2632          #endif
   2633              if(temp_u8 == MCI_PARAMS_LOADED_CHECKS)
   2634              {
   2635                  MCI_SET_STATUS_CTL(MCI_DI_PARAMETERS_LOADED);
   2636              }
   2637              else
   2638              {
   2639                  MCI_CLR_STATUS_CTL(MCI_DI_PARAMETERS_LOADED);
   2640              }
   2641          
   2642          
   2643          }
   2644          
