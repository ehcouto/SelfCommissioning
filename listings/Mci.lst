   2649          /**
   2650           * @brief   Initialize the analog interface variables
   2651           */
   2652          
   2653          #ifdef __IAR_SYSTEMS_ICC__
   2654          #pragma inline = forced
   2655          #endif
   2656          void Initialize_Current_DCBus_Voltage(void)
   2657          {
   2658              Mcl_IO.Is_ABC.A = (MCL_NOTATION_TYPE)0;
   2659              Mcl_IO.Is_ABC.B = (MCL_NOTATION_TYPE)0;
   2660              Mcl_IO.Is_ABC.C = (MCL_NOTATION_TYPE)0;
   2661              Mcl_IO.Vdc      = (MCL_NOTATION_TYPE)0;
   2662          }
   2663          
   2664          
   2665          
   2666          
   2667          //---------------------------------------------------------------------------------------------------------------------
   2668          /**
   2669           * @brief   Convert data from peripherals into requested to the motor control
   2670           */
   2671          #ifdef __IAR_SYSTEMS_ICC__
   2672          #pragma inline = forced
   2673          #endif
   2674          void Read_Current_DCBus_Voltage(sint32 ia_adc, sint32 ib_adc, sint32 ic_adc, sint32 dcbus_adc)
   2675          {
   2676          #ifndef MCI_CURRENT_SENSOR_GAIN_POSITIVE
   2677          
   2678              // Mcl interface Update
   2679              Mcl_IO.Is_ABC.A = MCL_CURRENT(((-ia_adc) << 4));
   2680              Mcl_IO.Is_ABC.B = MCL_CURRENT(((-ib_adc) << 4));
   2681              Mcl_IO.Is_ABC.C = MCL_CURRENT(((-ic_adc) << 4));
   2682          
   2683          #else
   2684          
   2685              // Mcl interface Update
   2686              Mcl_IO.Is_ABC.A = MCL_CURRENT(((ia_adc) << 4));
   2687              Mcl_IO.Is_ABC.B = MCL_CURRENT(((ib_adc) << 4));
   2688              Mcl_IO.Is_ABC.C = MCL_CURRENT(((ic_adc) << 4));
   2689          
   2690          #endif
   2691          
   2692              Mcl_IO.Vdc = MCL_VOLTAGE((dcbus_adc << 3));
   2693          }
