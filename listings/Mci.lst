   2175          //---------------------------------------------------------------------------------------------------------------------
   2176          /**
   2177           * @brief   Check for all error used in the control. Hardware and peripheral may
   2178           *          support to decrease the error polling rate.
   2179           */
   2180          #ifdef __IAR_SYSTEMS_ICC__
   2181          #pragma inline = forced
   2182          #endif
   2183          void Check_Errors_Pwm_Handler(void)
   2184          {
   2185              MCL_NOTATION_TYPE ia_abs;
   2186              MCL_NOTATION_TYPE ib_abs;
   2187              MCL_NOTATION_TYPE ic_abs;
   2188          
   2189              if(Mci_Control_State >= MCI_STARTING)
   2190              {
   2191                  ia_abs = MCL__ABS(Mcl_IO.Is_ABC.A);
   2192                  ib_abs = MCL__ABS(Mcl_IO.Is_ABC.B);
   2193                  ic_abs = MCL__ABS(Mcl_IO.Is_ABC.C);
   2194          
   2195                  if( (ia_abs >= MCI_MAXIMAL_MOTOR_CURRENT_ALLOWED)   ||
   2196                      (ib_abs >= MCI_MAXIMAL_MOTOR_CURRENT_ALLOWED)   ||
   2197                      (ic_abs >= MCI_MAXIMAL_MOTOR_CURRENT_ALLOWED) )
   2198                  {
   2199                      MCI_SET_ERROR(MCI_ERROR_SW_OVER_CURRENT);
   2200                  }
   2201                  else
   2202                  {
   2203                      MCI_CLR_ERROR(MCI_ERROR_SW_OVER_CURRENT);
   2204                  }
   2205              }
   2206              else
   2207              {
   2208                  MCI_CLR_ERROR(MCI_ERROR_SW_OVER_CURRENT);
   2209              }
   2210          }
   2211          
   2212          
   2213          
   2214          
   2215          //---------------------------------------------------------------------------------------------------------------------
   2216          /**
   2217           * @brief   Check for all error used in the control. Hardware and peripheral may
   2218           *          support to decrease the error polling rate.
   2219           */
   2220          #ifdef __IAR_SYSTEMS_ICC__
   2221          #pragma inline = forced
   2222          #endif
   2223          void Check_Errors_5ms_Handler(void)
   2224          {
   2225          	uint8 any_class_B_error_found;
   2226              uint8 temp_u8;
   2227              static uint8 time_postscaler = 0;
   2228          
   2229              //////////////////////////////////////////////////////////////////////////////////////////
   2230              //// DC Bus voltage monitor
   2231              if(!SURGE_RELAY_READY())
   2232              {
   2233                  MCI_SET_ERROR(MCI_ERROR_SURGE_RELAY_OPEN);
   2234              }
   2235              else
   2236              {
   2237                  MCI_CLR_ERROR(MCI_ERROR_SURGE_RELAY_OPEN);
   2238              }
   2239          
   2240              //////////////////////////////////////////////////////////////////////////////////////////
   2241              // DC Bus (over) current monitor
   2242              temp_u8 = MotorSafetyMgr__GetFault(SR_FAULT_OVER_CURRENT);
   2243          
   2244              if(temp_u8)
   2245              {
   2246                  MCI_SET_ERROR(MCI_ERROR_HW_OVER_CURRENT);
   2247              }
   2248              else
   2249              {
   2250                  MCI_CLR_ERROR(MCI_ERROR_HW_OVER_CURRENT);
   2251              }
   2252          
   2253              // Time post scaler, reduce from 5 ms to MCI_CHECKERR_POSTSCALER
   2254              if(time_postscaler)
   2255              {
   2256                  time_postscaler--;
   2257              }
   2258              else
   2259              {
   2260                  time_postscaler = MCI_CHECKERR_POSTSCALER;
   2261          
   2262                  // Any error found
   2263                  any_class_B_error_found = MotorSafetyMgr__AnyFaultFound();
   2264                  if(any_class_B_error_found)
   2265                  {
   2266                      // Look for electronics failure, OR wise operation across the flags below
   2267                      temp_u8  = MotorSafetyMgr__GetFault(SR_FAULT_CURRENT_SENSOR_FAILED);
   2268                      if(temp_u8)
   2269                      {
   2270                          MCI_SET_ERROR(MCI_ERROR_CURRENT_SENSOR_FAILED);
   2271                      }
   2272          
   2273                      temp_u8 = MotorSafetyMgr__GetFault(SR_FAULT_VOLTAGE_SENSOR_FAILED);
   2274                      if(temp_u8)
   2275                      {
   2276                          MCI_SET_ERROR(MCI_ERROR_VOLTAGE_SENSOR_FAILED);
   2277                      }
   2278          
   2279                      temp_u8 = MotorSafetyMgr__GetFault(SR_FAULT_PWM_SHUTDOWN_FAILED);
   2280                      if(temp_u8)
   2281                      {
   2282                          MCI_SET_ERROR(MCI_ERROR_PWM_SHUTDOWN_FAILED);
   2283                      }
   2284          
   2285          
   2286                      // Look for phase lost detection
   2287                      temp_u8  = MotorSafetyMgr__GetFault(SR_FAULT_PHASE_LOST);
   2288                      if(temp_u8)
   2289                      {
   2290                          MCI_SET_ERROR(MCI_ERROR_PHASE_LOST);
   2291                      }
   2292          
   2293                      //////////////////////////////////////////////////////////////////////////////////////////
   2294                      //// Class B check
   2295                      // Voltage is under the range from Class B
   2296                      temp_u8  = MotorSafetyMgr__GetFault(SR_FAULT_DCBUS_UNDER_VOLTAGE);
   2297                      if(temp_u8)
   2298                      {
   2299                          MCI_SET_ERROR(MCI_ERROR_DCBUS_UNDER_VOLTAGE);
   2300                      }
   2301          
   2302          
   2303                      // Voltage is over the range from Class B
   2304                      temp_u8  = MotorSafetyMgr__GetFault(SR_FAULT_DCBUS_OVER_VOLTAGE);
   2305                      if(temp_u8)
   2306                      {
   2307                          MCI_SET_ERROR(MCI_ERROR_DCBUS_OVER_VOLTAGE);
   2308                      }
   2309          
   2310          
   2311                      //// Check unlock door speed failed
   2312                      temp_u8 = MotorSafetyMgr__GetFault(SR_FAULT_UNLOCK_DOOR_SPEED_FAILED);
   2313                      if(temp_u8)
   2314                      {
   2315                          MCI_SET_ERROR(MCI_ERROR_UNLOCK_DOOR_SPEED_FAILED);
   2316                      }
   2317          
   2318          
   2319                      //// Check input capture plausibility faults
   2320                      #if defined MCL_GET_FAULT_INPUTCAPTURE_PLAUSIBILITY_MIN_FAILED
   2321                          // Min Tach Fault
   2322                          temp_u8 = MCL_GET_FAULT_INPUTCAPTURE_PLAUSIBILITY_MIN_FAILED();
   2323                          if(temp_u8)
   2324                          {
   2325                          	MCI_SET_ERROR(MCI_ERROR_INPUTCAPTURE_PLAUSIBILITY_MIN_FAILED);
   2326                          }
   2327                      #endif
   2328          
   2329                      #if defined MCL_GET_FAULT_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED
   2330                          // Max Speed change Fault
   2331                          temp_u8 = MCL_GET_FAULT_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED();
   2332                          if(temp_u8)
   2333                          {
   2334                          	MCI_SET_ERROR(MCI_ERROR_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED);
   2335                          }
   2336                      #endif
   2337          
   2338                      // Check for motor over heating
   2339                      temp_u8 = MotorSafetyMgr__GetFault(SR_FAULT_OVER_LOAD);
   2340                      if(temp_u8)
   2341                      {
   2342                         MCI_SET_ERROR(MCI_ERROR_OVER_LOAD);
   2343                      }
   2344                  }
   2345                  else
   2346                  {
   2347                      MCI_CLR_ERROR(MCI_ERROR_CURRENT_SENSOR_FAILED);
   2348                      MCI_CLR_ERROR(MCI_ERROR_VOLTAGE_SENSOR_FAILED);
   2349                      MCI_CLR_ERROR(MCI_ERROR_PWM_SHUTDOWN_FAILED);
   2350                      MCI_CLR_ERROR(MCI_ERROR_DCBUS_OVER_VOLTAGE);
   2351                      MCI_CLR_ERROR(MCI_ERROR_DCBUS_UNDER_VOLTAGE);
   2352                      MCI_CLR_ERROR(MCI_ERROR_UNLOCK_DOOR_SPEED_FAILED);
   2353          
   2354                      //// Check input capture plausibility faults
   2355                      #if defined MCL_GET_FAULT_INPUTCAPTURE_PLAUSIBILITY_MIN_FAILED
   2356                          MCI_CLR_ERROR(MCI_ERROR_INPUTCAPTURE_PLAUSIBILITY_MIN_FAILED);
   2357                      #endif
   2358          
   2359                      #if defined MCL_GET_FAULT_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED
   2360                          MCI_CLR_ERROR(MCI_ERROR_INPUTCAPTURE_PLAUSIBILITY_MAX_FAILED);
   2361                      #endif
   2362          
   2363                      MCI_CLR_ERROR(MCI_ERROR_OVER_LOAD);
   2364          
   2365                      // Look for phase lost detection
   2366          #if defined MCL_GET_MOTOR_DISCONNECTED
   2367                      // Motor disconnection check
   2368                      temp_u8 = MCL_GET_MOTOR_DISCONNECTED();
   2369          #endif
   2370                      if(temp_u8)
   2371                      {
   2372                          MCI_SET_ERROR(MCI_ERROR_PHASE_LOST);
   2373                      }
   2374                      else
   2375                      {
   2376                          MCI_CLR_ERROR(MCI_ERROR_PHASE_LOST);
   2377                      }
   2378                  }
   2379          
   2380          
   2381                  //////////////////////////////////////////
   2382                  ////// MCI_RUNNING
   2383                  if(Mci_Control_State == MCI_RUNNING)
   2384                  {
   2385                      temp_u8 = MotorSafetyMgr__DoesClassAHaveAccessToPwm();
   2386                      if(temp_u8 == FALSE)
   2387                      {
   2388                      	if(!any_class_B_error_found)
   2389                      	{
   2390                      		MCI_SET_ERROR(MCI_ERROR_CLASS_B_FORCE2STOP);
   2391                      	}
   2392                      }
   2393                  }
   2394                  //////////////////////////////////////////
   2395                  ////// MCI_STARTING
   2396                  else if(Mci_Control_State == MCI_STARTING)
   2397                  {
   2398                      temp_u8 = MotorSafetyMgr__DoesClassAHaveAccessToPwm();
   2399                      if(temp_u8 == FALSE)
   2400                      {
   2401                      	if(!any_class_B_error_found)
   2402                      	{
   2403                      		MCI_SET_ERROR(MCI_ERROR_CLASS_B_FORCE2STOP);
   2404                      	}
   2405                      }
   2406                  }
   2407                  //////////////////////////////////////////
   2408                  ////// MCI_INITIALIZING
   2409                  else if(Mci_Control_State == MCI_INITIALIZING)
   2410                  {
   2411                      if(Mci_GP_Timer < MCI_INIT_ERROR_THRES)
   2412                      {
   2413                          Mci_GP_Timer++;
   2414                      }
   2415                      else
   2416                      {
   2417                          MCI_SET_ERROR(MCI_ERROR_INITIALIZATION_FAILED);
   2418                      }
   2419                  }
   2420                  //////////////////////////////////////////
   2421                  ////// MCI_FAILED
   2422                  else if(Mci_Control_State == MCI_FAILED)
   2423                  {
   2424                      MCI_CLR_ERROR(MCI_ERROR_INITIALIZATION_FAILED);
   2425                      MCI_CLR_ERROR(MCI_ERROR_CLASS_B_FORCE2STOP);
   2426                  }
   2427                  //////////////////////////////////////////
   2428                  ////// MCI_CLASS_B_STARTING
   2429                  else if(Mci_Control_State == MCI_CLASS_B_STARTING)
   2430                  {
   2431                      if(Mci_GP_Timer < MCI_CLASS_B_STARTUP_THRES)
   2432                      {
   2433                          Mci_GP_Timer++;
   2434                      }
   2435                      else
   2436                      {
   2437                      	MCI_SET_ERROR(MCI_ERROR_CLASS_B_FORCE2STOP);
   2438                      }
   2439                  }
   2440          
   2441                  // Check if pwm is accessible by class A, then
   2442                  if(Mci_Control_State >= MCI_STARTING)
   2443                  {
   2444                      temp_u8 = BIT_TEST(Mci_Status_Control, MCI_DI_PARAMETERS_LOADED);
   2445                      if(!temp_u8)
   2446                      {
   2447                          MCI_SET_ERROR(MCI_ERROR_INITIALIZATION_FAILED);
   2448                      }
   2449                  }
   2450          
   2451          #if defined MCI_MEASURE_INVERTER_TEMP
   2452          
   2453                  if(InverterTemp__AboveThreshold_s16((MODULE_TEMP_TO_STOP<<16)) == TRUE)
   2454                  {
   2455                      MCI_SET_ERROR(MCI_ERROR_INVERTER_OVER_TEMP);
   2456                  }
   2457                  if(InverterTemp__AboveThreshold_s16((MODULE_TEMP_TO_START<<16)) == FALSE)
   2458                  {
   2459                      MCI_CLR_ERROR(MCI_ERROR_INVERTER_OVER_TEMP);
   2460                  }
   2461          
   2462          #endif
   2463          
   2464          
   2465          #if defined MCL_GET_LOCKED_ROTOR_AT_STARTUP
   2466          
   2467                 // Locked rotor by algorithm - startup phase
   2468                 temp_u8 = MCL_GET_LOCKED_ROTOR_AT_STARTUP();
   2469                 if(temp_u8)
   2470                 {
   2471                     MCI_SET_ERROR(MCI_ERROR_LOCKED_ROTOR_AT_STARTUP);
   2472                 }
   2473                 else
   2474                 {
   2475                     MCI_CLR_ERROR(MCI_ERROR_LOCKED_ROTOR_AT_STARTUP);
   2476                 }
   2477          
   2478          #endif
   2479          
   2480          
   2481          #if defined MCL_GET_LOCKED_ROTOR_IN_RUNNING
   2482          
   2483                 // Locked rotor by algorithm - motor running
   2484                 temp_u8 = MCL_GET_LOCKED_ROTOR_IN_RUNNING();
   2485                 if(temp_u8)
   2486                 {
   2487                     MCI_SET_ERROR(MCI_ERROR_LOCKED_ROTOR_IN_RUNNING);
   2488                 }
   2489                 else
   2490                 {
   2491                     MCI_CLR_ERROR(MCI_ERROR_LOCKED_ROTOR_IN_RUNNING);
   2492                 }
   2493          
   2494          #endif
   2495          
   2496          
   2497          #if defined MCL_GET_OBSERVER_FAILURE
   2498          
   2499                 // Observer failure found
   2500                 temp_u8 = MCL_GET_OBSERVER_FAILURE();
   2501                 if(temp_u8)
   2502                 {
   2503                     MCI_SET_ERROR(MCI_ERROR_OBSERVER_FAILURE);
   2504                 }
   2505                 else
   2506                 {
   2507                     MCI_CLR_ERROR(MCI_ERROR_OBSERVER_FAILURE);
   2508                 }
   2509          
   2510          #endif
   2511          
   2512          
   2513          #if defined MCL_CLASS_A_MOTOR_OVER_TEMP
   2514          
   2515                 // Motor over temperature
   2516                 temp_u8 = MCL_CLASS_A_MOTOR_OVER_TEMP();
   2517                 if(temp_u8)
   2518                 {
   2519                     MCI_SET_ERROR(MCI_ERROR_CLASS_A_MOTOR_OVER_TEMP);
   2520                 }
   2521                 else
   2522                 {
   2523                     MCI_CLR_ERROR(MCI_ERROR_CLASS_A_MOTOR_OVER_TEMP);
   2524                 }
   2525          
   2526          #endif
   2527          
   2528          
   2529          #if defined MCL_GET_INT_DISABLED
   2530          
   2531                 // Motor over temperature
   2532                 temp_u8 = MCL_GET_INT_DISABLED();
   2533                 if(temp_u8)
   2534                 {
   2535                     MCI_SET_ERROR(MCI_ERROR_INT_DISABLED);
   2536                 }
   2537                 else
   2538                 {
   2539                     MCI_CLR_ERROR(MCI_ERROR_INT_DISABLED);
   2540                 }
   2541          
   2542          #endif
   2543              }
   2544          }
