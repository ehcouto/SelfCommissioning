     83          //! Define the behavior and algorithm flow control
     84          typedef enum
     85          {
     86              MCI_FORCE_LOWERS_ON,                            //!<  0 - Enabled all lowers IGBTs
     87              MCI_ALL_DEVICES_OFF,                            //!<  1 - Disable all 6 IGBTs
     88              MCI_REQUESTED_STOP,                             //!<  2 - Requested to stop
     89              MCI_REQUESTED_START,                            //!<  3 - Requested to start
     90          
     91              MCI_REQUESTED_MANUAL_DC_VOLTAGE,                //!<  4 - Requested to manually control the output DC voltage
     92              MCI_REQUESTED_MANUAL_AC_VOLTAGE,                //!<  5 - Requested to manually control the output AC voltage
     93              MCI_REQUESTED_MANUAL_DC_CURRENT,                //!<  6 - Requested to manually control the output DC current
     94              MCI_REQUESTED_MANUAL_AC_CURRENT,                //!<  7 - Requested to manually control the output AC current
     95          
     96              MCI_REQUESTED_FVT_MODE,                         //!<  8 - Requested to execute functional verification test (FVT)
     97          } MCI_FLOWCONTROL_TYPE;
     98          
