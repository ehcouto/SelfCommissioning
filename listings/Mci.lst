     21                          MclObserver :
     22                          MclPwm :
     23                          MclSpeedCtrl :
     24                      }
     25                  Mcl :
     26                  Mcl ..> MacroBlocks
     27                  }
     28              }
     29          
     30              InverterTemp -[hidden]- Mcl
     31              SpeedRefGen -[hidden]- Mcl
     32              SurgeRelay -[hidden]- Mcl
