    458          //---------------------------------------------------------------------------------------------------------------------
    459          /**
    460           *    @brief    This function wait's till the flash command is executed.
    461           *    @details
    462           *    @param    bWaitComplete     : true if need wait till command completed before return.
    463           */
    464          static void Flash_Launchcmd(uint8 bWaitComplete)
    465           {
    466          	FTFA.FSTAT |= (FTFA_FSTAT_CCIF_MASK);
    467          
    468          	if (bWaitComplete)
    469          	{
    470          		// Wait till command is completed
    471          		while (!(FTFA.FSTAT & FTFA_FSTAT_CCIF_MASK));
    472          	}
    473          
    474          }
    475          //---------------------------------------------------------------------------------------------------------------------
    476          /**
    477           *    @brief    This function will step down the speed of Micro.
    478           *    @details  This method provides a way to switch from High to normal mode of operation.
    479           *
    480           */
    481          #if(MICRO_HIGHSPEEDRUN_MODE == ENABLED)
    482          static void Flash_SetNormalSpeedMode(void)
    483          {
    484          
    485              MICRO_DECLARE_INTERRUPT_CONTEXT_LOCAL();
    486              uint32 i;
    487          
    488              //Save and Disable the Interrupts
    489              MICRO_SAVE_INTERRUPT_CONTEXT_LOCAL();
    490          
    491          	/* The PMPROT register may have already been written by init code
    492          	 If so then this next write is not done.
    493          	 PMPROT is write once after RESET
    494          	 this write-once bit allows the MCU to enter Normal Speed Run Mode (HSRUN)*/
    495          	SMC.PMPROT.BIT.AHSRUN = 0;
    496          
    497          	/* Set the RUNM bits to 0b011 for HSRUN mode */
    498          	SMC.PMCTRL = SMC_PMCTRL_RUNM(0);
    499          
    500          	/* Wait for HSRUN regulator mode to be confirmed */
    501          	for (i = 0; i < 10000; i++)
    502          	{ /* check that the value of SMC_PMSTAT is not 0x10 once it is 0x10, we can stop checking */
    503          		if (SMC.PMSTAT != 0x01)
    504          		{
    505          			// 0x01 Current mode is normal run
    506          			// 0x80 Current mode is high speed run
    507          		}
    508          		else
    509          		break;
    510              }
    511          
    512              //Restore Interrupts
    513              MICRO_RESTORE_INTERRUPT_CONTEXT_LOCAL();
    514          }
    515          #endif

