     22          //-------------------------------------- PRIVATE (Variables, Constants & Defines) -------------------------------------
     23          //=====================================================================================================================
     24          /**
     25           *    @brief  - Defines the Interrupt Interval in us
     26           *    @details- Due to the Win implementation it is strongly recommended to use the timer interrupt interval of 1ms.
     27           *              The macro value should not be changed
     28           *
     29           *    @param  - 1000 // Do not change the value
     30           *
     31           *    @note   - Following is the Example\n
     32           *              "#define INTERRUPT_INTERVAL   1000"
     33           */
     34          //=====================================================================================================================
     35          #ifndef INTERRUPT_INTERVAL
     36          #define INTERRUPT_INTERVAL          1000                    //Interrupt interval in us
     37          #endif
     38          //=====================================================================================================================
     39          /**
     40           * @brief  - This macro defines the Systik interrupt group priority.
     41           * @details- Consists of 4 interrupt groups and each group consists of 4 sub-priorities.
     42           *           Only the group priority determines preemption of interrupt exceptions.
     43           *           When the processor is executing an interrupt exception handler, another interrupt with the
     44           *           same group priority as the interrupt being handled does not preempt the handler.
     45           *           If multiple pending interrupts have the same group priority, the sub-priority field determines
     46           *           the order in which they are processed. If multiple pending interrupts have the same group priority
     47           *           and sub-priority, the interrupt with the lowest IRQ number is processed first.
     48           *           The lower the Group priority the greater the priority of the corresponding interrupt group.
     49           *           The lower the sub-priority the greater the priorities of the corresponding interrupt within the group.
     50           *
     51           *           Note - Its recommended to configure the systik at highest priority.
     52           *
     53           *
     54           * @param  - 0/1/2/3
     55           *
     56           * @note   - Following are the Examples\n
     57           *           "#define SYSTICK_PREEMPTION_PRIORITY 0"  //The Systik is in interrupt group 0 having highest priority
     58           *           "#define SYSTICK_PREEMPTION_PRIORITY 1"  //The Systik is in interrupt group 1
     59           */
     60          //=====================================================================================================================
     61          #ifndef SYSTICK_PREEMPTION_PRIORITY
     62              #define SYSTICK_PREEMPTION_PRIORITY 3
     63          #endif
     64          
     65          //=====================================================================================================================
     66          /**
     67           * @brief  - This macro defines the Systik interrupt sub-priority.
     68           * @details- Each interrupt group consists of 4 interrupt sub-priorities.
     69           *           If multiple pending interrupts have the same group priority, the sub-priority field determines the
     70           *           order in which they are processed. If multiple pending interrupts have the same group priority
     71           *           and sub-priority, the interrupt with the lowest IRQ number is processed first.
     72           *           The lower the sub-priority the greater the priorities of the corresponding interrupt within the group.
     73           *
     74           *           Note - Its recommended to configure the systik at highest priority.
     75           *
     76           * @param  - 0/1/2/3
     77           *
     78           * @note   - Following are the Examples\n
     79           *           "#define SYSTICK_SUB_PRIORITY 0"  //The Systik sub-priority is 0 having highest priority within the group
     80           *           "#define SYSTICK_SUB_PRIORITY 1"   //The Systik sub-priority is 1
     81           */
     82          //=====================================================================================================================
     83          #ifndef SYSTICK_SUB_PRIORITY
     84              #define SYSTICK_SUB_PRIORITY        3
     85          #endif
     86          
     87          //=====================================================================================================================
     88          /**
     89           * @brief  - This macro defines long duration time interrupt
     90           * @details- The value should be in milli second.
     91           *            Long interval is configured only when the TimerInterrupt__SetLongInterval() is called during low power routine,
     92           *
     93           *           Note - User should take care of the long interval time and the watchdog time
     94           *
     95           * @param  - 1 to 1000
     96           *
     97           * @note   - Following are the Examples\n
     98           *           "#define TIMERITERUPT_LONG_INTERVAL_IN_US 25000"      //systick interval tick sets for every 25ms
     99           */
    100          //=====================================================================================================================
    101          #ifndef TIMERITERUPT_LONG_INTERVAL_IN_US
    102              #define TIMERITERUPT_LONG_INTERVAL_IN_US     25000
    103          #endif
    104          
    105          #define DEF_1MHZ                			1000000			//It generates a Timer clock freq = 1MHz
    106          #define DEF_1KHZ                            1000			//It generates a Timer clock freq = 1KHz
    107          
    108          #define TIMER_RELOAD_COUNT()            (Micro__GetClock()->HCLK_Frequency / (DEF_1MHZ/INTERRUPT_INTERVAL));
    109          #define TIMER_RELOAD_LONG_COUNT()       (Micro__GetClock()->HCLK_Frequency / (DEF_1MHZ/TIMERITERUPT_LONG_INTERVAL_IN_MS));
    110          #define HCLK_IN_MHZ()                   (Micro__GetClock()->HCLK_Frequency / DEF_1MHZ)
