   1374          /**
   1375           *    @brief    This method provides next index from cur_index - rolling on max_item
   1376           *
   1377           *    @param    cur_item - current item index
   1378           *    @param    max_item - maximum number of items
   1379           *
   1380           *    @return  cur_item+1 if result is < max_item, 0 otherwise
   1381           */
   1382          static uint8 GetNextItem(uint8 cur_item, uint8 max_item)
   1383          {
   1384              cur_item++;
   1385              if(cur_item >= max_item)
   1386              {
   1387                  cur_item = 0;
   1388              }
   1389              return(cur_item);
   1390          }
