    103          //---------------------------------------------------------------------------------------------------------------------
    104          // Macros to disable/restore context (interrupts/RTOS) on New command/feedback methods where
    105          // These macros definition are mandatory and should be defined in Reveal_prv.h
    106          #ifndef REVEAL__DECLARE_CONTEXT
    107              #error "REVEAL__DECLARE_CONTEXT() missing; it should be defined in Reveal_prv.h"
    108          #endif
    109          
    110          #ifndef REVEAL__SAVE_CONTEXT
    111              #error "REVEAL__SAVE_CONTEXT() missing; it should be defined in Reveal_prv.h"
    112          #endif
    113          
