   2251          //---------------------------------------------------------------------------------------------------------------------
   2252          /**
   2253           * @brief   Method to determine if the requested APIs from the Block Messages feature can be blocked. Result is based on
   2254           *          the list of possible APIs that can be blocked in the POSSIBLE_BLOCKED_APIS_LIST table.
   2255           * @param   pt: pointer to the list of APIs and opcodes requested to be blocked
   2256           * @param   number_of_bytes: number of bytes in the buffer pointed to by the "pt" argument
   2257           * @return  TRUE if all the requested APIs can be blocked, else FALSE.
   2258           */
   2259          static BOOL_TYPE RequestedAPIsCanBeBlocked(uint8 * pt, uint8 number_of_bytes)
   2260          {
   2261              uint8 index;
   2262              BOOL_TYPE apis_can_be_blocked = TRUE;
   2263          
   2264              // Verify all the requested APIs are in POSSIBLE_BLOCKED_APIS_LIST
   2265              for (uint8 count = 0; count < number_of_bytes; count+=BLOCKED_API_OPCODE_NUM_BYTES)   // Incrementing by BLOCKED_API_OPCODE_NUM_BYTES to skip over api/opcode pairs which are BLOCKED_API_OPCODE_NUM_BYTES bytes each
   2266              {
   2267                  // Walk the POSSIBLE_BLOCKED_APIS_LIST table to see if the requested API can be blocked
   2268                  for (index = 0; index < ELEMENTS_IN_ARRAY(POSSIBLE_BLOCKED_APIS_LIST); index++)
   2269                  {
   2270                      if (pt[count] == POSSIBLE_BLOCKED_APIS_LIST[index])
   2271                      {
   2272                          // Found the API is POSSIBLE_BLOCKED_APIS_LIST
   2273                          break;
   2274                      }
   2275                      //else, did not match API in POSSIBLE_BLOCKED_APIS_LIST, need to check next one
   2276                  }
   2277          
   2278                  // Check if the requested API was not found in the POSSIBLE_BLOCKED_APIS_LIST table
   2279                  if (index == ELEMENTS_IN_ARRAY(POSSIBLE_BLOCKED_APIS_LIST))
   2280                  {
   2281                      // API was not in the POSSIBLE_BLOCKED_APIS_LIST table and cannot be blocked
   2282                      apis_can_be_blocked = FALSE;
   2283                      break;
   2284                  }
   2285              }
   2286          
   2287              return(apis_can_be_blocked);
   2288          }
