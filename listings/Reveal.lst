   2230           * @brief Drop the message in the head of the queue.
   2231           * @details This function is used when a message is acknowledged or it's a bad message and it must be dropped.
   2232           * @param priority
   2233           */
   2234          static void DropMessageFromQueue(uint8 priority)
   2235          {
