   2401          /**
   2402           *  @brief      Controls the timer used to block api/opcode messages and clears all the blocked messages when the timer
   2403           *              expires
   2404           */
   2405          static void UpdateBlockedMessagesTimer(void)
   2406          {
   2407              if (Reveal_Blocked_Messages_Remaining_Time > 0)
   2408              {
   2409                  // Timer is still running, update the remaining time
   2410                  Reveal_Blocked_Messages_Remaining_Time--;
   2411          
   2412                  if (Reveal_Blocked_Messages_Remaining_Time == 0)
   2413                  {
   2414                      // Timer has expired, clear all blocked api/opcodes
   2415                      memset(Reveal_Blocked_Messages, 0, sizeof(Reveal_Blocked_Messages));
   2416                  }
   2417              }
   2418          }

