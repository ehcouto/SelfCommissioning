    230          static uint8 Reveal_Heartbeat_Node_Counter[15];
    231          
    232          //! Track the amount of time left to block messages (5ms increments)
    233          static uint16 Reveal_Blocked_Messages_Remaining_Time;
    234          
    235          //! Convert the block messages time in seconds to ticks managed by the module
    236          //! Value is based on 5ms call rate where the blocked messages remaining time is updated
    237          #define REVEAL_BLOCKED_MESSAGES_TIME_TO_TICKS   200 // 200 = 1s / 5ms
    238          
    239          //! Determines if any messages are currently being blocked
    240          #define MESSAGE_BLOCKING_ACTIVE() (Reveal_Blocked_Messages_Remaining_Time != 0)
    241          
    242          //! Define the byte offset (0-based) in the Block Messages payload where the API/Opcode pairs start
    243          #define BLOCKED_API_OPCODE_BYTE_OFFSET_START 3
    244          
    245          //! Define the number of bytes in the Block Messages payload that contain the information about a single api and opcode
    246          #define BLOCKED_API_OPCODE_NUM_BYTES         5
    247          
    248          //! Variable to keep track of which APIs/Opcodes are blocked
    249          //! Each entry in the array corresponds to an API in the POSSIBLE_BLOCKED_APIS_LIST table
    250          //! Each bit within a single entry represents whether the opcode for the API is blocked (1) or not (0)
    251          static uint32 Reveal_Blocked_Messages[ELEMENTS_IN_ARRAY(POSSIBLE_BLOCKED_APIS_LIST)];
