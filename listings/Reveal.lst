    115              #error "REVEAL__RESTORE_CONTEXT() missing; it should be defined in Reveal_prv.h"
    116          #endif
    117          
    118          //---------------------------------------------------------------------------------------------------------------------
    119          // Default debounce is set to 30ms
    120          #ifndef REVEAL_QUEUE_DEBOUNCE_MS
    121              #define REVEAL_QUEUE_DEBOUNCE_MS      30
    122          #endif
    123          
    124          // Debounce counter is scaled to 5ms
    125          #define REVEAL_QUEUE_DEBOUNCE_COUNT         ((REVEAL_QUEUE_DEBOUNCE_MS + 4)/5)
    126          
    127          // Valid range is [1..253] or 5-1265ms
    128          #if((REVEAL_QUEUE_DEBOUNCE_COUNT > 253) || (REVEAL_QUEUE_DEBOUNCE_COUNT <= 0))
    129          #error "REVEAL_QUEUE_DEBOUNCE_MS value shall be in [1..1265] range"
    130          #endif
    131          
    132          // Reveal Debounce counter:
    133          //  0               - IDLE       - Free
    134          //  1               - QUEUED     - Ready to be sent
    135          //  2               - TIMEOUT     - Ready to be sent
    136          //  > 2             - RESERVED   - Wait to complete it ( Debounce-2 counts )
    137          #define REVEAL_QUEUE_IDLE                           (0)
    138          #define REVEAL_QUEUE_QUEUED                         (1)
    139          #define REVEAL_QUEUE_TIMEOUT                        (2)
    140          #define SET_DEBOUNCE()                              (REVEAL_QUEUE_DEBOUNCE_COUNT + 2)
    141          #define IS_IDLE(x)                                  ((x) == 0)
    142          #define IS_QUEUED(x)                                ((x) == 1)
    143          #define IS_TIMEOUT(x)                               ((x) == 2)
    144          #define IS_PENDING(x)                               ((x) > 2)
    145          
