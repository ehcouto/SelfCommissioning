   2291          /**
   2292           * @brief This method handles a incoming Ack message.
   2293           * @param    node - the node id to send the message to
   2294           * @param    api - the api id of the command
   2295           * @param    opcode - the opcode of the command
   2296           * @param reason
   2297           * @param full_seach
   2298           */
   2299          static void RevealHandleAckParser(uint8 node, uint8 api, uint8 op_code, REVEAL_RECIPE_STATUS_TYPE reason, uint8 full_search)
   2300          {
   2301              uint8 count;
   2302              for (count=0;count< REVEAL_NUM_PARSERS;count++)
   2303              {
   2304                 if ((REVEAL_PARSER[count].API == api) ||    // Specific API parser or
   2305                     (REVEAL_PARSER[count].API == 0))        // Generic parser (API = 0) which should receive all APIs
   2306                 {
   2307                     if (REVEAL_PARSER[count].ACK_PARSER != NULL) // If the parser for the feedback is present
   2308                     {
   2309                         REVEAL_PARSER[count].ACK_PARSER(node,api, op_code,reason);
   2310                     }
   2311          
   2312                     if (full_search == FALSE)
   2313                     {
   2314                         if (REVEAL_PARSER[count].API != 0)      // If the generic parser is found it keeps searching for the specific parsers, otherwise it breaks and stop searching
   2315                         {
   2316                             break;
   2317                         }
   2318                     }
   2319                 }
   2320              }
   2321          }
