   1304          //---------------------------------------------------------------------------------------------------------------------
   1305          /**
   1306           *    @brief    Determines if the combination of api and opcode are currently blocked
   1307           *
   1308           *    @param    api - the api id of the command
   1309           *    @param    opcode - the opcode of the command
   1310           *
   1311           *    @return  TRUE if the message is blocked, else FALSE
   1312           */
   1313          static BOOL_TYPE IsMessageBlocked(uint8 api, uint8 opcode)
   1314          {
   1315              BOOL_TYPE is_message_blocked = FALSE;
   1316          
   1317              // Walk the POSSIBLE_BLOCKED_APIS_LIST table to find the index that corresponds to Reveal_Blocked_Messages array
   1318              for (uint8 index = 0; index < ELEMENTS_IN_ARRAY(POSSIBLE_BLOCKED_APIS_LIST); index++)
   1319              {
   1320                  if (api == POSSIBLE_BLOCKED_APIS_LIST[index])
   1321                  {
   1322                      // Found index in POSSIBLE_BLOCKED_APIS_LIST table with the API
   1323                      // Check bit that corresponds to the opcode to know if it is currently blocked
   1324                      is_message_blocked = (BOOL_TYPE)(BIT_TEST(Reveal_Blocked_Messages[index], opcode));
   1325                      break;
   1326                  }
   1327              }
   1328          
   1329              return(is_message_blocked);
   1330          }
