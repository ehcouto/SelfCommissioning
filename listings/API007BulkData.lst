    608          /**
    609           * @brief This method check the received segment_id ID with the list of segment_id ID's present with this node
    610           * @return segment_id ID if segment_id ID is present for this node
    611           * @return Invalid ID if segment_id ID is not present for this node
    612           */
    613          static uint8 GetSegmentIndex(API007APP_SEGMENT_ID segment_id)
    614          {
    615              uint8 idx;
    616          
    617              for (idx =0; idx < API007APP_MAX_NUMBER_SEGMENTS; idx++)
    618              {
    619                  if (API007BULKDATA_SEGMENT_ID[idx] == segment_id)
    620                  {
    621                      return(idx);
    622                  }
    623              }
    624              return (API007DATA_INVALID_SEGMENT_INDEX);
    625          }
