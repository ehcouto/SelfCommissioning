    180          #ifdef __IAR_SYSTEMS_ICC__
    181          #pragma inline = forced
    182          #endif
    183          static float32 Calculate_Flux_MTPV(MCL_DQ_REF_IO_F_TYPE *io, MCL_DQ_REF_PARAMS_TYPE *params)
    184          {
    185              float32 flux_limit_by_speed;
    186              float32 speed_abs_rotor;
    187              float32 vs_max;
    188              float32 temp_1_s32;
    189              float32 temp_2_s32;
    190              float32 temp_3_s32;
    191              float32 torque_error_factor;
    192              float32 iq_stator_current_abs;
    193          
    194              iq_stator_current_abs = MATHCALC__FABS(*(io->Ctrl_Specific->Iq_stator_current));
    195              speed_abs_rotor = MATHCALC__FABS(*(io->Ctrl_Specific->Speed_Rotor_Observed));
    196          
    197          //    MATHCALC__FILTER_CALC(speed_abs_rotor, speed_abs_rotor_sum, FILTER_SHIFT_FS_1KHZ_FC_1HZ);
    198          //    speed_abs_rotor = MATHCALC__FILTER_GET_FILTERED_VAR(speed_abs_rotor_sum, FILTER_SHIFT_FS_1KHZ_FC_1HZ);
    199          
    200              speed_abs_rotor = speed_abs_rotor + 0.1f;                              // Prevent zero division
    201          
    202              vs_max = (*(io->Vdc) * SQRT3_INV) * params->m_index;
    203          
    204              // Complete field weakening equation
    205          
    206              // (Rs * Id)
    207              temp_1_s32 = (*(io->Ctrl_Specific->Stator_Resistance) * *(io->Ctrl_Specific->Id_stator_current));
    208          
    209              // (Rs * Id)^2
    210              temp_1_s32 = (temp_1_s32 * temp_1_s32);
    211          
    212              // Vs_max^2
    213              temp_2_s32 = vs_max * vs_max;
    214          
    215              // sqrt(Vs_max^2 - Rs*Id^2)
    216              temp_1_s32 = MC_SQRT_F(temp_2_s32 - temp_1_s32);
    217          
    218              // Rs * Iq
    219              temp_2_s32 = *(io->Ctrl_Specific->Stator_Resistance) * iq_stator_current_abs;
    220          
    221              // sqrt(Vs_max^2 - Rs*Id^2) - Rs*Iq
    222              temp_1_s32 = temp_1_s32 - temp_2_s32;
    223              *(io->Ctrl_Specific->Vs_Flux) = (temp_1_s32);
    224          
    225              // (sqrt(Vs_max^2 - Rs*Id^2) - Rs*Iq)/abs(speed_r)
    226              flux_limit_by_speed = temp_1_s32/speed_abs_rotor;
    227          
    228          
    229              // Force at maximum flux at starting (prevent glitches on max flux)
    230              if( *(io->Ctrl_Specific->Elapsed_Time_After_Starting) < (params->Starting_Threshold) )
    231              {
    232                  flux_limit_by_speed = params->Max_Flux;
    233              }
    234              else
    235              {
    236          
    237                  temp_3_s32 = *(io->Q_Ref) - *(io->Ctrl_Specific->Torque);
    238                  torque_error_factor = (temp_3_s32 * params->Torque_Err_K);
    239                  torque_error_factor = MATHCALC__SATURATE_DIRECT(0, torque_error_factor, params->Torque_Err_Sat);
    240          
    241                  flux_limit_by_speed -= flux_limit_by_speed *  torque_error_factor;
    242          
    243                  // Limit the maximum flux
    244                  flux_limit_by_speed = MATHCALC__SATURATE_DIRECT(0, flux_limit_by_speed, (params->Max_Flux));
    245              }
    246              return flux_limit_by_speed;
    247          }
    248          
    249          
    250          #ifdef __IAR_SYSTEMS_ICC__
    251          #pragma inline = forced
    252          #endif
    253          static float32 Calculate_Flux_MTPA(MCL_DQ_REF_IO_F_TYPE *io, MCLDQREF_JOINT_PARAMS_TYPE *params)
    254          {
    255          
    256              //Id injection equations: general formulation
    257              float32 iq_braking;
    258              float32 ld;
    259              float32 lq;
    260              float32 flux_m;
    261              float32 flux_d;
    262              float32 flux_q;
    263              float32 flux_ref_mtpa;
    264              float32 total_squared_flux;
    265              float32 temp_1;
    266          
    267          
    268              // understand if there is a braking request (check for Id braking)
    269              if (Id_Braking == 0)
    270              {// motoring mode --> MTPA Trajectory
    271                  temp_1 =  MATHCALC__FABS(*(io->Torque_Ref));
    272                  flux_ref_mtpa = MathCalc__GetInterpolationFastF(temp_1, &params->MTPAPrm);
    273          #if (DQREF__FLUX_ADAPTATION==ENABLED)
    274                  Flux_M_Braking = params->DqRefPrm->Rotor_Flux_Nominal;      // reset to nominal value when not braking
    275          #endif
    276              }
    277              else
    278              {// braking mode --> non-regenerative trajectory
    279                  ld = io->Ctrl_Specific->Ldq_Ind->D;
    280                  lq = io->Ctrl_Specific->Ldq_Ind->Q;
    281                  flux_m = params->DqRefPrm->Rotor_Flux_Nominal;
    282          #if (DQREF__FLUX_ADAPTATION==ENABLED)
    283                  if(params->DqRefAddPrm->Flux_Adaptation_G_Gain != 0)
    284                  {
    285                      // adaptive calculation of magnet flux
    286                      Flux_M_Braking += params->DqRefAddPrm->Flux_Adaptation_G_Gain * (Id_Braking - *io->Ctrl_Specific->Id_Rotor_Current);
    287                      // saturate if needed
    288                      if (Flux_M_Braking < params->DqRefAddPrm->Flux_Adaptation_Low_Limit)
    289                      {
    290                          Flux_M_Braking = params->DqRefAddPrm->Flux_Adaptation_Low_Limit;
    291                      }
    292                      else if (Flux_M_Braking > params->DqRefAddPrm->Flux_Adaptation_High_Limit)
    293                      {
    294                          Flux_M_Braking = params->DqRefAddPrm->Flux_Adaptation_High_Limit;
    295                      }
    296                      flux_m = Flux_M_Braking;
    297                  }
    298          #endif
    299                  // iq_braking given torque_ref and id_braking
    300                  temp_1 = flux_m + (ld-lq)*Id_Braking;
    301                  iq_braking = *(io->Torque_Ref) * params->DqRefPrm->K_torque_inv * params->DqRefPrm->Rotor_Flux_Nominal / temp_1;
    302          
    303                  flux_d = flux_m + ld * Id_Braking;
    304                  flux_q = lq * iq_braking;
    305          
    306                  total_squared_flux = flux_d * flux_d + flux_q * flux_q;
    307                  flux_ref_mtpa = MC_SQRT_F(total_squared_flux);
    308              }
    309              return flux_ref_mtpa;
    310          
    311          }

